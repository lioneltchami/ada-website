# Sanity CMS
SANITY_PROJECT_ID=your-sanity-project-id
SANITY_DATASET=production
SANITY_TOKEN=
SANITY_API_TOKEN=

# Supabase
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DONATION_FOLLOWUP_CRON_SECRET=generate-a-long-random-secret

# Stripe (get from https://dashboard.stripe.com/test/apikeys)
# Test mode keys start with pk_test_ and sk_test_
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Site
PUBLIC_SITE_URL=https://apotidev.org

# Email (Resend - get from https://resend.com/api-keys)
RESEND_API_KEY=
FROM_EMAIL=ADA <noreply@apotidev.org>

# Umami Analytics (get from https://cloud.umami.is)
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_URL=https://cloud.umami.is

# PostHog product analytics (project API key starts with phc_)
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Lightweight web-vitals sampling (0 disables, 1 records every visit)
PUBLIC_WEB_VITALS_SAMPLE_RATE=0.2
