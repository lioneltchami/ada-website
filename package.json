    "@sanity/client": "^7.22.0",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.4.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "6.4.8",
    "lucide-react": "^1.14.0",
    "marked": "^18.0.5",
    "playwright": "^1.60.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "stripe": "^22.1.1",
    "tailwindcss": "^4.3.0",
    "wrangler": "^4.92.0",
