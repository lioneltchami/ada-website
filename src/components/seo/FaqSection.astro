---
import type { FaqItem } from "../../lib/structured-data";

interface Props {
  title: string;
  subtitle?: string;
  faqs: FaqItem[];
  contactHref?: string;
  contactLabel?: string;
  openFirst?: boolean;
}

const {
  title,
  subtitle,
  faqs,
  contactHref,
  contactLabel,
  openFirst = true,
} = Astro.props;
---

<div class="max-w-3xl">
  <h2 class="text-2xl font-heading font-bold text-gray-900 text-left">
    {title}
  </h2>
  {
    subtitle && (
      <p class="mt-2 text-left text-gray-600 text-sm">{subtitle}</p>
    )
  }
  <div class="mt-8 space-y-4">
    {
      faqs.map((faq, i) => (
        <details
          class="group p-5 bg-[#faf8f4] rounded-md border border-gray-200 cursor-pointer"
          open={openFirst && i === 0}
        >
          <summary class="flex items-center justify-between gap-4 font-semibold text-gray-900 text-sm list-none">
            <span>{faq.question}</span>
            <span
              class="flex-shrink-0 text-primary-600 group-open:rotate-180 transition-transform duration-200"
              aria-hidden="true"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="2.5"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m19.5 8.25-7.5 7.5-7.5-7.5"
                />
              </svg>
            </span>
          </summary>
          <p class="mt-3 text-sm text-gray-600 leading-relaxed">{faq.answer}</p>
        </details>
      ))
    }
  </div>
  {
    contactHref && contactLabel && (
      <p class="mt-6 text-left text-sm text-gray-500">
        <a
          href={contactHref}
          class="text-primary-600 hover:underline font-medium"
        >
          {contactLabel}
        </a>
      </p>
    )
  }
</div>
