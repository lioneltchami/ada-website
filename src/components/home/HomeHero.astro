---
import { getArchiveFeaturePhoto } from "../../data/archive-feature-photos";
import { localePath, type Locale } from "../../i18n";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const fr = locale === "fr";
const lead = "widow-support-food-cash-mar-2022";
const leadPhotos = [
  {
    slug: lead,
    photo: getArchiveFeaturePhoto(lead, locale),
    position: "object-center",
    caption: fr ? "Vivres et articles essentiels pour les veuves de Muea, 2022." : "Food and household essentials for widows in Muea, 2022.",
    linkLabel: fr ? "En savoir plus sur les visites aux veuves à Muea en 2022" : "Learn more about the 2022 widows’ home visits in Muea",
  },
  {
    slug: "first-widow-home-visits-2021",
    photo: getArchiveFeaturePhoto("first-widow-home-visits-2021", locale),
    position: "object-[center_32%]",
    caption: fr ? "Notre équipe pendant nos premières visites aux veuves, 2021." : "Our team during our first widows’ home visits, 2021.",
    linkLabel: fr ? "En savoir plus sur nos premières visites aux veuves en 2021" : "Learn more about our first widows’ home visits in 2021",
  },
].filter((slide) => Boolean(slide.photo));
const link = (slug: string) => localePath(`/projects/archive/${slug}/`, locale);
const cards = [
  {
    slug: "prenatal-care-support-program",
    title: fr ? "Des essentiels pour les mères" : "Essentials for mothers",
    place: "Muea · 2025",
  },
  {
    slug: "idp-girls-baking-training-jul-2022",
    title: fr ? "Atelier de pâtisserie pour les filles" : "Girls’ baking workshop",
    place: "Buea · 2022",
  },
].map((record) => ({ ...record, photo: getArchiveFeaturePhoto(record.slug, locale) }));
---

<section class="bg-[#f7f5f0] py-4 sm:py-7" data-home-hero>
  <div class="mx-auto grid w-full max-w-7xl gap-3 px-4 sm:px-6 lg:grid-cols-[2.1fr_1fr] lg:px-8">
    <div class="relative isolate flex min-h-[26rem] flex-col justify-end overflow-hidden rounded-xl bg-primary-950 text-white sm:min-h-[31rem]" data-hero-feature>
      {leadPhotos.map(({ photo, position }, index) => photo && (
        <img data-hero-image hidden={index !== 0} src={photo.src} alt={photo.alt} width={photo.width} height={photo.height}
          fetchpriority={index === 0 ? "high" : "auto"} loading={index === 0 ? "eager" : "lazy"} decoding="async"
          class:list={["absolute inset-0 -z-20 h-full w-full object-cover", position]} />
      ))}
      <div aria-hidden="true" class="lead-shade absolute inset-0 -z-10"></div>
      {leadPhotos.length > 1 && (
        <div data-hero-controls hidden role="group" aria-label={fr ? "Parcourir les photos à la une" : "Browse featured photos"}
          class="absolute inset-x-3 top-3 items-center justify-end gap-2 sm:inset-x-5 sm:top-5">
          <button type="button" data-hero-step="-1" aria-label={fr ? "Photo précédente" : "Previous featured photo"}
            class="grid size-11 place-items-center rounded-full border border-white/70 bg-primary-950/90 text-white hover:bg-primary-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
          </button>
          <button type="button" data-hero-step="1" aria-label={fr ? "Photo suivante" : "Next featured photo"}
            class="grid size-11 place-items-center rounded-full border border-white/70 bg-primary-950/90 text-white hover:bg-primary-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
          </button>
        </div>
      )}
      <div class="max-w-xl p-5 pt-20 sm:p-8 sm:pt-20 lg:p-10 lg:pt-20">
        <slot />
        {leadPhotos.length > 0 && (
          <div aria-live="polite">
            {leadPhotos.map(({ slug, caption, linkLabel }, index) => (
              <div hidden={index !== 0} data-hero-caption>
                <p class="mt-4 text-sm font-semibold text-white/95">{caption}</p>
                <a href={link(slug)} aria-label={linkLabel}
                  class="mt-3 inline-flex min-h-11 items-center rounded-md bg-white px-4 py-2.5 text-sm font-semibold text-primary-950 hover:bg-primary-100">
                  {fr ? "En savoir plus" : "Learn more"} <span aria-hidden="true" class="ml-2">→</span>
                </a>
              </div>
            ))}
          </div>
        )}
        <slot name="partner" />
      </div>
    </div>
    <div class="grid min-w-0 gap-3 sm:grid-cols-2 lg:grid-cols-1 lg:grid-rows-2">
      {cards.map(({ slug, title, place, photo }) => photo && (
        <a href={link(slug)} class="group relative isolate flex min-h-40 flex-col justify-end overflow-hidden rounded-xl bg-primary-950 p-4 text-white outline-offset-2 transition-shadow hover:ring-2 hover:ring-primary-700 sm:p-5 lg:min-h-0">
          <img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height}
            decoding="async" class="absolute inset-0 -z-20 h-full w-full object-cover object-center" />
          <div aria-hidden="true" class="card-shade absolute inset-0 -z-10"></div>
          <span class="text-xs font-semibold text-white">{place}</span>
          <span class="mt-1 flex items-end justify-between gap-2 font-heading text-base font-semibold leading-tight sm:text-lg">
            {title}<span aria-hidden="true">→</span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<script>
  for (const carousel of document.querySelectorAll("[data-hero-feature]")) {
    const controls = carousel.querySelector<HTMLElement>("[data-hero-controls]");
    const photos = [...carousel.querySelectorAll<HTMLImageElement>("[data-hero-image]")];
    const captions = [...carousel.querySelectorAll<HTMLElement>("[data-hero-caption]")];
    if (!controls || photos.length < 2 || photos.length !== captions.length) continue;

    let current = 0;
    controls.querySelectorAll<HTMLButtonElement>("[data-hero-step]").forEach((button) => {
      button.addEventListener("click", () => {
        current = (current + Number(button.dataset.heroStep) + photos.length) % photos.length;
        photos.forEach((photo, index) => { photo.hidden = index !== current; });
        captions.forEach((caption, index) => { caption.hidden = index !== current; });
      });
    });
    controls.hidden = false;
  }
</script>

<style>
  [data-hero-controls]:not([hidden]) { display: flex; }
  [data-hero-image][hidden], [data-hero-caption][hidden] { display: none; }

  .lead-shade {
    background: linear-gradient(0deg, rgb(5 26 19 / 98%) 5%, rgb(5 26 19 / 82%) 45%, rgb(5 26 19 / 12%) 82%);
  }
  .card-shade {
    background: linear-gradient(0deg, rgb(5 26 19 / 97%), rgb(5 26 19 / 68%) 34%, rgb(5 26 19 / 6%) 79%);
  }
  @media (min-width: 640px) {
    .lead-shade {
      background: linear-gradient(90deg, rgb(5 26 19 / 88%), rgb(5 26 19 / 37%) 65%, transparent),
                  linear-gradient(0deg, rgb(5 26 19 / 82%), transparent 85%);
    }
  }
</style>
