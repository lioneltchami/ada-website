---
import Section from "../layout/Section.astro";
import type { Locale } from "../../i18n";
import { localePath } from "../../i18n";

interface Props {
  locale?: Locale;
  title: string;
  excerpt: string;
  href: string;
  imageUrl?: string;
  imageAlt?: string;
}

const { locale = "en", title, excerpt, href, imageUrl, imageAlt } = Astro.props;
const isFr = locale === "fr";

const copy = isFr
  ? { badge: "Histoire à la une", cta: "Lire l'histoire complète →" }
  : { badge: "Featured story", cta: "Read the full story →" };
---

<Section background="white" padding="md">
  <div class="max-w-4xl mx-auto">
    <a
      href={href}
      class:list={[
        "group overflow-hidden rounded-2xl border border-primary-100 bg-gradient-to-r from-primary-50 to-accent-50 hover:shadow-lg transition-all duration-300",
        imageUrl
          ? "grid grid-cols-1 md:grid-cols-[1.1fr_1fr]"
          : "block",
      ]}
    >
      {
        imageUrl ? (
          <div class="relative min-h-[220px] md:min-h-full overflow-hidden">
            <img
              src={imageUrl}
              alt={imageAlt || title}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
              loading="lazy"
            />
          </div>
        ) : null
      }
      <div class="p-6 md:p-8 flex flex-col justify-center">
        <span class="self-start px-2 py-0.5 text-[10px] font-semibold uppercase bg-purple-100 text-purple-700 rounded-full">
          {copy.badge}
        </span>
        <h3 class="mt-3 text-xl md:text-2xl font-heading font-bold text-gray-900 group-hover:text-primary-700 transition-colors">
          {title}
        </h3>
        <p class="mt-3 text-sm text-gray-600 leading-relaxed">{excerpt}</p>
        <span class="mt-4 inline-block text-sm font-medium text-primary-600">
          {copy.cta}
        </span>
      </div>
    </a>
  </div>
</Section>
