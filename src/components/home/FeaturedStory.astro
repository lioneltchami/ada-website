---
import Section from "../layout/Section.astro";
import type { Locale } from "../../i18n";

interface Props {
  locale?: Locale;
  title: string;
  excerpt: string;
  href: string;
  imageUrl?: string;
  imageAlt?: string;
}

const { locale = "en", title, excerpt, href, imageUrl, imageAlt } = Astro.props;
const isFr = locale === "fr";

const copy = isFr
  ? { label: "Histoire à la une", cta: "Lire l'histoire complète →" }
  : { label: "Featured story", cta: "Read the full story →" };
---

<Section background="white" padding="md">
  <div class="max-w-4xl">
    <a
      href={href}
      class:list={[
        "group overflow-hidden rounded-md border border-gray-200 bg-[#faf8f4] transition-colors hover:border-primary-300",
        imageUrl
          ? "grid grid-cols-1 md:grid-cols-[1.1fr_1fr]"
          : "block",
      ]}
    >
      {
        imageUrl ? (
          <div class="relative min-h-[220px] md:min-h-full overflow-hidden">
            <img
              src={imageUrl}
              alt={imageAlt || title}
              class="absolute inset-0 w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        ) : null
      }
      <div class="p-6 md:p-8 flex flex-col justify-center">
        <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
          {copy.label}
        </p>
        <h3 class="mt-3 text-xl md:text-2xl font-heading font-bold text-gray-900 group-hover:text-primary-700 transition-colors">
          {title}
        </h3>
        <p class="mt-3 text-sm text-gray-600 leading-relaxed">{excerpt}</p>
        <span class="mt-5 font-heading text-sm font-semibold text-primary-700 underline underline-offset-4">
          {copy.cta}
        </span>
      </div>
    </a>
  </div>
</Section>
