---
import Section from "../layout/Section.astro";
import type { Locale } from "../../i18n";
import { localePath } from "../../i18n";
import type { GalleryMosaicPhoto } from "../../lib/gallery";

interface Props {
  locale?: Locale;
  photos: GalleryMosaicPhoto[];
}

const { locale = "en", photos } = Astro.props;
const isFr = locale === "fr";
const hasPhotos = photos.length >= 4;

const copy = isFr
  ? {
      eyebrow: "Sur le terrain",
      title: "Preuves en images",
      body: "Moments réels de nos programmes au Cameroun — distribution, formation, école et communauté.",
      gallery: "Voir la galerie",
    }
  : {
      eyebrow: "In the field",
      title: "Proof in pictures",
      body: "Real moments from ADA programs across Cameroon — relief, training, school support, and community work.",
      gallery: "Browse gallery",
    };
---

{
  hasPhotos && (
    <Section background="gray" padding="lg">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-wider text-primary-700">
            {copy.eyebrow}
          </p>
          <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900">
            {copy.title}
          </h2>
          <p class="mt-3 text-gray-600 leading-relaxed">{copy.body}</p>
        </div>
        <a
          href={localePath("/gallery", locale)}
          class="inline-flex items-center justify-center self-start md:self-auto px-4 py-2.5 text-sm font-semibold text-primary-800 border border-primary-200 rounded-lg bg-white hover:bg-primary-50 transition-colors"
        >
          {copy.gallery} →
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-2 md:gap-3">
        {photos.slice(0, 8).map((photo, index) => (
          <a
            href={
              photo.href?.startsWith("/")
                ? localePath(photo.href, locale)
                : localePath("/gallery", locale)
            }
            class:list={[
              "group relative overflow-hidden rounded-xl bg-gray-200",
              index === 0 || index === 5
                ? "aspect-[4/5] md:row-span-2 md:aspect-auto md:min-h-[280px]"
                : "aspect-[4/3]",
            ]}
          >
            <img
              src={photo.imageUrl}
              alt={photo.alt}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
              loading={index < 4 ? "eager" : "lazy"}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/55 via-transparent to-transparent opacity-80" />
            <div class="absolute bottom-0 left-0 right-0 p-3">
              <p class="text-white text-xs sm:text-sm font-medium line-clamp-2 drop-shadow">
                {photo.title}
              </p>
            </div>
          </a>
        ))}
      </div>
    </Section>
  )
}
