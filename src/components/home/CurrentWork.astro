---
import Section from "../layout/Section.astro";
import type { Locale } from "../../i18n";
import { localePath } from "../../i18n";
import { getArchiveFeaturePhoto } from "../../data/archive-feature-photos";
import {
  projectStatusLabel,
  type ProjectStatus,
} from "../../lib/project-lifecycle";
import type { UpcomingAnnouncement } from "../../lib/upcoming-announcements";
import type { SpotlightProject } from "../../lib/spotlight-projects";

interface Props {
  locale?: Locale;
  projects: SpotlightProject[];
  announcements: UpcomingAnnouncement[];
}

const { locale = "en", projects, announcements } = Astro.props;
const isFr = locale === "fr";
const hasProjects = projects.length > 0;

const copy = isFr
  ? {
      eyebrow: "En ce moment",
      title: "Ce que nous faisons maintenant",
      body: "Découvrez les prochaines actions d’ADA et les campagnes que vous pouvez soutenir.",
      campaignBody: "Découvrez les campagnes que vous pouvez soutenir.",
      upcoming: "Actions à venir",
      campaigns: "Campagnes à soutenir",
      scheduled: "Prévu",
      details: "Voir le projet",
      donate: "Donner",
      all: "Tous les projets",
      people: "bénéficiaires",
      archive: "Action passée",
    }
  : {
      eyebrow: "Right now",
      title: "What we are working on",
      body: "See what’s coming up and which campaigns you can support.",
      campaignBody: "See which campaigns you can support.",
      upcoming: "Upcoming outreaches",
      campaigns: "Campaigns you can support",
      scheduled: "Scheduled",
      details: "View project",
      donate: "Donate",
      all: "All projects",
      people: "beneficiaries",
      archive: "Past outreach",
    };

// These photos show related, completed work. Never use a campaign CMS image
// as proof of activities or imply that a past outreach is this campaign.
const relatedOutreachByCampaign = new Map([
  ["widow-support", {
    slug: "widow-support-food-cash-mar-2022",
    label: { en: "Widows’ home visits in Muea, March 2022", fr: "Visites à domicile auprès des veuves à Muea, mars 2022" },
  }],
  ["education-drive", {
    slug: "back-to-school-sep-2022",
    label: { en: "Back-to-school outreach in Buea, August 2022", fr: "Action de rentrée scolaire à Buea, août 2022" },
  }],
]);

function statusClass(status: ProjectStatus): string {
  if (status === "upcoming") return "bg-primary-100 text-primary-800";
  if (status === "active") return "bg-green-100 text-green-800";
  return "bg-yellow-100 text-yellow-800";
}

function formatSchedule(start?: string, end?: string): string {
  if (!start) return "";
  const opts: Intl.DateTimeFormatOptions = {
    month: "short",
    day: "numeric",
    year: "numeric",
  };
  const loc = isFr ? "fr-FR" : "en-US";
  const startLabel = new Date(`${start}T12:00:00`).toLocaleDateString(loc, opts);
  if (!end || end === start) return startLabel;
  const endLabel = new Date(`${end}T12:00:00`).toLocaleDateString(loc, opts);
  return `${startLabel} – ${endLabel}`;
}
---

{
  (hasProjects || announcements.length > 0) && (
<Section background="white" padding="lg">
  <div
    class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-10"
  >
    <div class="max-w-2xl">
      <p
        class="text-xs font-semibold uppercase tracking-wider text-primary-700"
      >
        {copy.eyebrow}
      </p>
      <h2
        class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900"
      >
        {copy.title}
      </h2>
      <p class="mt-4 text-gray-600 leading-relaxed">
        {announcements.length > 0 ? copy.body : copy.campaignBody}
      </p>
    </div>
    <a
      href={localePath("/projects", locale)}
      class="inline-flex items-center justify-center self-start lg:self-auto px-4 py-2.5 text-sm font-semibold text-primary-800 border border-primary-200 rounded-lg hover:bg-primary-50 transition-colors"
    >
      {copy.all} →
    </a>
  </div>

  {announcements.length > 0 && (
    <section
      class:list={["rounded-md border border-primary-200 bg-primary-50 p-5 sm:p-6", hasProjects && "mb-10"]}
      aria-labelledby="home-upcoming-outreaches"
    >
      <h3 id="home-upcoming-outreaches" class="font-heading text-lg font-bold text-primary-900">{copy.upcoming}</h3>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        {announcements.map(({ slug, title, date }) => (
          <li>
            <time datetime={date} class="block text-sm text-primary-800">{formatSchedule(date)}</time>
            <a class="mt-1 inline-block text-sm font-semibold text-primary-800 underline underline-offset-4 hover:text-primary-950" href={localePath(`/projects/${slug}/`, locale)}>{title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {hasProjects && announcements.length > 0 && <h3 class="mb-4 font-heading text-lg font-bold text-gray-900">{copy.campaigns}</h3>}
  {hasProjects && (
  <div
    class:list={[
      "grid items-start gap-6",
      projects.length === 1
        ? "grid-cols-1 max-w-3xl"
        : projects.length === 3
          ? "grid-cols-1 md:grid-cols-2 xl:grid-cols-3"
          : "grid-cols-1 md:grid-cols-2",
    ]}
  >
    {
      projects.map((project) => {
        const outreach = relatedOutreachByCampaign.get(project.slug);
        const photo = outreach && getArchiveFeaturePhoto(outreach.slug, locale);
        return (
          <article class="overflow-hidden rounded-md border border-gray-200 border-t-4 border-t-primary-600 bg-[#faf8f4]">
            <div class="p-6">
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span
                  class:list={[
                    "font-heading px-2 py-0.5 text-xs font-semibold rounded-md",
                    statusClass(project.status),
                  ]}
                >
                  {projectStatusLabel(project.status, locale)}
                </span>
                <span class="text-xs text-gray-500">{project.location}</span>
                <span class="text-xs text-gray-500">
                  {project.beneficiaries} {copy.people}
                </span>
              </div>
              <h3 class="text-xl font-heading font-bold text-gray-900">
                <a
                  href={localePath(`/projects/${project.slug}`, locale)}
                  class="hover:text-primary-700 transition-colors"
                >
                  {project.title}
                </a>
              </h3>
              {(project.startDate || project.endDate) && (
                <p class="mt-2 text-xs font-medium text-primary-800">
                  {copy.scheduled}:{" "}
                  {formatSchedule(project.startDate, project.endDate)}
                </p>
              )}
              <p class="mt-3 text-sm text-gray-600 leading-relaxed line-clamp-3">
                {project.description}
              </p>
              <div class="mt-5 flex gap-2">
                <a
                  href={localePath(`/projects/${project.slug}`, locale)}
                  class="flex-1 text-center px-3 py-2.5 text-sm font-medium text-primary-800 border border-primary-200 rounded-md hover:bg-primary-50 transition-colors"
                >
                  {copy.details}
                </a>
                <a
                  href={localePath(`/donate?project=${project.slug}`, locale)}
                  class="flex-1 text-center px-3 py-2.5 text-sm font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors"
                  data-umami-event="home-spotlight-donate"
                  data-ph-capture-attribute-campaign={project.slug}
                >
                  {copy.donate}
                </a>
              </div>
            </div>
            {outreach && photo && (
              <figure data-home-related-outreach={outreach.slug} class="border-t border-primary-100">
                <img
                  src={photo.src}
                  alt={photo.alt}
                  width={photo.width}
                  height={photo.height}
                  class="aspect-[16/9] h-auto w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="px-6 py-3 text-xs leading-relaxed text-gray-700">
                  <strong class="text-primary-800">{copy.archive}:</strong>{" "}
                  <a
                    href={localePath(`/projects/archive/${outreach.slug}/`, locale)}
                    class="underline underline-offset-2 hover:text-primary-800"
                  >{outreach.label[locale]}</a>
                </figcaption>
              </figure>
            )}
          </article>
        );
      })
    }
  </div>
  )}
</Section>
  )
}
