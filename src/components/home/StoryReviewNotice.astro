---
import type { ContentLocale } from "../../lib/sanity-locale";
import { getStoryReviewCopy } from "../../lib/story-review-notice";
import { localePath } from "../../i18n";
import Section from "../layout/Section.astro";

interface Props {
	locale?: ContentLocale;
	variant?: "index" | "detail" | "featured";
}

const { locale = "en", variant = "index" } = Astro.props;
const copy = getStoryReviewCopy(locale);
---

{variant === "featured" ? (
	<Section background="white" padding="md">
		<div class="max-w-4xl rounded-md border border-gray-200 bg-[#faf8f4] p-6 md:p-8">
			<p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
				{copy.featuredLabel}
			</p>
			<h2 class="mt-3 text-xl font-heading font-bold text-gray-900 md:text-2xl">
				{copy.featuredTitle}
			</h2>
			<p class="mt-3 max-w-2xl text-sm leading-relaxed text-gray-600">
				{copy.featuredMessage}
			</p>
			<a
				href={localePath("/stories", locale)}
				class="mt-5 inline-flex font-heading text-sm font-semibold text-primary-700 underline underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700"
			>
				{copy.featuredLink}
			</a>
		</div>
	</Section>
) : variant === "detail" ? (
	<div
		class="mx-auto max-w-3xl rounded-lg border border-primary-200 bg-primary-50 p-6 sm:p-8"
		aria-labelledby="story-review-notice-title"
	>
		<h2 id="story-review-notice-title" class="font-heading text-xl font-bold text-gray-900">
			{copy.detailNoticeTitle}
		</h2>
		<p class="mt-3 text-base leading-relaxed text-gray-700">{copy.detailNoticeMessage}</p>
		<a
			href={localePath("/stories", locale)}
			class="mt-5 inline-flex font-heading text-sm font-semibold text-primary-700 underline underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700"
		>
			{copy.detailBackLink}
		</a>
	</div>
) : (
	<div
		class="mx-auto max-w-3xl rounded-lg border border-primary-200 bg-primary-50 p-6 sm:p-8"
		aria-labelledby="story-review-notice-title"
	>
		<h2 id="story-review-notice-title" class="font-heading text-xl font-bold text-gray-900">
			{copy.indexTitle}
		</h2>
		<p class="mt-3 text-base leading-relaxed text-gray-700">{copy.indexMessage}</p>
	</div>
)}
