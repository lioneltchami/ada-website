---
import { outreachDisplayTitle } from "../../lib/outreach-display-title";
import { CHRISTMAS_OUTREACH_DATE, christmasPlanningDocuments } from "../../lib/christmas-announcements";
import { hasReleased2023ProjectDocumentSet } from "../../lib/reviewed-project-records";
import { hasReleased2024ProjectDocumentSet, hasReleased2025ProjectDocumentSet } from "../../lib/reviewed-project-summaries-2024-25";
import { reviewed2026Release } from "../../lib/reviewed-project-summaries-2026";
import { released2026ReportLabel, released2025ReportLabel } from "../../lib/archive-project-document-links";
import { hasReleasedProjectDocumentSet } from "../../data/organization";
import reviews from "../../../content/year-in-review.json";
import Section from "../layout/Section.astro";
import type { Locale } from "../../i18n";
import type {
  YearDocumentGroup,
  ProjectDemographic,
} from "../../lib/project-archive";
import {
  demographicLabel,
  projectDisplayTitle,
} from "../../lib/project-archive";
import {
  groupDiligenceDocs,
  type DiligenceDoc,
  type DiligenceGroup,
} from "../../data/diligence-docs";

interface Props {
  locale: Locale;
  labels: {
    annualReports: string;
    projectDocs: string;
    projectDocsIntro: string;
    projectDocsIntroOne: string;
    funderDocs: string;
    funderDocsDesc: string;
    tor: string;
    financials: string;
    completionReport: string;
    download: string;
    openLink: string;
    annualReportForYear: string;
    projectsInYear: string;
    projectInYear: string;
    diligenceGroups: Record<DiligenceGroup, string>;
    demographics: Record<ProjectDemographic, string>;
  };
  dueDiligenceDocs: DiligenceDoc[];
  yearGroups: YearDocumentGroup[];
  totalProjects: number;
}

const { locale, labels, dueDiligenceDocs, yearGroups, totalProjects } =
  Astro.props;
const englishProjectPdfs = (slug: string) => slug === "first-widow-home-visits-2021" || hasReleasedProjectDocumentSet(slug) || hasReleased2023ProjectDocumentSet(slug) || hasReleased2024ProjectDocumentSet(slug) || hasReleased2025ProjectDocumentSet(slug) || Boolean(reviewed2026Release(slug));
const reviewedYears = new Set(reviews.map(({ year }) => year));
const projectYears = new Set(yearGroups.map(({ year }) => year));
const libraryYears: YearDocumentGroup[] = [
  ...yearGroups,
  ...reviews.filter(({ year }) => !projectYears.has(year)).map(({ year }) => ({
    year, projectCount: 0, demographics: [],
  })),
].sort((a, b) => b.year - a.year);
const latestYear = yearGroups[0]?.year;
const fr = locale === "fr";
const diligenceSections = groupDiligenceDocs(dueDiligenceDocs);
function diligenceFileType(link: string) {
  const path = link.split(/[?#]/, 1)[0];
  return path.match(/\.(pdf|xlsx)$/i)?.[1]?.toUpperCase() ?? (fr ? "Lien" : "Link");
}

function projectsInYearLabel(count: number): string {
  const template = count === 1 ? labels.projectInYear : labels.projectsInYear;
  return template.replace("{count}", String(count));
}

const projectDocsIntro =
  totalProjects === 1
    ? labels.projectDocsIntroOne.replace("{count}", String(totalProjects))
    : labels.projectDocsIntro.replace("{count}", String(totalProjects));
---

<nav aria-label={fr ? "Dans cette bibliothèque de ressources" : "On this page"} class="mx-auto flex max-w-5xl flex-wrap gap-x-6 gap-y-1 px-4 py-3 text-sm font-semibold text-primary-900 sm:px-6">
  <a href="#due-diligence" class="inline-flex min-h-11 items-center underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4">{labels.funderDocs}</a>
  <a href="#year-in-review" class="inline-flex min-h-11 items-center underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4">{labels.projectDocs}{fr ? " et bilans annuels" : " and Year in Review"}</a>
</nav>

<!-- Due diligence — grouped cards for funders -->
<Section id="due-diligence" class="scroll-mt-24" background="gray" padding="lg">
  <div class="max-w-5xl mx-auto">
    <div class="mb-8 max-w-3xl">
      <h2 class="text-3xl font-heading font-bold text-gray-900">
        {labels.funderDocs}
      </h2>
      <p class="text-gray-600 mt-2 leading-relaxed">{labels.funderDocsDesc}</p>
    </div>

    <div class="space-y-10">
      {
        diligenceSections.map((section) => (
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider text-primary-700 mb-4">
              {labels.diligenceGroups[section.group]}
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {section.docs.map((doc) => (
                <a
                  href={doc.link}
                  hreflang={doc.language}
                  target={doc.external ? "_blank" : "_self"}
                  rel={doc.external ? "noopener" : undefined}
                  class="group flex gap-5 p-6 bg-white rounded-md border border-gray-200 hover:border-primary-300 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600"
                >
                  <div
                    class="w-14 h-14 rounded-md bg-primary-50 border border-primary-100 flex items-center justify-center shrink-0"
                    aria-hidden="true"
                  >
                    <span class="font-heading text-xs font-bold uppercase tracking-wider text-primary-700">{diligenceFileType(doc.link)}</span>
                  </div>
                  <div class="min-w-0 flex-1 flex flex-col">
                    <span class="font-bold text-gray-900 text-lg leading-snug group-hover:text-primary-800 transition-colors">
                      {doc.title}
                    </span>
                    {doc.meta && (
                      <span class="mt-1 text-xs font-semibold uppercase tracking-wide text-gray-500">
                        {doc.meta}
                      </span>
                    )}
                    <span class="text-sm text-gray-600 mt-1.5 leading-relaxed">
                      {doc.desc}
                    </span>
                    <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary-700">
                      {doc.action ?? labels.download}
                      <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden="true"
                      >
                        →
                      </span>
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Section>

<!-- Projects by year → demographic -->
<Section id="project-documents" background="white" padding="lg">
  <div class="max-w-5xl mx-auto">
    <h2 id="year-in-review" class="scroll-mt-24 text-3xl font-heading font-bold text-gray-900">
      {labels.projectDocs}
    </h2>
    <p class="mt-1 text-sm text-gray-600">{projectDocsIntro}</p>
    {totalProjects > 0 && <p class="mt-1 text-sm text-gray-600">{fr ? "Les documents de projet s’ouvrent dans un nouvel onglet." : "Project documents open in a new tab."}</p>}

    <div class="mt-6 space-y-3">
      {
        libraryYears.map((yearGroup) => {
          const hasReview = reviewedYears.has(yearGroup.year);
          return (
          <div data-document-year={yearGroup.year} class="relative">
          {yearGroup.projectCount === 0 ? (
            <div class="flex min-h-14 items-center rounded-xl border border-gray-200 bg-gray-50/40 py-3 pl-4 pr-40 sm:pr-56">
              <h3 class="font-heading font-bold text-gray-900">{yearGroup.year}</h3>
            </div>
          ) : <details
            class="group rounded-xl border border-gray-200 bg-gray-50/40 open:bg-white open:shadow-sm"
            open={yearGroup.year === latestYear}
          >
            <summary class:list={[
              "relative flex min-h-14 flex-wrap items-center gap-x-3 gap-y-1 py-3 pl-4 pr-10 cursor-pointer list-none [&::-webkit-details-marker]:hidden focus-visible:outline-2 focus-visible:outline-primary-700",
              hasReview && "pr-40 sm:pr-56",
            ]}>
              <span class="font-heading font-bold text-gray-900">
                {yearGroup.year}
              </span>
              <span class:list={["text-xs text-gray-600", hasReview && "sr-only sm:not-sr-only"]}>
                {projectsInYearLabel(yearGroup.projectCount)}
              </span>
              <span
                class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 group-open:rotate-180 transition-transform"
                aria-hidden="true"
              >
                ▾
              </span>
            </summary>

            <div class="px-4 pb-4 pt-0 border-t border-gray-100">
              {yearGroup.annualReportPath && (
                <a
                  href={yearGroup.annualReportPath}
                  target="_blank"
                  rel="noopener"
                  class="mt-3 inline-flex items-center gap-2 text-sm font-medium text-primary-700 hover:text-primary-800"
                >
                  <span aria-hidden="true">📊</span>
                  {labels.annualReportForYear.replace(
                    "{year}",
                    String(yearGroup.year),
                  )}
                </a>
              )}

              {String(yearGroup.year) === CHRISTMAS_OUTREACH_DATE.slice(0, 4) && (
                <div class="mt-4 rounded-lg border border-gray-200 p-3">
                  <h3 class="font-semibold text-gray-900">{fr ? "Plans des actions de Noël" : "Christmas Outreach Plans"}</h3>
                  <p class="mt-1 text-sm text-gray-600">{fr ? "Termes de référence uniquement. Ces documents ne sont pas des rapports d’activité." : "Terms of Reference only. These are not completion reports."}</p>
                  <ul class="mt-2 space-y-1">
                    {christmasPlanningDocuments.map((project) => (
                      <li>
                        <a href={project.tor} hreflang="en" class="inline-flex min-h-6 items-center text-sm text-primary-800 underline focus-visible:outline-2 focus-visible:outline-offset-2">
                          <span data-outreach-title={project.slug}>{outreachDisplayTitle(project, locale)}</span>{" · "} {fr ? "Termes de référence (PDF en anglais)" : "Terms of Reference (PDF)"}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="mt-4 space-y-5">
                {yearGroup.demographics.map((demoGroup) => (
                  <div
                    role="group"
                    aria-label={demographicLabel(
                      demoGroup.demographic,
                      labels.demographics,
                    )}
                  >
                    <h3 class="text-xs font-bold uppercase tracking-wider text-primary-700">
                      {demographicLabel(
                        demoGroup.demographic,
                        labels.demographics,
                      )}
                    </h3>
                    <ul class="mt-2 space-y-2">
                      {demoGroup.projects.map((project) => {
                        const title = projectDisplayTitle(project, locale);
                        const englishNote = fr && englishProjectPdfs(project.slug) ? " (PDF en anglais)" : "";
                        const reportLabel = released2026ReportLabel(project.slug, locale) ?? released2025ReportLabel(project.slug, locale) ?? (hasReleased2024ProjectDocumentSet(project.slug) ? (fr ? "Rapport de projet et budget" : "Project report and budget") : hasReleasedProjectDocumentSet(project.slug) ? (fr ? "Rapport de projet et compte financier" : "Project report and financial account") : labels.completionReport);
                        return (
                        <li class="rounded-lg border border-gray-100 bg-white px-3 py-2.5">
                          <p data-outreach-title={project.slug} class="text-sm font-medium text-gray-900">
                            {title}
                          </p>
                          <p class="mt-1.5 flex flex-wrap gap-x-3 gap-y-1 text-xs">
                            <a
                              href={project.torUrl}
                              aria-label={`${labels.tor}${englishNote} : ${title} (${yearGroup.year})`}
                              hreflang={englishProjectPdfs(project.slug) ? "en" : undefined}
                              target="_blank"
                              rel="noopener"
                              class="inline-flex min-h-6 items-center text-primary-700 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
                            >
                              {labels.tor}{englishNote}
                            </a>
                            <span class="text-gray-300" aria-hidden="true">
                              ·
                            </span>
                            {project.financialReportUrl && <>
                              <a
                                href={project.financialReportUrl}
                                aria-label={`${labels.financials}${englishNote} : ${title} (${yearGroup.year})`}
                                hreflang={englishProjectPdfs(project.slug) ? "en" : undefined}
                                target="_blank"
                                rel="noopener"
                                class="inline-flex min-h-6 items-center text-primary-700 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
                              >
                                {labels.financials}{englishNote}
                              </a>
                              <span class="text-gray-300" aria-hidden="true">·</span>
                            </>}
                            <a
                              href={project.reportUrl}
                              aria-label={`${reportLabel}${englishNote} : ${title} (${yearGroup.year})`}
                              hreflang={englishProjectPdfs(project.slug) ? "en" : undefined}
                              target="_blank"
                              rel="noopener"
                              class="inline-flex min-h-6 items-center text-primary-700 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
                            >
                              {reportLabel}{englishNote}
                            </a>
                          </p>
                        </li>
                      ); })}
                    </ul>
                  </div>
                ))}
              </div>
            </div>
          </details>}
          {hasReview && (
            <a href={`/docs/year-in-review/ADA-${yearGroup.year}-Year-in-Review.pdf`}
              data-annual-review={yearGroup.year}
              aria-label={fr ? `Bilan ${yearGroup.year} (PDF bilingue)` : `${yearGroup.year} Year in Review (bilingual PDF)`}
              class="absolute right-10 top-1.5 inline-flex min-h-11 items-center gap-2 whitespace-nowrap rounded-md px-2 text-xs font-semibold text-primary-900 underline underline-offset-4 hover:bg-primary-50 focus-visible:outline-2 focus-visible:outline-offset-2 sm:text-sm">
              {fr ? "Bilan de l’année" : "Year in Review"}
              <span aria-hidden="true" class="hidden text-xs font-normal text-gray-600 sm:inline">PDF · EN/FR</span>
            </a>
          )}
          </div>
          );
        })
      }
    </div>
  </div>
</Section>
