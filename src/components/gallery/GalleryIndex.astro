---
import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../layout/PageHero.astro";
import Section from "../layout/Section.astro";
import {
  getClearedGalleryMedia,
  type ClearedGalleryMedia,
} from "../../lib/gallery-media-clearance";
import { getGalleryImages, sanityImageUrl } from "../../lib/sanity";
import type { Locale } from "../../i18n";
import { localePath } from "../../i18n";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const isFr = locale === "fr";
const byYear = new Map<number, ClearedGalleryMedia[]>();

try {
  const rows = await getGalleryImages(undefined, locale);
  const seen = new Set<string>();
  for (const row of rows) {
    // A Sanity title, year or project pointer is not independent evidence.
    const media = getClearedGalleryMedia(row._id, row.photo?.asset?._ref);
    if (!media || seen.has(media.id)) continue;
    seen.add(media.id);
    const items = byYear.get(media.year) ?? [];
    items.push(media);
    byYear.set(media.year, items);
  }
} catch {
  // A failed gallery fetch must not expose fallback images without clearance.
}

const years = [...byYear.entries()].sort(([a], [b]) => b - a);
for (const [, items] of years) {
  items.sort((a, b) => (b.date || "").localeCompare(a.date || "") || a.id.localeCompare(b.id));
}
const archiveHref = localePath("/projects/archive/", locale);
const formatDate = (date: string) => new Intl.DateTimeFormat(
  isFr ? "fr-CM" : "en-CM", { dateStyle: "long", timeZone: "UTC" },
).format(new Date(`${date}T00:00:00Z`));

const copy = isFr
  ? {
      title: "Galerie",
      description: "Retrouvez les photos approuvées des actions d’ADA au Cameroun et les comptes rendus des projets.",
      subtitle: "Les actions d’ADA au Cameroun en images.",
      mediaCount: (count: number) => count === 1 ? "1 photo" : `${count} photos`,
      record: "Consulter le dossier de ce projet",
      emptyTitle: "Découvrir nos actions sur le terrain",
      emptyBody: "Aucune photo n’est actuellement publiée dans cette galerie. Les archives présentent les actions menées au Cameroun et les comptes rendus disponibles.",
      browse: "Consulter les archives des projets",
    }
  : {
      title: "Photo Gallery",
      description: "Find approved photos of ADA’s work in Cameroon and browse the project records.",
      subtitle: "A look at ADA’s work in Cameroon.",
      mediaCount: (count: number) => count === 1 ? "1 photo" : `${count} photos`,
      record: "View this project record",
      emptyTitle: "Explore our work in Cameroon",
      emptyBody: "There are no photos published in this gallery right now. The project archive shows what our teams have done and includes reports where available.",
      browse: "Browse the project archive",
    };
---

<PageLayout title={copy.title} description={copy.description}>
  <PageHero title={copy.title} subtitle={copy.subtitle} compact />

  <Section background="white" padding="lg">
    {years.length > 0 ? (
      <div class="space-y-12">
        {years.map(([year, mediaItems]) => (
          <section aria-labelledby={`gallery-year-${year}`}>
            <div class="mb-6 flex flex-wrap items-center gap-3">
              <h2 id={`gallery-year-${year}`} class="font-heading text-2xl font-bold text-gray-900">
                {year}
              </h2>
              <span class="rounded-md border border-primary-100 bg-primary-50 px-2.5 py-0.5 text-xs font-medium text-primary-800">
                {copy.mediaCount(mediaItems.length)}
              </span>
            </div>

            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {mediaItems.map((media) => (
                <figure class="overflow-hidden rounded-lg border border-gray-200 bg-white">
                  <div class="aspect-[4/3] bg-[#efece4]">
                    <img
                      src={sanityImageUrl(media.assetRef, 480)}
                      srcset={[320, 480, 720].map(width => `${sanityImageUrl(media.assetRef, width)} ${width}w`).join(", ")}
                      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                      alt={isFr ? media.altFr : media.alt}
                      class="h-full w-full object-contain"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <figcaption class="p-4 text-sm leading-relaxed text-gray-700">
                    <p class="font-semibold text-gray-900">{isFr ? media.captionFr : media.caption}</p>
                    <p class="mt-1">{media.date ? <time datetime={media.date}>{formatDate(media.date)}</time> : year}</p>
                    {media.archiveSlug && (
                      <a
                        href={localePath(`/projects/archive/${media.archiveSlug}/`, locale)}
                        class="mt-2 inline-flex min-h-11 items-center rounded-sm font-semibold text-primary-800 underline underline-offset-4 hover:text-primary-950"
                      >{copy.record}</a>
                    )}
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <div class="max-w-2xl rounded-lg border border-primary-100 bg-white p-6 sm:p-8">
        <h2 class="font-heading text-xl font-semibold text-gray-900">{copy.emptyTitle}</h2>
        <p class="mt-2 max-w-prose text-gray-700">{copy.emptyBody}</p>
        <a
          href={archiveHref}
          class="mt-4 inline-flex min-h-11 items-center rounded-sm font-semibold text-primary-800 underline underline-offset-4 hover:text-primary-950"
        >{copy.browse} <span aria-hidden="true" class="ml-2">→</span></a>
      </div>
    )}
  </Section>
</PageLayout>
