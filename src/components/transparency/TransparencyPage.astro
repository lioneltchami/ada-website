---
import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../layout/PageHero.astro";
import Section from "../layout/Section.astro";
import type { Locale } from "../../i18n";
import { t, localePath } from "../../i18n";
import {
  annualReportPdfs,
  impactGrowthByYear,
  indicatorProgress,
  measurableIndicatorsEn,
  measurableIndicatorsFr,
  REGISTRATION_CERTIFICATE_URL,
  REGISTRATION_NUMBER,
} from "../../data/organization";
import { transparencyCopyFor } from "../../data/transparency-copy";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels = t(locale);
const copy = transparencyCopyFor(locale);
const measurableIndicators =
  locale === "fr" ? measurableIndicatorsFr : measurableIndicatorsEn;
const impactChartMax = Math.max(
  ...impactGrowthByYear.map((item) => item.value),
);
---

<PageLayout title={copy.meta.title} description={copy.meta.description}>
  <PageHero
    title={copy.hero.title}
    subtitle={copy.hero.subtitle}
    badge={copy.hero.badge}
    compact
  />

  <!-- Registration -->
  <Section background="white" padding="lg">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-heading font-bold text-gray-900">
        {labels.transparency.legalRegistration}
      </h2>
      <div class="mt-6 p-6 bg-gray-50 rounded-2xl border border-gray-200">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wider">
              {copy.registration.orgNameLabel}
            </p>
            <p class="mt-1 text-sm font-semibold text-gray-900">
              {copy.registration.orgName}
            </p>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wider">
              {copy.registration.countryLabel}
            </p>
            <p class="mt-1 text-sm font-semibold text-gray-900">
              {copy.registration.country}
            </p>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wider">
              {copy.registration.legalStatusLabel}
            </p>
            <p class="mt-1 text-sm font-semibold text-gray-900">
              {copy.registration.legalStatus}
            </p>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wider">
              {copy.registration.yearLabel}
            </p>
            <p class="mt-1 text-sm font-semibold text-gray-900">
              {copy.registration.year}
            </p>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wider">
              {copy.registration.regNumberLabel}
            </p>
            <p class="mt-1 text-sm font-semibold text-gray-900">
              {REGISTRATION_NUMBER}
            </p>
          </div>
          <div>
            <p class="text-xs text-gray-500 uppercase tracking-wider">
              {copy.registration.governingLawLabel}
            </p>
            <p class="mt-1 text-sm font-semibold text-gray-900">
              {copy.registration.governingLaw}
            </p>
          </div>
        </div>
        <a
          href={REGISTRATION_CERTIFICATE_URL}
          target="_blank"
          rel="noopener"
          class="mt-4 inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-primary-700 bg-white border border-primary-200 rounded-lg hover:bg-primary-50 transition-colors"
        >
          <span aria-hidden="true">📄</span>
          {copy.registration.downloadCertificate}
        </a>
      </div>
    </div>
  </Section>

  <!-- Governance & Board -->
  <Section background="white" padding="lg">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-heading font-bold text-gray-900">
        {labels.transparency.governanceStructure}
      </h2>
      <p class="mt-2 text-gray-600">{copy.governance.intro}</p>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
        {
          copy.governance.roles.map((role) => (
            <div class="p-4 bg-gray-50 rounded-xl border border-gray-100">
              <p class="text-xs text-gray-500 uppercase tracking-wider">
                {role.role}
              </p>
              <p class="mt-1 text-sm font-semibold text-gray-900">{role.name}</p>
              {role.note && (
                <p class="text-xs text-gray-500">{role.note}</p>
              )}
            </div>
          ))
        }
      </div>

      <div class="mt-6 p-4 bg-primary-50 rounded-xl border border-primary-100">
        <p class="text-sm text-primary-800">
          <strong>{copy.governance.principlesLabel}</strong>{" "}
          {copy.governance.principles}
        </p>
      </div>
    </div>
  </Section>

  <!-- Fund Flow -->
  <Section background="white" padding="lg">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-3xl">
        <span
          class="inline-flex px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary-700 bg-primary-50 rounded-full"
        >
          {copy.fundFlow.badge}
        </span>
        <h2 class="mt-4 text-2xl font-heading font-bold text-gray-900">
          {copy.fundFlow.title}
        </h2>
        <p class="mt-3 text-gray-600">{copy.fundFlow.intro}</p>
      </div>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-5 gap-4">
        {
          copy.fundFlow.steps.map((item) => (
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-200">
              <div class="w-9 h-9 rounded-full bg-primary-600 text-white flex items-center justify-center text-sm font-bold">
                {item.step}
              </div>
              <h3 class="mt-4 text-sm font-semibold text-gray-900">
                {item.title}
              </h3>
              <p class="mt-2 text-xs text-gray-600 leading-relaxed">{item.desc}</p>
            </div>
          ))
        }
      </div>

      <div
        class="mt-6 grid grid-cols-1 md:grid-cols-[1fr_auto] gap-4 items-center p-5 bg-amber-50 border border-amber-200 rounded-xl"
      >
        <p class="text-sm text-amber-900 leading-relaxed">
          <strong>{copy.fundFlow.internationalNoteLabel}</strong>{" "}
          {copy.fundFlow.internationalNote}
        </p>
        <a
          href={localePath("/contact?subject=Donor+Due+Diligence", locale)}
          class="inline-flex justify-center px-4 py-2 text-sm font-semibold text-amber-900 bg-white border border-amber-300 rounded-lg hover:bg-amber-100 transition-colors"
        >
          {copy.fundFlow.askDocuments}
        </a>
      </div>
    </div>
  </Section>

  <!-- International Support -->
  <Section background="gray" padding="lg">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-3xl">
        <span
          class="inline-flex px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary-700 bg-white rounded-full"
        >
          {copy.internationalSupport.badge}
        </span>
        <h2 class="mt-4 text-2xl font-heading font-bold text-gray-900">
          {copy.internationalSupport.title}
        </h2>
        <p class="mt-3 text-gray-600">{copy.internationalSupport.intro}</p>
      </div>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
        {
          copy.internationalSupport.notes.map((item) => (
            <div class="p-5 bg-white rounded-xl border border-gray-200">
              <p class="text-xs font-semibold uppercase tracking-wider text-primary-700">
                {item.region}
              </p>
              <h3 class="mt-3 text-base font-semibold text-gray-900">
                {item.status}
              </h3>
              <p class="mt-3 text-sm text-gray-600 leading-relaxed">
                {item.detail}
              </p>
            </div>
          ))
        }
      </div>

      <div class="mt-6 p-5 bg-white rounded-xl border border-gray-200">
        <h3 class="text-base font-semibold text-gray-900">
          {copy.internationalSupport.fiscalTitle}
        </h3>
        <p class="mt-2 text-sm text-gray-600 leading-relaxed">
          {copy.internationalSupport.fiscalBody}
        </p>
      </div>
    </div>
  </Section>

  <!-- Partner Due Diligence -->
  <Section background="white" padding="lg">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-[0.95fr_1.05fr] gap-8 items-start">
        <div>
          <span
            class="inline-flex px-3 py-1 text-xs font-semibold uppercase tracking-wider text-primary-700 bg-primary-50 rounded-full"
          >
            {copy.partnerDueDiligence.badge}
          </span>
          <h2 class="mt-4 text-2xl font-heading font-bold text-gray-900">
            {copy.partnerDueDiligence.title}
          </h2>
          <p class="mt-3 text-gray-600">{copy.partnerDueDiligence.intro}</p>
          <a
            href={localePath("/contact?subject=Partner+Due+Diligence", locale)}
            class="mt-5 inline-flex justify-center px-4 py-2 text-sm font-semibold text-primary-700 bg-white border border-primary-200 rounded-lg hover:bg-primary-50 transition-colors"
          >
            {copy.partnerDueDiligence.requestPacket}
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {
            copy.partnerDueDiligence.documents.map((document) => (
              <div class="p-4 bg-gray-50 rounded-xl border border-gray-200">
                <p class="text-sm font-semibold text-gray-900">{document}</p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
        {
          copy.partnerDueDiligence.thirdPartyProof.map((item) => (
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-200">
              <p class="text-sm font-semibold text-gray-900">{item.label}</p>
              <p class="mt-2 text-xs text-gray-600 leading-relaxed">{item.note}</p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Financial Overview -->
  <Section background="gray" padding="lg">
    <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl font-heading font-bold text-gray-900">
        {labels.transparency.financialAccountability}
      </h2>
      <p class="mt-2 text-gray-600">{copy.financial.intro}</p>

      <div class="mt-8 p-6 bg-white rounded-2xl border border-gray-200">
        <div
          class="flex h-8 overflow-hidden rounded-full bg-gray-100"
          aria-label={copy.financial.moneyGoesAria}
        >
          <div class="bg-primary-600" style="width: 80%"></div>
          <div class="bg-accent-500" style="width: 15%"></div>
          <div class="bg-gray-500" style="width: 5%"></div>
        </div>

        <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
          {
            copy.financial.moneyGoes.map((item) => (
              <div class="p-4 bg-gray-50 rounded-xl border border-gray-200">
                <div class="flex items-center justify-between gap-3">
                  <p class="text-sm font-semibold text-gray-900">{item.label}</p>
                  <p class="text-2xl font-bold text-primary-700">{item.value}</p>
                </div>
                <div class="mt-3 h-2 rounded-full bg-white overflow-hidden">
                  <div
                    class="h-full bg-primary-600 rounded-full"
                    style={`width: ${item.width}`}
                  />
                </div>
                <p class="mt-3 text-xs text-gray-600 leading-relaxed">
                  {item.detail}
                </p>
              </div>
            ))
          }
        </div>

        <p class="mt-5 text-xs text-gray-500">{copy.financial.allocationNote}</p>
      </div>

      <h3 class="mt-10 text-lg font-semibold text-gray-900">
        {copy.financial.annualSummary}
      </h3>
      <div class="mt-4 overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-200">
              <th class="text-left py-3 px-2 text-gray-700 font-medium">
                {copy.financial.tableHeaders.year}
              </th>
              <th class="text-right py-3 px-2 text-gray-700 font-medium">
                {copy.financial.tableHeaders.totalReceived}
              </th>
              <th class="text-right py-3 px-2 text-gray-700 font-medium">
                {copy.financial.tableHeaders.programs}
              </th>
              <th class="text-right py-3 px-2 text-gray-700 font-medium">
                {copy.financial.tableHeaders.operations}
              </th>
              <th class="text-right py-3 px-2 text-gray-700 font-medium">
                {copy.financial.tableHeaders.admin}
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {
              copy.financial.rows.map((row) => (
                <tr>
                  <td class="py-3 px-2 font-medium">{row.year}</td>
                  <td class="text-right py-3 px-2">{row.total}</td>
                  <td class="text-right py-3 px-2">{row.programs}</td>
                  <td class="text-right py-3 px-2">{row.operations}</td>
                  <td class="text-right py-3 px-2">{row.admin}</td>
                </tr>
              ))
            }
          </tbody>
          <tfoot>
            <tr class="border-t-2 border-gray-300 font-semibold">
              <td class="py-3 px-2">{copy.financial.totalLabel}</td>
              <td class="text-right py-3 px-2">{copy.financial.totals.total}</td>
              <td class="text-right py-3 px-2">
                {copy.financial.totals.programs}
              </td>
              <td class="text-right py-3 px-2">
                {copy.financial.totals.operations}
              </td>
              <td class="text-right py-3 px-2">{copy.financial.totals.admin}</td>
            </tr>
          </tfoot>
        </table>
      </div>
      <p class="mt-4 text-xs text-gray-500">{copy.financial.footnote}</p>
      <div class="mt-6">
        <h3 class="text-lg font-semibold text-gray-900">
          {copy.financial.annualReports}
        </h3>
        <div class="mt-3 space-y-2">
          {
            annualReportPdfs.map((report) => (
              <a
                href={report.path}
                target="_blank"
                rel="noopener"
                class="flex items-center gap-2 px-4 py-2 text-sm font-medium text-primary-700 bg-white border border-primary-200 rounded-lg hover:bg-primary-50 transition-colors"
              >
                <span aria-hidden="true">📊</span>
                {copy.financial.annualReportLink(report.year)}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </Section>

  <!-- Measurable Results -->
  <Section background="white" padding="lg">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-heading font-bold text-gray-900">
        {labels.transparency.measurableResults}
      </h2>
      <p class="mt-2 text-gray-600">{copy.measurable.intro}</p>

      <div class="mt-8 space-y-6">
        {
          measurableIndicators.map((r) => (
            <div class="p-5 bg-gray-50 rounded-2xl border border-gray-100">
              <div class="flex items-start justify-between gap-4">
                <div class="flex-1">
                  <p class="text-sm font-semibold text-gray-900">{r.indicator}</p>

                  <div class="mt-3 w-full bg-gray-200 rounded-full h-2">
                    <div
                      class="bg-primary-600 h-2 rounded-full transition-all duration-1000"
                      style={`width: ${indicatorProgress(r)}%`}
                    />
                  </div>

                  <div class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-2 text-[10px] uppercase tracking-wider text-gray-500 font-medium">
                    <span>
                      {labels.transparency.baseline}:{" "}
                      <span class="text-gray-900 font-bold">{r.baseline}</span>
                    </span>
                    <span>
                      {labels.transparency.target}:{" "}
                      <span class="text-gray-900 font-bold">{r.target}</span>
                    </span>
                    <span>
                      {labels.transparency.actual}:{" "}
                      <span class="text-primary-700 font-bold">{r.actual}</span>
                    </span>
                  </div>
                </div>
                <span
                  class:list={[
                    "px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider rounded-full whitespace-nowrap",
                    r.status === "on-track"
                      ? "bg-green-100 text-green-700"
                      : "bg-yellow-100 text-yellow-700",
                  ]}
                >
                  {r.status === "on-track"
                    ? labels.transparency.onTrack
                    : labels.transparency.inProgress}
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Impact Growth -->
  <Section background="white" padding="lg">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-heading font-bold text-gray-900">
        {labels.transparency.historicalTrends}
      </h2>
      <p class="mt-2 text-gray-600">{labels.transparency.livesImpactedGrowth}</p>

      <div
        class="mt-12 flex items-end justify-between gap-2 h-64 border-b border-gray-200 pb-2"
      >
        {
          impactGrowthByYear.map((item) => (
            <div class="flex-1 flex flex-col items-center gap-2 group">
              <div class="relative w-full flex flex-col items-center">
                <span class="text-[10px] font-bold text-primary-700 opacity-0 group-hover:opacity-100 transition-opacity mb-1">
                  {item.label}
                </span>
                <div
                  class="w-full max-w-[40px] bg-primary-100 border-x border-t border-primary-200 rounded-t-lg group-hover:bg-primary-600 transition-all duration-500"
                  style={`height: ${(item.value / impactChartMax) * 180}px`}
                />
              </div>
              <span class="text-xs font-semibold text-gray-500">{item.year}</span>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Theory of Change -->
  <Section background="gray" padding="lg">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-heading font-bold text-gray-900">
        {labels.transparency.theoryOfChange}
      </h2>
      <p class="mt-2 text-gray-600">{copy.theoryOfChange.intro}</p>

      <div class="mt-8 grid grid-cols-1 md:grid-cols-4 gap-4">
        {
          copy.theoryOfChange.steps.map((s) => (
            <div class="text-center">
              <div class="w-12 h-12 mx-auto rounded-full bg-primary-600 flex items-center justify-center text-white font-bold">
                {s.step}
              </div>
              <h3 class="mt-3 text-sm font-semibold text-gray-900">{s.title}</h3>
              <p class="mt-1 text-xs text-gray-600">{s.desc}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-8 p-4 bg-primary-50 rounded-xl border border-primary-100">
        <p class="text-sm text-primary-800">
          <strong>{copy.theoryOfChange.sustainabilityLabel}</strong>{" "}
          {copy.theoryOfChange.sustainability}
        </p>
      </div>
    </div>
  </Section>

  <!-- SDG Alignment -->
  <Section background="gray" padding="lg">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-heading font-bold text-gray-900 text-center">
        {labels.transparency.sdgAlignment}
      </h2>
      <p class="mt-4 text-gray-600 text-center max-w-2xl mx-auto">
        {copy.sdg.intro}
      </p>
      <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-4">
        {
          copy.sdg.goals.map((goal) => (
            <div class="p-4 bg-white rounded-xl border border-gray-200 text-center">
              <div
                class="w-12 h-12 mx-auto rounded-lg flex items-center justify-center"
                style={`background-color: ${goal.color}`}
              >
                <span class="text-white font-bold text-sm">{goal.number}</span>
              </div>
              <h3 class="mt-2 text-xs font-semibold text-gray-900">
                {goal.title}
              </h3>
              <p class="mt-1 text-[10px] text-gray-500">{goal.detail}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-6 p-4 bg-white rounded-xl border border-gray-200">
        <p class="text-sm text-gray-700 text-center">
          <strong>{copy.sdg.feministLabel}</strong> {copy.sdg.feminist}
        </p>
      </div>
    </div>
  </Section>

  <!-- Climate & Environmental Stewardship -->
  <Section background="white" padding="lg">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-heading font-bold text-gray-900 text-center">
        {labels.transparency.environmentalStewardship}
      </h2>
      <p class="mt-4 text-gray-600 text-center max-w-2xl mx-auto">
        {copy.environment.intro}
      </p>
      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
        {
          copy.environment.items.map((item) => (
            <div class="p-5 bg-gray-50 rounded-xl border border-gray-200 border-t-2 border-t-transparent hover:border-t-primary-500 hover:-translate-y-1 hover:shadow-lg transition-all duration-300">
              <span class="text-2xl" aria-hidden="true">
                {item.icon}
              </span>
              <h3 class="mt-2 text-sm font-semibold text-gray-900">
                {item.title}
              </h3>
              <p class="mt-1 text-xs text-gray-600">{item.desc}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-8 p-4 bg-accent-50 rounded-xl border border-accent-100">
        <p class="text-sm text-gray-700">
          <strong>{copy.environment.commitmentLabel}</strong>{" "}
          {copy.environment.commitment}
        </p>
      </div>
    </div>
  </Section>

  <!-- Accountability Practices -->
  <Section background="gray" padding="md">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-heading font-bold text-gray-900">
        {copy.accountability.title}
      </h2>
      <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-4">
        {
          copy.accountability.practices.map((p) => (
            <div class="p-4 bg-white rounded-lg">
              <p class="text-sm font-semibold text-gray-900">{p.title}</p>
              <p class="mt-1 text-xs text-gray-600">{p.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- CTA -->
  <Section background="dark" padding="md" class="!bg-gray-900 !bg-none">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-2xl font-heading font-bold">{copy.cta.title}</h2>
      <p class="mt-2 text-white/80 text-sm">{copy.cta.body}</p>
      <a
        href={localePath("/contact", locale)}
        class="mt-4 inline-flex items-center px-6 py-3 text-sm font-semibold text-primary-800 bg-white rounded-lg hover:bg-gray-100 transition-colors"
      >
        {copy.cta.button}
      </a>
    </div>
  </Section>
</PageLayout>
