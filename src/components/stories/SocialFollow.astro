---
import { additionalSocialProfiles } from "../../data/social-profiles";
import type { Locale } from "../../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const fr = locale === "fr";
const profiles = [
  { name: "Facebook", href: "https://www.facebook.com/ApotiDev" },
  { name: "Instagram", href: "https://www.instagram.com/apotidev/" },
  ...additionalSocialProfiles,
];
---

<section class="mt-10 border-t border-primary-200 pt-6" aria-labelledby="social-follow-heading">
  <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-4">
    <div>
      <h2 id="social-follow-heading" class="font-heading text-xl font-bold text-primary-900">
        {fr ? "Suivez-nous sur les réseaux sociaux" : "Follow ADA on social media"}
      </h2>
      <p class="mt-1 text-sm text-gray-700">
        {fr ? "Retrouvez nos nouvelles sur les comptes officiels de l’association." : "Find updates from ADA on our official profiles."}
      </p>
    </div>
    <ul class="flex flex-wrap gap-2">
      {profiles.map(({ name, href }) => (
        <li><a href={href} class="inline-flex min-h-11 items-center rounded-md border border-primary-200 px-3 py-2 text-sm font-semibold text-primary-800 hover:bg-primary-50 focus-visible:outline-2 focus-visible:outline-offset-2">
          {name} <span aria-hidden="true" class="ml-1">↗</span>
        </a></li>
      ))}
    </ul>
  </div>
</section>
