---
import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../layout/PageHero.astro";
import Section from "../layout/Section.astro";
import { getProjects, type SanityProject } from "../../lib/sanity";
import { resolveProjectCardImage } from "../../lib/project-images";
import {
  getProjectLifecycleState,
  isProjectFundable,
  projectStatusLabel,
  type ProjectStatus,
} from "../../lib/project-lifecycle";
import {
  mergeProjectLists,
  normalizeFallbackProjects,
} from "../../lib/project-fallbacks";
import type { Locale } from "../../i18n";
import { localePath } from "../../i18n";
import { resolveHeroImage } from "../../lib/hero-images";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const isFr = locale === "fr";
const heroImage = await resolveHeroImage([
  "widow-support",
  "education-orphans",
]);

let projectData;
try {
  const sanityProjects = await getProjects(locale);
  if (sanityProjects?.length) {
    projectData = mergeProjectLists(
      sanityProjects.map((p: SanityProject) => {
        const lifecycle = getProjectLifecycleState(p, { locale });
        const image = resolveProjectCardImage(p, 600);
        return {
          slug: p.slug.current,
          title: p.title,
          location: p.location,
          status: lifecycle.status as ProjectStatus,
          originalStatus: p.status,
          archiveHref: lifecycle.archiveHref,
          archiveReady: lifecycle.archiveReady,
          isAutoArchived: lifecycle.isAutoCompleted,
          hasEnded: lifecycle.hasEnded,
          isUpcoming: lifecycle.isUpcoming,
          startDate: p.startDate,
          endDate: p.endDate,
          description: p.description,
          beneficiaries: p.beneficiaries,
          goal: p.goalAmount,
          raised: p.raisedAmount,
          imageUrl: image.imageUrl,
          imageAlt: image.imageAlt,
        };
      }),
      normalizeFallbackProjects({ locale }),
    );
  } else {
    projectData = normalizeFallbackProjects({ locale });
  }
} catch {
  projectData = normalizeFallbackProjects({ locale });
}

const projects = projectData;
const upcomingProjects = projects.filter((p) => p.status === "upcoming");
const activeProjects = projects.filter(
  (p) => p.status === "active" || p.status === "paused",
);
const completedProjects = projects.filter((p) => p.status === "completed");

const activeCount = projects.filter((p) => p.status === "active").length;
const upcomingCount = upcomingProjects.length;
const totalBeneficiaries = projects.reduce(
  (sum, p) => sum + p.beneficiaries,
  0,
);
const totalRaised = projects.reduce((sum, p) => sum + p.raised, 0);
const uniqueLocations = new Set(projects.map((p) => p.location)).size;

const copy = isFr
  ? {
      metaTitle: "Nos Projets",
      metaDescription:
        "Découvrez les programmes d'ADA soutenant les veuves, orphelins et jeunes femmes au Cameroun, ainsi que les dossiers de projets disponibles.",
      heroTitle: "Nos Projets",
      heroSubtitle:
        "Découvrez les programmes actifs d’ADA au Cameroun et parcourez les dossiers de projets disponibles.",
      heroBadge: "Programmes & Campagnes",
      upcomingEyebrow: "Campagne à venir",
      upcomingTitle: "Campagne communautaire",
      upcomingBody:
        "Consultez les dates et les informations indiquées sur chaque dossier de projet.",
      upcomingDonate: "Soutenir",
      upcomingDetails: "Détails",
      scheduled: "Prévu",
      activeTitle: "Programmes en cours",
      activeSr: "Programmes actuels",
      raised: "collectés",
      of: "sur",
      details: "Détails",
      donate: "Donner",
      completedEyebrow: "Terminés ou archivés",
      completedTitle: "Dossiers de projets",
      completedBody:
        "Certains dossiers sont marqués comme terminés par ADA. D’autres sont archivés après leur date de fin prévue; la date seule ne confirme ni la réalisation ni l’existence d’un rapport final.",
      archiveReady: "Dossier d’archive disponible",
      autoArchived: "Archivé selon la date de fin",
      completed: "Marqué comme terminé",
      viewArchive: "Voir le dossier d’archive",
      viewDetails: "Voir les détails de clôture",
      archiveCta: "Voir toutes les archives de projets →",
      archiveHint:
        "Parcourez les dossiers de projets par démographie et consultez les documents disponibles.",
      statActive: "Programmes actifs",
      statUpcoming: "À venir",
      statCommunities: "Lieux indiqués",
      statBeneficiaries: "Bénéficiaires indiqués",
      statRaised: "Montants déclarés collectés",
      statsNote:
        "Ces chiffres résument les dossiers affichés ; une même personne peut être comptée dans plusieurs projets.",
    }
  : {
      metaTitle: "Our Projects",
      metaDescription:
        "Explore ADA's programs supporting widows, orphans, and young women across Cameroon, along with available project records.",
      heroTitle: "Our Projects",
      heroSubtitle:
        "Explore ADA's active programs in Cameroon and browse available project records.",
      heroBadge: "Programs & Campaigns",
      upcomingEyebrow: "Upcoming campaign",
      upcomingTitle: "Community campaign",
      upcomingBody:
        "Check each project record for its listed dates and available information.",
      upcomingDonate: "Support this campaign",
      upcomingDetails: "Details",
      scheduled: "Scheduled",
      activeTitle: "Current programs",
      activeSr: "Current Projects",
      raised: "raised",
      of: "of",
      details: "Details",
      donate: "Donate",
      completedEyebrow: "Completed or archived",
      completedTitle: "Project records",
      completedBody:
        "Some records are marked completed by ADA. Others move here after their planned end date; a date alone does not confirm delivery or a final report.",
      archiveReady: "Archive record available",
      autoArchived: "Archived by end date",
      completed: "Marked completed",
      viewArchive: "View archive record",
      viewDetails: "View completion details",
      archiveCta: "View full project archive →",
      archiveHint:
        "Browse project records by demographic and review available documents.",
      statActive: "Active Programs",
      statUpcoming: "Upcoming",
      statCommunities: "Listed locations",
      statBeneficiaries: "Beneficiaries listed",
      statRaised: "Reported funds raised",
      statsNote:
        "These figures summarize the listed records; the same person may be counted in more than one project.",
    };

function statusBadgeClass(status: ProjectStatus): string {
  if (status === "upcoming") return "bg-primary-100 text-primary-800";
  if (status === "active") return "bg-green-100 text-green-700";
  if (status === "completed") return "bg-gray-100 text-gray-600";
  return "bg-yellow-100 text-yellow-700";
}

function formatSchedule(start?: string, end?: string): string {
  if (!start) return "";
  const opts: Intl.DateTimeFormatOptions = {
    month: "short",
    day: "numeric",
    year: "numeric",
  };
  const loc = isFr ? "fr-FR" : "en-US";
  const startLabel = new Date(`${start}T12:00:00`).toLocaleDateString(
    loc,
    opts,
  );
  if (!end || end === start) return startLabel;
  const endLabel = new Date(`${end}T12:00:00`).toLocaleDateString(loc, opts);
  return `${startLabel} – ${endLabel}`;
}
---

<PageLayout title={copy.metaTitle} description={copy.metaDescription}>
  <PageHero
    title={copy.heroTitle}
    subtitle={copy.heroSubtitle}
    imageUrl={heroImage?.imageUrl}
    imageAlt={heroImage?.imageAlt}
  />

  {
    upcomingProjects.length > 0 && (
      <Section background="white" padding="lg">
        <div class="max-w-3xl mb-10">
          <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
            {copy.upcomingEyebrow}
          </p>
          <h2 class="mt-3 text-2xl md:text-3xl font-heading font-bold text-gray-900 tracking-tight">
            {copy.upcomingTitle}
          </h2>
          <p class="mt-3 text-sm text-gray-600 leading-relaxed">
            {copy.upcomingBody}
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {upcomingProjects.map((project) => (
            <article class="group relative overflow-hidden rounded-md border border-gray-200 bg-[#faf8f4]">
              <a
                href={localePath(`/projects/${project.slug}`, locale)}
                class="block"
              >
                <div class="aspect-[16/10] overflow-hidden bg-gray-100">
                  <img
                    src={project.imageUrl}
                    alt={project.imageAlt}
                    class="w-full h-full object-cover object-top"
                    loading="eager"
                  />
                </div>
                <div class="p-6 pb-20">
                  <div class="flex flex-wrap items-center gap-2 mb-3">
                    <span
                      class:list={[
                        "font-heading px-2 py-0.5 text-xs font-semibold rounded-md",
                        statusBadgeClass(project.status),
                      ]}
                    >
                      {projectStatusLabel(project.status, locale)}
                    </span>
                    <span class="text-xs text-gray-500">
                      {project.location}
                    </span>
                  </div>
                  <h3 class="text-xl font-heading font-bold text-gray-900">
                    {project.title}
                  </h3>
                  {(project.startDate || project.endDate) && (
                    <p class="mt-2 text-xs font-medium text-primary-800">
                      {copy.scheduled}:{" "}
                      {formatSchedule(project.startDate, project.endDate)}
                    </p>
                  )}
                  <p class="mt-3 text-sm text-gray-600 leading-relaxed line-clamp-3">
                    {project.description}
                  </p>
                  <div class="mt-5">
                    <div class="flex justify-between text-sm mb-1">
                      <span class="text-gray-600">
                        ${project.raised.toLocaleString()} {copy.raised}
                      </span>
                      <span class="text-gray-500">
                        {copy.of} ${project.goal.toLocaleString()}
                      </span>
                    </div>
                    <div class="w-full h-2 bg-primary-50 rounded-md overflow-hidden border border-primary-100">
                      <div
                        class="h-full bg-primary-500 rounded-md"
                        style={`width: ${Math.min(100, (project.raised / Math.max(project.goal, 1)) * 100)}%`}
                      />
                    </div>
                  </div>
                </div>
              </a>
              <div class="absolute bottom-0 left-0 right-0 p-6 pt-0 flex gap-2">
                <a
                  href={localePath(`/projects/${project.slug}`, locale)}
                  class="flex-1 text-center px-3 py-2.5 text-sm font-medium text-primary-800 border border-primary-200 rounded-lg bg-white/90 hover:bg-primary-50 transition-colors"
                  aria-label={`${copy.upcomingDetails}: ${project.title}`}
                >
                  {copy.upcomingDetails}
                </a>
                <a
                  href={localePath(`/donate?project=${project.slug}`, locale)}
                  class="flex-1 text-center px-3 py-2.5 text-sm font-semibold text-white bg-secondary-500 rounded-lg hover:bg-secondary-600 transition-colors"
                  aria-label={`${copy.upcomingDonate}: ${project.title}`}
                >
                  {copy.upcomingDonate}
                </a>
              </div>
            </article>
          ))}
        </div>
      </Section>
    )
  }

  <Section background={upcomingProjects.length ? "gray" : "white"} padding="lg">
    {
      upcomingProjects.length > 0 && (
        <h2 class="text-2xl font-heading font-bold text-gray-900 mb-8 max-w-5xl mx-auto">
          {copy.activeTitle}
        </h2>
      )
    }
    {upcomingProjects.length === 0 && <h2 class="sr-only">{copy.activeSr}</h2>}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        activeProjects.map((project) => (
          <article
            class="relative bg-[#faf8f4] rounded-md overflow-hidden border border-gray-200"
            data-status={project.status}
          >
            <a
              href={localePath(`/projects/${project.slug}`, locale)}
              class="block"
            >
              <div class="h-48 overflow-hidden bg-gray-100">
                <img
                  src={project.imageUrl}
                  alt={project.imageAlt}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="p-6 pb-20">
                <div class="flex items-center gap-2 mb-3">
                  <span
                    class:list={[
                      "font-heading px-2 py-0.5 text-xs font-medium rounded-md",
                      statusBadgeClass(project.status),
                    ]}
                  >
                    {projectStatusLabel(project.status, locale)}
                  </span>
                  <span class="text-xs text-gray-500">{project.location}</span>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">
                  {project.title}
                </h3>
                <p class="mt-2 text-sm text-gray-600 line-clamp-2">
                  {project.description}
                </p>
                <div class="mt-4">
                  <div class="flex justify-between text-sm mb-1">
                    <span class="text-gray-600">
                      ${project.raised.toLocaleString()} {copy.raised}
                    </span>
                    <span class="text-gray-500">
                      {copy.of} ${project.goal.toLocaleString()}
                    </span>
                  </div>
                  <div
                    class="w-full h-2 bg-gray-200 rounded-md overflow-hidden"
                    role="progressbar"
                    aria-valuenow={Math.round(
                      (project.raised / Math.max(project.goal, 1)) * 100,
                    )}
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-label={`${project.title} fundraising progress`}
                  >
                    <div
                      class="h-full bg-primary-500 rounded-md"
                      style={`width: ${Math.min(100, (project.raised / Math.max(project.goal, 1)) * 100)}%`}
                    />
                  </div>
                </div>
              </div>
            </a>
            <div class="absolute bottom-0 left-0 right-0 p-6 pt-0 flex gap-2">
              <a
                href={localePath(`/projects/${project.slug}`, locale)}
                class="flex-1 text-center px-3 py-2 text-sm font-medium text-primary-700 border border-primary-200 rounded-lg hover:bg-primary-50 transition-colors"
                aria-label={`${copy.details}: ${project.title}`}
              >
                {copy.details}
              </a>
              {isProjectFundable(project.status) ? (
                <a
                  href={localePath(`/donate?project=${project.slug}`, locale)}
                  class="flex-1 text-center px-3 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors"
                  aria-label={`${copy.donate}: ${project.title}`}
                >
                  {copy.donate}
                </a>
              ) : (
                <span class="flex-1 text-center px-3 py-2 text-sm font-medium text-gray-400 border border-gray-100 rounded-lg">
                  {projectStatusLabel(project.status, locale)}
                </span>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  {
    completedProjects.length > 0 && (
      <Section background="gray" padding="lg">
        <div class="max-w-3xl mb-8">
          <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
            {copy.completedEyebrow}
          </p>
          <h2 class="mt-3 text-2xl md:text-3xl font-heading font-bold text-gray-900 tracking-tight">
            {copy.completedTitle}
          </h2>
          <p class="mt-3 text-sm text-gray-600">{copy.completedBody}</p>
        </div>
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
          {completedProjects.map((project) => (
            <article class="bg-[#faf8f4] rounded-md overflow-hidden border border-gray-200">
              <a
                href={
                  project.archiveHref ||
                  localePath(`/projects/${project.slug}`, locale)
                }
                class="block"
              >
                <div class="h-40 overflow-hidden bg-gray-100">
                  <img
                    src={project.imageUrl}
                    alt={project.imageAlt}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
                <div class="p-5">
                  <span class="font-heading inline-flex px-2 py-0.5 text-xs font-medium rounded-md bg-gray-100 text-gray-600">
                    {project.isAutoArchived
                      ? copy.autoArchived
                      : project.archiveReady
                        ? copy.archiveReady
                        : copy.completed}
                  </span>
                  <h3 class="mt-3 text-lg font-semibold text-gray-900">
                    {project.title}
                  </h3>
                  <p class="mt-2 text-sm text-gray-600 line-clamp-2">
                    {project.description}
                  </p>
                  <span class="mt-4 inline-flex text-sm font-semibold text-primary-700">
                    {project.archiveReady ? copy.viewArchive : copy.viewDetails}{" "}
                    →
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </Section>
    )
  }

  <Section background="gray" padding="sm">
    <div class="max-w-3xl">
      <a
        href={localePath("/projects/archive", locale)}
        class="font-heading inline-flex items-center gap-2 text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
      >
        {copy.archiveCta}
      </a>
      <p class="mt-2 text-xs text-gray-500">{copy.archiveHint}</p>
    </div>
  </Section>

  <Section background="dark" padding="md" class="!bg-[#121a14] !bg-none">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8">
      <div>
        <p class="font-heading text-3xl font-bold">{upcomingCount}</p>
        <p class="mt-1 text-sm text-white/70">{copy.statUpcoming}</p>
      </div>
      <div>
        <p class="font-heading text-3xl font-bold">{activeCount}</p>
        <p class="mt-1 text-sm text-white/70">{copy.statActive}</p>
      </div>
      <div>
        <p class="font-heading text-3xl font-bold">{uniqueLocations}</p>
        <p class="mt-1 text-sm text-white/70">{copy.statCommunities}</p>
      </div>
      <div>
        <p class="text-3xl font-bold">{totalBeneficiaries}+</p>
        <p class="mt-1 text-sm text-white/70">{copy.statBeneficiaries}</p>
      </div>
      <div>
        <p class="text-3xl font-bold">${Math.round(totalRaised / 1000)}K+</p>
        <p class="mt-1 text-sm text-white/70">{copy.statRaised}</p>
      </div>
    </div>
    <p class="mt-6 max-w-3xl text-xs leading-relaxed text-white/60">
      {copy.statsNote}
    </p>
  </Section>
</PageLayout>
