---
import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../layout/PageHero.astro";
import Section from "../layout/Section.astro";
import { getProjects, type SanityProject } from "../../lib/sanity";
import { resolveProjectCardImage } from "../../lib/project-images";
import {
  getProjectLifecycleState,
  isProjectFundable,
  projectStatusLabel,
  type ProjectStatus,
} from "../../lib/project-lifecycle";
import {
  mergeProjectLists,
  normalizeFallbackProjects,
} from "../../lib/project-fallbacks";
import type { Locale } from "../../i18n";
import { localePath } from "../../i18n";

interface Props {
  locale?: Locale;
}

const { locale = "en" } = Astro.props;
const isFr = locale === "fr";

let projectData;
try {
  const sanityProjects = await getProjects();
  if (sanityProjects?.length) {
    projectData = mergeProjectLists(
      sanityProjects.map((p: SanityProject) => {
        const lifecycle = getProjectLifecycleState(p, { locale });
        const image = resolveProjectCardImage(p, 600);
        return {
          slug: p.slug.current,
          title: p.title,
          location: p.location,
          status: lifecycle.status as ProjectStatus,
          originalStatus: p.status,
          archiveHref: lifecycle.archiveHref,
          archiveReady: lifecycle.archiveReady,
          hasEnded: lifecycle.hasEnded,
          isUpcoming: lifecycle.isUpcoming,
          startDate: p.startDate,
          endDate: p.endDate,
          description: p.description,
          beneficiaries: p.beneficiaries,
          goal: p.goalAmount,
          raised: p.raisedAmount,
          imageUrl: image.imageUrl,
          imageAlt: image.imageAlt,
        };
      }),
      normalizeFallbackProjects({ locale }),
    );
  } else {
    projectData = normalizeFallbackProjects({ locale });
  }
} catch {
  projectData = normalizeFallbackProjects({ locale });
}

const projects = projectData;
const upcomingProjects = projects.filter((p) => p.status === "upcoming");
const activeProjects = projects.filter(
  (p) => p.status === "active" || p.status === "paused",
);
const completedProjects = projects.filter((p) => p.status === "completed");

const activeCount = projects.filter((p) => p.status === "active").length;
const upcomingCount = upcomingProjects.length;
const totalBeneficiaries = projects.reduce(
  (sum, p) => sum + p.beneficiaries,
  0,
);
const totalRaised = projects.reduce((sum, p) => sum + p.raised, 0);
const uniqueLocations = new Set(projects.map((p) => p.location)).size;

const copy = isFr
  ? {
      metaTitle: "Nos Projets",
      metaDescription:
        "Découvrez les programmes d'ADA soutenant les veuves, orphelins et jeunes femmes au Cameroun — y compris les campagnes Back to School à venir.",
      heroTitle: "Nos Projets",
      heroSubtitle:
        "Programmes actifs et campagnes à venir au Cameroun. Quand la date de fin passe, le projet quitte la liste active et peut rejoindre les archives.",
      heroBadge: "Programmes & Campagnes",
      upcomingEyebrow: "À venir — août 2026",
      upcomingTitle: "Campagnes Back to School",
      upcomingBody:
        "Deux campagnes communautaires de rentrée scolaire — Buea (Sud-Ouest) et Bamenda (Nord-Ouest). Les dons sont ouverts dès maintenant ; l'action sur le terrain suit le calendrier des flyers.",
      upcomingDonate: "Soutenir",
      upcomingDetails: "Détails",
      scheduled: "Prévu",
      activeTitle: "Programmes en cours",
      activeSr: "Programmes actuels",
      raised: "collectés",
      of: "sur",
      details: "Détails",
      donate: "Donner",
      completedEyebrow: "Récemment terminés",
      completedTitle: "Projets passés au bilan",
      completedBody:
        "Lorsqu'une date de fin est dépassée, le projet n'est plus une priorité de collecte. S'il dispose d'un dossier d'archive, les visiteurs voient le rapport final.",
      archiveReady: "Archive prête",
      completed: "Terminé",
      viewArchive: "Voir le rapport d'archive",
      viewDetails: "Voir les détails de clôture",
      archiveCta: "📁 Voir toutes les archives de projets (2022–2026) →",
      archiveHint:
        "Parcourez les projets terminés par démographie, avec rapports téléchargeables.",
      statActive: "Programmes actifs",
      statUpcoming: "À venir",
      statCommunities: "Communautés",
      statBeneficiaries: "Bénéficiaires",
      statRaised: "Fonds collectés",
    }
  : {
      metaTitle: "Our Projects",
      metaDescription:
        "Explore ADA's programs supporting widows, orphans, and young women across Cameroon — including upcoming Back to School outreaches.",
      heroTitle: "Our Projects",
      heroSubtitle:
        "Active programs and upcoming campaigns across Cameroon. When a project end date passes, it leaves the active list and can move into the archive.",
      heroBadge: "Programs & Campaigns",
      upcomingEyebrow: "Coming up — August 2026",
      upcomingTitle: "Back to School outreaches",
      upcomingBody:
        "Two community Back to School campaigns — Buea (South West) and Bamenda (North West). Donations are open now; field delivery follows the flyer schedule.",
      upcomingDonate: "Support this campaign",
      upcomingDetails: "Details",
      scheduled: "Scheduled",
      activeTitle: "Current programs",
      activeSr: "Current Projects",
      raised: "raised",
      of: "of",
      details: "Details",
      donate: "Donate",
      completedEyebrow: "Recently completed",
      completedTitle: "Projects that have moved into the track record",
      completedBody:
        "When a project end date passes, it stops appearing as an active fundraising priority. If its archive record is ready, visitors go straight to the final report page.",
      archiveReady: "Archive ready",
      completed: "Completed",
      viewArchive: "View archive report",
      viewDetails: "View completion details",
      archiveCta: "📁 View Full Project Archive (2022–2026) →",
      archiveHint:
        "Browse all completed and ongoing projects by demographic, with downloadable reports.",
      statActive: "Active Programs",
      statUpcoming: "Upcoming",
      statCommunities: "Communities",
      statBeneficiaries: "Beneficiaries",
      statRaised: "Funds Raised",
    };

function statusBadgeClass(status: ProjectStatus): string {
  if (status === "upcoming") return "bg-sky-100 text-sky-800";
  if (status === "active") return "bg-green-100 text-green-700";
  if (status === "completed") return "bg-gray-100 text-gray-600";
  return "bg-yellow-100 text-yellow-700";
}

function formatSchedule(start?: string, end?: string): string {
  if (!start) return "";
  const opts: Intl.DateTimeFormatOptions = {
    month: "short",
    day: "numeric",
    year: "numeric",
  };
  const loc = isFr ? "fr-FR" : "en-US";
  const startLabel = new Date(`${start}T12:00:00`).toLocaleDateString(loc, opts);
  if (!end || end === start) return startLabel;
  const endLabel = new Date(`${end}T12:00:00`).toLocaleDateString(loc, opts);
  return `${startLabel} – ${endLabel}`;
}
---

<PageLayout title={copy.metaTitle} description={copy.metaDescription}>
  <PageHero
    title={copy.heroTitle}
    subtitle={copy.heroSubtitle}
    badge={copy.heroBadge}
  />

  {
    upcomingProjects.length > 0 && (
      <Section background="white" padding="lg">
        <div class="max-w-3xl mx-auto text-center mb-10">
          <p class="text-xs font-semibold uppercase tracking-wider text-sky-700">
            {copy.upcomingEyebrow}
          </p>
          <h2 class="mt-3 text-2xl md:text-3xl font-heading font-bold text-gray-900">
            {copy.upcomingTitle}
          </h2>
          <p class="mt-3 text-sm text-gray-600 leading-relaxed">
            {copy.upcomingBody}
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {upcomingProjects.map((project) => (
            <article class="group relative overflow-hidden rounded-2xl border border-sky-100 bg-gradient-to-br from-sky-50/80 via-white to-primary-50/40 shadow-card hover:shadow-lg hover:-translate-y-1 transition-all duration-300">
              <a
                href={localePath(`/projects/${project.slug}`, locale)}
                class="block"
              >
                <div class="aspect-[16/10] overflow-hidden bg-gray-100">
                  <img
                    src={project.imageUrl}
                    alt={project.imageAlt}
                    class="w-full h-full object-cover object-top group-hover:scale-[1.02] transition-transform duration-500"
                    loading="eager"
                  />
                </div>
                <div class="p-6 pb-20">
                  <div class="flex flex-wrap items-center gap-2 mb-3">
                    <span
                      class:list={[
                        "px-2 py-0.5 text-xs font-semibold rounded-full",
                        statusBadgeClass(project.status),
                      ]}
                    >
                      {projectStatusLabel(project.status, locale)}
                    </span>
                    <span class="text-xs text-gray-500">
                      📍 {project.location}
                    </span>
                  </div>
                  <h3 class="text-xl font-heading font-bold text-gray-900">
                    {project.title}
                  </h3>
                  {(project.startDate || project.endDate) && (
                    <p class="mt-2 text-xs font-medium text-sky-800">
                      {copy.scheduled}:{" "}
                      {formatSchedule(project.startDate, project.endDate)}
                    </p>
                  )}
                  <p class="mt-3 text-sm text-gray-600 leading-relaxed line-clamp-3">
                    {project.description}
                  </p>
                  <div class="mt-5">
                    <div class="flex justify-between text-sm mb-1">
                      <span class="text-gray-600">
                        ${project.raised.toLocaleString()} {copy.raised}
                      </span>
                      <span class="text-gray-500">
                        {copy.of} ${project.goal.toLocaleString()}
                      </span>
                    </div>
                    <div class="w-full h-2 bg-white/80 rounded-full overflow-hidden border border-sky-100">
                      <div
                        class="h-full bg-sky-500 rounded-full"
                        style={`width: ${Math.min(100, (project.raised / Math.max(project.goal, 1)) * 100)}%`}
                      />
                    </div>
                  </div>
                </div>
              </a>
              <div class="absolute bottom-0 left-0 right-0 p-6 pt-0 flex gap-2">
                <a
                  href={localePath(`/projects/${project.slug}`, locale)}
                  class="flex-1 text-center px-3 py-2.5 text-sm font-medium text-sky-800 border border-sky-200 rounded-lg bg-white/90 hover:bg-sky-50 transition-colors"
                >
                  {copy.upcomingDetails}
                </a>
                <a
                  href={localePath(
                    `/donate?project=${project.slug}`,
                    locale,
                  )}
                  class="flex-1 text-center px-3 py-2.5 text-sm font-semibold text-white bg-sky-600 rounded-lg hover:bg-sky-700 transition-colors"
                >
                  {copy.upcomingDonate}
                </a>
              </div>
            </article>
          ))}
        </div>
      </Section>
    )
  }

  <Section background={upcomingProjects.length ? "gray" : "white"} padding="lg">
    {
      upcomingProjects.length > 0 && (
        <h2 class="text-2xl font-heading font-bold text-gray-900 mb-8 max-w-5xl mx-auto">
          {copy.activeTitle}
        </h2>
      )
    }
    {
      upcomingProjects.length === 0 && (
        <h2 class="sr-only">{copy.activeSr}</h2>
      )
    }
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        activeProjects.map((project) => (
          <article
            class="relative bg-white rounded-card shadow-card overflow-hidden border border-gray-100 border-t-2 border-t-transparent hover:border-t-primary-500 hover:shadow-lg hover:-translate-y-1 transition-all duration-300"
            data-status={project.status}
          >
            <a
              href={localePath(`/projects/${project.slug}`, locale)}
              class="block"
            >
              <div class="h-48 overflow-hidden bg-gray-100">
                <img
                  src={project.imageUrl}
                  alt={project.imageAlt}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
              <div class="p-6 pb-20">
                <div class="flex items-center gap-2 mb-3">
                  <span
                    class:list={[
                      "px-2 py-0.5 text-xs font-medium rounded-full",
                      statusBadgeClass(project.status),
                    ]}
                  >
                    {projectStatusLabel(project.status, locale)}
                  </span>
                  <span class="text-xs text-gray-500">
                    📍 {project.location}
                  </span>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">
                  {project.title}
                </h3>
                <p class="mt-2 text-sm text-gray-600 line-clamp-2">
                  {project.description}
                </p>
                <div class="mt-4">
                  <div class="flex justify-between text-sm mb-1">
                    <span class="text-gray-600">
                      ${project.raised.toLocaleString()} {copy.raised}
                    </span>
                    <span class="text-gray-500">
                      {copy.of} ${project.goal.toLocaleString()}
                    </span>
                  </div>
                  <div
                    class="w-full h-2 bg-gray-200 rounded-full overflow-hidden"
                    role="progressbar"
                    aria-valuenow={Math.round(
                      (project.raised / Math.max(project.goal, 1)) * 100,
                    )}
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-label={`${project.title} fundraising progress`}
                  >
                    <div
                      class="h-full bg-primary-500 rounded-full"
                      style={`width: ${Math.min(100, (project.raised / Math.max(project.goal, 1)) * 100)}%`}
                    />
                  </div>
                </div>
              </div>
            </a>
            <div class="absolute bottom-0 left-0 right-0 p-6 pt-0 flex gap-2">
              <a
                href={localePath(`/projects/${project.slug}`, locale)}
                class="flex-1 text-center px-3 py-2 text-sm font-medium text-primary-700 border border-primary-200 rounded-lg hover:bg-primary-50 transition-colors"
              >
                {copy.details}
              </a>
              {isProjectFundable(project.status) ? (
                <a
                  href={localePath(
                    `/donate?project=${project.slug}`,
                    locale,
                  )}
                  class="flex-1 text-center px-3 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors"
                >
                  {copy.donate}
                </a>
              ) : (
                <span class="flex-1 text-center px-3 py-2 text-sm font-medium text-gray-400 border border-gray-100 rounded-lg">
                  {projectStatusLabel(project.status, locale)}
                </span>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  {
    completedProjects.length > 0 && (
      <Section background="gray" padding="lg">
        <div class="max-w-3xl mx-auto text-center">
          <p class="text-xs font-semibold uppercase tracking-wider text-primary-700">
            {copy.completedEyebrow}
          </p>
          <h2 class="mt-3 text-2xl md:text-3xl font-heading font-bold text-gray-900">
            {copy.completedTitle}
          </h2>
          <p class="mt-3 text-sm text-gray-600">{copy.completedBody}</p>
        </div>
        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {completedProjects.map((project) => (
            <article class="bg-white rounded-card shadow-card overflow-hidden border border-gray-100">
              <a
                href={
                  project.archiveHref ||
                  localePath(`/projects/${project.slug}`, locale)
                }
                class="block"
              >
                <div class="h-40 overflow-hidden bg-gray-100">
                  <img
                    src={project.imageUrl}
                    alt={project.imageAlt}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
                <div class="p-5">
                  <span class="inline-flex px-2 py-0.5 text-xs font-medium rounded-full bg-gray-100 text-gray-600">
                    {project.archiveReady ? copy.archiveReady : copy.completed}
                  </span>
                  <h3 class="mt-3 text-lg font-semibold text-gray-900">
                    {project.title}
                  </h3>
                  <p class="mt-2 text-sm text-gray-600 line-clamp-2">
                    {project.description}
                  </p>
                  <span class="mt-4 inline-flex text-sm font-semibold text-primary-700">
                    {project.archiveReady ? copy.viewArchive : copy.viewDetails}{" "}
                    →
                  </span>
                </div>
              </a>
            </article>
          ))}
        </div>
      </Section>
    )
  }

  <Section background="gray" padding="sm">
    <div class="text-center">
      <a
        href={localePath("/projects/archive", locale)}
        class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-primary-700 border border-primary-200 rounded-lg hover:bg-primary-50 transition-colors"
      >
        {copy.archiveCta}
      </a>
      <p class="mt-2 text-xs text-gray-500">{copy.archiveHint}</p>
    </div>
  </Section>

  <Section background="dark" padding="md">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-8 text-center">
      <div>
        <p class="text-3xl font-bold">{upcomingCount}</p>
        <p class="mt-1 text-sm text-white/70">{copy.statUpcoming}</p>
      </div>
      <div>
        <p class="text-3xl font-bold">{activeCount}</p>
        <p class="mt-1 text-sm text-white/70">{copy.statActive}</p>
      </div>
      <div>
        <p class="text-3xl font-bold">{uniqueLocations}</p>
        <p class="mt-1 text-sm text-white/70">{copy.statCommunities}</p>
      </div>
      <div>
        <p class="text-3xl font-bold">{totalBeneficiaries}+</p>
        <p class="mt-1 text-sm text-white/70">{copy.statBeneficiaries}</p>
      </div>
      <div>
        <p class="text-3xl font-bold">${Math.round(totalRaised / 1000)}K+</p>
        <p class="mt-1 text-sm text-white/70">{copy.statRaised}</p>
      </div>
    </div>
  </Section>
</PageLayout>
