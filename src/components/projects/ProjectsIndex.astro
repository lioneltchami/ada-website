---
import { outreachDisplayTitle, outreachTitleLocation } from "../../lib/outreach-display-title";
import { getEditorialHeroPhoto } from "../../data/editorial-hero-photos";
import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../layout/PageHero.astro";
import Section from "../layout/Section.astro";
import { getProjects, type SanityProject } from "../../lib/sanity";
import { resolveProjectCardImage } from "../../lib/project-images";
import {
  getProjectLifecycleState,
  projectStatusLabel,
  type ProjectStatus,
} from "../../lib/project-lifecycle";
import { mergeProjectLists, normalizeFallbackProjects } from "../../lib/project-fallbacks";
import { localizeProjectsIndexFallback, selectProjectsIndexImage } from "../../lib/projects-index-presentation";
import type { Locale } from "../../i18n";
import { localePath } from "../../i18n";

interface Props {
  locale?: Locale;
}

type ProjectCard = {
  slug: string;
  title: string;
  location: string;
  status: ProjectStatus;
  archiveHref: string;
  archiveReady: boolean;
  isAutoArchived: boolean;
  hasEnded: boolean;
  isFundable: boolean;
  startDate?: string | null;
  endDate?: string | null;
  description: string;
  imageUrl: string;
  imageAlt: string;
};

const { locale = "en" } = Astro.props;
const isFr = locale === "fr";
const link = (path: string) => localePath(path, locale);
const archiveHref = link("/projects/archive");

function fromSanity(p: SanityProject): ProjectCard {
  const lifecycle = getProjectLifecycleState(p, { locale });
  const image = resolveProjectCardImage(p, 600);
  return {
    ...p,
    ...image,
    slug: p.slug.current,
    status: lifecycle.status,
    archiveHref: lifecycle.archiveHref,
    archiveReady: lifecycle.archiveReady,
    isAutoArchived: lifecycle.isAutoCompleted,
    hasEnded: lifecycle.hasEnded,
    isFundable: lifecycle.isFundable,
  };
}

const fallback: ProjectCard[] = normalizeFallbackProjects({ locale }).map((p) => localizeProjectsIndexFallback(p, locale));
// Campaign amounts in Sanity and the fallback seeds are manually entered,
// not confirmed Stripe receipts. Do not render totals or progress from either.
let projects: ProjectCard[] = fallback;
try {
  const rows = await getProjects(locale);
  if (rows?.length) projects = mergeProjectLists(rows.map(fromSanity), fallback);
} catch {
  // Keep the approved listing and archive routes available without claiming funds.
}

const upcoming = projects.filter((p) => p.status === "upcoming");
const current = projects.filter((p) => p.status === "active");
const paused = projects.filter((p) => p.status === "paused");
const records = projects.filter((p) => p.status === "completed");
const activeCount = current.filter((p) => !p.hasEnded).length;

const copy = isFr
  ? {
      title: "Nos projets",
      intro: "Découvrez les actions à venir, les programmes en cours et les dossiers de projets d’ADA au Cameroun.",
      archive: "Voir les archives de projets",
      archiveHint: "Parcourez les dossiers par catégorie d’action et consultez les documents disponibles.",
      upcoming: "Actions à venir",
      current: "Programmes en cours",
      paused: "Programmes en pause",
      records: "Dossiers de projets",
      recordsNote: "Un dossier peut être archivé après la date prévue. Une date passée ne confirme ni la réalisation du projet ni la publication d’un rapport.",
      closed: "Date prévue passée",
      archivedByDate: "Archivé selon la date de fin",
      archiveReady: "Dossier d’archive disponible",
      details: "Voir le projet",
      viewRecord: "Voir le dossier",
      donate: "Donner",
      stats: "Aperçu des projets",
      statUpcoming: "Actions à venir",
      statActive: "Programmes en cours",
    }
  : {
      title: "Our Projects",
      intro: "See ADA’s upcoming outreaches, current programs, and project records in Cameroon.",
      archive: "View the project archive",
      archiveHint: "Browse records by outreach category and see the available documents.",
      upcoming: "Upcoming outreaches",
      current: "Current programs",
      paused: "Paused programs",
      records: "Project records",
      recordsNote: "Records may be archived after their scheduled date. A past date does not confirm that the project took place or that a report is available.",
      closed: "Scheduled date passed",
      archivedByDate: "Archived by end date",
      archiveReady: "Archive record available",
      details: "View project",
      viewRecord: "View record",
      donate: "Donate",
      stats: "Projects at a glance",
      statUpcoming: "Upcoming outreaches",
      statActive: "Current programs",
    };

const timeFormatter = new Intl.DateTimeFormat(isFr ? "fr-FR" : "en-US", {
  dateStyle: "full",
  timeZone: "UTC",
});
function projectDate(value?: string | null) {
  if (!value || !/^\d{4}-\d{2}-\d{2}$/.test(value)) return undefined;
  const date = new Date(`${value}T00:00:00Z`);
  if (!Number.isFinite(date.getTime()) || date.toISOString().slice(0, 10) !== value) return undefined;
  return { value, label: timeFormatter.format(date) };
}
const focus = "focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-700";
const secondaryLink = `inline-flex min-h-11 items-center rounded-md border border-primary-300 px-4 py-2 text-sm font-semibold text-primary-800 hover:bg-primary-50 ${focus}`;
const primaryLink = `inline-flex min-h-11 items-center rounded-md bg-primary-700 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-900 ${focus}`;

const groups = [
  { id: "upcoming-outreaches", title: copy.upcoming, items: upcoming, background: "white" as const },
  { id: "current-programs", title: copy.current, items: current, background: "gray" as const },
  { id: "project-records", title: copy.records, items: records, background: "white" as const },
  { id: "paused-programs", title: copy.paused, items: paused, background: "gray" as const },
];
---

<PageLayout title={copy.title} description={copy.intro}>
  <PageHero
    title={copy.title}
    subtitle={copy.intro}
    photo={getEditorialHeroPhoto("projects", locale)}
    compact
  >
    <a
      href={archiveHref}
      class="mt-6 inline-flex min-h-11 items-center gap-2 rounded-md bg-[#faf8f4] px-4 py-2 text-sm font-semibold text-primary-900 hover:bg-primary-50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
    >
      {copy.archive} <span aria-hidden="true">→</span>
    </a>
  </PageHero>

  <div class="border-b border-primary-100 bg-[#faf8f4]">
    <dl aria-label={copy.stats} class="mx-auto grid max-w-7xl grid-cols-2 gap-3 px-4 py-5 sm:px-6 md:flex md:gap-10 lg:px-8">
      <div class="flex items-baseline gap-2.5">
        <dt class="order-2 text-sm font-medium text-gray-700">{copy.statUpcoming}</dt>
        <dd class="order-1 font-heading text-2xl font-semibold tabular-nums text-primary-800">{upcoming.length}</dd>
      </div>
      <div class="flex items-baseline gap-2.5">
        <dt class="order-2 text-sm font-medium text-gray-700">{copy.statActive}</dt>
        <dd class="order-1 font-heading text-2xl font-semibold tabular-nums text-primary-800">{activeCount}</dd>
      </div>
    </dl>
  </div>

  {
    groups.map(({ id, title, items, background }) => items.length ? (
      <Section id={id} background={background} padding="md">
        <h2 class="font-heading text-2xl font-bold tracking-tight text-gray-900 md:text-3xl">{title}</h2>
        {id === "project-records" && (
          <p class="mt-3 max-w-prose text-sm leading-relaxed text-gray-700">{copy.recordsNote}</p>
        )}
        <div class="mt-6 grid gap-5 md:grid-cols-2">
          {items.map((project) => {
            const displayTitle = outreachDisplayTitle(project, locale);
            const archived = project.status === "completed";
            const href = archived && project.archiveHref ? project.archiveHref : link(`/projects/${project.slug}`);
            const badge = project.isAutoArchived ? copy.archivedByDate
              : archived && project.archiveReady ? copy.archiveReady
              : project.hasEnded && project.status === "active" ? copy.closed
              : projectStatusLabel(project.status, locale);
            const image = selectProjectsIndexImage(project, locale);
            const start = projectDate(project.startDate) ?? projectDate(project.endDate);
            const end = projectDate(project.endDate);
            return (
              <article class="flex flex-col overflow-hidden rounded-lg border border-gray-200 bg-[#faf8f4]">
                {image && (
                  <div class="h-44 overflow-hidden bg-[#efece4] md:h-48">
                    <img src={image.src} alt={image.alt} class="h-full w-full object-cover object-center" loading="lazy" />
                  </div>
                )}
                <div class="flex flex-1 flex-col p-5 sm:p-6">
                  <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-gray-700">
                    <span class:list={[
                      "inline-flex rounded-md px-2 py-1 text-xs font-semibold",
                      project.status === "paused" ? "bg-amber-100 text-amber-900" :
                        archived ? "bg-gray-100 text-gray-700" : "bg-primary-100 text-primary-900",
                    ]}>{badge}</span>
                    {project.location && project.location !== outreachTitleLocation(project.slug) && <span>{project.location}</span>}
                  </p>
                  <h3 data-outreach-title={project.slug} class="mt-3 font-heading text-xl font-bold text-gray-900">{displayTitle}</h3>
                  {start && (
                    <p class="mt-2 text-sm font-medium text-primary-800">
                      <time datetime={start.value}>{start.label}</time>
                      {end && end.value !== start.value && <><span aria-hidden="true"> – </span><span class="sr-only">{isFr ? " au " : " to "}</span><time datetime={end.value}>{end.label}</time></>}
                    </p>
                  )}
                  <p class="mt-3 max-w-prose text-sm leading-relaxed text-gray-700">{project.description}</p>
                  <div class="mt-auto flex flex-wrap gap-2 pt-5">
                    <a href={href} class={secondaryLink} aria-label={`${archived ? copy.viewRecord : copy.details}: ${displayTitle}`}>
                      {archived ? copy.viewRecord : copy.details}
                    </a>
                    {project.isFundable && (
                      <a href={link(`/donate?project=${encodeURIComponent(project.slug)}`)} class={primaryLink} aria-label={`${copy.donate}: ${displayTitle}`}>
                        {copy.donate}
                      </a>
                    )}
                  </div>
                </div>
              </article>
            );
          })}
        </div>
        {id === "project-records" && (
          <div class="mt-6">
            <a href={archiveHref} class={secondaryLink}>{copy.archive} <span class="ml-2" aria-hidden="true">→</span></a>
            <p class="mt-2 text-sm text-gray-700">{copy.archiveHint}</p>
          </div>
        )}
      </Section>
    ) : null)
  }
</PageLayout>
