---
import { outreachDisplayTitle, outreachTitleLocation } from "../../lib/outreach-display-title";
import { christmasPlanTor } from "../../lib/christmas-announcements";
import PageLayout from "../../layouts/PageLayout.astro";
import { projectStatusLabel, type ProjectStatus } from "../../lib/project-lifecycle";
import { localePath } from "../../i18n";

interface Props {
  locale: "en" | "fr";
  project: {
    slug?: string;
    title: string;
    location: string;
    description: string;
    startDate?: string;
    status: ProjectStatus;
    autoArchived?: boolean;
    hasEnded?: boolean;
    hasAnnouncementImage?: boolean;
    imageUrl?: string;
    imageAlt?: string;
    archiveHref?: string;
  };
}

const { locale, project } = Astro.props;
const fr = locale === "fr";
const title = outreachDisplayTitle(project, locale);
const detailLocation = project.location !== outreachTitleLocation(project.slug) ? project.location : "";
const tor = christmasPlanTor(project.slug, project.startDate);
const date = project.startDate && /^\d{4}-\d{2}-\d{2}$/.test(project.startDate) && new Intl.DateTimeFormat(fr ? "fr-CM" : "en-CM", {
  dateStyle: "full",
  timeZone: "UTC",
}).format(new Date(`${project.startDate}T00:00:00Z`));
---
<PageLayout title={title} description={project.description.slice(0, 160)} hideFloatingDonate>
  <section class="bg-primary-900 text-white py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <a class="text-white/90 hover:underline" href={localePath("/projects", locale)}>
        ← {fr ? "Tous les projets" : "All projects"}
      </a>
      <p class="mt-8 text-sm font-semibold text-white/90">
        {project.autoArchived ? (fr ? "Archivé" : "Archived") :
          project.hasEnded ? (fr ? "Date prévue passée" : "Scheduled date passed") :
          projectStatusLabel(project.status, locale)}
      </p>
      <h1 data-outreach-title={project.slug} class="mt-2 text-4xl md:text-5xl font-heading font-bold">{title}</h1>
      <p class="mt-3 text-white/90">
        {detailLocation}{date && <>{detailLocation && " · "}<time datetime={project.startDate}>{date}</time></>}
      </p>
    </div>
  </section>
  <section class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    {project.hasAnnouncementImage && project.imageUrl && (
      <img class="mb-8 max-h-[28rem] w-full rounded-md object-cover" src={project.imageUrl} alt={project.imageAlt || ""} />
    )}
    <h2 class="text-2xl font-heading font-bold text-gray-900">
      {fr ? "À propos de cette action" : "About this outreach"}
    </h2>
    <p class="mt-3 max-w-prose text-gray-700 leading-relaxed">{project.description}</p>
    {tor && (
      <div class="mt-7">
        <h2 class="text-lg font-heading font-bold text-gray-900">{fr ? "Documents de planification" : "Planning documents"}</h2>
        <a class="inline-flex min-h-11 items-center text-primary-800 underline" href={tor} hreflang="en">
          {fr ? "Termes de référence (PDF en anglais)" : "Terms of Reference (PDF)"}
        </a>
        <p class="text-sm text-gray-600">{fr ? "Document de planification. Ce n’est pas un rapport d’activité." : "Advance plan, not a completion report."}</p>
      </div>
    )}
    {project.autoArchived && project.archiveHref && (
      <a class="inline-block mt-6 text-primary-800 underline" href={project.archiveHref}>
        {fr ? "Consulter le dossier d’archive" : "View archive record"}
      </a>
    )}
  </section>
</PageLayout>
