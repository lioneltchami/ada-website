---
import { type Locale } from "../../i18n";
import OutreachPhoto from "../media/OutreachPhoto.astro";
import Section from "../layout/Section.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isFr = locale === "fr";
const title = isFr ? "Appelés à Servir" : "Called to Serve";
const label = isFr ? "Notre histoire" : "Our story";
---

<Section background="gray" padding="lg">
  <div data-about-story class="max-w-5xl">
    <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
      {label}
    </p>
    <h2 class="mt-3 font-heading text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl md:text-4xl">
      {title}
    </h2>
    <div class="mt-5 grid items-start gap-6 md:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] md:gap-8">
      <div class="space-y-4 leading-relaxed text-gray-600">
        <slot />
      </div>
      <OutreachPhoto record="city-cleanup-may-2023" locale={locale} class="max-w-sm" />
    </div>
  </div>
</Section>
