---
import HeroBackdrop from "./HeroBackdrop.astro";

interface Props {
  title: string;
  subtitle?: string;
  /** @deprecated Eyebrows default off per design.md — ignored if passed */
  badge?: string;
  compact?: boolean;
  imageUrl?: string;
  imageAlt?: string;
  imageDecorative?: boolean;
  imageLayout?: "background" | "side";
  preserveFraming?: boolean;
  photo?: { src: string; alt: string; credit: { text: string; href: string } };
}

const {
  title,
  subtitle,
  compact = false,
  photo,
  imageUrl = photo?.src || "",
  imageAlt = photo?.alt || "",
  imageDecorative = false,
  imageLayout = "side",
  preserveFraming = false,
} = Astro.props;
---

<!-- Hallmark · genre: editorial · chrome: PageHero · design-system: design.md · designed-as-app -->
<section
  class:list={[
    "relative isolate overflow-hidden text-white",
    compact ? "py-14 md:py-16" : "py-20 md:py-28",
    (!imageUrl || imageLayout === "side") && "bg-primary-900",
  ]}
>
  <HeroBackdrop {imageUrl} imageAlt={imageAlt || title} {imageDecorative} {imageLayout} {preserveFraming} />
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
    <div class="max-w-3xl">
      <h1
        class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold leading-tight tracking-tight"
      >
        {title}
      </h1>
      {
        subtitle && (
          <p class="mt-4 text-base md:text-lg text-white/80 max-w-2xl leading-relaxed">
            {subtitle}
          </p>
        )
      }
      <slot />
      {photo && (
        <p class="mt-4 text-sm leading-relaxed text-white/90">
          <a href={photo.credit.href} class="underline decoration-white/50 underline-offset-4 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-4">
            {photo.credit.text}
          </a>
        </p>
      )}
    </div>
  </div>
</section>
