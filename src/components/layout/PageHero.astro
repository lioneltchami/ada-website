---
interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  compact?: boolean;
  imageUrl?: string;
  imageAlt?: string;
}

const {
  title,
  subtitle,
  badge,
  compact = false,
  imageUrl = "",
  imageAlt = "",
} = Astro.props;
---

<!-- Hallmark · genre: editorial · macrostructure: Photographic · design-system: design.md · designed-as-app -->
<section
  class:list={[
    "relative overflow-hidden text-white",
    compact ? "py-14 md:py-16" : "py-20 md:py-28",
    !imageUrl && "bg-primary-900",
  ]}
>
  {
    imageUrl ? (
      <img
        src={imageUrl}
        alt={imageAlt || title}
        class="absolute inset-0 w-full h-full object-cover"
        loading="eager"
      />
    ) : null
  }
  <div
    class:list={[
      "absolute inset-0",
      imageUrl
        ? "bg-gradient-to-r from-primary-950/92 via-primary-900/75 to-primary-900/40"
        : "bg-primary-900",
    ]}
  >
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
    <div class="max-w-3xl">
      {
        badge && (
          <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-200 mb-3">
            {badge}
          </p>
        )
      }
      <h1
        class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold leading-tight tracking-tight"
      >
        {title}
      </h1>
      {
        subtitle && (
          <p class="mt-4 text-base md:text-lg text-white/80 max-w-2xl leading-relaxed">
            {subtitle}
          </p>
        )
      }
      <slot />
    </div>
  </div>
</section>
