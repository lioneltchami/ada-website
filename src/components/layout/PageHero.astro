---
interface Props {
  title: string;
  subtitle?: string;
  /** @deprecated Eyebrows default off per design.md — ignored if passed */
  badge?: string;
  compact?: boolean;
  imageUrl?: string;
  imageAlt?: string;
  imageDecorative?: boolean;
  imageLayout?: "background" | "side";
}

const {
  title,
  subtitle,
  compact = false,
  imageUrl = "",
  imageAlt = "",
  imageDecorative = false,
  imageLayout = "background",
} = Astro.props;
---

<!-- Hallmark · genre: editorial · chrome: PageHero · design-system: design.md · designed-as-app -->
<section
  class:list={[
    "relative isolate overflow-hidden text-white",
    compact ? "py-14 md:py-16" : "py-20 md:py-28",
    (!imageUrl || imageLayout === "side") && "bg-primary-900",
  ]}
>
  {
    imageUrl ? (
      <img
        src={imageUrl}
        alt={imageDecorative ? "" : imageAlt || title}
        aria-hidden={imageDecorative ? "true" : undefined}
        class:list={[
          "absolute object-cover",
          imageLayout === "side"
	            ? "inset-y-0 right-0 h-full w-full object-center lg:left-auto lg:w-auto lg:object-contain"
            : "inset-0 h-full w-full",
        ]}
        loading="eager"
      />
    ) : null
  }
  <div
    class:list={[
      "absolute inset-0",
      imageUrl
        ? imageLayout === "side"
          ? "bg-gradient-to-r from-primary-900 via-primary-900/90 to-primary-900/25"
          : "bg-gradient-to-r from-primary-950/92 via-primary-900/75 to-primary-900/40"
        : "bg-primary-900",
    ]}
  >
  </div>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">
    <div class="max-w-3xl">
      <h1
        class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold leading-tight tracking-tight"
      >
        {title}
      </h1>
      {
        subtitle && (
          <p class="mt-4 text-base md:text-lg text-white/80 max-w-2xl leading-relaxed">
            {subtitle}
          </p>
        )
      }
      <slot />
    </div>
  </div>
</section>
