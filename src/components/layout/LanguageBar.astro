---
import { getLocale } from "../../i18n";
import { getLanguageBarSwitch } from "../../i18n/routes";

const locale = getLocale(
  Astro.url.pathname,
  Astro.url.searchParams.get("locale"),
);
const localeSwitch = getLanguageBarSwitch(
  Astro.url.pathname,
  locale,
  Astro.url.searchParams,
);
const languages = [
  { code: "en", label: "English", compact: "EN" },
  { code: "fr", label: "Français", compact: "FR" },
] as const;
---

<nav
  id="language-navigation"
  aria-label="Language / Langue"
  class="shrink-0 font-heading"
>
  <ul
    class="inline-flex items-center rounded-full border border-primary-200 bg-white p-0.5"
  >
    {
      languages.map(({ code, label, compact }) => (
        <li>
          {code === locale ? (
            <span
              lang={code}
              aria-current="true"
              class="inline-flex min-h-11 min-w-11 justify-center items-center rounded-full bg-primary-700 px-2 sm:px-3 text-xs sm:text-sm font-bold text-white underline decoration-2 underline-offset-4"
            >
              <span class="sr-only sm:not-sr-only">{label}</span>
              <span class="sm:hidden" aria-hidden="true">
                {compact}
              </span>
            </span>
          ) : localeSwitch ? (
            <a
              href={localeSwitch.href}
              lang={code}
              hreflang={code}
              data-locale-switch={
                !localeSwitch.authRoute && !localeSwitch.homeFallback
                  ? ""
                  : undefined
              }
              data-auth-locale-switch={localeSwitch.authRoute ? "" : undefined}
              hidden={localeSwitch.authRoute}
              class="inline-flex min-h-11 min-w-11 justify-center items-center rounded-full px-2 sm:px-3 text-xs sm:text-sm font-semibold text-primary-800 hover:bg-primary-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700"
              title={
                localeSwitch.homeFallback
                  ? code === "fr"
                    ? "Accueil en français"
                    : "English homepage"
                  : undefined
              }
            >
              <span class="sr-only sm:not-sr-only">{label}</span>
              <span class="sm:hidden" aria-hidden="true">
                {compact}
              </span>
              {localeSwitch.homeFallback && (
                <span class="sr-only">
                  {code === "fr" ? " — accueil" : " — homepage"}
                </span>
              )}
            </a>
          ) : null}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* Author display utilities must not override hidden auth-callback controls. */
  [data-auth-locale-switch][hidden] {
    display: none;
  }
</style>
