---
import { getTeamRoster } from "../../data/team-profiles";

interface Props {
  locale: "en" | "fr";
}

const { locale } = Astro.props;
const { groups, readBio, board } = getTeamRoster(locale);
---
<div class="team-roster space-y-8">
  {groups.map((group, i) => (
    <section aria-labelledby={`team-group-${i}`}>
      <h3 id={`team-group-${i}`} class="mb-4 font-heading text-xl font-semibold text-gray-900">{group.title}</h3>
      <div class="grid grid-cols-1 items-start gap-4 sm:grid-cols-2">
        {group.profiles.map((profile) => (
          <article class="min-w-0 overflow-hidden rounded-xl border border-gray-200 bg-gray-50" data-team-person={profile.id}>
            {profile.portrait && (
              <div class="aspect-[4/3] bg-primary-50">
                <img
                  src={profile.portrait.src}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover object-top"
                />
              </div>
            )}
            <div class="p-5">
              <h4 class="text-lg font-semibold text-gray-900">{profile.name}</h4>
              {profile.role && <p class="mt-1 text-sm font-semibold text-primary-700">{profile.role}</p>}
              {profile.summary && <p class="mt-3 text-sm leading-relaxed text-gray-700">{profile.summary}</p>}
              {profile.bio && (
                <details class="group mt-4 border-t border-gray-200">
                  <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded text-sm font-semibold text-primary-800 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary-700">
                    {readBio}<span class="sr-only">: {profile.name}</span>
                    <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" width="16" height="16" class="shrink-0 group-open:rotate-180"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </summary>
                  <p class="text-sm leading-relaxed text-gray-700">{profile.bio}</p>
                </details>
              )}
            </div>
          </article>
        ))}
        {i === 0 && (
          <article class="rounded-xl border border-gray-200 bg-white p-5">
            <h4 class="text-lg font-semibold text-gray-900">{board.title}</h4>
            <p class="mt-2 text-sm leading-relaxed text-gray-700">{board.text}</p>
          </article>
        )}
      </div>
    </section>
  ))}
</div>

<style>
  summary::-webkit-details-marker { display: none; }
</style>
