---
import { getLocale, t, localePath } from "../../i18n";
import LanguageBar from "./LanguageBar.astro";

const locale = getLocale(
  Astro.url.pathname,
  Astro.url.searchParams.get("locale"),
);
const i18n = t(locale);
const currentPath = Astro.url.pathname;
const navLinks = [
  { href: localePath("/about", locale), label: i18n.nav.about },
  { href: localePath("/projects", locale), label: i18n.nav.projects },
  { href: localePath("/stories", locale), label: i18n.nav.stories },
  { href: localePath("/gallery", locale), label: i18n.nav.gallery },
  { href: localePath("/sponsor", locale), label: i18n.nav.sponsor },
  { href: localePath("/contact", locale), label: i18n.nav.contact },
];

function isActive(href: string): boolean {
  const path = currentPath.replace(/\/$/, "") || "/";
  if (href === "/") return path === "/";
  return path === href || path.startsWith(href + "/");
}
---

<!-- Hallmark · genre: editorial · chrome: N6 masthead · design-system: design.md · designed-as-app -->
<header
  id="site-header"
  class="sticky top-0 z-40 bg-[#f7f5f0] border-b border-transparent transition-[border-color] duration-200"
>
  <nav
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
    aria-label={locale === "fr" ? "Navigation principale" : "Main navigation"}
  >
    <!-- One masthead row: brand, centered desktop navigation, language and Donate. -->
    <div
      class="grid grid-cols-[minmax(0,1fr)_auto] items-center gap-3 h-16 xl:grid-cols-[auto_minmax(0,1fr)_auto] xl:h-20"
    >
      <a
        href={localePath("/", locale)}
        class="flex items-center gap-3 min-w-0"
        data-header-brand
        aria-label={locale === "fr"
          ? "Accueil — Apoti Development Association"
          : "Apoti Development Association home"}
      >
        <img
          src="/brand/ada-symbol.png"
          alt=""
          width="56"
          height="56"
          class="w-11 h-11 sm:w-12 sm:h-12 xl:w-14 xl:h-14 shrink-0 object-contain"
          loading="eager"
          decoding="async"
        />
        <div class="hidden sm:block min-w-0 font-heading">
          <span
            class="block text-[13px] xl:text-base leading-tight font-bold text-gray-900 tracking-tight truncate"
            >Apoti Development</span
          >
          <span
            class="block text-[13px] xl:text-sm leading-tight text-gray-600 mt-0.5 font-medium tracking-[0.01em]"
            >Association</span
          >
        </div>
      </a>

      <ul
        class="hidden xl:flex items-center justify-center gap-1 2xl:gap-2 font-heading text-sm"
        data-desktop-navigation
      >
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "inline-flex min-h-11 items-center rounded-md px-2 py-2 transition-colors whitespace-nowrap focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700",
                  isActive(link.href)
                    ? "bg-primary-50 text-primary-900 font-semibold ring-1 ring-inset ring-primary-200 underline decoration-2 underline-offset-4"
                    : "text-gray-600 hover:bg-gray-100 hover:text-primary-700",
                ]}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-1.5 sm:gap-3" data-header-actions>
        <LanguageBar />
        <a
          href={localePath("/donate", locale)}
          class="font-heading inline-flex min-h-11 items-center whitespace-nowrap px-3 sm:px-4 py-2 text-sm font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors"
          data-umami-event="nav-donate"
        >
          {i18n.nav.donate}
        </a>

        <button
          type="button"
          class="xl:hidden flex h-11 w-11 items-center justify-center text-gray-700 hover:text-gray-900"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label={locale === "fr" ? "Ouvrir le menu" : "Open menu"}
          id="mobile-menu-btn"
        >
          <span class="sr-only" id="mobile-menu-label">
            {locale === "fr" ? "Ouvrir le menu" : "Open menu"}
          </span>
          <svg
            class="w-5 h-5"
            id="menu-icon-open"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
          </svg>
          <svg
            class="w-5 h-5 hidden"
            id="menu-icon-close"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18 18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="hidden xl:hidden pb-4"
      aria-label={locale === "fr" ? "Navigation mobile" : "Mobile navigation"}
    >
      <ul class="space-y-0.5 pt-2 border-t border-gray-200 font-heading">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "flex items-center gap-2 rounded-md px-3 py-2.5 text-base transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700",
                  isActive(link.href)
                    ? "bg-primary-50 font-semibold text-primary-900 shadow-sm"
                    : "text-gray-700 hover:bg-gray-50 hover:text-primary-700",
                ]}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                <span
                  class:list={[
                    "h-2 w-2 shrink-0 rounded-full",
                    isActive(link.href) ? "bg-primary-700" : "bg-transparent",
                  ]}
                  aria-hidden="true"
                />
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="pt-2">
          <a
            href={localePath("/donate", locale)}
            class="flex items-center justify-center px-3 py-3 text-base font-semibold text-white bg-secondary-500 rounded-md"
          >
            {i18n.nav.donateNow}
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script is:inline src="/scripts/header-menu.js"></script>
