---
import { getLocale, t, switchLocalePath, localePath } from "../../i18n";

const locale = getLocale(Astro.url.pathname);
const i18n = t(locale);
const currentPath = Astro.url.pathname;

function hasLocaleAlternative(pathname: string): boolean {
  const englishPath = pathname.replace(/^\/fr(?=\/|$)/, "") || "/";
  if (
    englishPath.startsWith("/auth") ||
    englishPath === "/404" ||
    englishPath.startsWith("/dashboard")
  )
    return false;
  if (englishPath === "/donate/thank-you") return false;

  return (
    englishPath === "/" ||
    englishPath === "/about" ||
    englishPath === "/contact" ||
    englishPath === "/donate" ||
    englishPath === "/gallery" ||
    englishPath === "/get-involved" ||
    englishPath === "/monthly" ||
    englishPath === "/sponsor" ||
    englishPath === "/sponsor/inquiry" ||
    englishPath === "/impact-scorecard" ||
    englishPath === "/partners" ||
    englishPath === "/privacy" ||
    englishPath === "/resources" ||
    englishPath === "/team" ||
    englishPath === "/terms" ||
    englishPath === "/transparency" ||
    englishPath === "/projects" ||
    englishPath.startsWith("/projects/") ||
    englishPath === "/stories" ||
    englishPath.startsWith("/stories/")
  );
}

const switchPath = switchLocalePath(currentPath);
const showLocaleSwitch = hasLocaleAlternative(currentPath);

const navLinks = [
  { href: localePath("/about", locale), label: i18n.nav.about },
  { href: localePath("/projects", locale), label: i18n.nav.projects },
  { href: localePath("/stories", locale), label: i18n.nav.stories },
  { href: localePath("/gallery", locale), label: i18n.nav.gallery },
  { href: localePath("/sponsor", locale), label: i18n.nav.sponsor },
  { href: localePath("/contact", locale), label: i18n.nav.contact },
];

function isActive(href: string): boolean {
  const path = currentPath.replace(/\/$/, "") || "/";
  if (href === "/") return path === "/";
  return path === href || path.startsWith(href + "/");
}
---

<!-- Hallmark · genre: editorial · chrome: N6 masthead · design-system: design.md · designed-as-app -->
<header
  id="site-header"
  class="sticky top-0 z-40 bg-[#f7f5f0] border-b border-transparent transition-[border-color] duration-200"
>
  <nav
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
    aria-label="Main navigation"
  >
    <!-- N6 masthead: brand row -->
    <div class="flex items-center justify-between h-16">
      <a
        href={localePath("/", locale)}
        class="flex items-center gap-2.5 min-w-0"
      >
        <img
          src="/brand/ada-logo.png"
          alt="Apoti Development Association"
          class="w-11 h-11 sm:w-12 sm:h-12 object-contain"
          loading="eager"
          decoding="async"
        />
        <div class="hidden sm:block min-w-0 font-heading">
          <span class="block text-sm font-bold text-gray-900 tracking-tight truncate"
            >Apoti Development</span
          >
          <span class="block text-[11px] text-gray-500 -mt-0.5 font-medium"
            >Association</span
          >
        </div>
      </a>

      <div class="flex items-center gap-2 sm:gap-3">
        {
          showLocaleSwitch && (
            <a
              href={switchPath}
              class="font-heading text-xs font-semibold text-gray-600 hover:text-primary-700 underline-offset-4 hover:underline"
              aria-label={
                locale === "en" ? "Switch to French" : "Passer en anglais"
              }
            >
              {i18n.common.language}
            </a>
          )
        }
        <a
          href={localePath("/donate", locale)}
          class="font-heading inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors"
          data-umami-event="nav-donate"
        >
          {i18n.nav.donate}
        </a>

        <button
          type="button"
          class="lg:hidden p-2 text-gray-700 hover:text-gray-900"
          aria-expanded="false"
          aria-controls="mobile-menu"
          id="mobile-menu-btn"
        >
          <span class="sr-only">Open menu</span>
          <svg
            class="w-5 h-5"
            id="menu-icon-open"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
          </svg>
          <svg
            class="w-5 h-5 hidden"
            id="menu-icon-close"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18 18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- N6 secondary link row -->
    <ul
      class="hidden lg:flex items-center gap-0 pb-3 -mt-1 font-heading text-sm"
    >
      {
        navLinks.map((link, i) => (
          <li class="flex items-center">
            {i > 0 && (
              <span class="mx-3 h-3 w-px bg-gray-300" aria-hidden="true" />
            )}
            <a
              href={link.href}
              class:list={[
                "py-1 transition-colors",
                isActive(link.href)
                  ? "text-primary-700 font-semibold"
                  : "text-gray-600 hover:text-primary-700",
              ]}
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="hidden lg:hidden pb-4"
      aria-label="Mobile navigation"
    >
      <ul class="space-y-0.5 pt-2 border-t border-gray-200 font-heading">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "block px-1 py-2.5 text-base",
                  isActive(link.href)
                    ? "text-primary-700 font-semibold"
                    : "text-gray-700 hover:text-primary-700",
                ]}
                aria-current={isActive(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        {
          showLocaleSwitch && (
            <li>
              <a
                href={switchPath}
                class="block px-1 py-2.5 text-base text-gray-700 hover:text-primary-700"
              >
                {locale === "en" ? "Français" : "English"}
              </a>
            </li>
          )
        }
        <li class="pt-2">
          <a
            href={localePath("/donate", locale)}
            class="flex items-center justify-center px-3 py-3 text-base font-semibold text-white bg-secondary-500 rounded-md"
          >
            {i18n.nav.donateNow}
          </a>
        </li>
      </ul>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById("site-header");
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("menu-icon-open");
  const iconClose = document.getElementById("menu-icon-close");

  window.addEventListener(
    "scroll",
    () => {
      const scrolled = window.scrollY > 8;
      header?.classList.toggle("border-gray-200", scrolled);
      header?.classList.toggle("border-transparent", !scrolled);
    },
    { passive: true },
  );

  function openMenu() {
    btn?.setAttribute("aria-expanded", "true");
    menu?.classList.remove("hidden");
    iconOpen?.classList.add("hidden");
    iconClose?.classList.remove("hidden");
    menu?.querySelector("a")?.focus();
  }

  function closeMenu() {
    btn?.setAttribute("aria-expanded", "false");
    menu?.classList.add("hidden");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
    btn?.focus();
  }

  btn?.addEventListener("click", () => {
    const expanded = btn.getAttribute("aria-expanded") === "true";
    expanded ? closeMenu() : openMenu();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !menu?.classList.contains("hidden")) {
      closeMenu();
    }
  });
</script>
