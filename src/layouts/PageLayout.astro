---
import BaseLayout from "./BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import Chatbot from "../components/islands/Chatbot";
import { getFaqResponses } from "../lib/sanity";
import { getLocale, localePath, t } from "../i18n";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  noIndex?: boolean;
  noBreadcrumbJsonLd?: boolean;
  jsonLdExtra?: Record<string, unknown>[];
}

const props = Astro.props;
const locale = getLocale(
  Astro.url.pathname,
  Astro.url.searchParams.get("locale"),
);
const labels = t(locale);
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const showFloatingDonate = !(
  pathname === "/" ||
  pathname === "/fr" ||
  pathname === "/donate" ||
  pathname === "/fr/donate" ||
  pathname === "/monthly" ||
  pathname === "/fr/monthly" ||
  pathname === "/donate/thank-you" ||
  pathname === "/fr/donate/thank-you" ||
  pathname === "/contact" ||
  pathname === "/fr/contact" ||
  pathname === "/sponsor" ||
  pathname === "/fr/sponsor" ||
  pathname === "/sponsor/inquiry" ||
  pathname === "/fr/sponsor/inquiry" ||
  pathname.startsWith("/auth") ||
  pathname.startsWith("/fr/auth") ||
  pathname.startsWith("/dashboard")
);
const showChatbot = ["/", "/get-involved"].includes(pathname);

let faqData: { keywords: string[]; keywordsFr?: string[]; response: string }[] =
  [];
const faqPaths = new Set([
  "/",
  "/contact",
  "/get-involved",
  "/fr",
  "/fr/contact",
  "/fr/get-involved",
]);
if (faqPaths.has(pathname)) {
  try {
    const faqs = await getFaqResponses(locale);
    if (faqs?.length) {
      faqData = faqs.map((f) => ({
        keywords: f.keywords,
        keywordsFr: f.keywordsFr,
        response: f.response,
      }));
    }
  } catch {}
}
---

<BaseLayout {...props}>
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-primary-600 focus:text-white focus:rounded"
  >
    {locale === "fr" ? "Aller au contenu principal" : "Skip to main content"}
  </a>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  {
    showFloatingDonate && (
      <a
        href={localePath("/donate", locale)}
        data-floating-donate
        class="fixed bottom-4 right-4 z-50 sm:hidden flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors border border-secondary-600/20"
        style={
          showChatbot
            ? "left:max(1rem,env(safe-area-inset-left));right:auto;bottom:max(1rem,env(safe-area-inset-bottom))"
            : undefined
        }
        aria-label={labels.nav.donate}
      >
        <svg
          class="w-4 h-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"
          />
        </svg>
        {labels.nav.donate}
      </a>
    )
  }
  <Footer />
  <script is:inline src="/scripts/footer-donate.js"></script>
  {showChatbot && <Chatbot client:idle faqs={faqData} locale={locale} />}
</BaseLayout>
