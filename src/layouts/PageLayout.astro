---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Chatbot from '../components/islands/Chatbot';
import { getFaqResponses } from '../lib/sanity';
import { getLocale, localePath, t } from '../i18n';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noIndex?: boolean;
}

const props = Astro.props;
const locale = getLocale(Astro.url.pathname);
const labels = t(locale);
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const showFloatingDonate = !(
  pathname === '/donate' ||
  pathname === '/fr/donate' ||
  pathname === '/donate/thank-you' ||
  pathname === '/fr/donate/thank-you' ||
  pathname === '/sponsor' ||
  pathname === '/fr/sponsor' ||
  pathname.startsWith('/auth') ||
  pathname.startsWith('/fr/auth') ||
  pathname.startsWith('/dashboard')
);

let faqData: { keywords: string[]; response: string }[] = [];
if (Astro.url.pathname === '/' || Astro.url.pathname === '/contact' || Astro.url.pathname === '/donate' || Astro.url.pathname === '/get-involved') {
  try {
    const faqs = await getFaqResponses();
    if (faqs?.length) {
      faqData = faqs.map(f => ({ keywords: f.keywords, response: f.response }));
    }
  } catch {}
}
---

<BaseLayout {...props}>
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:p-4 focus:bg-primary-600 focus:text-white focus:rounded"
  >
    Skip to main content
  </a>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  {showFloatingDonate && (
    <a
      href={localePath('/donate', locale)}
      class="fixed bottom-4 right-4 z-50 sm:hidden flex items-center gap-2 px-4 py-3 text-sm font-semibold text-white bg-secondary-500 rounded-full shadow-lg shadow-secondary-500/30 hover:bg-secondary-600 transition-colors"
      aria-label={labels.nav.donate}
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
      </svg>
      {labels.nav.donate}
    </a>
  )}
  <Footer />
  {(Astro.url.pathname === '/' || Astro.url.pathname === '/contact' || Astro.url.pathname === '/donate' || Astro.url.pathname === '/get-involved') && (
    <Chatbot client:idle faqs={faqData} />
  )}
</BaseLayout>
