---
import { getLocale, switchLocalePath } from "../i18n";
import { REGISTRATION_NUMBER, buildBreadcrumbList } from "../data/organization";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  noIndex?: boolean;
}

const {
  title,
  description,
  ogImage = "https://cdn.sanity.io/images/rj2m21gk/production/85d73f4797b625e01e2a66df43cea27625e0ad72-800x600.jpg?w=1200&h=630&fit=crop",
  noIndex = false,
} = Astro.props;

const locale = getLocale(Astro.url.pathname);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const alternateLocale = locale === "fr" ? "en" : "fr";
const alternateUrl = new URL(switchLocalePath(Astro.url.pathname), Astro.site);
const emitLocaleAlternates = !noIndex;
const webVitalsSampleRate = Number(
  import.meta.env.PUBLIC_WEB_VITALS_SAMPLE_RATE ?? "0.2",
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NonprofitOrganization",
  name: "Apoti Development Association",
  alternateName: "ADA",
  url: Astro.site?.toString() || "https://apotidev.org",
  logo: "https://apotidev.org/brand/ada-logo.png",
  description:
    "Faith-based charity empowering widows, orphans, and young women in Cameroon through food distribution, education, vocational training, and healthcare since 2021.",
  foundingDate: "2021",
  foundingLocation: { "@type": "Place", name: "Buea, Cameroon" },
  areaServed: { "@type": "Country", name: "Cameroon" },
  address: {
    "@type": "PostalAddress",
    addressCountry: "CM",
    addressRegion: "South West Region",
    addressLocality: "Buea",
  },
  contactPoint: [
    {
      "@type": "ContactPoint",
      email: "info@apotidev.org",
      telephone: "+237676282346",
      contactType: "general inquiries",
      availableLanguage: ["English", "French"],
    },
    {
      "@type": "ContactPoint",
      email: "info@apotidev.org",
      contactType: "donations",
      url: "https://apotidev.org/donate",
    },
  ],
  identifier: REGISTRATION_NUMBER,
  nonprofitStatus: `Registered Non-Profit Association, Cameroon (${REGISTRATION_NUMBER})`,
  knowsAbout: [
    "Widow empowerment",
    "Orphan education",
    "Women vocational training",
    "Clean water access",
    "Community development",
    "Cameroon",
  ],
  sameAs: [
    "https://facebook.com/apotidev",
    "https://instagram.com/apotidev",
    "https://twitter.com/apotidev",
  ],
};

const breadcrumbList = buildBreadcrumbList(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Apoti Development Association</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {
      emitLocaleAlternates && (
        <>
          <link
            rel="alternate"
            hreflang={locale === "fr" ? "fr" : "en"}
            href={canonicalUrl}
          />
          <link
            rel="alternate"
            hreflang={alternateLocale}
            href={alternateUrl}
          />
          <link
            rel="alternate"
            hreflang="x-default"
            href={locale === "fr" ? alternateUrl : canonicalUrl}
          />
        </>
      )
    }

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "fr" ? "fr_FR" : "en_CA"} />
    <meta property="og:site_name" content="Apoti Development Association" />
    <meta
      property="og:image:alt"
      content="Apoti Development Association programs supporting widows, orphans, and young women in Cameroon"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:site" content="@apotidev" />
    <meta name="twitter:creator" content="@apotidev" />
    <meta name="author" content="Apoti Development Association" />

    {noIndex && <meta name="robots" content="noindex, follow" />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Plus+Jakarta+Sans:wght@700;800&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Plus+Jakarta+Sans:wght@700;800&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript
      ><link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Plus+Jakarta+Sans:wght@700;800&display=swap"
      /></noscript
    >

    <meta name="theme-color" content="#15803d" />
    <meta name="application-name" content="Apoti Development Association" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="icon" href="/favicon.ico?v=2" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {
      breadcrumbList && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(breadcrumbList)}
        />
      )
    }

    {
      import.meta.env.PUBLIC_UMAMI_WEBSITE_ID && (
        <script
          defer
          src={`${import.meta.env.PUBLIC_UMAMI_URL || "https://cloud.umami.is"}/script.js`}
          data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID}
        />
      )
    }
    {
      import.meta.env.PUBLIC_POSTHOG_KEY && (
        <script
          src="/scripts/posthog-init.js"
          defer
          data-key={import.meta.env.PUBLIC_POSTHOG_KEY}
          data-host={
            import.meta.env.PUBLIC_POSTHOG_HOST || "https://us.i.posthog.com"
          }
          data-ui-host={
            import.meta.env.PUBLIC_POSTHOG_UI_HOST || "https://us.posthog.com"
          }
        />
      )
    }
  </head>
  <body>
    <slot />
    <script
      src="/scripts/web-vitals-beacon.js"
      defer
      data-sample-rate={String(webVitalsSampleRate)}
    ></script>
  </body>
</html>
