---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/layout/Section.astro";
import NewsletterSignup from "../../components/islands/NewsletterSignup";
---
<!-- Hallmark · genre: editorial · macrostructure: Split Studio · design-system: design.md · designed-as-app -->

<PageLayout
  title="Thank You for Your Donation"
  description="Your donation has been received. Thank you for supporting ADA's mission in Cameroon."
  noIndex
>
  <!-- Hero Thank You -->
  <Section background="white" padding="lg">
    <div class="max-w-lg">
      <div
        class="w-16 h-16 rounded-md bg-primary-50 border border-primary-100 flex items-center justify-center"
      >
        <svg
          class="w-10 h-10 text-primary-600"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
          ></path>
        </svg>
      </div>
      <h1
        class="mt-6 text-3xl font-heading font-bold text-gray-900"
        id="thank-you-heading"
      >
        Thank You!
      </h1>
      <p class="mt-4 text-lg text-gray-600" id="thank-you-message">
        Your generous donation has been received. Your receipt will be emailed
        after payment confirmation.
      </p>
      <p class="mt-3 text-sm text-gray-500 max-w-sm">
        Your support makes a real difference in the lives of widows, orphans,
        and young women in Cameroon. We are grateful for you.
      </p>
      <div
        class="mt-6 inline-flex items-center gap-2 px-4 py-2 bg-[#faf8f4] rounded-md text-sm text-primary-800 font-medium border border-primary-200"
      >
        Check your inbox — your receipt is on its
        way
      </div>
    </div>
  </Section>

  <!-- Monthly Upsell — hidden in the browser when Stripe returns from a monthly checkout -->
  <Section background="gray" padding="sm">
    <div id="monthly-upsell" class="max-w-lg">
      <div
        class="p-5 bg-white rounded-md border border-primary-200"
      >
        <p class="text-base font-semibold text-gray-900">
           Make your impact ongoing
        </p>
        <p class="mt-2 text-sm text-gray-600 max-w-sm">
          Monthly donors give ADA more predictability to plan school support,
          field follow-up, and urgent household needs before crises grow.
        </p>
        <a
          href="/monthly"
          class="mt-4 inline-flex items-center px-5 py-2.5 text-sm font-semibold text-primary-700 border border-primary-200 rounded-md hover:bg-primary-50 transition-colors"
        >
          Become a Monthly Supporter
        </a>
        <p class="mt-2 text-xs text-gray-400">Cancel anytime · No fees</p>
      </div>
    </div>
  </Section>

  <!-- What Happens Next -->
  <Section background="white" padding="md">
    <div class="max-w-2xl">
      <h2 class="text-xl font-heading font-bold text-gray-900">
        What Happens Next
      </h2>
      <ul class="mt-6 divide-y divide-gray-200 border-y border-gray-200">
        {
          [
            {
              title: "Receipt by email",
              desc: "An official PDF receipt and thank-you note are emailed after Stripe confirms the gift.",
            },
            {
              title: "Funds reach Cameroon",
              desc: "ADA reconciles the gift with program records and field priorities.",
            },
            {
              title: "30-day impact update",
              desc: "Your gift is queued for a follow-up update with field notes, photos, or a report link when available.",
            },
          ].map((step) => (
            <li class="py-5">
              <p class="font-heading text-sm font-semibold text-gray-900">
                {step.title}
              </p>
              <p class="mt-1 text-sm text-gray-600 leading-relaxed">
                {step.desc}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- Share -->
  <Section background="gray" padding="md">
    <div class="max-w-lg">
      <h2 class="text-lg font-semibold text-gray-900">Spread the Word</h2>
      <p class="mt-1 text-sm text-gray-600">
        Help us reach more supporters by sharing your generosity.
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <a
          href="https://twitter.com/intent/tweet?text=I%20just%20donated%20to%20%40apotidev%20%E2%80%94%20supporting%20widows%2C%20orphans%2C%20and%20young%20women%20in%20Cameroon.%20Join%20me%3A%20https%3A%2F%2Fapotidev.org%2Fdonate"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors"
          aria-label="Share on X (Twitter)"
        >
          Share on X
        </a>
        <a
          href="https://www.facebook.com/sharer/sharer.php?u=https%3A%2F%2Fapotidev.org%2Fdonate"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors"
          aria-label="Share on Facebook"
        >
          Share on Facebook
        </a>
        <a
          href="https://wa.me/?text=I%20just%20donated%20to%20Apoti%20Development%20Association%20%E2%80%94%20supporting%20communities%20in%20Cameroon.%20Join%20me%3A%20https%3A%2F%2Fapotidev.org%2Fdonate"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors"
          aria-label="Share on WhatsApp"
        >
          WhatsApp
        </a>
        <a
          href="https://www.linkedin.com/sharing/share-offsite/?url=https%3A%2F%2Fapotidev.org%2Fdonate"
          target="_blank"
          rel="noopener noreferrer"
          class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors"
          aria-label="Share on LinkedIn"
        >
          LinkedIn
        </a>
      </div>
    </div>
  </Section>

  <!-- Newsletter -->
  <Section background="white" padding="md">
    <div class="max-w-lg">
      <h2 class="text-lg font-semibold text-gray-900">Stay Connected</h2>
      <p class="mt-1 text-sm text-gray-600">
        Get monthly updates with photos and stories showing how your donation is
        making a difference.
      </p>
      <div class="mt-4">
        <NewsletterSignup client:visible />
      </div>
    </div>
  </Section>

  <!-- Navigation -->
  <Section background="gray" padding="sm">
    <div class="flex flex-wrap items-center gap-4">
      <a
        href="/"
        class="font-heading text-sm font-semibold text-primary-800 underline underline-offset-4 hover:text-primary-900"
      >
        Return Home
      </a>
      <a
        href="/stories"
        class="font-heading text-sm font-semibold text-primary-800 underline underline-offset-4 hover:text-primary-900"
      >
        Read Impact Stories
      </a>
      <a
        href="/transparency"
        class="font-heading text-sm font-semibold text-primary-800 underline underline-offset-4 hover:text-primary-900"
      >
        See How Funds Are Used
      </a>
    </div>
  </Section>
</PageLayout>

<script>
  // Keep donor names out of URLs, analytics, and browser history. Only use the return
  // URL to decide whether the monthly upsell should be visible.
  const params = new URLSearchParams(window.location.search);
  if (params.get("frequency") === "monthly") {
    document.getElementById("monthly-upsell")?.closest("section")?.remove();
  }
</script>
