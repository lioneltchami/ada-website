---
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import ResetPasswordForm from '../../components/islands/ResetPasswordForm';
---
<!-- Hallmark · genre: editorial · macrostructure: App · design-system: design.md · designed-as-app -->

<PageLayout title="Reset Password" description="Set a new password for your ADA account." noIndex>
  <Section background="gray" padding="lg">
    <div class="max-w-md mx-auto">
      <div class="mb-8">
        <h1 class="mt-4 text-2xl font-heading font-bold text-gray-900">Set New Password</h1>
        <p class="mt-1 text-sm text-gray-600">Enter your new password below.</p>
      </div>
      <div class="bg-[#faf8f4] p-6 rounded-md border border-gray-200">
        <ResetPasswordForm client:load />
        <p class="mt-4 text-center text-sm text-gray-600">
          <a href="/auth/login" class="text-primary-600 hover:underline">Back to Login</a>
        </p>
      </div>
    </div>
  </Section>
</PageLayout>
