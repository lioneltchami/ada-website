---
import PageLayout from '../../layouts/PageLayout.astro';
import Section from '../../components/layout/Section.astro';
import ResetPasswordForm from '../../components/islands/ResetPasswordForm';
const fr = Astro.url.searchParams.get("locale") === "fr";
export const prerender = false;
---
<!-- Hallmark · genre: editorial · macrostructure: App · design-system: design.md · designed-as-app -->

<PageLayout title={fr ? "Réinitialiser le mot de passe" : "Reset Password"} description={fr ? "Définissez un nouveau mot de passe pour votre compte ADA." : "Set a new password for your ADA account."} noIndex>
  <Section background="gray" padding="lg">
    <div class="max-w-md mx-auto">
      <div class="mb-8">
        <h1 class="mt-4 text-2xl font-heading font-bold text-gray-900">{fr ? "Définir un nouveau mot de passe" : "Set New Password"}</h1>
        <p class="mt-1 text-sm text-gray-600">{fr ? "Saisissez votre nouveau mot de passe ci-dessous." : "Enter your new password below."}</p>
      </div>
      <div class="bg-[#faf8f4] p-6 rounded-md border border-gray-200">
        <ResetPasswordForm client:load locale={fr ? "fr" : "en"} />
        <p class="mt-4 text-center text-sm text-gray-600">
          <a href={fr ? "/auth/login?locale=fr" : "/auth/login"} class="text-primary-600 hover:underline">{fr ? "Retour à la connexion" : "Back to Login"}</a>
        </p>
      </div>
    </div>
  </Section>
</PageLayout>
