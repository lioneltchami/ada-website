---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/layout/Section.astro";
import ForgotPasswordForm from "../../components/islands/ForgotPasswordForm";
const fr = Astro.url.searchParams.get("locale") === "fr";
export const prerender = false;
---
<!-- Hallmark · genre: editorial · macrostructure: App · design-system: design.md · designed-as-app -->

<PageLayout title={fr ? "Mot de passe oublié" : "Forgot Password"} description={fr ? "Réinitialisez le mot de passe de votre compte ADA." : "Reset your ADA account password."} noIndex>
  <Section background="gray" padding="lg">
    <div class="max-w-md mx-auto">
      <div class="mb-8">
        <h1 class="text-2xl font-heading font-bold text-gray-900">{fr ? "Réinitialiser votre mot de passe" : "Reset Your Password"}</h1>
        <p class="mt-1 text-sm text-gray-600">{fr ? "Saisissez votre adresse e-mail pour recevoir un lien de réinitialisation." : "Enter your email and we'll send you a reset link."}</p>
      </div>
      <div class="bg-[#faf8f4] p-6 rounded-md border border-gray-200">
        <ForgotPasswordForm client:load locale={fr ? "fr" : "en"} />
        <p class="mt-4 text-center text-sm text-gray-600">
          <a href={fr ? "/auth/login?locale=fr" : "/auth/login"} class="text-primary-600 hover:underline">{fr ? "Retour à la connexion" : "Back to Login"}</a>
        </p>
      </div>
    </div>
  </Section>
</PageLayout>
