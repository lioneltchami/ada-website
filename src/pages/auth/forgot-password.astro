---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/layout/Section.astro";
import ForgotPasswordForm from "../../components/islands/ForgotPasswordForm";
---
<!-- Hallmark · genre: editorial · macrostructure: App · design-system: design.md · designed-as-app -->

<PageLayout title="Forgot Password" description="Reset your ADA account password." noIndex>
  <Section background="gray" padding="lg">
    <div class="max-w-md mx-auto">
      <div class="mb-8">
        <h1 class="text-2xl font-heading font-bold text-gray-900">Reset Your Password</h1>
        <p class="mt-1 text-sm text-gray-600">Enter your email and we'll send you a reset link.</p>
      </div>
      <div class="bg-[#faf8f4] p-6 rounded-md border border-gray-200">
        <ForgotPasswordForm client:load />
        <p class="mt-4 text-center text-sm text-gray-600">
          <a href="/auth/login" class="text-primary-600 hover:underline">Back to Login</a>
        </p>
      </div>
    </div>
  </Section>
</PageLayout>
