---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/layout/Section.astro";
import { REGISTRATION_NUMBER } from "../../data/organization";

const sponsorTypes = [
  "Individual",
  "Church or faith community",
  "Company / CSR team",
  "School or university",
  "Diaspora group",
  "Foundation or grantmaker",
  "Other",
];

const interests = [
  "Sponsor a project",
  "Sponsor a program cycle",
  "Run a group campaign",
  "Give monthly or quarterly",
  "Offer in-kind support",
  "Request documents first",
  "Not sure yet",
];

const budgetRanges = [
  { label: "$500-$1,000 USD", value: "$500-$1,000" },
  { label: "$2,500-$5,000 USD", value: "$2,500-$5,000" },
  { label: "$10,000+ USD", value: "$10,000+" },
  { label: "Custom / discuss first", value: "Custom / discuss first" },
  { label: "In-kind support", value: "In-kind support" },
];

const timings = [
  "Ready now",
  "Within 30 days",
  "This quarter",
  "Planning for later",
  "Just gathering information",
];

const recognitionOptions = [
  "Public recognition is okay",
  "Internal acknowledgment only",
  "Anonymous in public materials",
  "Discuss first",
];

const reportingNeeds = [
  "Sponsor packet",
  "Registration certificate",
  "Financial summary",
  "Safeguarding policy",
  "Project reports",
  "Invoice or sponsorship agreement",
  "Board / internal approval support",
  "None yet",
];

const callPreferences = [
  "Email first",
  "Request a short call",
  "WhatsApp is best",
  "Send documents first",
];
---

<!-- Hallmark · genre: editorial · macrostructure: Split Studio · design-system: design.md · designed-as-app -->
<PageLayout
  title="Sponsor Inquiry"
  description="Start a sponsor inquiry with ADA. Share what you want to fund and what records your organization needs."
>
  <section class="bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-20">
      <div class="max-w-3xl">
        <h1
          class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-gray-950 leading-tight"
        >
          Sponsor a focused ADA program
        </h1>
        <p class="mt-4 text-lg text-gray-600 leading-relaxed">
          Tell us what you want to fund and what records your organization
          needs. Use the contact preference below to tell ADA how you would like
          to be contacted; this is a request, not a scheduled call.
        </p>
        <p class="mt-4 text-sm text-gray-500">
          Cameroon-registered NGO ({REGISTRATION_NUMBER}) · Receipts for records
          · Project reports available · Recognition or anonymity by preference ·
          Bilingual English/French reporting
        </p>
      </div>
    </div>
  </section>

  <Section background="gray" padding="lg">
    <div
      class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-[0.78fr_1.22fr] gap-8 items-start"
    >
      <aside class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
        <h2 class="text-lg font-heading font-bold text-gray-900">
          Before you submit
        </h2>
        <ul class="mt-4 space-y-3 text-sm text-gray-600 leading-relaxed">
          <li>
            Do not send bank details, card details, tax IDs, or sensitive
            documents through this form.
          </li>
          <li>
            For restricted gifts or non-card payment paths, inquire before
            payment so ADA can confirm purpose and reporting.
          </li>
          <li>Most sponsors can complete this form in under 3 minutes.</li>
        </ul>
        <div class="mt-5 flex flex-col gap-2">
          <a
            href="/docs/diligence/ada-sponsor-readiness-packet.pdf"
            target="_blank"
            rel="noopener"
            class="text-sm font-semibold text-primary-700 hover:underline"
          >
            Open sponsor packet
          </a>
          <a
            href="/resources#due-diligence"
            class="text-sm font-semibold text-primary-700 hover:underline"
          >
            Review diligence documents
          </a>
        </div>
      </aside>

      <form
        id="sponsor-inquiry-form"
        class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm md:p-6"
        novalidate
      >
        <div id="form-status" class="sr-only" role="status" aria-live="polite">
        </div>
        <div
          id="form-error-summary"
          class="hidden rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700"
          role="alert"
          tabindex="-1"
        >
        </div>

        <fieldset class="space-y-4">
          <legend class="text-base font-semibold text-gray-900"
            >Contact details</legend
          >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label
                for="name"
                class="block text-sm font-medium text-gray-700 mb-1"
                >Full name *</label
              >
              <input
                id="name"
                name="name"
                required
                autocomplete="name"
                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
              />
            </div>
            <div>
              <label
                for="email"
                class="block text-sm font-medium text-gray-700 mb-1"
                >Email address *</label
              >
              <input
                id="email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
              />
            </div>
            <div id="organization-field">
              <label
                for="organization"
                class="block text-sm font-medium text-gray-700 mb-1"
                >Organization or group name</label
              >
              <input
                id="organization"
                name="organization"
                required
                aria-required="true"
                autocomplete="organization"
                aria-describedby="organization-help"
                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
              />
              <p id="organization-help" class="mt-1 text-xs text-gray-600">
                Required for organizations and groups; optional for individuals.
              </p>
            </div>
            <div>
              <label
                for="country"
                class="block text-sm font-medium text-gray-700 mb-1"
                >Country *</label
              >
              <input
                id="country"
                name="country"
                required
                autocomplete="country-name"
                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
              />
            </div>
            <div class="sm:col-span-2">
              <label
                for="phone"
                class="block text-sm font-medium text-gray-700 mb-1"
                >Phone or WhatsApp</label
              >
              <input
                id="phone"
                name="phone"
                type="tel"
                autocomplete="tel"
                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
              />
            </div>
          </div>
        </fieldset>

        <fieldset class="mt-7 space-y-4">
          <legend class="text-base font-semibold text-gray-900"
            >Sponsorship fit</legend
          >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label
                for="sponsorType"
                class="block text-sm font-medium text-gray-700 mb-1"
                >Sponsor type *</label
              >
              <select
                id="sponsorType"
                name="sponsorType"
                required
                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
              >
                <option value="">Select one</option>
                {
                  sponsorTypes.map((option) => (
                    <option value={option}>{option}</option>
                  ))
                }
              </select>
            </div>
            <div>
              <label
                for="interest"
                class="block text-sm font-medium text-gray-700 mb-1"
                >Sponsorship interest *</label
              >
              <select
                id="interest"
                name="interest"
                required
                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
              >
                <option value="">Select one</option>
                {
                  interests.map((option) => (
                    <option value={option}>{option}</option>
                  ))
                }
              </select>
            </div>
            <div>
              <label
                for="budgetRange"
                class="block text-sm font-medium text-gray-700 mb-1"
                >Estimated sponsorship range (optional)</label
              >
              <select
                id="budgetRange"
                name="budgetRange"
                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
              >
                <option value="">Prefer not to say</option>
                {
                  budgetRanges.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))
                }
              </select>
              <p class="mt-1 text-xs text-gray-500">
                Amounts are in USD. You can leave this blank.
              </p>
            </div>
            <div>
              <label
                for="preferredTiming"
                class="block text-sm font-medium text-gray-700 mb-1"
                >Preferred timing (optional)</label
              >
              <select
                id="preferredTiming"
                name="preferredTiming"
                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
              >
                <option value="">Select if known</option>
                {
                  timings.map((option) => (
                    <option value={option}>{option}</option>
                  ))
                }
              </select>
            </div>
            <div>
              <label
                for="recognitionPreference"
                class="block text-sm font-medium text-gray-700 mb-1"
                >Recognition preference (optional)</label
              >
              <select
                id="recognitionPreference"
                name="recognitionPreference"
                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
              >
                <option value="">Select if known</option>
                {
                  recognitionOptions.map((option) => (
                    <option value={option}>{option}</option>
                  ))
                }
              </select>
              <p class="mt-1 text-xs text-gray-500">
                ADA will not publish your name, logo, photos, or sponsorship
                details without approval.
              </p>
            </div>
            <div>
              <label
                for="callPreference"
                class="block text-sm font-medium text-gray-700 mb-1"
                >Contact preference (optional)</label
              >
              <select
                id="callPreference"
                name="callPreference"
                class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
              >
                <option value="">Select if known</option>
                {
                  callPreferences.map((option) => (
                    <option value={option}>{option}</option>
                  ))
                }
              </select>
            </div>
          </div>
        </fieldset>

        <fieldset class="mt-7 space-y-4">
          <legend class="text-base font-semibold text-gray-900"
            >Records and next step</legend
          >
          <div>
            <label
              for="fundingPurpose"
              class="block text-sm font-medium text-gray-700 mb-1"
              >What would you like to fund? *</label
            >
            <textarea
              id="fundingPurpose"
              name="fundingPurpose"
              rows="4"
              required
              minlength="10"
              maxlength="1000"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
            ></textarea>
          </div>
          <div>
            <p class="text-sm font-medium text-gray-700">
              Reporting or due-diligence needs
            </p>
            <p class="mt-1 text-xs text-gray-500">
              We match reporting to the sponsorship size and agreement.
            </p>
            <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 gap-2">
              {
                reportingNeeds.map((option) => (
                  <label class="flex gap-2 text-sm text-gray-700">
                    <input
                      type="checkbox"
                      name="reportingNeeds"
                      value={option}
                      class="mt-1 rounded border-gray-300 text-primary-600 focus:ring-primary-500"
                    />
                    <span>{option}</span>
                  </label>
                ))
              }
            </div>
          </div>
          <label class="flex gap-2 text-sm text-gray-700">
            <input
              type="checkbox"
              name="invoiceOrWire"
              value="true"
              class="mt-1 rounded border-gray-300 text-primary-600 focus:ring-primary-500"
            />
            <span
              >We may need an invoice, sponsorship agreement, bank/wire, or
              direct-transfer path.</span
            >
          </label>
          <div>
            <label
              for="notes"
              class="block text-sm font-medium text-gray-700 mb-1"
              >Anything else ADA should know?</label
            >
            <textarea
              id="notes"
              name="notes"
              rows="3"
              maxlength="1000"
              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-primary-500 focus:ring-2 focus:ring-primary-500"
            ></textarea>
          </div>
        </fieldset>

        <div class="hidden" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <p class="mt-5 text-xs text-gray-500">
          We use this information only to respond to your sponsorship inquiry.
          Do not send bank details or sensitive documents through this form.
        </p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center">
          <button
            id="sponsor-submit"
            type="submit"
            class="inline-flex w-full justify-center px-5 py-3 text-sm font-semibold text-white bg-primary-700 rounded-lg hover:bg-primary-800 transition-colors disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
          >
            Submit sponsor inquiry
          </button>
          <a
            href="/docs/diligence/ada-sponsor-readiness-packet.pdf"
            target="_blank"
            rel="noopener"
            class="inline-flex w-full justify-center px-5 py-3 text-sm font-semibold text-primary-700 bg-primary-50 rounded-lg hover:bg-primary-100 transition-colors sm:w-auto"
          >
            Download sponsor packet
          </a>
        </div>
      </form>
    </div>
  </Section>
</PageLayout>

<script>
  const form = document.getElementById(
    "sponsor-inquiry-form",
  ) as HTMLFormElement | null;
  const submitButton = document.getElementById(
    "sponsor-submit",
  ) as HTMLButtonElement | null;
  const status = document.getElementById("form-status");
  const errorSummary = document.getElementById("form-error-summary");
  const sponsorTypeSelect = document.getElementById(
    "sponsorType",
  ) as HTMLSelectElement | null;
  const organizationInput = document.getElementById(
    "organization",
  ) as HTMLInputElement | null;
  const organizationField = document.getElementById("organization-field");
  const budgetRangeSelect = document.getElementById(
    "budgetRange",
  ) as HTMLSelectElement | null;

  const requestedBudgetRange = new URLSearchParams(window.location.search).get(
    "budgetRange",
  );
  if (
    budgetRangeSelect &&
    requestedBudgetRange &&
    Array.from(budgetRangeSelect.options).some(
      (option) => option.value === requestedBudgetRange,
    )
  ) {
    budgetRangeSelect.value = requestedBudgetRange;
  }

  function syncOrganizationRequirement() {
    if (!sponsorTypeSelect || !organizationInput || !organizationField) return;
    const isIndividual = sponsorTypeSelect.value === "Individual";
    organizationField.hidden = isIndividual;
    organizationInput.required = !isIndividual;
    organizationInput.setAttribute("aria-required", String(!isIndividual));
    if (isIndividual) {
      organizationInput.value = "";
      organizationInput.removeAttribute("aria-invalid");
    }
  }

  sponsorTypeSelect?.addEventListener("change", syncOrganizationRequirement);
  syncOrganizationRequirement();

  function setError(message: string) {
    if (!errorSummary) return;
    errorSummary.textContent = message;
    errorSummary.classList.remove("hidden");
    errorSummary.focus();
  }

  function clearError() {
    if (!errorSummary) return;
    errorSummary.textContent = "";
    errorSummary.classList.add("hidden");
  }

  function updateFieldErrorDescription(field: Element, invalid: boolean) {
    const describedBy = new Set(
      (field.getAttribute("aria-describedby") || "")
        .split(/\s+/)
        .filter(Boolean),
    );
    if (invalid) describedBy.add("form-error-summary");
    else describedBy.delete("form-error-summary");
    if (describedBy.size) {
      field.setAttribute("aria-describedby", [...describedBy].join(" "));
    } else {
      field.removeAttribute("aria-describedby");
    }
  }

  form?.addEventListener("input", (event) => {
    const field = event.target;
    if (
      field instanceof HTMLInputElement ||
      field instanceof HTMLTextAreaElement
    ) {
      if (field.checkValidity()) {
        field.removeAttribute("aria-invalid");
        updateFieldErrorDescription(field, false);
      }
    }
  });

  form?.addEventListener("change", (event) => {
    const field = event.target;
    if (field instanceof HTMLSelectElement && field.checkValidity()) {
      field.removeAttribute("aria-invalid");
      updateFieldErrorDescription(field, false);
    }
  });

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    clearError();

    if (!form.checkValidity()) {
      form.querySelectorAll(":invalid").forEach((field) => {
        field.setAttribute("aria-invalid", "true");
        updateFieldErrorDescription(field, true);
      });
      form.reportValidity();
      setError("Please complete the required fields before submitting.");
      return;
    }

    const data = new FormData(form);
    const payload = {
      website: String(data.get("website") || ""),
      name: String(data.get("name") || ""),
      email: String(data.get("email") || ""),
      phone: String(data.get("phone") || ""),
      organization: String(data.get("organization") || ""),
      country: String(data.get("country") || ""),
      sponsorType: String(data.get("sponsorType") || ""),
      interest: String(data.get("interest") || ""),
      budgetRange: String(data.get("budgetRange") || ""),
      preferredTiming: String(data.get("preferredTiming") || ""),
      recognitionPreference: String(data.get("recognitionPreference") || ""),
      fundingPurpose: String(data.get("fundingPurpose") || ""),
      reportingNeeds: data.getAll("reportingNeeds").map(String),
      invoiceOrWire: data.get("invoiceOrWire") === "true",
      callPreference: String(data.get("callPreference") || ""),
      notes: String(data.get("notes") || ""),
    };

    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = "Submitting...";
    }

    try {
      const response = await fetch("/api/sponsor-inquiry", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      if (!response.ok) throw new Error("Submission failed");

      form.reset();
      syncOrganizationRequirement();
      form.querySelectorAll('[aria-invalid="true"]').forEach((field) => {
        field.removeAttribute("aria-invalid");
        updateFieldErrorDescription(field, false);
      });
      if (status) {
        status.className =
          "mt-4 rounded-lg border border-green-200 bg-green-50 p-3 text-sm font-medium text-green-700";
        status.textContent =
          "Your inquiry was sent to ADA. For anything else, contact info@apotidev.org.";
        status.setAttribute("tabindex", "-1");
        status.focus();
      }
      if (submitButton) submitButton.textContent = "Inquiry submitted";
    } catch {
      setError(
        "We could not submit the inquiry. Please try again or email info@apotidev.org directly.",
      );
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = "Submit sponsor inquiry";
      }
    }
  });
</script>
