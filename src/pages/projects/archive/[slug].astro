---
import ArchiveProjectDetail from "../../../components/projects/ArchiveProjectDetail.astro";
import { loadProjectArchiveEntries } from "../../../lib/project-archive";

export async function getStaticPaths() {
  const records = await loadProjectArchiveEntries();
  return records.map(record => ({ params: { slug: record.slug.current }, props: { record } }));
}

const { record } = Astro.props;
---

<ArchiveProjectDetail record={record} locale="en" />
