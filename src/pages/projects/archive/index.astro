---
import PageLayout from "../../../layouts/PageLayout.astro";
import PageHero from "../../../components/layout/PageHero.astro";
import Section from "../../../components/layout/Section.astro";
import {
  countProjectsUnderFinancialReview,
  countOwnerMarkedCompletions,
  loadProjectArchiveEntries,
} from "../../../lib/project-archive";
import { sanityImageUrl } from "../../../lib/sanity";
import { resolveHeroImage } from "../../../lib/hero-images";

const records = await loadProjectArchiveEntries();
const heroImage = await resolveHeroImage([
  "education-orphans",
  "widow-support",
]);

const archiveItems = records.map((r) => ({
  ...r,
  thumbUrl: r.photo?.asset?._ref ? sanityImageUrl(r.photo.asset._ref, 240) : "",
  thumbAlt: r.photo?.alt || r.title,
}));

const demographics = [
  "all",
  "widows",
  "orphans",
  "young-women",
  "pregnant-women",
  "idps",
  "community",
];
const demoLabels: Record<string, string> = {
  all: "All",
  widows: "Widows",
  orphans: "Orphans",
  "young-women": "Young Women",
  "pregnant-women": "Pregnant Women",
  idps: "IDPs",
  community: "Community",
};
const statusColors: Record<string, string> = {
  completed: "text-green-600",
  ongoing: "text-yellow-600",
  planned: "text-gray-400",
};

// Stats
const totalBeneficiaries = archiveItems.reduce(
  (sum, r) => sum + (r.beneficiaries || 0),
  0,
);
const totalBudget = archiveItems.reduce((sum, r) => sum + (r.budget || 0), 0);
const financeReviewCount = countProjectsUnderFinancialReview(archiveItems);
const completedCount = countOwnerMarkedCompletions(archiveItems);
const years = [...new Set(archiveItems.map((r) => r.year))].sort(
  (a, b) => b - a,
);

// Group by year
const byYear: Record<number, typeof archiveItems> = {};
for (const r of archiveItems) {
  if (!byYear[r.year]) byYear[r.year] = [];
  byYear[r.year].push(r);
}
---

<!-- Hallmark · genre: editorial · macrostructure: Long Document · design-system: design.md · designed-as-app -->
<PageLayout
  title="Archive of Project Records"
  description="Browse ADA's archive of project records."
>
  <PageHero
    title="Archive of Project Records"
    subtitle="Browse archive entries by demographic or explore the timeline."
    compact
    imageUrl={heroImage?.imageUrl}
    imageAlt={heroImage?.imageAlt}
  />

  <!-- Back to projects -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <a
      href="/projects"
      class="inline-flex items-center text-sm text-primary-600 hover:text-primary-700 transition-colors"
      >← Back to Current Projects</a
    >
  </div>

  <!-- Stats Bar -->
  <Section background="white" padding="sm">
    <div
      class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-4 border-y border-gray-200 py-6"
    >
      <div>
        <p class="text-2xl font-bold text-primary-700 tabular-nums">
          {totalBeneficiaries.toLocaleString()}
        </p>
        <p class="text-xs text-gray-500 uppercase tracking-wider">
          Reported beneficiary counts
        </p>
        <p class="mt-1 text-xs text-gray-500">
          Sum of per-record counts; a person may appear in multiple projects.
        </p>
      </div>
      <div>
        <p class="text-2xl font-bold text-primary-700 tabular-nums">
          {archiveItems.length}
        </p>
        <p class="text-xs text-gray-500 uppercase tracking-wider">
          Archive records
        </p>
      </div>
      <div>
        <p class="text-2xl font-bold text-primary-700 tabular-nums">
          ${totalBudget.toLocaleString()}
        </p>
        <p class="text-xs text-gray-500 uppercase tracking-wider">
          Listed budget/goal fields (USD)
        </p>
        <p class="mt-1 text-xs text-gray-500">
          Sum of displayed USD budget/goal fields; not a verified expenditure total. {financeReviewCount} project records are excluded while their financial details are reviewed.
        </p>
      </div>
      <div>
        <p class="text-2xl font-bold text-primary-700 tabular-nums">
          {completedCount}/{archiveItems.length}
        </p>
        <p class="text-xs text-gray-500 uppercase tracking-wider">
          Marked completed
        </p>
      </div>
    </div>
  </Section>

  <!-- Demographic Tabs -->
  <Section background="gray" padding="lg">
    <div class="max-w-5xl mx-auto">
      <!-- Tabs -->
      <div
        class="flex flex-wrap gap-2 mb-8 justify-center"
        id="demo-tabs"
        role="group"
        aria-label="Filter by demographic"
      >
        {
          demographics.map((d) => (
            <button
              type="button"
              aria-pressed={d === "all" ? "true" : "false"}
              data-demo={d}
              class:list={[
                "px-4 py-2 text-sm font-medium rounded-md transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-700 focus-visible:ring-offset-2",
                d === "all"
                  ? "bg-primary-600 text-white"
                  : "bg-white text-gray-700 border border-gray-200 hover:border-primary-300 hover:text-primary-700",
              ]}
            >
              {demoLabels[d]}
              <span class="ml-1 text-xs opacity-70">
                (
                {d === "all"
                  ? archiveItems.length
                  : archiveItems.filter((r) => r.demographic === d).length}
                )
              </span>
            </button>
          ))
        }
      </div>
      <p
        id="filter-result-count"
        class="sr-only"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        {archiveItems.length} archive entries shown
      </p>
      <p
        id="filter-no-results"
        class="hidden text-center text-sm text-gray-600"
        aria-live="polite"
      >
        No projects match this group.
      </p>

      <!-- Timeline -->
      <div class="relative">
        <div
          class="absolute left-4 md:left-8 top-0 bottom-0 w-0.5 bg-primary-200"
          aria-hidden="true"
        >
        </div>

        {
          years.map((year) => (
            <div class="mb-8" data-year-group={year}>
              <div class="relative flex items-center mb-4">
                <div class="px-3 py-1 rounded-md border border-primary-600 bg-white flex items-center justify-center z-10">
                  <h2 class="text-primary-700 font-bold text-xs md:text-sm tabular-nums">
                    {year}
                  </h2>
                </div>
                <div class="ml-3 h-px flex-1 bg-primary-100" />
              </div>

              <div class="ml-12 md:ml-24 space-y-3">
                {byYear[year].map((r) => (
                  <a
                    href={r.href || `/projects/archive/${r.slug.current}`}
                    class="group archive-item block p-4 bg-white rounded-md border border-gray-100 hover:border-primary-200 transition-all duration-200"
                    data-demo={r.demographic}
                  >
                    <div class="flex items-start gap-3">
                      {r.thumbUrl ? (
                        <img
                          src={r.thumbUrl}
                          alt={r.thumbAlt}
                          class="w-16 h-16 rounded-lg object-cover flex-shrink-0"
                          loading="lazy"
                        />
                      ) : (
                        <div class="w-16 h-16 rounded-lg bg-primary-50 flex-shrink-0" />
                      )}
                      <div class="flex-1 min-w-0 flex items-start justify-between gap-3">
                        <div class="flex-1 min-w-0">
                          <div class="flex items-center gap-2 mb-1">
                            <h3 class="text-sm font-semibold text-gray-900 group-hover:text-primary-700 transition-colors truncate">
                              {r.title}
                            </h3>
                          </div>
                          <div class="flex flex-wrap items-center gap-2 text-xs text-gray-500">
                            <span class="px-2 py-0.5 bg-primary-50 text-primary-700 rounded-md font-medium">
                              {demoLabels[r.demographic]}
                            </span>
                            {r.beneficiaries && (
                              <span>
                                {r.beneficiaries.toLocaleString()} beneficiaries
                              </span>
                            )}
                            {r.location && <span>{r.location}</span>}
                            {r.hasToR && (
                              <span class="text-primary-600">ToR</span>
                            )}
                            {r.hasReport && (
                              <span class="text-primary-600">Report</span>
                            )}
                          </div>
                        </div>
                        <div class="text-right flex-shrink-0">
                          {r.budget && (
                            <p class="text-sm font-semibold text-gray-900">
                              ${r.budget.toLocaleString()}
                            </p>
                          )}
                          {r.financialReviewNote && !r.budget && (
                            <p class="mt-2 text-xs text-amber-800">Financial figures under review</p>
                          )}
                          <p
                            class:list={[
                              "text-xs capitalize",
                              r.autoArchived
                                ? "text-gray-500"
                                : r.status === "completed"
                                  ? "text-green-600"
                                  : r.status === "ongoing"
                                    ? "text-yellow-600"
                                    : "text-gray-400",
                            ]}
                          >
                            {r.autoArchived ? "Archived by end date" : r.status}
                          </p>
                        </div>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Section>
</PageLayout>

<script>
  const tabs = document.querySelectorAll("#demo-tabs button");
  const items = document.querySelectorAll(".archive-item");
  const yearGroups = document.querySelectorAll("[data-year-group]");
  const resultCount = document.getElementById("filter-result-count");
  const noResults = document.getElementById("filter-no-results");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const demo = tab.getAttribute("data-demo");

      // Update tab styles
      tabs.forEach((t) => {
        t.classList.remove("bg-primary-600", "text-white");
        t.classList.add(
          "bg-white",
          "text-gray-700",
          "border",
          "border-gray-200",
        );
        t.setAttribute("aria-pressed", "false");
      });
      tab.classList.remove(
        "bg-white",
        "text-gray-700",
        "border",
        "border-gray-200",
      );
      tab.classList.add("bg-primary-600", "text-white");
      tab.setAttribute("aria-pressed", "true");

      // Filter items
      let visibleCount = 0;
      items.forEach((item) => {
        const el = item as HTMLElement;
        if (demo === "all" || el.dataset.demo === demo) {
          el.style.display = "";
          visibleCount += 1;
        } else {
          el.style.display = "none";
        }
      });

      if (resultCount) {
        resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? "archive entry" : "archive entries"} shown`;
      }
      noResults?.classList.toggle("hidden", visibleCount > 0);

      // Hide empty year groups
      yearGroups.forEach((group) => {
        const el = group as HTMLElement;
        const visibleItems = el.querySelectorAll(
          '.archive-item:not([style*="display: none"])',
        );
        el.style.display = visibleItems.length > 0 ? "" : "none";
      });
    });
  });
</script>
