---
import PageLayout from "../../../layouts/PageLayout.astro";
import { archiveProjectDisplayTitle } from "../../../lib/archive-project-display-title";
import { getEligibleArchiveFeaturePhoto } from "../../../lib/archive-eligible-feature-photo";
import PageHero from "../../../components/layout/PageHero.astro";
import Section from "../../../components/layout/Section.astro";
import {
  countOwnerMarkedCompletions,
  formatArchiveCardMonth,
  loadProjectArchiveEntries,
} from "../../../lib/project-archive";
import ArchiveCardStatuses from "../../../components/projects/ArchiveCardStatuses.astro";
import { archiveExchangePegSource, archiveExchangeRateSource, formatArchiveCardFinances } from "../../../lib/archive-card-finances";
import { getArchiveCardStatus } from "../../../lib/archive-card-status";
import { getArchiveOutreachCategory, getArchiveOutreachFilters } from "../../../lib/archive-outreach-categories";
import { resolveHeroImage } from "../../../lib/hero-images";

const records = await loadProjectArchiveEntries();
const heroImage = await resolveHeroImage([

  "widow-support",
]);

const archiveItems = records.map((r) => ({
  ...r,
  archiveCategory: getArchiveOutreachCategory(r.slug.current, r.outreachCategory),
  archiveMonth: formatArchiveCardMonth(r, "en"),
  cardStatus: getArchiveCardStatus(r, "en"),
  localFinance: formatArchiveCardFinances(r, "en"),
  featurePhoto: getEligibleArchiveFeaturePhoto(r, "en", 240),
}));

const outreachFilters = getArchiveOutreachFilters(archiveItems, "en");
const audienceLabels: Record<string, string> = {
  widows: "Widows",
  orphans: "Orphans",
  "young-women": "Young Women",
  "pregnant-women": "Pregnant Women",
  idps: "IDPs",
  community: "Community",
};

// Stats
const totalBeneficiaries = archiveItems.reduce(
  (sum, r) => sum + (r.beneficiaries || 0),
  0,
);
const completedCount = countOwnerMarkedCompletions(archiveItems);
const years = [...new Set(archiveItems.map((r) => r.year))].sort(
  (a, b) => b - a,
);

// Group by year
const byYear: Record<number, typeof archiveItems> = {};
for (const r of archiveItems) {
  if (!byYear[r.year]) byYear[r.year] = [];
  byYear[r.year].push(r);
}
---

<!-- Hallmark · genre: editorial · macrostructure: Long Document · design-system: design.md · designed-as-app -->
<PageLayout
  title="Archive of Project Records"
  description="Browse ADA's archive of project records."
>
  <PageHero
    title="Archive of Project Records"
    subtitle="Browse archive entries by outreach category or explore the timeline."
    compact
    imageUrl={heroImage?.imageUrl}
    imageAlt={heroImage?.imageAlt}
  />

  <!-- Back to projects -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4">
    <a
      href="/projects"
      class="inline-flex items-center text-sm text-primary-600 hover:text-primary-700 transition-colors"
      >← Back to Current Projects</a
    >
  </div>

  <!-- Stats Bar -->
  <Section background="white" padding="sm">
    <div
      class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-5 border-y border-gray-200 py-6"
    >
      <div>
        <p class="text-2xl font-bold text-primary-700 tabular-nums">
          {archiveItems.length.toLocaleString("en")}
        </p>
        <p class="text-xs text-gray-500 uppercase tracking-wider">
          Outreach records
        </p>
      </div>
      <div>
        <p class="text-2xl font-bold text-primary-700 tabular-nums">
          {completedCount.toLocaleString("en")} of {archiveItems.length.toLocaleString("en")}
        </p>
        <p class="text-xs text-gray-500 uppercase tracking-wider">
          Marked complete
        </p>
      </div>
      <div class="col-span-2 sm:col-span-1">
        <p class="text-2xl font-bold text-primary-700 tabular-nums">
          {totalBeneficiaries.toLocaleString("en")}
        </p>
        <p class="text-xs text-gray-500 uppercase tracking-wider">
          Reported participants across outreaches
        </p>
        <p class="mt-1 text-xs text-gray-500">
          People who took part in more than one outreach may be counted more than once.
        </p>
      </div>
    </div>
    <p class="mt-4 text-center text-xs text-gray-500">Approximate USD equivalents alongside FCFA amounts use the <a class="underline" href={archiveExchangeRateSource}>U.S. Federal Reserve monthly average</a> for the project month and the <a class="underline" href={archiveExchangePegSource}>BEAC euro peg</a>. They are not amounts paid in USD.</p>
  </Section>

  <!-- Outreach category filters -->
  <Section background="gray" padding="lg">
    <div class="max-w-5xl mx-auto">
      <div
        class="flex flex-wrap gap-2 mb-8 justify-center"
        id="archive-category-filters"
        role="group"
        aria-label="Filter archive by outreach category"
      >
        {
          outreachFilters.map(({ id, label, count }) => (
            <button
              type="button"
              aria-pressed={id === "all" ? "true" : "false"}
              data-archive-category={id}
              class:list={[
                "px-4 py-2 text-sm font-medium rounded-md transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-700 focus-visible:ring-offset-2",
                id === "all"
                  ? "bg-primary-600 text-white"
                  : "bg-white text-gray-700 border border-gray-200 hover:border-primary-300 hover:text-primary-700",
              ]}
            >
              {label}
              <span class="ml-1 text-xs opacity-70">
                ({count})
              </span>
            </button>
          ))
        }
      </div>
      <p
        id="filter-result-count"
        class="sr-only"
        role="status"
        aria-live="polite"
        aria-atomic="true"
      >
        {archiveItems.length} archive entries shown
      </p>
      <p
        id="filter-no-results"
        class="hidden text-center text-sm text-gray-600"
        aria-live="polite"
      >
        No projects match this category.
      </p>

      <!-- Timeline -->
      <div class="relative">
        <div
          class="absolute left-4 md:left-8 top-0 bottom-0 w-0.5 bg-primary-200"
          aria-hidden="true"
        >
        </div>

        {
          years.map((year) => (
            <div class="mb-8" data-year-group={year}>
              <div class="relative flex items-center mb-4">
                <div class="px-3 py-1 rounded-md border border-primary-600 bg-white flex items-center justify-center z-10">
                  <h2 class="text-primary-700 font-bold text-xs md:text-sm tabular-nums">
                    {year}
                  </h2>
                </div>
                <div class="ml-3 h-px flex-1 bg-primary-100" />
              </div>

              <div class="ml-4 sm:ml-12 md:ml-24 space-y-3">
                {byYear[year].map((r) => (
                  <a
                    href={r.href || `/projects/archive/${r.slug.current}`}
                    class="group archive-item block p-3 sm:p-4 bg-white rounded-md border border-gray-100 hover:border-primary-200 transition-all duration-200"
                    data-archive-category={r.archiveCategory ?? ""}
                  >
                    <div class="flex items-start gap-3">
                      {r.featurePhoto ? (
                        <img
                          src={r.featurePhoto.src}
                          alt={r.featurePhoto.alt}
                          width={r.featurePhoto.width}
                          height={r.featurePhoto.height}
                          class="h-auto w-14 flex-shrink-0 rounded-md sm:w-16"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <div class="w-16 h-16 rounded-lg bg-primary-50 flex-shrink-0" />
                      )}
                      <div class="flex-1 min-w-0 grid gap-2 md:grid-cols-[minmax(0,1fr)_minmax(0,0.9fr)] md:gap-4">
                        <div class="flex-1 min-w-0">
                          <div class="flex items-center gap-2 mb-1">
                            <h3 class="text-sm font-semibold text-gray-900 group-hover:text-primary-700 transition-colors break-words">
                              {archiveProjectDisplayTitle(r, "en")}
                            </h3>
                          </div>
                          <div class="flex flex-wrap items-center gap-2 text-xs text-gray-500">
                            <span data-archive-month={r.archiveMonth ?? ""} class="font-medium text-gray-700">{r.archiveMonth ?? "Month not recorded"}</span>
                            <span class="px-2 py-0.5 bg-primary-50 text-primary-700 rounded-md font-medium">
                              {audienceLabels[r.demographic]}
                            </span>
                            {r.beneficiaries && (
                              <span>
                                {r.beneficiaries.toLocaleString()} beneficiaries
                              </span>
                            )}
                            {r.location && <span>{r.location}</span>}
                          </div>
                        </div>
                        <ArchiveCardStatuses status={r.cardStatus} budget={r.budget} localFinance={r.localFinance} locale="en" />
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </Section>
</PageLayout>

<script>
  const buttons = document.querySelectorAll("#archive-category-filters button");
  const items = document.querySelectorAll(".archive-item");
  const yearGroups = document.querySelectorAll("[data-year-group]");
  const resultCount = document.getElementById("filter-result-count");
  const noResults = document.getElementById("filter-no-results");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const category = button.getAttribute("data-archive-category");

      // Update filter styles
      buttons.forEach((t) => {
        t.classList.remove("bg-primary-600", "text-white");
        t.classList.add(
          "bg-white",
          "text-gray-700",
          "border",
          "border-gray-200",
        );
        t.setAttribute("aria-pressed", "false");
      });
      button.classList.remove(
        "bg-white",
        "text-gray-700",
        "border",
        "border-gray-200",
      );
      button.classList.add("bg-primary-600", "text-white");
      button.setAttribute("aria-pressed", "true");

      // Filter items
      let visibleCount = 0;
      items.forEach((item) => {
        const el = item as HTMLElement;
        if (category === "all" || el.dataset.archiveCategory === category) {
          el.style.display = "";
          visibleCount += 1;
        } else {
          el.style.display = "none";
        }
      });

      if (resultCount) {
        resultCount.textContent = `${visibleCount} ${visibleCount === 1 ? "archive entry" : "archive entries"} shown`;
      }
      noResults?.classList.toggle("hidden", visibleCount > 0);

      // Hide empty year groups
      yearGroups.forEach((group) => {
        const el = group as HTMLElement;
        const visibleItems = el.querySelectorAll(
          '.archive-item:not([style*="display: none"])',
        );
        el.style.display = visibleItems.length > 0 ? "" : "none";
      });
    });
  });
</script>
