---
import { getEditorialHeroPhoto } from "../../data/editorial-hero-photos";
import { REGISTRATION_NUMBER } from "../../data/organization";
import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../../components/layout/PageHero.astro";
import Section from "../../components/layout/Section.astro";
import CalledToServe from "../../components/about/CalledToServe.astro";

const locale = "fr";
const archivePath = "/fr/projects/archive";
const missionStatement = "Ancrés dans la foi chrétienne, nous apportons un soutien concret aux femmes et aux adolescentes au Cameroun, en particulier aux veuves et aux mères. Nous accueillons les personnes de toutes convictions, religieuses ou non. La participation à la prière n’est jamais une condition pour recevoir de l’aide.";
const storyParagraphs = [
  "Lionel Tchami Nfada a fondé Apoti Development Association en 2021. En novembre de la même année, notre équipe a apporté des denrées à des veuves de Buea et a pris le temps de les écouter et de prier avec celles qui le souhaitaient.",
  "Depuis, nous travaillons avec des équipes locales pour répondre à des besoins concrets. Aujourd’hui, nous accordons la priorité aux femmes et aux adolescentes. Nos archives gardent aussi la trace de nos actions communautaires antérieures.",
];
const coreValues = [
  { title: "Foi et compassion", desc: "Notre foi chrétienne nous inspire à servir avec attention et humilité." },
  { title: "Dignité et respect", desc: "Nous écoutons les femmes et les adolescentes, respectons leurs choix et protégeons leur vie privée." },
  { title: "Partenariats locaux", desc: "Nous collaborons avec des personnes et des organisations qui connaissent bien leurs communautés." },
  { title: "Transparence", desc: "Nous rendons compte de nos actions, de l’utilisation des fonds et des résultats que nous pouvons vérifier." },
];
const programs = [
  { title: "Soutien aux veuves", desc: "Une aide alimentaire et pratique qui tient compte des besoins exprimés par les veuves.", slug: "widow-support-food-cash-mar-2022" },
  { title: "Dignité des adolescentes", desc: "Une sensibilisation à la santé menstruelle et des fournitures utiles pour les adolescentes.", slug: "girls-dignity-menstrual-health-bamenda-jun-2026" },
  { title: "Soutien aux mères", desc: "Une action achevée à Muea a permis de remettre aux mères des articles essentiels pour elles et leurs nouveau-nés.", slug: "prenatal-care-support-program" },
];
const timeline = [
  { year: "2021", event: "Lionel Tchami Nfada fonde ADA. L’équipe effectue ses premières visites à domicile auprès de veuves à Buea." },
  { year: "2023", event: "Fournitures scolaires à Buea." },
  { year: "2024", event: "Notre première action de rentrée scolaire à Bamenda." },
  { year: "2026", event: "Action pour la dignité et la santé menstruelle des filles à Bamenda." },
];
---

<!-- Hallmark · genre: editorial · macrostructure: Long Document · design-system: design.md · designed-as-app -->
<PageLayout title="À propos" description="Découvrez Apoti Development Association, une association chrétienne qui soutient les femmes et les adolescentes au Cameroun, notamment les veuves et les mères.">
  <PageHero
    title="À propos"
    subtitle="Un soutien concret aux femmes et aux adolescentes au Cameroun."
    photo={getEditorialHeroPhoto("about", locale)}
  />

  <!-- Mission -->
  <Section background="white" padding="lg">
    <div class="max-w-3xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Notre mission
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Faire briller la lumière de Jésus-Christ par une aide concrète
      </h2>
      <p class="mt-6 text-lg text-gray-600 leading-relaxed">{missionStatement}</p>
    </div>
    <p class="mt-6 text-sm text-gray-600 max-w-3xl">
      Association sans but lucratif enregistrée au Cameroun · {REGISTRATION_NUMBER}
    </p>
  </Section>

  <CalledToServe locale={locale}>
    {storyParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    <a href="/fr/team/" class="inline-flex mt-2 font-semibold text-primary-700 underline underline-offset-4">Rencontrer notre équipe</a>
  </CalledToServe>

  <!-- Valeurs -->
  <Section background="gray" padding="lg">
    <div class="max-w-3xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Ce qui nous guide
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Nos Valeurs
      </h2>
    </div>
    <ul class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-0 border-t border-gray-200 max-w-4xl">
      {coreValues.map((v) => (
        <li class="border-b border-gray-200 py-5">
          <h3 class="font-heading text-lg font-semibold text-gray-900">{v.title}</h3>
          <p class="mt-1 text-sm text-gray-600 leading-relaxed">{v.desc}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- Programmes (liés aux pages projets) -->
  <Section background="white" padding="lg">
    <div class="max-w-3xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Comment nous servons
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Nos Programmes
      </h2>
      <p class="mt-4 text-lg text-gray-600 leading-relaxed">
        Découvrez nos actions à travers les comptes rendus. Chaque exemple présente une action que nous avons menée.
      </p>
    </div>
    <ul class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-0 border-t border-gray-200 max-w-4xl">
      {programs.map((program) => (
        <li class="border-b border-gray-200">
          <a href={`${archivePath}/${program.slug}/`} class="group flex items-baseline justify-between gap-4 py-5">
            <div>
              <h3 class="font-heading text-lg font-semibold text-gray-900 group-hover:text-primary-700 transition-colors">
                {program.title}
              </h3>
              <p class="mt-1 text-sm text-gray-600 leading-relaxed">{program.desc}</p>
              <span class="mt-2 inline-block text-sm font-semibold text-primary-700 underline underline-offset-4">Consulter la fiche de l’action</span>
            </div>
            <span class="font-heading text-sm font-semibold text-primary-700 shrink-0" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section background="gray" padding="lg">
    <div id="where-we-work" class="max-w-5xl scroll-mt-28">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">Nos lieux d’intervention</p>
      <h2 class="mt-3 font-heading text-3xl font-bold tracking-tight text-gray-900 md:text-4xl">Où nous intervenons</h2>
      <div class="mt-8 grid gap-5 lg:grid-cols-3">
        <article class="border border-gray-200 bg-white p-6">
          <p class="text-xs font-semibold uppercase tracking-wide text-primary-700">Activités en cours</p>
          <h3 class="mt-2 font-heading text-lg font-bold text-gray-900">Cameroun</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-700">Nous sommes enregistrés au Cameroun et travaillons avec des équipes locales à Buea et à Bamenda. Nos actions à Bamenda ont commencé en 2024 avec une action de rentrée scolaire.</p>
        </article>
        <article class="border border-gray-200 bg-white p-6">
          <p class="text-xs font-semibold uppercase tracking-wide text-primary-700">Initiative sœur</p>
          <h3 class="mt-2 font-heading text-lg font-bold text-gray-900">Nigeria</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-700">Au Nigeria, notre initiative sœur est Beacon of Blessings Charity Initiative.</p>
          <a href="https://www.blessedbeaconcharity.org/" class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-primary-800 underline underline-offset-4">Visiter le site de Beacon of Blessings</a>
        </article>
        <article class="border border-gray-200 bg-white p-6">
          <p class="text-xs font-semibold uppercase tracking-wide text-primary-700">En préparation</p>
          <h3 class="mt-2 font-heading text-lg font-bold text-gray-900">Canada</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-700">Nous préparons la création d’un organisme sans but lucratif au Canada et étudions les possibilités d’y mener des actions. Nous n’y avons lancé aucun programme et ne délivrons pas de reçus officiels de dons aux fins de l’impôt canadien.</p>
        </article>
      </div>
      <figure class="mt-8 max-w-xl">
        <img src="/images/projects/bamenda-back-to-school-2024-blurred.webp" width="1280" height="720" alt="Des élèves tiennent des cartables bleus. Les visages sont masqués." class="block w-full rounded-lg" loading="lazy" decoding="async" />
        <figcaption class="mt-2 text-sm text-gray-700">Des sacs et des fournitures lors de notre action de rentrée scolaire à Bamenda en 2024. Les visages sont masqués.</figcaption>
      </figure>
    </div>
  </Section>

  <!-- Chronologie -->
  <Section background="gray" padding="lg">
    <div class="max-w-3xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Notre parcours
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Les étapes de notre parcours
      </h2>
    </div>
    <ol class="mt-10 max-w-3xl space-y-0 list-none border-l border-gray-200 ml-1">
      {timeline.map((milestone) => (
        <li class="relative pl-8 pb-8 last:pb-0">
          <span
            class="absolute left-0 top-1.5 -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-primary-600 border-2 border-[#f7f5f0]"
            aria-hidden="true"
          />
          <p class="font-heading text-sm font-bold text-primary-700">{milestone.year}</p>
          <p class="mt-1 text-sm text-gray-600 leading-relaxed">{milestone.event}</p>
        </li>
      ))}
    </ol>
    <a href={`${archivePath}/`} class="mt-6 inline-flex text-sm font-semibold text-primary-700 underline underline-offset-4">Consulter toutes les fiches d’action</a>
  </Section>

  <!-- Vidéo d'Impact -->
  <Section background="white" padding="lg">
    <div class="max-w-4xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Images de terrain
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Actions antérieures
      </h2>
      <p class="mt-4 text-lg text-gray-600 leading-relaxed">
        Ces vidéos retracent une partie de notre histoire et illustrent également des actions communautaires plus larges. Retrouvez les comptes rendus dans nos archives.
      </p>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-md overflow-hidden border border-gray-200">
          <video controls preload="metadata" class="w-full aspect-video bg-gray-900" aria-label="Vidéo du programme Rentrée Scolaire ADA">
            <source src="https://cdn.sanity.io/files/rj2m21gk/production/6d43bdec66014a0bddb4702538982688a8ec4412.mp4" type="video/mp4" />
            Votre navigateur ne supporte pas la balise vidéo.
          </video>
          <p class="p-3 text-sm text-gray-600 bg-gray-50 border-t border-gray-200">Programme Rentrée Scolaire 2022</p>
        </div>
        <div class="rounded-md overflow-hidden border border-gray-200">
          <video controls preload="metadata" class="w-full aspect-video bg-gray-900" aria-label="Vidéo d'action communautaire ADA">
            <source src="https://cdn.sanity.io/files/rj2m21gk/production/02cbff013caef81d8c01e96e68f95cb364ce3a01.mp4" type="video/mp4" />
            Votre navigateur ne supporte pas la balise vidéo.
          </video>
          <p class="p-3 text-sm text-gray-600 bg-gray-50 border-t border-gray-200">Action Communautaire</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- CTA -->
  <Section background="dark" padding="lg" class="!bg-[#121a14] !bg-none">
    <div class="max-w-2xl">
      <h2 class="text-3xl md:text-4xl font-heading font-bold tracking-tight text-left">
        Rejoignez Notre Mission
      </h2>
      <p class="mt-4 text-lg text-white/80 text-left">
        Par un don, le bénévolat ou la prière, vous pouvez soutenir nos actions auprès des femmes et des adolescentes au Cameroun.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/fr/donate"
          class="font-heading inline-flex items-center px-5 py-2.5 text-sm font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors"
        >
          Faire un Don
        </a>
        <a
          href="/fr/get-involved"
          class="font-heading text-sm font-semibold text-white/90 underline decoration-white/40 underline-offset-4 hover:text-white"
        >
          S'Impliquer
        </a>
        <a
          href="/fr/team"
          class="font-heading text-sm font-semibold text-white/90 underline decoration-white/40 underline-offset-4 hover:text-white"
        >
          Notre Équipe
        </a>
      </div>
    </div>
  </Section>
</PageLayout>
