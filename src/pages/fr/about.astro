---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/layout/PageHero.astro';
import Section from '../../components/layout/Section.astro';
import { getAboutPage, type SanityAboutPage, sanityImageUrl } from '../../lib/sanity';
import { createClient } from '@sanity/client';

let missionStatement = "Faire briller la lumière de Jésus-Christ en autonomisant les veuves, orphelins et jeunes femmes du Cameroun à travers la distribution alimentaire, l'éducation, la formation professionnelle et les soins de santé — restaurant la dignité et construisant l'autonomie.";
const defaultMissionStatement = missionStatement;
let storyParagraphs = [
  "Fondée en 2021, Apoti Development Association est née d'une conviction profonde que la foi doit s'exprimer par l'action. Au cœur du Cameroun, où les veuves, les orphelins et les jeunes femmes font face à des défis quotidiens de pauvreté et de marginalisation, nous avons vu une opportunité de faire une différence tangible.",
  "Le Pasteur Emmanuel Tchami, témoin des luttes des veuves de sa communauté qui avaient tout perdu — leur mari, leurs revenus, leur dignité — s'est senti appelé à agir. Il a rassemblé un petit groupe de croyants engagés et ensemble, ils ont livré leurs premiers colis alimentaires à trois veuves à Bamenda.",
  "Ce qui a commencé comme un simple acte de compassion est devenu une organisation communautaire au service de communautés à travers le Cameroun. Ses programmes sont conçus non seulement pour apporter un soutien immédiat, mais aussi pour renforcer l'autonomie.",
];
const defaultStoryParagraphs = storyParagraphs;
let coreValues = [
  { icon: '', title: 'Foi et Amour', desc: 'Enracinés dans la foi chrétienne, nous servons avec un amour inconditionnel.' },
  { icon: '', title: 'Dignité et Respect', desc: "Chaque personne est traitée avec la dignité qu'elle mérite." },
  { icon: '', title: 'Autonomisation', desc: 'Nous équipons les gens de compétences pour construire leur propre avenir.' },
  { icon: '', title: 'Transparence', desc: 'Nous sommes responsables envers nos donateurs et communautés.' },
  { icon: '', title: 'Partenariat Communautaire', desc: 'Nous travaillons aux côtés des leaders locaux.' },
  { icon: '', title: 'Impact Durable', desc: 'Nos programmes créent un changement à long terme, pas un soulagement temporaire.' },
];
let programs = [
  { icon: '', title: 'Distribution Alimentaire', desc: 'Colis alimentaires réguliers pour les veuves et familles.', slug: 'widow-support' },
  { icon: '', title: 'Formation Professionnelle', desc: 'Couture, coiffure et artisanat pour les jeunes femmes.', slug: 'women-empowerment' },
  { icon: '', title: 'Visites Hospitalières', desc: 'Soutien médical et visites aux membres de la communauté.', slug: 'emergency-relief' },
  { icon: '', title: 'Soutien Scolaire', desc: 'Fournitures, uniformes et frais de scolarité pour les orphelins.', slug: 'education-orphans' },
  { icon: '', title: 'Nettoyage Communautaire', desc: "Gestion environnementale à travers des campagnes de nettoyage et plantation d'arbres.", slug: 'women-empowerment' },
];
let timeline = [
  { year: '2021', event: 'Fondée à Buea — premiers colis alimentaires livrés aux veuves en difficulté' },
  { year: '2022', event: 'Lancement du Programme Veuves — 15 veuves inscrites en formation professionnelle' },
  { year: '2023', event: "Programme d'éducation — 20 orphelins parrainés pour l'école" },
  { year: '2024', event: 'Bureau de Bamenda ouvert — expansion régionale et documentation partenaires' },
  { year: '2025', event: '200+ vies impactées — nettoyage communautaire mobilise 200 bénévoles' },
  { year: '2026', event: 'Partenariats institutionnels canadiens et préparation d’un centre de formation' },
];

try {
  const page = await getAboutPage("fr");
  if (page) {
    missionStatement = page.missionStatement || missionStatement;
    if (page.storyParagraphs?.length && typeof page.storyParagraphs[0] === 'string') storyParagraphs = page.storyParagraphs;
    if (page.coreValues?.length) {
      coreValues = page.coreValues.map((v) => ({
        icon: v.icon || "",
        title: v.title,
        desc: v.description,
      }));
    }
    if (page.programs?.length) {
      programs = page.programs.map((p) => ({
        icon: p.icon || "",
        title: p.title,
        desc: p.description,
        slug: p.slug || "widow-support",
      }));
    }
    if (page.timeline?.length) timeline = page.timeline;
  }
} catch {}

const wellReference = /clean water|water well|borehole|water access|puits|forage|eau potable/i;
if (wellReference.test(missionStatement)) missionStatement = defaultMissionStatement;
storyParagraphs = storyParagraphs.filter((paragraph) => !wellReference.test(paragraph));
if (storyParagraphs.length === 0) storyParagraphs = defaultStoryParagraphs;
programs = programs.filter((program) => !wellReference.test(`${program.title} ${program.desc}`));
timeline = timeline.filter((item) => !wellReference.test(item.event));

let communityPhotoUrl = '';
let communityPhotoAlt = 'Travail communautaire d\'ADA au Cameroun';
try {
  const projectId = import.meta.env.SANITY_PROJECT_ID || 'rj2m21gk';
  const dataset = import.meta.env.SANITY_DATASET || 'production';
  const client = createClient({ projectId, dataset, apiVersion: '2026-03-28', useCdn: true });
  const photo = await client.fetch('*[_type == "galleryImage" && defined(photo)] | order(year desc) [0] { title, titleFr, "ref": photo.asset._ref, "alt": photo.alt, "altFr": photo.altFr }');
  if (photo?.ref) {
    communityPhotoUrl = sanityImageUrl(photo.ref, 1400);
    communityPhotoAlt = photo.altFr || photo.titleFr || photo.alt || photo.title || communityPhotoAlt;
  }
} catch {}
---

<!-- Hallmark · genre: editorial · macrostructure: Long Document · design-system: design.md · designed-as-app -->
<PageLayout title="À Propos" description="Découvrez la mission d'Apoti Development Association pour autonomiser les communautés vulnérables au Cameroun.">
  <PageHero
    title="À Propos de Nous"
    subtitle="Association caritative chrétienne autonomisant les communautés vulnérables du Cameroun depuis 2021."
    imageUrl={communityPhotoUrl}
    imageAlt={communityPhotoAlt}
  />

  <!-- Mission -->
  <Section background="white" padding="lg">
    <div class="max-w-3xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Notre mission
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Faire briller la lumière de Jésus-Christ par des soins concrets
      </h2>
      <p class="mt-6 text-lg text-gray-600 leading-relaxed">{missionStatement}</p>
    </div>
    <div class="mt-10 grid grid-cols-3 gap-8 border-y border-gray-200 py-8 max-w-3xl">
      <div>
        <p class="font-heading text-3xl font-bold text-primary-700 tracking-tight">200+</p>
        <p class="mt-1 text-sm text-gray-600">Vies Changées</p>
      </div>
      <div>
        <p class="font-heading text-3xl font-bold text-primary-700 tracking-tight">5</p>
        <p class="mt-1 text-sm text-gray-600">Communautés</p>
      </div>
      <div>
        <p class="font-heading text-3xl font-bold text-primary-700 tracking-tight">80%</p>
        <p class="mt-1 text-sm text-gray-600">Aux Programmes</p>
      </div>
    </div>
    <p class="mt-6 text-sm text-gray-500 max-w-3xl">
      ONG enregistrée au Cameroun · Dirigée depuis le Canada · N&deg; 415/G.37/D14/VolI/SAAJP
    </p>
  </Section>

  <!-- Notre Histoire + Photo -->
  <Section background="gray" padding="lg">
    <div class="max-w-4xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Notre histoire
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Appelés à Servir
      </h2>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-5 gap-8 items-start">
        <div class="md:col-span-3 space-y-4 text-gray-600 leading-relaxed">
          {storyParagraphs.map(p => <p>{p}</p>)}
          <div class="mt-6 rounded-md border border-gray-200 bg-white p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-primary-700">Crédibilité du fondateur</p>
            <h3 class="mt-2 text-lg font-semibold text-gray-900">Le Pasteur Emmanuel Tchami dirige ADA à travers des partenariats avec l'église locale et la communauté.</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">Son équipe travaille directement avec les veuves, les tuteurs d'orphelins, les responsables scolaires et les bénévoles au Cameroun pour que le soutien atteigne des programmes nommés et des besoins communautaires documentés.</p>
            <dl class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
              <div>
                <dt class="font-semibold text-gray-900">Fondée</dt>
                <dd class="text-gray-500">2021 à Buea</dd>
              </div>
              <div>
                <dt class="font-semibold text-gray-900">Responsabilité</dt>
                <dd class="text-gray-500">ONG enregistrée</dd>
              </div>
              <div>
                <dt class="font-semibold text-gray-900">Modèle</dt>
                <dd class="text-gray-500">Partenaires locaux d'abord</dd>
              </div>
            </dl>
          </div>
        </div>
        {communityPhotoUrl && (
          <div class="md:col-span-2">
            <img src={communityPhotoUrl} alt="Programme communautaire ADA en action" class="w-full rounded-md border border-gray-200" loading="lazy" />
          </div>
        )}
      </div>
    </div>
  </Section>

  <!-- Vidéo d'Impact -->
  <Section background="white" padding="lg">
    <div class="max-w-4xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Images de terrain
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Voyez Notre Impact
      </h2>
      <p class="mt-4 text-lg text-gray-600 leading-relaxed">
        Découvrez comment votre soutien transforme des vies dans nos communautés.
      </p>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-md overflow-hidden border border-gray-200">
          <video controls preload="metadata" class="w-full aspect-video bg-gray-900" aria-label="Vidéo du programme Rentrée Scolaire ADA">
            <source src="https://cdn.sanity.io/files/rj2m21gk/production/6d43bdec66014a0bddb4702538982688a8ec4412.mp4" type="video/mp4" />
            Votre navigateur ne supporte pas la balise vidéo.
          </video>
          <p class="p-3 text-sm text-gray-600 bg-gray-50 border-t border-gray-200">Programme Rentrée Scolaire 2022</p>
        </div>
        <div class="rounded-md overflow-hidden border border-gray-200">
          <video controls preload="metadata" class="w-full aspect-video bg-gray-900" aria-label="Vidéo d'action communautaire ADA">
            <source src="https://cdn.sanity.io/files/rj2m21gk/production/02cbff013caef81d8c01e96e68f95cb364ce3a01.mp4" type="video/mp4" />
            Votre navigateur ne supporte pas la balise vidéo.
          </video>
          <p class="p-3 text-sm text-gray-600 bg-gray-50 border-t border-gray-200">Action Communautaire</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Valeurs -->
  <Section background="gray" padding="lg">
    <div class="max-w-3xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Ce qui nous guide
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Nos Valeurs
      </h2>
    </div>
    <ul class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-0 border-t border-gray-200 max-w-4xl">
      {coreValues.map((v) => (
        <li class="border-b border-gray-200 py-5">
          <h3 class="font-heading text-lg font-semibold text-gray-900">{v.title}</h3>
          <p class="mt-1 text-sm text-gray-600 leading-relaxed">{v.desc}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- Programmes (liés aux pages projets) -->
  <Section background="white" padding="lg">
    <div class="max-w-3xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Comment nous servons
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Nos Programmes
      </h2>
      <p class="mt-4 text-lg text-gray-600 leading-relaxed">
        Des programmes ciblés répondent aux besoins les plus pressants de nos communautés.
      </p>
    </div>
    <ul class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-0 border-t border-gray-200 max-w-4xl">
      {programs.map((program) => (
        <li class="border-b border-gray-200">
          <a href={`/fr/projects/${program.slug}`} class="group flex items-baseline justify-between gap-4 py-5">
            <div>
              <h3 class="font-heading text-lg font-semibold text-gray-900 group-hover:text-primary-700 transition-colors">
                {program.title}
              </h3>
              <p class="mt-1 text-sm text-gray-600 leading-relaxed">{program.desc}</p>
            </div>
            <span class="font-heading text-sm font-semibold text-primary-700 shrink-0" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <!-- Chronologie -->
  <Section background="gray" padding="lg">
    <div class="max-w-3xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Notre parcours
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Des premiers colis alimentaires à un impact grandissant
      </h2>
    </div>
    <ol class="mt-10 max-w-3xl space-y-0 list-none border-l border-gray-200 ml-1">
      {timeline.map((milestone) => (
        <li class="relative pl-8 pb-8 last:pb-0">
          <span
            class="absolute left-0 top-1.5 -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-primary-600 border-2 border-[#f7f5f0]"
            aria-hidden="true"
          />
          <p class="font-heading text-sm font-bold text-primary-700">{milestone.year}</p>
          <p class="mt-1 text-sm text-gray-600 leading-relaxed">{milestone.event}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- CTA -->
  <Section background="dark" padding="lg" class="!bg-[#121a14] !bg-none">
    <div class="max-w-2xl">
      <h2 class="text-3xl md:text-4xl font-heading font-bold tracking-tight text-left">
        Rejoignez Notre Mission
      </h2>
      <p class="mt-4 text-lg text-white/80 text-left">
        Que ce soit par un don, le bénévolat ou la prière, vous pouvez faire la différence dans la vie des veuves, orphelins et jeunes femmes au Cameroun.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/fr/donate"
          class="font-heading inline-flex items-center px-5 py-2.5 text-sm font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors"
        >
          Faire un Don
        </a>
        <a
          href="/fr/get-involved"
          class="font-heading text-sm font-semibold text-white/90 underline decoration-white/40 underline-offset-4 hover:text-white"
        >
          S'Impliquer
        </a>
        <a
          href="/fr/team"
          class="font-heading text-sm font-semibold text-white/90 underline decoration-white/40 underline-offset-4 hover:text-white"
        >
          Notre Équipe
        </a>
      </div>
    </div>
  </Section>
</PageLayout>
