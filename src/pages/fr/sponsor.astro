        </a>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-2 text-left sm:grid-cols-2">
        {
          trustProofs.map((proof) => (
            <div class="rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-white/85">
