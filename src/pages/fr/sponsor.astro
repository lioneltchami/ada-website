---
import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../../components/layout/PageHero.astro";
import Section from "../../components/layout/Section.astro";
import FaqSection from "../../components/seo/FaqSection.astro";
import { REGISTRATION_NUMBER } from "../../data/organization";
import { resolveHeroImage } from "../../lib/hero-images";
import { SPONSOR_FAQS_FR, buildFaqPage } from "../../lib/structured-data";

const heroImage = await resolveHeroImage([
  "widow-support",
  "education-orphans",
]);
const sponsorFaqs = SPONSOR_FAQS_FR;
const faqPageSchema = buildFaqPage(
  sponsorFaqs,
  new URL("/fr/sponsor", Astro.site).toString(),
);

const sponsorTiers = [
  {
    name: "Sponsor communautaire",
    amount: "500 $-1 000 $",
    budgetValue: "$500-$1,000",
    funds:
      "Fournitures scolaires, soutien alimentaire, campagne saisonnière ou besoins urgents de ménage.",
    outcome:
      "Aide un besoin précis de ménage, d'école ou de secours à passer d'un manque urgent à un soutien documenté.",
    receives:
      "Reçu ADA, courte mise à jour, note d'utilisation des fonds, et reconnaissance publique ou discrète au choix.",
  },
  {
    name: "Sponsor de projet",
    amount: "2 500 $-5 000 $",
    budgetValue: "$2,500-$5,000",
    funds:
      "Projet défini pour l'éducation, les veuves, les orphelins, les jeunes femmes ou les familles déplacées.",
    outcome:
      "Finance un projet limité avec personnes servies, budget, preuves et résumé final.",
    receives:
      "Mises à jour trimestrielles et annuelles avec jalons et points d'information; photos de projet avec consentement, résumé d'impact et rapport final.",
  },
  {
    name: "Sponsor de programme",
    amount: "10 000 $+",
    budgetValue: "$10,000+",
    funds:
      "Saison complète de programme, cycle de soutien à plusieurs familles ou réponse communautaire récurrente.",
    outcome:
      "Soutient un programme mesurable avec des mises à jour trimestrielles et annuelles incluant les jalons et les points d'information, ainsi qu'un rapport final de résultats.",
    receives:
      "Accord de parrainage, mises à jour trimestrielles et annuelles incluant les jalons et les points d'information, rapport final distinct et logo si approuvé.",
  },
  {
    name: "Partenaire stratégique",
    amount: "Sur mesure",
    budgetValue: "Custom / discuss first",
    funds:
      "Engagement pluriannuel, soutien aux capacités ou initiative adaptée avec la direction d'ADA.",
    outcome:
      "Crée des objectifs partagés, une cadence de rapports et un plan de partenariat avant tout transfert de fonds.",
    receives:
      "Mises à jour trimestrielles et annuelles, incluant les jalons et les points d'information; reconnaissance ou anonymat selon préférence.",
  },
];

const fundingPaths = [
  {
    title: "Sponsoriser un projet",
    text: "Financer une campagne définie avec objectif, calendrier, budget et mise à jour de clôture.",
  },
  {
    title: "Lancer une campagne de groupe",
    text: "Églises, entreprises, écoles et groupes de la diaspora peuvent explorer avec ADA un soutien commun à une campagne.",
  },
  {
    title: "Soutenir régulièrement",
    text: "Un parrainage mensuel ou trimestriel aide ADA à planifier le soutien alimentaire, scolaire et sanitaire.",
  },
  {
    title: "Offrir une aide en nature",
    text: "Compétences, fournitures, logistique, formation ou équipement peuvent être coordonnés par accord préalable.",
  },
];

const sponsorReceives = [
  "Reçu ou confirmation de parrainage pour vos dossiers",
  "Résumé clair de l'utilisation des fonds",
  "Mises à jour trimestrielles et annuelles, incluant les jalons et les points d'information",
  "Reconnaissance par nom ou logo, seulement avec approbation",
  "Reconnaissance publique, mention interne ou anonymat complet selon préférence",
  "Photos ou témoignages lorsque cela est approprié et consenti",
];

const outcomeProofs = [
  {
    project: "Soutien rentrée scolaire",
    costLabel: "Activité passée",
    cost: "Deux campagnes scolaires en 2024",
    served: "40 enfants orphelins",
    outcome:
      "Les enfants ont reçu frais, fournitures et matériel scolaire avant le début de l'année.",
    evidence:
      "Listes de présence, justificatifs d'achat, photos consenties et résumés de projet.",
    next: "Financer le prochain trimestre plus tôt pour aider familles et écoles à planifier.",
  },
  {
    project: "Aide alimentaire d'urgence",
    cost: "Budget de secours documenté de 2 417 $",
    served: "50 familles déplacées; 150+ personnes",
    outcome:
      "Les familles ont reçu des colis alimentaires planifiés pendant un cycle d'urgence de trois mois.",
    evidence:
      "Registres de distribution, reçus, notes de terrain et rapport de clôture.",
    next: "Pré-positionner un fonds d'urgence soutenu par sponsors avant la prochaine période de crise.",
  },
];

const trustProofs = [
  `ONG enregistrée : ${REGISTRATION_NUMBER}`,
  "Objectif de 80% vers l'exécution des programmes",
  "Reçus fournis pour les dossiers",
  "Rapports de projet disponibles",
  "Paiement carte sécurisé par Stripe",
  "Dossier de diligence disponible",
  "Rapports bilingues : anglais/français",
];

const diligenceItems = [
  "Certificat d'enregistrement au Cameroun",
  "Aperçu de la direction et de la gouvernance",
  "Modèle d'allocation financière",
  "Rapports annuels et dossiers de projet",
  "Politiques de protection et de gestion financière",
  "Attentes de rapport et chemin de contact",
];
---

<!-- Hallmark · genre: editorial · macrostructure: Split Studio · design-system: design.md · designed-as-app -->
<PageLayout
  title="Sponsoriser un Programme"
  description="Sponsorisez un soutien pratique pour les veuves, orphelins, jeunes femmes, familles déplacées et élèves au Cameroun. Options claires, reçus, rapports et diligence raisonnable."
  jsonLdExtra={[faqPageSchema]}
>
  <PageHero
    title="Sponsorisez un soutien pratique pour les familles au Cameroun"
    subtitle="Associez-vous à ADA pour financer des programmes communautaires directs avec options claires, documents écrits et utilisation transparente des fonds."
    compact
    imageUrl={heroImage?.imageUrl}
    imageAlt={heroImage?.imageAlt}
  />

  <section class="overflow-hidden bg-white">
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-10 items-center"
    >
      <div class="min-w-0">
        <p
          class="text-xs font-semibold uppercase tracking-wider text-primary-700"
        >
          Sponsoriser le travail d'ADA au Cameroun
        </p>
        <h2
          class="mt-4 max-w-3xl text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-gray-950 leading-tight"
        >
          Parrainer des programmes communautaires
        </h2>
        <p class="mt-5 text-lg text-gray-600 leading-relaxed max-w-2xl">
          Le parrainage permet de discuter d'un soutien à un projet ou programme
          défini, ainsi que des documents ou mises à jour associés. Pour un don
          général, consultez la <a
            href="/fr/donate"
            class="font-semibold text-primary-700 underline underline-offset-2"
            >page des dons</a
          >.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-3">
          <a
            href="/fr/sponsor/inquiry"
            class="inline-flex items-center justify-center px-5 py-3 text-sm font-semibold text-white bg-primary-700 rounded-md hover:bg-primary-800 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700"
          >
            Discuter d'un parrainage
          </a>
          <a
            href="/docs/diligence/ada-corporate-sponsor-one-pager.pdf"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center px-4 py-2 text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
          >
            Télécharger la fiche
          </a>
          <a
            href="#tiers"
            class="inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-700 underline underline-offset-4 hover:text-gray-900"
          >
            Voir les options
          </a>
        </div>
        <p class="mt-5 text-xs text-gray-500">
          Enregistrée au Cameroun ({REGISTRATION_NUMBER}). Le modèle public
          d'allocation d'ADA vise 80% des dépenses pour les programmes directs.
        </p>
      </div>

      <div class="rounded-md border border-gray-200 bg-gray-50 p-6 md:p-8">
        <h2 class="text-xl font-heading font-bold text-gray-900">
          Prêt pour les sponsors, en bref
        </h2>
        <dl class="mt-6 space-y-4">
          <div
            class="grid grid-cols-1 gap-1 border-b border-gray-200 pb-3 sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] sm:gap-4"
          >
            <dt class="text-sm text-gray-500">Statut légal</dt>
            <dd
              class="min-w-0 break-words text-sm font-semibold text-gray-900 sm:text-right"
            >
              ONG enregistrée au Cameroun
            </dd>
          </div>
          <div
            class="grid grid-cols-1 gap-1 border-b border-gray-200 pb-3 sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] sm:gap-4"
          >
            <dt class="text-sm text-gray-500">Rapports</dt>
            <dd
              class="min-w-0 break-words text-sm font-semibold text-gray-900 sm:text-right"
            >
              Mises à jour, dossiers, rapports
            </dd>
          </div>
          <div
            class="grid grid-cols-1 gap-1 border-b border-gray-200 pb-3 sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] sm:gap-4"
          >
            <dt class="text-sm text-gray-500">Modes de don</dt>
            <dd
              class="min-w-0 break-words text-sm font-semibold text-gray-900 sm:text-right"
            >
              Dons par carte en USD; ponctuels ou mensuels
            </dd>
          </div>
          <div
            class="grid grid-cols-1 gap-1 sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] sm:gap-4"
          >
            <dt class="text-sm text-gray-500">Diligence</dt>
            <dd
              class="min-w-0 break-words text-sm font-semibold text-gray-900 sm:text-right"
            >
              Dossier disponible
            </dd>
          </div>
        </dl>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href="/docs/diligence/ada-corporate-sponsor-one-pager.pdf"
            target="_blank"
            rel="noopener"
            class="text-sm font-semibold text-primary-700 hover:underline"
          >
            Fiche sponsor
          </a>
          <a
            href="/docs/diligence/ada-registration-certificate.pdf"
            target="_blank"
            rel="noopener"
            class="text-sm font-semibold text-primary-700 hover:underline"
          >
            Certificat
          </a>
          <a
            href="/fr/transparency"
            class="text-sm font-semibold text-primary-700 hover:underline"
          >
            Transparence
          </a>
          <a
            href="/fr/resources"
            class="text-sm font-semibold text-primary-700 hover:underline"
          >
            Ressources
          </a>
          <a
            href="/fr/impact-scorecard"
            class="text-sm font-semibold text-primary-700 hover:underline"
          >
            Tableau d'impact
          </a>
        </div>
      </div>
    </div>
  </section>

  <Section background="gray" padding="md">
    <div class="max-w-4xl">
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900">
        Quatre façons simples d'aider
      </h2>
      <p class="mt-3 text-sm text-gray-600">
        Choisissez le chemin adapté à votre église, entreprise, école, groupe de
        diaspora, fondation ou famille.
      </p>
    </div>
    <dl
      class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-x-12 border-t border-gray-200"
    >
      {
        fundingPaths.map((path) => (
          <div class="border-b border-gray-200 py-6">
            <dt class="text-base font-semibold text-gray-900">{path.title}</dt>
            <dd class="mt-2 text-sm text-gray-600 leading-relaxed">
              {path.text}
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section background="white" padding="lg">
    <div class="max-w-4xl">
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900">
        L'impact présenté comme résultats
      </h2>
      <p class="mt-3 text-sm text-gray-600 leading-relaxed">
        Les sponsors doivent voir ce qui a changé, pas seulement ce qu'ADA a
        fait. Ces exemples présentent l'activité, les personnes servies, les
        résultats, les preuves et le prochain jalon.
      </p>
    </div>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-5">
      {
        outcomeProofs.map((proof) => (
          <article class="rounded-md border border-gray-200 bg-white p-5">
            <h3 class="text-lg font-semibold text-gray-900">{proof.project}</h3>
            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="font-semibold text-gray-900">
                  {proof.costLabel || "Coût documenté (USD)"}
                </dt>
                <dd class="mt-1 text-gray-600 leading-relaxed">{proof.cost}</dd>
              </div>
              <div>
                <dt class="font-semibold text-gray-900">Nombre servi</dt>
                <dd class="mt-1 text-gray-600 leading-relaxed">
                  {proof.served}
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-gray-900">Résultat</dt>
                <dd class="mt-1 text-gray-600 leading-relaxed">
                  {proof.outcome}
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-gray-900">Preuves</dt>
                <dd class="mt-1 text-gray-600 leading-relaxed">
                  {proof.evidence}
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-gray-900">Prochain jalon</dt>
                <dd class="mt-1 text-gray-600 leading-relaxed">{proof.next}</dd>
              </div>
            </dl>
          </article>
        ))
      }
    </div>
  </Section>

  <Section id="tiers" background="white" padding="lg">
    <div class="max-w-4xl">
      <div>
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900">
          Options de parrainage
        </h2>
        <p class="mt-3 text-sm text-gray-600">
          Les montants suggérés sont en USD. Les dons par carte sont possibles
          en une fois ou chaque mois; utilisez le formulaire de demande pour
          discuter du soutien à un projet ou programme défini.
        </p>
      </div>
      <p class="mt-4 text-xs text-gray-500">Tous les montants sont en USD.</p>
      <div
        class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-0 border-t border-gray-200"
      >
        {
          sponsorTiers.map((tier) => (
            <article class="flex h-full flex-col border-b border-gray-200 py-6">
              <h3 class="text-lg font-semibold text-gray-900">{tier.name}</h3>
              <p class="mt-2 text-2xl font-bold text-primary-700">
                {tier.amount}
              </p>
              <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-gray-500">
                Finance
              </p>
              <p class="mt-1 text-sm text-gray-600 leading-relaxed">
                {tier.funds}
              </p>
              <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-gray-500">
                Résultat visé
              </p>
              <p class="mt-1 text-sm text-gray-600 leading-relaxed">
                {tier.outcome}
              </p>
              <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-gray-500">
                Le sponsor reçoit
              </p>
              <p class="mt-1 flex-1 text-sm text-gray-600 leading-relaxed">
                {tier.receives}
              </p>
              <a
                href={`/fr/sponsor/inquiry?budgetRange=${encodeURIComponent(tier.budgetValue)}`}
                aria-label={`Demander des renseignements sur ${tier.name} (${tier.amount})`}
                class="mt-6 inline-flex text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
              >
                Demander cette option
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </Section>

  <Section background="gray" padding="lg">
    <div
      class="max-w-5xl grid grid-cols-1 lg:grid-cols-[0.95fr_1.05fr] gap-8 items-start"
    >
      <div>
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900">
          Un suivi clair, pas de promesses vagues
        </h2>
        <p class="mt-3 text-gray-600 leading-relaxed">
          Chaque sponsor reçoit une confirmation de soutien et un document utile
          pour ses dossiers. Les rapports restent pratiques : assez de détails
          pour montrer la bonne gestion, sans surcharger les sponsors ou les
          communautés servies.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href="/fr/projects/archive"
            class="inline-flex text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
          >
            Voir le travail réalisé
          </a>
          <a
            href="/fr/resources#due-diligence"
            class="inline-flex text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
          >
            Consulter les documents
          </a>
        </div>
      </div>
      <ul class="divide-y divide-gray-200 border-y border-gray-200">
        {
          sponsorReceives.map((item) => (
            <li class="py-3 text-sm text-gray-700 leading-relaxed">{item}</li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section background="white" padding="lg">
    <div
      class="max-w-5xl grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-8 items-start"
    >
      <div>
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900">
          Ce que les sponsors peuvent examiner avant de donner
        </h2>
        <p class="mt-3 text-gray-600 leading-relaxed">
          Pour les sponsors qui ont besoin d'une validation interne, ADA peut
          fournir une fiche sponsor d'une page, un dossier de diligence
          raisonnable concis et les documents publics déjà disponibles sur le
          site.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href="/docs/diligence/ada-corporate-sponsor-one-pager.pdf"
            target="_blank"
            rel="noopener"
            class="inline-flex text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
          >
            Télécharger la fiche
          </a>
          <a
            href="/docs/diligence/ada-sponsor-readiness-packet.pdf"
            target="_blank"
            rel="noopener"
            class="inline-flex text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
          >
            Ouvrir le dossier
          </a>
          <a
            href="/fr/resources#due-diligence"
            class="inline-flex text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
          >
            Consulter les documents
          </a>
        </div>
      </div>
      <ul class="divide-y divide-gray-200 border-y border-gray-200">
        {
          diligenceItems.map((item) => (
            <li class="py-3 text-sm text-gray-700">{item}</li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section background="gray" padding="md">
    <div
      class="max-w-5xl grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-8 items-start"
    >
      <div>
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900">
          Dons et parrainage
        </h2>
        <p class="mt-3 text-gray-600 leading-relaxed">
          Un don général soutient le travail d'ADA. Une demande de parrainage
          permet de discuter d'un projet ou programme défini avant de décider de
          donner.
        </p>
      </div>
      <div class="space-y-4">
        <div class="rounded-md border border-gray-200 bg-white p-5">
          <h3 class="text-base font-semibold text-gray-900">Dons en ligne</h3>
          <p class="mt-3 text-sm text-gray-700 leading-relaxed">
            Donnez par carte en USD, en une fois ou chaque mois. La page de don
            d'ADA est accessible sans créer de compte.
          </p>
          <a
            href="/fr/donate"
            class="mt-4 inline-flex text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
          >
            Faire un don
          </a>
        </div>
        <div class="rounded-md border border-amber-200 bg-amber-50 p-5">
          <h3 class="text-base font-semibold text-amber-950">
            Statut fiscal et parrainage clairs
          </h3>
          <p class="mt-2 text-sm text-amber-900 leading-relaxed">
            ADA est enregistrée au Cameroun. À ce jour, les contributions ne
            sont pas présentées comme déductibles d'impôt au Canada, aux
            États-Unis, au Royaume-Uni ou dans l'Union européenne sauf si un
            partenaire enregistré qualifié est confirmé par écrit. ADA peut
            fournir un reçu, une facture ou une confirmation de parrainage pour
            vos dossiers, mais ne donne pas de conseil fiscal.
          </p>
          <p class="mt-3 text-sm text-amber-900 leading-relaxed">
            Si ADA confirme à l'avenir un sponsor fiscal qualifié ou un
            partenaire caritatif enregistré, ADA publiera le nom du partenaire,
            le pays, les instructions de don, le traitement fiscal admissible et
            les limites de reçu avant de promouvoir ce chemin.
          </p>
          <a
            href="/fr/sponsor/inquiry"
            class="mt-4 inline-flex text-sm font-semibold text-amber-950 underline underline-offset-4 hover:text-amber-900"
          >
            Discuter des exigences
          </a>
        </div>
      </div>
    </div>
  </Section>

  <Section background="white" padding="lg">
    <FaqSection
      title="FAQ parrainage"
      subtitle="Statut fiscal, utilisation des fonds, rapports et démarches."
      faqs={sponsorFaqs}
      contactHref="/fr/sponsor/inquiry"
      contactLabel="Une question ? Envoyez une demande de parrainage à ADA."
    />
  </Section>

  <Section background="dark" padding="lg" class="!bg-gray-900 !bg-none">
    <div class="max-w-4xl">
      <h2 class="text-2xl md:text-3xl font-heading font-bold">
        Prêt à sponsoriser un programme ciblé ?
      </h2>
      <p class="mt-3 text-sm text-white/80 leading-relaxed">
        Dites-nous quel type de sponsor vous êtes, ce que vous souhaitez
        financer et les documents dont vous avez besoin. ADA pourra vous
        transmettre des informations pertinentes sur les options de don ou de
        parrainage.
      </p>
      <div class="mt-7 flex flex-col sm:flex-row gap-3">
        <a
          href="/fr/sponsor/inquiry"
          class="inline-flex items-center px-4 py-2 text-sm font-semibold text-white border border-white/40 rounded-md hover:bg-white/10 transition-colors"
        >
          Commencer une demande
        </a>
        <a
          href="/fr/donate"
          class="inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors"
        >
