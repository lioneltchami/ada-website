---
import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../../components/layout/PageHero.astro";
import Section from "../../components/layout/Section.astro";
import {
  getVolunteerRoles,
  getSiteSettings,
  type SanityVolunteerRole,
} from "../../lib/sanity";
import {
  resolveGalleryStrip,
  resolveHeroImage,
} from "../../lib/hero-images";

const fallbackRoles = [
  {
    title: "Coordinateur Communautaire",
    time: "10-15 h/semaine",
    location: "Sur place",
    desc: "Diriger l'engagement communautaire et la mise en œuvre des programmes.",
  },
  {
    title: "Mentor Éducatif",
    time: "5-10 h/semaine",
    location: "Sur place",
    desc: "Encadrer et accompagner les enfants orphelins dans notre programme éducatif.",
  },
  {
    title: "Formateur Professionnel",
    time: "8-12 h/semaine",
    location: "Sur place",
    desc: "Enseigner des compétences professionnelles aux jeunes femmes.",
  },
  {
    title: "Bénévole Santé",
    time: "5-8 h/semaine",
    location: "Sur place",
    desc: "Aider aux visites hospitalières et aux campagnes de sensibilisation.",
  },
  {
    title: "Médias & Communication",
    time: "5-10 h/semaine",
    location: "À distance",
    desc: "Gérer les réseaux sociaux, créer du contenu et raconter notre histoire.",
  },
  {
    title: "Collecte de Fonds",
    time: "Flexible",
    location: "À distance",
    desc: "Aider à planifier des campagnes et coordonner des événements.",
  },
];

let volunteerRoles = fallbackRoles;
try {
  const roles = await getVolunteerRoles("fr");
  if (roles?.length)
    volunteerRoles = roles.map((r: SanityVolunteerRole) => ({
      title: r.title,
      time: r.timeCommitment,
      location: r.location,
      desc: r.description,
    }));
} catch {}

let socialFacebook = "https://facebook.com/apotidev";
let socialInstagram = "https://instagram.com/apotidev";
let socialTwitter = "https://twitter.com/apotidev";
try {
  const settings = await getSiteSettings("fr");
  if (settings) {
    socialFacebook = settings.socialFacebook || socialFacebook;
    socialInstagram = settings.socialInstagram || socialInstagram;
    socialTwitter = settings.socialTwitter || socialTwitter;
  }
} catch {}

const partnershipTiers = [
  {
    tier: "Sponsor Communautaire",
    range: "500$-1 000$",
    desc: "Soutien aux fournitures, repas ou campagnes saisonnières avec reçu et mise à jour concise.",
  },
  {
    tier: "Sponsor de Projet",
    range: "2 500$-5 000$",
    desc: "Financement d'un projet défini avec budget, personnes servies, résultat et rapport final.",
  },
  {
    tier: "Sponsor de Programme",
    range: "10 000$+",
    desc: "Soutien à un cycle complet avec mises à jour trimestrielles, rapport final et reconnaissance convenue.",
  },
  {
    tier: "Partenaire Stratégique",
    range: "Sur mesure",
    desc: "Discussion pour une campagne plus large, un soutien récurrent ou un accord de rapport adapté.",
  },
];

const heroImage = await resolveHeroImage([
  "widow-support",
  "education-orphans",
]);
const galleryStrip = await resolveGalleryStrip(4);
const ways = [
  {
    title: "Bénévolat",
    desc: "Donnez votre temps et vos compétences",
    href: "#benevole",
    image: galleryStrip[0],
  },
  {
    title: "Don Mensuel",
    desc: "Rejoignez notre communauté de donateurs",
    href: "/fr/monthly",
    image: galleryStrip[1],
  },
  {
    title: "Sensibiliser",
    desc: "Partagez notre mission",
    href: "#sensibiliser",
    image: galleryStrip[2],
  },
  {
    title: "Partenariat",
    desc: "Partenariats corporatifs",
    href: "#partenariats",
    image: galleryStrip[3],
  },
];
---
<!-- Hallmark · genre: editorial · macrostructure: Photographic · design-system: design.md · designed-as-app -->

<PageLayout
  title="S'Impliquer"
  description="Rejoignez ADA en tant que bénévole, donateur mensuel ou partenaire corporatif."
>
  <PageHero
    title="S'Impliquer"
    subtitle="Il existe de nombreuses façons de soutenir notre mission. Trouvez celle qui vous convient."
    imageUrl={heroImage?.imageUrl}
    imageAlt={heroImage?.imageAlt}
  />

  <Section background="white" padding="lg">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-heading font-bold text-gray-900 tracking-tight">
        Comment Aider
      </h2>
    </div>
    <ul class="mt-10 divide-y divide-gray-200 border-y border-gray-200 max-w-3xl">
      {
        ways.map((way) => (
          <li>
            <a
              href={way.href}
              class="group flex flex-col sm:flex-row sm:items-center gap-4 py-5"
            >
              {way.image ? (
                <div class="w-full sm:w-28 h-20 shrink-0 overflow-hidden rounded-md bg-gray-100">
                  <img
                    src={way.image.imageUrl}
                    alt={way.image.imageAlt}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
              ) : null}
              <div class="min-w-0">
                <h3 class="font-heading text-lg font-semibold text-gray-900 group-hover:text-primary-700">
                  {way.title}
                </h3>
                <p class="mt-1 text-sm text-gray-600">{way.desc}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="benevole" background="gray" padding="lg">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-heading font-bold text-gray-900 tracking-tight">
        Opportunités de Bénévolat
      </h2>
    </div>
    <ul class="mt-10 divide-y divide-gray-200 border-y border-gray-200 max-w-3xl">
      {
        volunteerRoles.map((role) => (
          <li class="py-5">
            <h3 class="font-heading text-base font-semibold text-gray-900">{role.title}</h3>
            <p class="mt-1 text-xs text-gray-500">
              {role.time} · {role.location}
            </p>
            <p class="mt-2 text-sm text-gray-600">{role.desc}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="partenariats" background="gray" padding="lg">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-heading font-bold text-gray-900 tracking-tight">
        Partenariats Corporatifs
      </h2>
    </div>
    <ul class="mt-10 divide-y divide-gray-200 border-y border-gray-200 max-w-3xl">
      {
        partnershipTiers.map((p) => (
          <li class="py-5">
            <h3 class="font-heading text-lg font-semibold text-gray-900">{p.tier}</h3>
            <p class="mt-1 font-heading text-base font-bold text-primary-700">{p.range}</p>
            <p class="mt-2 text-sm text-gray-600">{p.desc}</p>
          </li>
        ))
      }
    </ul>
    <div class="mt-8">
      <a
        href="/fr/sponsor"
        class="inline-flex text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
        >Voir les options de parrainage</a
      >
    </div>
  </Section>

  <Section id="sensibiliser" background="dark" padding="md">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-heading font-bold">Partagez Notre Mission</h2>
      <p class="mt-2 text-white/80">
        Partagez sur les réseaux sociaux et aidez-nous à toucher plus de
        personnes.
      </p>
      <div class="mt-4 flex flex-wrap gap-4">
        <a
          href={socialFacebook}
          target="_blank"
          rel="noopener"
          class="text-sm text-white underline underline-offset-4 hover:text-white/90"
          >Facebook</a
        >
        <a
          href={socialInstagram}
          target="_blank"
          rel="noopener"
          class="text-sm text-white underline underline-offset-4 hover:text-white/90"
          >Instagram</a
        >
        <a
          href={socialTwitter}
          target="_blank"
          rel="noopener"
          class="text-sm text-white underline underline-offset-4 hover:text-white/90"
          >Twitter/X</a
        >
      </div>
    </div>
  </Section>
</PageLayout>
