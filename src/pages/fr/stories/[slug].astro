---
import PageLayout from "../../../layouts/PageLayout.astro";
import StoryReleaseDetail from "../../../components/stories/StoryReleaseDetail.astro";
import { STORY_RELEASE_COPY } from "../../../lib/story-release-copy";

export function getStaticPaths() {
	return Object.keys(STORY_RELEASE_COPY).map((slug) => ({ params: { slug } }));
}

const { slug = "" } = Astro.params;
const post = STORY_RELEASE_COPY[slug as keyof typeof STORY_RELEASE_COPY];
if (!post) throw new Error(`Unknown Story slug: ${slug}`);
const copy = post.fr;
---

<PageLayout
	title={copy.title}
	description={copy.excerpt}
	ogImage="/brand/ada-logo.png"
	ogImageAlt="Apoti Development Association"
	noIndex
	noBreadcrumbJsonLd
>
	<StoryReleaseDetail slug={slug} locale="fr" />
</PageLayout>
