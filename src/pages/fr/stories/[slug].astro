---
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHero from '../../../components/layout/PageHero.astro';
import Section from '../../../components/layout/Section.astro';
import StoryReviewNotice from '../../../components/home/StoryReviewNotice.astro';
import { getBlogPostSlugs } from '../../../lib/sanity';
import { getStoryReviewCopy } from '../../../lib/story-review-notice';

export async function getStaticPaths() {
  try {
    const slugs = await getBlogPostSlugs();
    return slugs.map((slug) => ({ params: { slug } }));
  } catch {
    return [];
  }
}

const copy = getStoryReviewCopy('fr');
---

<PageLayout
  title={copy.detailTitle}
  description={copy.detailDescription}
  ogImage="/brand/ada-logo.png"
  ogImageAlt="Apoti Development Association"
  noIndex={true}
  noBreadcrumbJsonLd={true}
>
  <PageHero title={copy.detailTitle} compact />

  <Section background="white" padding="lg">
    <StoryReviewNotice locale="fr" variant="detail" />
  </Section>

  <Section background="gray" padding="md">
    <div class="max-w-3xl mx-auto">
      <p class="text-gray-700">Découvrez d’autres façons de contacter ADA.</p>
      <div class="mt-4 flex flex-col sm:flex-row items-start gap-3">
        <a href="/fr/donate" class="px-6 py-3 text-sm font-semibold text-white bg-secondary-500 rounded-lg hover:bg-secondary-600 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700">Faire un don</a>
        <a href="/fr/projects" class="px-6 py-3 text-sm font-medium text-primary-700 border border-primary-200 rounded-lg hover:bg-primary-50 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700">Découvrir les projets d’ADA</a>
        <a href="/fr/get-involved" class="px-6 py-3 text-sm font-medium text-primary-700 border border-primary-200 rounded-lg hover:bg-primary-50 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700">Découvrir comment s’impliquer</a>
        <a href="/fr/contact" class="px-6 py-3 text-sm font-medium text-primary-700 border border-primary-200 rounded-lg hover:bg-primary-50 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700">Contacter ADA</a>
      </div>
    </div>
  </Section>
</PageLayout>
