---
import SocialFollow from "../../../components/stories/SocialFollow.astro";
import PageLayout from "../../../layouts/PageLayout.astro";
import PageHero from "../../../components/layout/PageHero.astro";
import Section from "../../../components/layout/Section.astro";
import StoryReleaseIndex from "../../../components/stories/StoryReleaseIndex.astro";
import { STORY_RELEASE_HERO_IMAGE } from "../../../lib/story-release-index";

const title = "Témoignages et actualités";
const description = "Témoignages, nouvelles des actions et réflexions sur les programmes d’Apoti Development Association au Cameroun.";
---

<PageLayout title={title} description={description} ogImage="/brand/ada-primary-lockup.png" ogImageAlt="Apoti Development Association">
	<PageHero title={title} subtitle="Des témoignages de personnes accompagnées et des nouvelles de nos actions." photo={{ src: STORY_RELEASE_HERO_IMAGE, alt: "", credit: { text: "Des bénévoles lors de notre nettoyage de mai 2023 à Buea", href: "/fr/projects/archive/city-cleanup-may-2023/" } }} imageDecorative imageLayout="side" preserveFraming />
	<Section background="white" padding="lg">
		<StoryReleaseIndex locale="fr" />
		<SocialFollow locale="fr" />
	</Section>
</PageLayout>
