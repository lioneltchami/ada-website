---
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHero from '../../../components/layout/PageHero.astro';
import Section from '../../../components/layout/Section.astro';
import { sanityImageUrl } from '../../../lib/sanity';
import { createClient } from '@sanity/client';

let posts: any[] = [];
let galleryPhotos: any[] = [];
try {
  const projectId = import.meta.env.SANITY_PROJECT_ID || 'rj2m21gk';
  const dataset = import.meta.env.SANITY_DATASET || 'production';
  const client = createClient({ projectId, dataset, apiVersion: '2026-03-28', useCdn: true });
  posts = await client.fetch('*[_type == "blogPost"] | order(publishedAt desc) { _id, title, titleFr, slug, excerpt, excerptFr, publishedAt, category, personPhoto { asset { _ref }, alt } }');
  galleryPhotos = await client.fetch('*[_type == "galleryImage" && defined(photo)] | order(year desc) [0...4] { _id, title, photo { asset { _ref }, alt } }');
} catch {}

const categories = ['all', 'story', 'update', 'announcement'];
const categoryLabels: Record<string, string> = {
  all: 'Tous',
  story: 'Histoires',
  update: 'Actualités',
  announcement: 'Annonces',
};

const storyHero =
  posts.find((p) => p.personPhoto?.asset?._ref) ||
  galleryPhotos.find((g) => g.photo?.asset?._ref);
const storyHeroUrl = storyHero?.personPhoto?.asset?._ref
  ? sanityImageUrl(storyHero.personPhoto.asset._ref, 1400)
  : storyHero?.photo?.asset?._ref
    ? sanityImageUrl(storyHero.photo.asset._ref, 1400)
    : '';
const storyHeroAlt =
  storyHero?.personPhoto?.alt ||
  storyHero?.photo?.alt ||
  storyHero?.title ||
  'Histoires ADA';
---
<!-- Hallmark · genre: editorial · macrostructure: Long Document · design-system: design.md · designed-as-app -->

<PageLayout title="Témoignages & Actualités" description="Lisez des histoires d'impact, des mises à jour de programmes et des annonces d'Apoti Development Association.">
  <PageHero
    title="Témoignages & Actualités"
    subtitle="Nouvelles, histoires d'impact et annonces de nos programmes."
    compact
    imageUrl={storyHeroUrl}
    imageAlt={storyHeroAlt}
  />

  <Section background="white" padding="lg">
    {posts.length > 0 ? (
      <div>
        <!-- Category Filters -->
        <div class="flex flex-wrap gap-2 mb-8" id="story-filters">
          {categories.map((cat) => (
            <button
              type="button"
              data-filter={cat}
              aria-pressed={cat === 'all' ? "true" : "false"}
              class:list={["font-heading px-3 py-1.5 text-sm font-medium rounded-md transition-colors", cat === 'all' ? "bg-primary-700 text-white" : "text-gray-700 hover:text-primary-700"]}
            >
              {categoryLabels[cat]} ({cat === 'all' ? posts.length : posts.filter(p => p.category === cat).length})
            </button>
          ))}
        </div>

        <!-- Posts list -->
        <ul class="divide-y divide-gray-200 border-y border-gray-200" id="stories-grid">
          {posts.map((post) => (
            <li class="story-card" data-category={post.category || 'update'}>
              <a href={`/fr/stories/${post.slug.current}`} class="group flex flex-col sm:flex-row gap-4 py-6">
                {post.personPhoto?.asset?._ref && (
                  <div class="w-full sm:w-36 h-28 shrink-0 overflow-hidden rounded-md bg-gray-100">
                    <img src={sanityImageUrl(post.personPhoto.asset._ref, 400)} alt={post.personPhoto?.alt || (post.titleFr || post.title)} class="w-full h-full object-cover" loading="lazy" />
                  </div>
                )}
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-2 mb-2">
                    <span class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
                      {post.category === 'story' ? 'histoire' : post.category === 'announcement' ? 'annonce' : 'actualité'}
                    </span>
                    {post.publishedAt && (
                      <time class="text-xs text-gray-500">{new Date(post.publishedAt).toLocaleDateString('fr-FR', { year: 'numeric', month: 'short' })}</time>
                    )}
                  </div>
                  <h2 class="font-heading text-lg font-semibold text-gray-900 group-hover:text-primary-700 transition-colors leading-tight">{post.titleFr || post.title}</h2>
                  <p class="mt-2 text-sm text-gray-600 line-clamp-2 leading-relaxed">{post.excerptFr || post.excerpt}</p>
                  <span class="mt-3 inline-block font-heading text-sm font-semibold text-primary-700">Lire la suite →</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <div class="py-12">
        <h2 class="text-xl font-semibold text-gray-900">Histoires à Venir</h2>
        <p class="mt-2 text-gray-600">Nous travaillons à partager plus d'histoires d'impact. Revenez bientôt !</p>
      </div>
    )}
  </Section>

  <Section background="gray" padding="md">
    <div>
      <h3 class="text-lg font-heading font-semibold text-gray-900 mb-4">De notre galerie</h3>
      {galleryPhotos.length > 0 && (
        <div class="flex gap-3 mb-4">
          {galleryPhotos.map((img) => (
            <a href="/fr/gallery" class="block w-20 h-20 rounded-lg overflow-hidden hover:opacity-80 transition-opacity">
              <img src={sanityImageUrl(img.photo.asset._ref, 160)} alt={img.photo?.alt || img.title} class="w-full h-full object-cover" loading="lazy" />
            </a>
          ))}
        </div>
      )}
      <a href="/fr/gallery" class="inline-flex items-center gap-2 text-sm font-medium text-primary-600 hover:text-primary-700 transition-colors">
        Voir la galerie complète →
      </a>
    </div>
  </Section>
</PageLayout>

<script>
  const buttons = document.querySelectorAll('#story-filters button');
  const cards = document.querySelectorAll('.story-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      buttons.forEach(b => {
        b.classList.remove('bg-primary-600', 'text-white');
        b.classList.add('bg-gray-100', 'text-gray-700');
        b.setAttribute('aria-pressed', 'false');
      });
      btn.classList.remove('bg-gray-100', 'text-gray-700');
      btn.classList.add('bg-primary-600', 'text-white');
      btn.setAttribute('aria-pressed', 'true');

      cards.forEach(card => {
        if (filter === 'all' || card.getAttribute('data-category') === filter) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
