---
import PageLayout from '../../../layouts/PageLayout.astro';
import PageHero from '../../../components/layout/PageHero.astro';
import Section from '../../../components/layout/Section.astro';
import StoryReviewNotice from '../../../components/home/StoryReviewNotice.astro';
import { getStoryReviewCopy } from '../../../lib/story-review-notice';

const copy = getStoryReviewCopy('fr');
---

<PageLayout
  title={copy.indexPageTitle}
  description={copy.indexPageDescription}
  ogImage="/brand/ada-logo.png"
  ogImageAlt="Apoti Development Association"
>
  <PageHero
    title={copy.indexPageTitle}
    subtitle={copy.indexHeroSubtitle}
    compact
  />

  <Section background="white" padding="lg">
    <StoryReviewNotice locale="fr" />
  </Section>
</PageLayout>
