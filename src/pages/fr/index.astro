---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/layout/Section.astro";
import CurrentWork from "../../components/home/CurrentWork.astro";
import PhotoMosaic from "../../components/home/PhotoMosaic.astro";
import WorkVideo from "../../components/home/WorkVideo.astro";
import FeaturedStory from "../../components/home/FeaturedStory.astro";
import {
  getImpactMetrics,
  getProjects,
  getTestimonials,
  getBlogPostBySlug,
  getHomePage,
  sanityImageUrl,
  type SanityImpactMetric,
  type SanityProject,
} from "../../lib/sanity";
import { REGISTRATION_NUMBER } from "../../data/organization";
import { homepageStatsFallback } from "../../data/impact";
import { loadSpotlightProjects } from "../../lib/spotlight-projects";
import { loadGalleryMosaic } from "../../lib/gallery";
import { t } from "../../i18n";

const i18n = t("fr");

let heroImageUrl = "";
try {
  const projects = await getProjects("fr");
  if (projects?.length) {
    const preferred =
      projects.find(
        (p: SanityProject) =>
          p.slug?.current === "widow-support" && p.mainImage?.asset?._ref,
      ) ||
      projects.find(
        (p: SanityProject) =>
          p.slug?.current === "education-orphans" && p.mainImage?.asset?._ref,
      ) ||
      projects.find((p: SanityProject) => p.mainImage?.asset?._ref);
    if (preferred?.mainImage?.asset?._ref)
      heroImageUrl = sanityImageUrl(preferred.mainImage.asset._ref, 1200);
  }
} catch {}

let stats = homepageStatsFallback("fr");

try {
  const metrics = await getImpactMetrics("fr");
  if (metrics?.length) {
    const labelMap: Record<string, string> = {
      "Lives Impacted": i18n.stats.livesImpacted,
      "Communities Served": i18n.stats.communitiesServed,
      "Widows Supported": i18n.stats.widowsSupported,
      "Years of Service": i18n.stats.yearsOfService,
    };
    stats = metrics.map((m: SanityImpactMetric) => ({
      value: `${m.value}${m.suffix || ""}`,
      label: labelMap[m.label] || m.label,
    }));
  }
} catch {}

interface Testimonial {
  name: string;
  quote: string;
  location: string;
  program: string;
  photoUrl?: string;
  photoAlt?: string;
}

const fallbackTestimonials: Testimonial[] = [
  {
    name: "Amina N.",
    quote:
      "Après le décès de mon mari, je ne savais pas comment nourrir mes enfants. ADA m'a fourni des colis alimentaires et m'a inscrite à une formation en couture. Aujourd'hui je gère ma propre boutique.",
    location: "Bamenda",
    program: "Programme Veuves",
  },
  {
    name: "Marie F.",
    quote:
      "ADA a payé mes frais de scolarité quand ma grand-mère ne pouvait pas. Ils m'ont donné des livres, un uniforme et un mentor. Je veux devenir infirmière.",
    location: "Douala",
    program: "Éducation des Orphelins",
  },
  {
    name: "Esther K.",
    quote:
      "Le programme de formation m'a appris la coiffure. ADA m'a même aidée à obtenir mes premiers outils. Maintenant j'ai des clients réguliers.",
    location: "Yaoundé",
    program: "Autonomisation des Femmes",
  },
];

let testimonials: Testimonial[] = fallbackTestimonials;
try {
  const data = await getTestimonials("fr");
  if (data?.length) {
    testimonials = data.map((item: any) => ({
      name: item.name,
      quote: item.quote,
      location: item.location || "",
      program: item.program || "",
      photoUrl: item.photo?.asset?._ref
        ? sanityImageUrl(item.photo.asset._ref, 200)
        : undefined,
      photoAlt: item.photo?.alt || item.name,
    }));
  }
} catch {}

let missionCards = [
  {
    icon: "",
    title: "Soutien aux Veuves",
    description:
      "Aide financière, formation professionnelle et accompagnement communautaire pour les veuves qui reconstruisent leur vie.",
  },
  {
    icon: "",
    title: "Éducation",
    description:
      "Fournitures scolaires, frais de scolarité, uniformes et mentorat pour les enfants orphelins et vulnérables.",
  },
  {
    icon: "",
    title: "Autonomisation",
    description:
      "Formation professionnelle, microfinance et appui au démarrage pour les jeunes femmes en quête d'indépendance.",
  },
];
try {
  const home = await getHomePage("fr");
  if (home?.missionCards?.length) {
    missionCards = home.missionCards.map((c) => ({
      icon: c.icon || "",
      title: c.title,
      description: c.description,
    }));
  }
} catch {}

const spotlightProjects = await loadSpotlightProjects("fr", 4);
const mosaicPhotos = await loadGalleryMosaic(8, "fr");

let featuredStory = {
  title:
    "Mama Patience : De la vente de ses dernières marmites à la gestion d'un commerce",
  excerpt:
    "Quand son mari est décédé, Patience a tout perdu. Elle vendait ses marmites une par une pour nourrir ses quatre enfants. Aujourd'hui, grâce à un investissement de 400$ sur 12 mois, elle gère un commerce alimentaire au marché de Bamenda.",
  href: "/fr/stories/why-we-focus-on-widows",
  imageUrl: "",
  imageAlt: "",
};
try {
  const story = await getBlogPostBySlug("why-we-focus-on-widows", "fr");
  if (story) {
    featuredStory = {
      title: story.title || featuredStory.title,
      excerpt: story.excerpt || featuredStory.excerpt,
      href: "/fr/stories/why-we-focus-on-widows",
      imageUrl: story.personPhoto?.asset?._ref
        ? sanityImageUrl(story.personPhoto.asset._ref, 800)
        : "",
      imageAlt: story.personPhoto?.alt || story.title,
    };
  }
} catch {}

const programPillars = [
  {
    title: "Relief pour les veuves",
    text: "Aide alimentaire, soutien financier et suivi des familles qui reconstruisent leur stabilité.",
    href: "/fr/projects/widow-support",
  },
  {
    title: "Éducation des orphelins",
    text: "Frais scolaires, fournitures, uniformes et mentorat pour maintenir les enfants à l'école.",
    href: "/fr/projects/education-orphans",
  },
  {
    title: "Compétences des jeunes femmes",
    text: "Formation professionnelle et appui de départ pour créer des revenus dignes.",
    href: "/fr/projects/women-empowerment",
  },
  {
    title: "Urgence familiale",
    text: "Nourriture, hygiène et soutien ménager rapide pour les familles en crise.",
    href: "/fr/projects/emergency-relief",
  },
  {
    title: "Santé et maternité",
    text: "Appui pratique pour les visites d'hôpital, les soins prénataux et les besoins urgents.",
    href: "/fr/projects/archive/hospital-prenatal-care-jul-2025",
  },
  {
    title: "Développement communautaire",
    text: "Eau potable, environnement et améliorations locales portées par les communautés.",
    href: "/fr/projects/archive",
  },
];

const confidenceProofs = [
  { label: "Enregistrée au Cameroun", value: REGISTRATION_NUMBER },
  {
    label: "Responsabilité diaspora",
    value: "Direction bénévole et exécution locale",
  },
  {
    label: "Documentation ouverte",
    value: "Rapports, politiques et archives de projets disponibles",
  },
  {
    label: "Statut donateur clair",
    value: "Reçus pour vos dossiers, sans promesse fiscale hors Cameroun",
  },
];

const journeyMilestones = [
  {
    year: "2021",
    title: "Fondée à Buea",
    text: "ADA commence à Buea par le soutien alimentaire aux veuves et familles vulnérables.",
  },
  {
    year: "2022",
    title: "Soutien élargi",
    text: "L'aide aux veuves grandit avec la formation, le suivi et l'appui familial.",
  },
  {
    year: "2023",
    title: "Éducation renforcée",
    text: "Les frais scolaires, fournitures et mentors deviennent une priorité centrale.",
  },
  {
    year: "2024",
    title: "Bureau de Bamenda",
    text: "ADA ouvre un bureau à Bamenda et structure rapports, TDR et documents financiers.",
  },
  {
    year: "2025",
    title: "Programmes communautaires",
    text: "Santé, mentorat, environnement et urgence atteignent plus de communautés.",
  },
  {
    year: "2026",
    title: "Partenariats prêts",
    text: "ADA prépare des systèmes plus solides pour les donateurs récurrents et institutions.",
  },
];

const actionPaths = [
  {
    title: "Donner",
    text: "Soutenir l'aide urgente et les programmes durables par un don unique ou mensuel.",
    href: "/fr/donate",
    cta: "Faire un don",
  },
  {
    title: "Bénévolat",
    text: "Offrir du temps, des compétences, de la traduction, du mentorat ou de la collecte de fonds.",
    href: "/fr/get-involved",
    cta: "S'impliquer",
  },
  {
    title: "Partenariat",
    text: "Sponsoriser un programme ciblé avec options claires, rapports et diligence raisonnable.",
    href: "/fr/sponsor",
    cta: "Sponsoriser un programme",
  },
  {
    title: "Rapports",
    text: "Lire les rapports annuels, politiques et documents de projet avant de financer.",
    href: "/fr/resources",
    cta: "Voir les ressources",
  },
];
---

<PageLayout
  title="Autonomiser les Communautés au Cameroun"
  description="Association caritative chrétienne soutenant les veuves, orphelins et jeunes femmes au Cameroun depuis 2021."
>
  <!-- Hallmark · genre: editorial · macrostructure: Photographic · design-system: design.md · designed-as-app -->
  <section class="relative overflow-hidden min-h-[70vh] flex items-end text-white">
    {
      heroImageUrl ? (
        <img
          src={heroImageUrl}
          alt="Bénéficiaires des programmes ADA au Cameroun"
          class="absolute inset-0 w-full h-full object-cover"
          loading="eager"
        />
      ) : (
        <div class="absolute inset-0 bg-primary-900" />
      )
    }
    <div
      class="absolute inset-0 bg-gradient-to-r from-primary-950/95 via-primary-900/70 to-primary-900/25"
    >
    </div>
    <div class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="max-w-2xl">
        <p
          class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-200 mb-4"
        >
          {i18n.hero.badge}
        </p>
        <h1
          class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-heading font-bold leading-[1.1] tracking-tight"
        >
          {i18n.hero.headline}
        </h1>
        <p class="mt-5 text-base md:text-lg text-white/85 leading-relaxed max-w-xl">
          {i18n.hero.subtitle}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="/fr/donate"
            class="font-heading inline-flex items-center px-5 py-2.5 text-sm font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors"
          >
            {i18n.hero.cta}
          </a>
          <a
            href="/fr/projects"
            class="font-heading inline-flex items-center px-5 py-2.5 text-sm font-semibold text-white border border-white/40 rounded-md hover:bg-white/10 transition-colors"
          >
            {i18n.hero.ctaSecondary}
          </a>
          <a
            href="/fr/transparency"
            class="font-heading text-sm font-semibold text-white/90 underline decoration-white/40 underline-offset-4 hover:text-white"
          >
            Transparence
          </a>
        </div>
        <p class="mt-6 text-sm text-white/75">
          {
            stats
              .slice(0, 2)
              .map((stat) => `${stat.value} ${stat.label}`)
              .join(" · ")
          }
          {" · "}80% aux programmes
        </p>
      </div>
    </div>
  </section>

  <CurrentWork locale="fr" projects={spotlightProjects} />
  <PhotoMosaic locale="fr" photos={mosaicPhotos} />
  <WorkVideo locale="fr" />

  <Section background="white" padding="md">
    <div
      class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-4 border-y border-gray-200 py-8"
    >
      {
        stats.map((stat) => (
          <div>
            <p class="font-heading text-3xl md:text-4xl font-bold text-primary-700 tracking-tight">
              {stat.value}
            </p>
            <p class="mt-1 text-sm text-gray-600">{stat.label}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-gray-500">
      85% des bénéficiaires sont des femmes et des filles · 5% de frais
      administratifs · Enregistrement ONG Cameroun {REGISTRATION_NUMBER} ·{" "}
      <a
        href="/fr/transparency"
        class="text-primary-700 underline underline-offset-2"
        >Rapport de transparence</a
      >
    </p>
  </Section>

  <Section background="gray" padding="md">
    <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-10 items-start">
      <div>
        <p
          class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700"
        >
          Confiance des partenaires
        </p>
        <h2
          class="mt-3 text-2xl md:text-3xl font-heading font-bold text-gray-900 tracking-tight"
        >
          Assez proche pour connaître les familles. Assez organisée pour montrer
          les preuves.
        </h2>
        <p class="mt-4 text-gray-600 leading-relaxed">
          ADA combine des relations locales au Cameroun avec une gouvernance
          bénévole, des dossiers de projet et une communication claire avec les
          donateurs.
        </p>
      </div>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-gray-200 border border-gray-200">
        {
          confidenceProofs.map((item) => (
            <div class="bg-[#f7f5f0] p-5">
              <dt class="font-heading text-xs font-semibold uppercase tracking-wider text-gray-500">
                {item.label}
              </dt>
              <dd class="mt-2 text-sm font-semibold text-gray-900 leading-relaxed">
                {item.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <Section background="white" padding="lg">
    <div class="max-w-3xl">
      <p
        class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700"
      >
        Comment nous servons
      </p>
      <h2
        class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight"
      >
        Des chemins concrets pour les familles vulnérables
      </h2>
      <p class="mt-4 text-gray-600 leading-relaxed">
        Chaque programme commence par un besoin immédiat, puis avance vers la
        dignité, la stabilité et l'autonomie.
      </p>
    </div>
    <ul class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-0 border-t border-gray-200">
      {
        programPillars.map((pillar) => (
          <li class="border-b border-gray-200">
            <a
              href={pillar.href}
              class="group flex items-baseline justify-between gap-4 py-5"
            >
              <div>
                <h3 class="font-heading text-lg font-semibold text-gray-900 group-hover:text-primary-700 transition-colors">
                  {pillar.title}
                </h3>
                <p class="mt-1 text-sm text-gray-600 leading-relaxed">
                  {pillar.text}
                </p>
              </div>
              <span
                class="font-heading text-sm font-semibold text-primary-700 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section background="gray" padding="lg">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <div>
        <p
          class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700"
        >
          Leadership et gouvernance
        </p>
        <blockquote
          class="mt-4 text-xl md:text-2xl font-heading font-bold text-gray-900 leading-snug tracking-tight"
        >
          « La foi doit devenir soin pratique, dossiers fiables et service
          responsable. »
        </blockquote>
        <p class="mt-5 text-gray-600 leading-relaxed">
          ADA est dirigée par une équipe exécutive bénévole, un conseil de 12
          membres et une coordination locale au Cameroun.
        </p>
      </div>
      <div>
        <h2
          class="text-2xl md:text-3xl font-heading font-bold text-gray-900 tracking-tight"
        >
          Relations locales, responsabilité visible
        </h2>
        <p class="mt-4 text-gray-600 leading-relaxed">
          Les programmes sont coordonnés avec les veuves, les familles, les
          écoles, les églises, les bénévoles et les partenaires communautaires
          pour répondre à des besoins documentés.
        </p>
        <dl class="mt-6 grid grid-cols-3 gap-4 border-t border-gray-200 pt-6">
          <div>
            <dt
              class="font-heading text-xs font-semibold uppercase tracking-wider text-gray-500"
            >
              Conseil
            </dt>
            <dd class="mt-1 font-heading text-lg font-bold text-primary-700">
              12 membres
            </dd>
          </div>
          <div>
            <dt
              class="font-heading text-xs font-semibold uppercase tracking-wider text-gray-500"
            >
              Terrain
            </dt>
            <dd class="mt-1 font-heading text-lg font-bold text-primary-700">
              Cameroun
            </dd>
          </div>
          <div>
            <dt
              class="font-heading text-xs font-semibold uppercase tracking-wider text-gray-500"
            >
              Contrôle
            </dt>
            <dd class="mt-1 font-heading text-lg font-bold text-primary-700">
              Double rôle
            </dd>
          </div>
        </dl>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/fr/about"
            class="font-heading text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
            >Lire notre histoire</a
          >
          <a
            href="/fr/transparency"
            class="font-heading text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
            >Voir la gouvernance</a
          >
        </div>
      </div>
    </div>
  </Section>

  <Section background="white" padding="lg">
    <div class="max-w-3xl">
      <p
        class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700"
      >
        Parcours ADA
      </p>
      <h2
        class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight"
      >
        Des premiers colis alimentaires à une transparence prête pour les
        partenaires
      </h2>
      <p class="mt-4 text-gray-600 leading-relaxed">
        ADA grandit en répondant aux besoins réels des communautés et en
        documentant le travail au fur et à mesure.
      </p>
    </div>
    <ol class="mt-10 max-w-3xl space-y-0 list-none border-l border-gray-200 ml-1">
      {
        journeyMilestones.map((item) => (
          <li class="relative pl-8 pb-8 last:pb-0">
            <span
              class="absolute left-0 top-1.5 -translate-x-1/2 w-2 h-2 rounded-sm bg-primary-600 border border-[#f7f5f0]"
              aria-hidden="true"
            />
            <p class="font-heading text-sm font-bold text-primary-700">
              {item.year}
            </p>
            <h3 class="mt-1 font-heading text-base font-semibold text-gray-900">
              {item.title}
            </h3>
            <p class="mt-1 text-sm text-gray-600 leading-relaxed">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section background="gray" padding="lg">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.1fr] gap-10 items-start">
      <div>
        <h2
          class="text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight"
        >
          {i18n.mission.heading}
        </h2>
        <p class="mt-4 text-lg text-gray-600 leading-relaxed">
          {i18n.mission.body}
        </p>
      </div>
      <ul class="space-y-0 border-t border-gray-200">
        {
          missionCards.map((card) => (
            <li class="border-b border-gray-200 py-5">
              <h3 class="font-heading text-lg font-semibold text-gray-900">
                {card.title}
              </h3>
              <p class="mt-1 text-sm text-gray-600 leading-relaxed">
                {card.description}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <FeaturedStory
    locale="fr"
    title={featuredStory.title}
    excerpt={featuredStory.excerpt}
    href={featuredStory.href}
    imageUrl={featuredStory.imageUrl}
    imageAlt={featuredStory.imageAlt}
  />

  <Section background="white" padding="lg">
    <p
      class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700"
    >
      Voix du terrain
    </p>
    <h2
      class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight"
    >
      {i18n.testimonials.heading}
    </h2>
    {
      testimonials[0] && (
        <figure class="mt-10 max-w-3xl">
          <blockquote class="text-xl md:text-2xl text-gray-800 leading-relaxed">
            « {testimonials[0].quote} »
          </blockquote>
          <figcaption class="mt-6 flex items-center gap-3">
            {testimonials[0].photoUrl ? (
              <img
                src={testimonials[0].photoUrl}
                alt={testimonials[0].photoAlt || testimonials[0].name}
                class="w-12 h-12 rounded-md object-cover border border-gray-200"
                loading="lazy"
              />
            ) : (
              <div class="w-12 h-12 rounded-md bg-primary-100 text-primary-700 flex items-center justify-center text-sm font-heading font-bold border border-primary-200">
                {testimonials[0].name.charAt(0)}
              </div>
            )}
            <div>
              <p class="font-heading text-sm font-semibold text-gray-900">
                {testimonials[0].name}
              </p>
              <p class="text-xs text-gray-500">
                {testimonials[0].program}
                {testimonials[0].location
                  ? ` · ${testimonials[0].location}`
                  : ""}
              </p>
            </div>
          </figcaption>
        </figure>
      )
    }
    {
      testimonials.length > 1 && (
        <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8 border-t border-gray-200 pt-10">
          {testimonials.slice(1, 3).map((te) => (
            <figure>
              <blockquote class="text-base text-gray-700 leading-relaxed">
                « {te.quote} »
              </blockquote>
              <figcaption class="mt-4 flex items-center gap-3">
                {te.photoUrl ? (
                  <img
                    src={te.photoUrl}
                    alt={te.photoAlt || te.name}
                    class="w-10 h-10 rounded-md object-cover border border-gray-200"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-10 h-10 rounded-md bg-primary-100 text-primary-700 flex items-center justify-center text-xs font-heading font-bold border border-primary-200">
                    {te.name.charAt(0)}
                  </div>
                )}
                <div>
                  <p class="font-heading text-sm font-semibold text-gray-900">
                    {te.name}
                  </p>
                  <p class="text-xs text-gray-500">
                    {te.program}
                    {te.location ? ` · ${te.location}` : ""}
                  </p>
                </div>
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }
  </Section>

  <Section background="gray" padding="lg">
    <div class="max-w-3xl">
      <p
        class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700"
      >
        Rejoindre le travail
      </p>
      <h2
        class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight"
      >
        Choisissez la façon d'aider qui vous correspond
      </h2>
    </div>
    <ul class="mt-8 max-w-3xl divide-y divide-gray-200 border-y border-gray-200">
      {
        actionPaths.map((path) => (
          <li>
            <a
              href={path.href}
              class="group flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-6 py-5"
            >
              <div>
                <h3 class="font-heading text-lg font-semibold text-gray-900 group-hover:text-primary-700 transition-colors">
                  {path.title}
                </h3>
                <p class="mt-1 text-sm text-gray-600 leading-relaxed">
                  {path.text}
                </p>
              </div>
              <span class="font-heading text-sm font-semibold text-primary-700 shrink-0">
                {path.cta} →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section background="dark" padding="lg" class="!bg-[#121a14] !bg-none">
    <div class="max-w-2xl">
      <h2
        class="text-3xl md:text-4xl font-heading font-bold tracking-tight text-left"
      >
        {i18n.cta.heading}
      </h2>
      <p class="mt-4 text-lg text-white/80 text-left">{i18n.cta.body}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/fr/donate"
          class="font-heading inline-flex items-center px-5 py-2.5 text-sm font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors"
        >
          {i18n.cta.donate}
        </a>
        <a
          href="/fr/get-involved"
          class="font-heading text-sm font-semibold text-white/90 underline decoration-white/40 underline-offset-4 hover:text-white"
        >
          {i18n.cta.volunteer}
        </a>
      </div>
    </div>
  </Section>
</PageLayout>
