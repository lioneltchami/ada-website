---
import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/layout/Section.astro";
import CurrentWork from "../../components/home/CurrentWork.astro";
import OutreachPhoto from "../../components/media/OutreachPhoto.astro";
import { getArchiveFeaturePhoto } from "../../data/archive-feature-photos";
import { getArchiveSupportingPhotos } from "../../data/archive-supporting-photos";
import HomeHero from "../../components/home/HomeHero.astro";
import HomepageOutreachPhotos from "../../components/home/HomepageOutreachPhotos.astro";
import WorkVideo from "../../components/home/WorkVideo.astro";
import StoryReviewNotice from "../../components/home/StoryReviewNotice.astro";
import {
  getProjects,
  getTestimonials,
  type SanityProject,
} from "../../lib/sanity";
import { REGISTRATION_NUMBER } from "../../data/organization";
import { listUpcomingAnnouncements } from "../../lib/upcoming-announcements";

let homepageProjects: SanityProject[] = [];
try {
  homepageProjects = await getProjects("fr");
} catch {}

interface Testimonial {
  name: string;
  quote: string;
  location: string;
  program: string;
}

let testimonials: Testimonial[] = [];
try {
  const data = await getTestimonials("fr");
  if (data?.length) {
    testimonials = data.map((item: any) => ({
      name: item.name,
      quote: item.quote,
      location: item.location || "",
      program: item.program || "",
    }));
  }
} catch {}

const announcements = listUpcomingAnnouncements(homepageProjects, { locale: "fr" });

const programPillars = [
  {
    title: "Soutien aux veuves",
    photo: getArchiveSupportingPhotos("widow-support-food-cash-mar-2022", "fr")[0],
    text: "À Muea, en 2022, notre équipe a rendu visite à environ 20 veuves et leur a apporté des vivres et des articles de première nécessité.",
    outreach: "/fr/projects/archive/widow-support-food-cash-mar-2022/",
    outreachLabel: "Dossier des visites aux veuves",
    report: "/docs/projects/widow-support-food-cash-mar-2022/report.pdf",
    reportLabel: "Rapport des visites aux veuves (PDF)",
  },
  {
    title: "Dignité et apprentissage des adolescentes",
    photo: getArchiveSupportingPhotos("idp-girls-baking-training-jul-2022", "fr")[0],
    photoHref: "/fr/projects/archive/idp-girls-baking-training-jul-2022/",
    photoLabel: "Atelier de pâtisserie pour les filles (2022)",
    text: "À Bamenda, en 2026, les 20 adolescentes présentes à la rencontre sur la santé menstruelle ont chacune reçu un kit.",
    outreach: "/fr/projects/archive/girls-dignity-menstrual-health-bamenda-jun-2026/",
    outreachLabel: "Dossier de l’action pour les adolescentes",
    report: "/docs/projects/girls-dignity-menstrual-health-bamenda-jun-2026/report.pdf",
    reportLabel: "Rapport sur la dignité des adolescentes (PDF)",
  },
  {
    title: "Soutien aux mères",
    photo: getArchiveFeaturePhoto("prenatal-care-support-program", "fr"),
    text: "À Muea, en 2025, nous avons apporté des articles essentiels à environ 15 mères et à leurs nouveau-nés lors d’une visite à l’hôpital.",
    outreach: "/fr/projects/archive/prenatal-care-support-program/",
    outreachLabel: "Dossier de l’action auprès des mères",
    report: "/docs/projects/prenatal-care-support-program/report.pdf",
    reportLabel: "Rapport du soutien aux mères (PDF)",
  },
];

const confidenceProofs = [
  { label: "Enregistrée au Cameroun", value: REGISTRATION_NUMBER },
  {
    label: "Direction bénévole",
    value: "Programmes menés localement au Cameroun",
  },
  {
    label: "Nos actions documentées",
    value: "Comptes rendus, rapports financiers et bilans annuels",
    href: "/fr/resources/",
    link: "Consulter les documents",
  },
  {
    label: "Statut donateur clair",
    value: "Reçus pour vos dossiers, sans promesse fiscale hors Cameroun",
  },
];

const journeyMilestones = [
  {
    year: "2021",
    title: "Fondée à Buea",
    text: "ADA commence à Buea par le soutien alimentaire aux veuves et familles vulnérables.",
  },
  {
    year: "2022",
    title: "Soutien communautaire",
    text: "L'aide alimentaire et familiale est restée un volet du travail d'ADA.",
  },
  {
    year: "2023",
    title: "Soutien aux élèves et aux adolescentes",
    text: "À Buea, nous avons organisé une action de rentrée scolaire et marqué la Journée internationale de la fille.",
  },
  {
    year: "2024",
    title: "Une nouvelle action pour les adolescentes à Buea",
    text: "Nous avons renouvelé notre action à l’occasion de la Journée internationale de la fille.",
  },
  {
    year: "2025",
    title: "Début de nos actions à Bamenda",
    text: "Nous avons commencé à intervenir à Bamenda en 2025. À Muea, notre équipe a apporté des articles essentiels aux mères et à leurs nouveau-nés.",
  },
  {
    year: "2026",
    title: "Partenariats prêts",
    text: "ADA prépare des systèmes plus solides pour les donateurs récurrents et institutions.",
  },
];

const actionPaths = [
  {
    title: "Donner",
    text: "Soutenir nos actions au Cameroun par un don unique ou mensuel.",
    href: "/fr/donate",
    cta: "Faire un don",
  },
  {
    title: "Bénévolat",
    text: "Offrir du temps, des compétences, de la traduction, du mentorat ou de la collecte de fonds.",
    href: "/fr/get-involved",
    cta: "S'impliquer",
  },
  {
    title: "Partenariat",
    text: "Soutenir une action précise et convenir avec nous du budget et du compte rendu.",
    href: "/fr/sponsor",
    cta: "Sponsoriser un programme",
  },
  {
    title: "Rapports",
    text: "Lire les rapports annuels, politiques et documents de projet avant de financer.",
    href: "/fr/resources",
    cta: "Voir les ressources",
  },
];
---

<PageLayout
  title="Apoti Development Association | Espoir, dignité, autonomisation"
  description="Organisation humanitaire chrétienne au Cameroun. Nos équipes locales soutiennent les veuves, les mères et les adolescentes."
>
  <HomeHero locale="fr">
    <p
      class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-200 mb-4"
    >
      Organisation humanitaire chrétienne · Cameroun
    </p>
    <h1
      class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-heading font-bold leading-[1.1] tracking-tight"
    >
      Un soutien concret aux femmes et aux adolescentes au Cameroun
    </h1>
    <p class="mt-5 text-base md:text-lg text-white/85 leading-relaxed max-w-xl">
      Notre foi chrétienne nous pousse à servir les veuves, les mères et les adolescentes.
    </p>
    <a
      slot="partner"
      href="/fr/sponsor/"
      class="mt-1 inline-flex min-h-11 items-center text-sm font-semibold text-white underline decoration-white/70 underline-offset-4 hover:decoration-current"
    >
      Devenir partenaire
    </a>
  </HomeHero>

  <Section background="white" padding="lg">
    <div class="max-w-3xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Comment nous servons
      </p>
      <h2 id="home-our-work" class="scroll-mt-24 mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Des actions ancrées dans les besoins du terrain
      </h2>
      <p class="mt-4 text-gray-600 leading-relaxed">
        Notre foi motive notre engagement. Il n’est pas nécessaire de participer à une prière ou à une autre activité religieuse pour recevoir de l’aide.
      </p>
    </div>
    <ul class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-3">
      {
        programPillars.map((pillar) => (
          <li class="flex flex-col overflow-hidden rounded-xl border border-primary-200 bg-[#f7f5f0]">
            {pillar.photo && (
              <a href={pillar.photoHref || pillar.outreach} aria-label={pillar.photoLabel || pillar.outreachLabel} class="group relative isolate block focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-white">
                <img src={pillar.photo.src} width={pillar.photo.width} height={pillar.photo.height} alt={pillar.photo.alt}
                  loading="lazy" decoding="async" class="aspect-[3/2] w-full bg-primary-50 object-cover" />
                <span class="absolute inset-x-0 bottom-0 bg-primary-950/90 px-4 py-3 font-heading text-base font-semibold text-white group-hover:underline sm:text-lg">{pillar.photoLabel || pillar.title} <span aria-hidden="true">→</span></span>
              </a>
            )}
            <div class="flex flex-1 flex-col p-5 sm:p-6">
              <h3 class="font-heading text-xl font-semibold text-gray-900">{pillar.title}</h3>
              <p class="mt-2 flex-1 text-sm text-gray-700 leading-relaxed">{pillar.text}</p>
              <a href={pillar.outreach} class="mt-4 w-fit text-sm font-semibold text-primary-800 underline underline-offset-4 hover:text-primary-950">{pillar.outreachLabel}</a>
              <a href={pillar.report} class="mt-2 w-fit text-sm text-primary-800 underline underline-offset-4 hover:text-primary-950">{pillar.reportLabel}</a>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-sm text-gray-700">
      Les actions menées auprès d’un public plus large restent accessibles dans les{" "}
      <a href="/fr/projects/archive/" class="font-semibold text-primary-800 underline underline-offset-4">archives des actions</a>.
    </p>
  </Section>

  <CurrentWork locale="fr" projects={[]} announcements={announcements} />
  <WorkVideo locale="fr" />
  <HomepageOutreachPhotos locale="fr" />

  <Section background="gray" padding="md">
    <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-10 items-start">
      <div>
        <p
          class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700"
        >
          Confiance des partenaires
        </p>
        <h2
          class="mt-3 text-2xl md:text-3xl font-heading font-bold text-gray-900 tracking-tight"
        >
          Proches des communautés, transparents sur nos actions.
        </h2>
        <p class="mt-4 text-gray-600 leading-relaxed">
          ADA combine des relations locales au Cameroun avec une gouvernance
          bénévole, des dossiers de projet et une communication claire avec les
          donateurs.
        </p>
      </div>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-gray-200 border border-gray-200">
        {
          confidenceProofs.map((item) => (
            <div class="bg-[#f7f5f0] p-5">
              <dt class="font-heading text-xs font-semibold uppercase tracking-wider text-gray-500">
                {item.label}
              </dt>
              <dd class="mt-2 text-sm font-semibold text-gray-900 leading-relaxed">
                {item.value}
                {item.href && (
                  <a href={item.href} class="mt-2 block w-fit text-primary-800 underline underline-offset-2 hover:text-primary-950">
                    {item.link}
                  </a>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <Section background="gray" padding="lg">
    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.25fr)_minmax(0,1fr)]">
      <div>
        <p
          class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700"
        >
          Leadership et gouvernance
        </p>
        <blockquote
          class="mt-4 text-xl md:text-2xl font-heading font-bold text-gray-900 leading-snug tracking-tight"
        >
          « La foi doit devenir soin pratique, dossiers fiables et service
          responsable. »
        </blockquote>
        <p class="mt-5 text-gray-600 leading-relaxed">
          ADA est dirigée par une équipe exécutive bénévole, un conseil de 12
          membres et une coordination locale au Cameroun.
        </p>
      </div>
      <div>
        <h2
          class="text-2xl md:text-3xl font-heading font-bold text-gray-900 tracking-tight"
        >
          Relations locales, responsabilité visible
        </h2>
        <p class="mt-4 text-gray-600 leading-relaxed">
          Nous écoutons les femmes et les adolescentes et travaillons avec les églises, les écoles, les bénévoles et les partenaires locaux pour répondre à des besoins concrets.
        </p>
        <dl class="mt-6 grid grid-cols-3 gap-4 border-t border-gray-200 pt-6">
          <div>
            <dt
              class="font-heading text-xs font-semibold uppercase tracking-wider text-gray-500"
            >
              Conseil
            </dt>
            <dd class="mt-1 font-heading text-lg font-bold text-primary-700">
              12 membres
            </dd>
          </div>
          <div>
            <dt
              class="font-heading text-xs font-semibold uppercase tracking-wider text-gray-500"
            >
              Terrain
            </dt>
            <dd class="mt-1 font-heading text-lg font-bold text-primary-700">
              Cameroun
            </dd>
          </div>
          <div>
            <dt
              class="font-heading text-xs font-semibold uppercase tracking-wider text-gray-500"
            >
              Contrôle
            </dt>
            <dd class="mt-1 font-heading text-lg font-bold text-primary-700">
              Double rôle
            </dd>
          </div>
        </dl>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/fr/about"
            class="font-heading text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
            >Lire notre histoire</a
          >
          <a
            href="/fr/transparency"
            class="font-heading text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
            >Voir la gouvernance</a
          >
        </div>
      </div>
      <OutreachPhoto record="city-cleanup-may-2025" locale="fr" class="max-w-md" />
    </div>
  </Section>

  <Section background="white" padding="lg">
    <div class="max-w-3xl">
      <p
        class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700"
      >
        Parcours ADA
      </p>
      <h2
        class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight"
      >
        Des premiers colis alimentaires à une transparence prête pour les
        partenaires
      </h2>
      <p class="mt-4 text-gray-600 leading-relaxed">
        ADA grandit en répondant aux besoins réels des communautés et en
        documentant le travail au fur et à mesure.
      </p>
    </div>
    <ol class="mt-10 max-w-3xl space-y-0 list-none border-l border-gray-200 ml-1">
      {
        journeyMilestones.map((item) => (
          <li class="relative pl-8 pb-8 last:pb-0">
            <span
              class="absolute left-0 top-1.5 -translate-x-1/2 w-2 h-2 rounded-sm bg-primary-600 border border-[#f7f5f0]"
              aria-hidden="true"
            />
            <p class="font-heading text-sm font-bold text-primary-700">
              {item.year}
            </p>
            <h3 class="mt-1 font-heading text-base font-semibold text-gray-900">
              {item.title}
            </h3>
            <p class="mt-1 text-sm text-gray-600 leading-relaxed">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <StoryReviewNotice locale="fr" variant="featured" />

  {testimonials.length > 0 && (
  <Section background="white" padding="lg">
    <p
      class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700"
    >
      Voix du terrain
    </p>
    <h2
      class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight"
    >
      Histoires du terrain
    </h2>
    {
      testimonials[0] && (
        <figure class="mt-10 max-w-3xl">
          <blockquote class="text-xl md:text-2xl text-gray-800 leading-relaxed">
            « {testimonials[0].quote} »
          </blockquote>
          <figcaption class="mt-6 flex items-center gap-3">
            <div class="w-12 h-12 rounded-md bg-primary-100 text-primary-700 flex items-center justify-center text-sm font-heading font-bold border border-primary-200">
              {testimonials[0].name.charAt(0)}
            </div>
            <div>
              <p class="font-heading text-sm font-semibold text-gray-900">
                {testimonials[0].name}
              </p>
              <p class="text-xs text-gray-500">
                {testimonials[0].program}
                {testimonials[0].location
                  ? ` · ${testimonials[0].location}`
                  : ""}
              </p>
            </div>
          </figcaption>
        </figure>
      )
    }
    {
      testimonials.length > 1 && (
        <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8 border-t border-gray-200 pt-10">
          {testimonials.slice(1, 3).map((te) => (
            <figure>
              <blockquote class="text-base text-gray-700 leading-relaxed">
                « {te.quote} »
              </blockquote>
              <figcaption class="mt-4 flex items-center gap-3">
                <div class="w-10 h-10 rounded-md bg-primary-100 text-primary-700 flex items-center justify-center text-xs font-heading font-bold border border-primary-200">
                  {te.name.charAt(0)}
                </div>
                <div>
                  <p class="font-heading text-sm font-semibold text-gray-900">
                    {te.name}
                  </p>
                  <p class="text-xs text-gray-500">
                    {te.program}
                    {te.location ? ` · ${te.location}` : ""}
                  </p>
                </div>
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }
  </Section>
  )}

  <Section background="gray" padding="lg">
    <div class="max-w-3xl">
      <p
        class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700"
      >
        Rejoindre le travail
      </p>
      <h2
        class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight"
      >
        Choisissez la façon d'aider qui vous correspond
      </h2>
    </div>
    <ul class="mt-8 max-w-3xl divide-y divide-gray-200 border-y border-gray-200">
      {
        actionPaths.map((path) => (
          <li>
            <a
              href={path.href}
              class="group flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-6 py-5"
            >
              <div>
                <h3 class="font-heading text-lg font-semibold text-gray-900 group-hover:text-primary-700 transition-colors">
                  {path.title}
                </h3>
                <p class="mt-1 text-sm text-gray-600 leading-relaxed">
                  {path.text}
                </p>
              </div>
              <span class="font-heading text-sm font-semibold text-primary-700 shrink-0">
                {path.cta} →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section background="dark" padding="lg" class="!bg-[#121a14] !bg-none">
    <div class="max-w-2xl">
      <h2
        class="text-3xl md:text-4xl font-heading font-bold tracking-tight text-left"
      >
        Soutenir nos actions au Cameroun
      </h2>
      <p class="mt-4 text-lg text-white/80 text-left">Votre don au fonds général aide nos équipes locales à répondre aux besoins prioritaires de nos actions approuvées.</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/fr/donate"
          class="font-heading inline-flex min-h-11 items-center px-5 py-2.5 text-sm font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors"
        >
          Faire un don
        </a>
        <a
          href="/fr/get-involved"
          class="font-heading text-sm font-semibold text-white/90 underline decoration-white/40 underline-offset-4 hover:text-white"
        >
          Devenir bénévole
        </a>
      </div>
    </div>
  </Section>
</PageLayout>
