---
import PageLayout from "../../../layouts/PageLayout.astro";
import Section from "../../../components/layout/Section.astro";
import DonationForm from "../../../components/islands/DonationForm";
import {
  getProjects,
  getSiteSettings,
  type SanityProject,
} from "../../../lib/sanity";
import {
  getProjectLifecycleState,
  isProjectFundable,
} from "../../../lib/project-lifecycle";
import {
  mergeProjectLists,
  normalizeFallbackProjects,
} from "../../../lib/project-fallbacks";
import { t } from "../../../i18n";
import { DONATION_FAQS_FR, buildFaqPage } from "../../../lib/structured-data";
import FaqSection from "../../../components/seo/FaqSection.astro";

const i18n = t("fr");

let contactEmail = "info@apotidev.org";
try {
  const s = await getSiteSettings("fr");
  if (s?.contactEmail) contactEmail = s.contactEmail;
} catch {}

const trustIndicators = [
  { text: "Don en ligne sécurisé", sub: "Paiements traités par Stripe" },
  {
    text: "Objectif de 80 % pour les programmes",
    sub: "Cible publique d'allocation, pas un ratio audité des dépenses",
  },
];

const currentCampaignNeeds = [
  "Nourriture d'urgence et essentiels pour veuves et enfants",
  "Soutien scolaire, uniformes et fournitures pour élèves vulnérables",
  "Transport et suivi sur le terrain pour que l'aide atteigne les familles directement",
];

const otherWaysToGive = [
  {
    title: i18n.donate.inKind,
    description: `Contactez <a href="mailto:${contactEmail}" class="text-primary-600 hover:underline">${contactEmail}</a> pour organiser des biens ou des fournitures.`,
  },
  {
    title: i18n.donate.matching,
    description: i18n.donate.matchingDesc,
  },
  {
    title: "Parrainages",
    description:
      '<a href="/fr/sponsor" class="text-primary-600 hover:underline">Sponsorisez un programme ciblé</a> et recevez des reçus et des mises à jour claires.',
  },
  {
    title: i18n.donate.legacy,
    description: `<a href="/fr/contact?subject=Legs+et+Donations" class="text-primary-600 hover:underline">${i18n.donate.legacyDesc}</a>`,
  },
];

// Les exemples de coût par montant sont omis tant que chaque correspondance
// entre montant et résultat n'a pas une source documentée partageable.

let projectOptions: { slug: string; title: string }[] =
  normalizeFallbackProjects({ locale: "fr" })
    .filter((p) => isProjectFundable(p.status))
    .map((p) => ({ slug: p.slug, title: p.title }));

try {
  const projects = await getProjects("fr");
  if (projects?.length) {
    projectOptions = mergeProjectLists(
      projects
        .filter((p: SanityProject) =>
          isProjectFundable(
            getProjectLifecycleState(p, { locale: "fr" }).status,
          ),
        )
        .map((p: SanityProject) => ({
          slug: p.slug.current,
          title: p.title,
        })),
      projectOptions,
    );
  }
} catch {}

const donationFaqs = DONATION_FAQS_FR;
const faqPageSchema = buildFaqPage(
  donationFaqs,
  new URL("/fr/donate", Astro.site).toString(),
);
---

<PageLayout
  title="Faire un Don"
  description="Soutenez les programmes d'Apoti Development Association auprès des communautés vulnérables au Cameroun. Don ponctuel ou mensuel par paiement sécurisé."
  jsonLdExtra={[faqPageSchema]}
>
  <!-- Hallmark · genre: editorial · macrostructure: Split Studio · design-system: design.md · designed-as-app -->

  <!-- Split Studio: proof + form -->
  <Section background="white" padding="lg">
    <div
      class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-6 lg:gap-x-14 lg:gap-y-5 items-start"
    >
      <div class="min-w-0 lg:col-start-1 lg:row-start-1">
        <p
          class="text-xs font-semibold uppercase tracking-wider text-primary-700"
        >
          {i18n.donate.badge}
        </p>
        <h1
          class="mt-3 text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-gray-950 leading-tight tracking-tight"
        >
          {i18n.donate.title}
        </h1>
        <p class="mt-5 text-lg text-gray-600 leading-relaxed max-w-xl">
          {i18n.donate.subtitle}
        </p>
      </div>

      <div
        id="donation-form"
        class="min-w-0 scroll-mt-24 rounded-md border border-gray-200 bg-gray-50 p-5 md:p-6 lg:col-start-2 lg:row-start-1 lg:row-span-2"
      >
        <DonationForm client:load projects={projectOptions} locale="fr" />
      </div>

      <div class="min-w-0 lg:col-start-1 lg:row-start-2">
        <ul
          class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-gray-200 pt-5"
        >
          {
            trustIndicators.map((item) => (
              <li class="min-w-0">
                <p class="text-sm font-semibold text-gray-900">{item.text}</p>
                <p class="mt-1 text-sm text-gray-600 leading-relaxed">
                  {item.sub}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- Records and Reporting -->
  <Section background="white" padding="md">
    <div
      class="max-w-5xl mx-auto flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="max-w-2xl">
        <p
          class="text-xs font-semibold uppercase tracking-wider text-primary-700"
        >
          Confiance des donateurs
        </p>
        <h2
          class="mt-2 text-xl md:text-2xl font-heading font-bold text-gray-900"
        >
          Consulter nos documents
        </h2>
        <p class="mt-2 text-sm text-gray-600 leading-relaxed">
          Consultez les résumés financiers, les politiques et les dossiers de
          projets terminés publiés par ADA.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <a
          href="/fr/transparency"
          class="inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-primary-600 rounded-md hover:bg-primary-700 transition-colors"
          >Voir les rapports</a
        >
        <a
          href="/fr/projects/archive"
          class="inline-flex items-center px-4 py-2 text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
          >Projets terminés</a
        >
      </div>
    </div>
  </Section>

  <!-- Current Campaign -->
  <Section background="gray" padding="md">
    <div
      class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-[1fr_0.8fr] gap-5 items-stretch"
    >
      <div class="bg-white rounded-md border border-gray-200 p-5 md:p-6">
        <p
          class="text-xs font-semibold uppercase tracking-wider text-primary-700"
        >
          Campagne en cours
        </p>
        <h2
          class="mt-3 text-2xl md:text-3xl font-heading font-bold text-gray-900"
        >
          Soutien aux veuves et familles au Cameroun
        </h2>
        <p class="mt-3 text-sm md:text-base text-gray-600 leading-relaxed">
          Cette saison, les dons non restreints sont priorisés pour un
          soulagement pratique qui stabilise les ménages vulnérables :
          nourriture, soutien scolaire, fournitures essentielles et visites sur
          le terrain pour les familles que ADA sert déjà.
        </p>
        <ul class="mt-4 space-y-2">
          {
            currentCampaignNeeds.map((need) => (
              <li class="flex gap-3 text-sm text-gray-700">
                <span
                  class="mt-1 h-2 w-2 rounded-full bg-primary-500 flex-shrink-0"
                  aria-hidden="true"
                />
                <span>{need}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href="#donation-form"
            class="inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors"
            >Donner à cette campagne</a
          >
          <a
            href="/fr/projects/widow-support"
            class="inline-flex items-center px-4 py-2 text-sm font-semibold text-primary-700 bg-primary-50 rounded-lg hover:bg-primary-100 transition-colors"
            >Voir le projet</a
          >
        </div>
      </div>
      <div
        class="bg-primary-700 rounded-md p-5 md:p-6 text-white flex flex-col justify-between"
      >
        <div>
          <p
            class="text-sm font-semibold uppercase tracking-wider text-white/70"
          >
            Comment les dons sont affectés
          </p>
          <p class="mt-3 text-base text-white/90 leading-relaxed">
            Si cette campagne est entièrement financée ou si les besoins
            changent, les dons sont affectés à des besoins de programme connexes
            sauf demande contraire du donateur.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Monthly Giving -->
  <Section background="white" padding="md">
    <div
      class="max-w-5xl mx-auto flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="max-w-2xl">
        <p
          class="text-xs font-semibold uppercase tracking-wider text-primary-700"
        >
          Don mensuel
        </p>
        <h2
          class="mt-3 text-2xl md:text-3xl font-heading font-bold text-gray-900"
        >
          Don mensuel
        </h2>
        <p class="mt-2 text-sm text-gray-600 leading-relaxed">
          Découvrez le fonctionnement des dons récurrents et comment les
          modifier ou les annuler.
        </p>
      </div>
      <a
        href="/fr/monthly"
        class="inline-flex items-center text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800 shrink-0"
        >Voir les dons mensuels</a
      >
    </div>
  </Section>

  <!-- Other Ways to Give -->
  <Section background="gray" padding="md">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-heading font-bold text-gray-900">
        {i18n.donate.otherWays}
      </h2>
      <ul class="mt-4 divide-y divide-gray-200 border-y border-gray-200">
        {
          otherWaysToGive.map((item) => (
            <li class="py-3">
              <h3 class="text-sm font-semibold text-gray-900">{item.title}</h3>
              <p
                class="mt-1 text-sm text-gray-600 leading-relaxed"
                set:html={item.description}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- Donation FAQ -->
  <Section background="white" padding="lg">
    <FaqSection
      title="Questions fréquentes"
      subtitle="Tout ce qu'il faut savoir avant de donner."
      faqs={donationFaqs}
      contactHref="/fr/contact?subject=Question+Don"
      contactLabel="D'autres questions ? Contactez-nous — réponse sous 24 h en général."
    />
  </Section>
</PageLayout>
