---
import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../../components/layout/PageHero.astro";
import Section from "../../components/layout/Section.astro";
import { getSiteSettings } from "../../lib/sanity";
import { resolveHeroImage } from "../../lib/hero-images";

let contactEmail = "info@apotidev.org";
let contactPhone = "+237 676 282 346";
let whatsappLink = "https://wa.me/237676282346";
const officeHours =
  "Du lundi au vendredi, de 8 h à 17 h, heure du Cameroun (UTC+1)";

try {
  const settings = await getSiteSettings("fr");
  if (settings) {
    contactEmail = settings.contactEmail || contactEmail;
    contactPhone = settings.contactPhone || contactPhone;
    const phoneDigits = (settings.contactPhone || contactPhone).replace(
      /[^0-9]/g,
      "",
    );
    whatsappLink = phoneDigits ? `https://wa.me/${phoneDigits}` : whatsappLink;
  }
} catch {}

const heroImage = await resolveHeroImage([
  "widow-support",
]);
---

<!-- Hallmark · genre: editorial · macrostructure: Long Document · design-system: design.md · designed-as-app -->
<PageLayout
  title="Contact"
  description="Contactez Apoti Development Association par e-mail ou WhatsApp pour toute question ou demande d'information."
>
  <PageHero
    title="Contactez-nous"
    subtitle="Une question ou envie de vous impliquer ? Écrivez-nous."
    compact
    imageUrl={heroImage?.imageUrl}
    imageAlt={heroImage?.imageUrl
      ? "Activité de soutien communautaire d’ADA au Cameroun"
      : undefined}
  />

  <Section background="white" padding="lg">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-3 lg:gap-12">
      <section class="space-y-6" aria-labelledby="contact-direct">
        <div>
          <h2 id="contact-direct" class="text-xl font-semibold text-gray-900">
            Nous contacter directement
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            Choisissez le moyen qui vous convient.
          </p>
        </div>

        <dl class="space-y-4">
          <div class="flex items-start gap-3">
            <span
              aria-hidden="true"
              class="mt-1 h-8 w-1 flex-shrink-0 rounded-sm bg-primary-600"
            ></span>
            <div>
              <dt class="text-sm font-medium text-gray-900">E-mail</dt>
              <dd class="mt-1">
                <a
                  href={`mailto:${contactEmail}`}
                  class="text-sm font-medium text-primary-700 underline-offset-4 hover:underline"
                >
                  {contactEmail}
                </a>
              </dd>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span
              aria-hidden="true"
              class="mt-1 h-8 w-1 flex-shrink-0 rounded-sm bg-primary-600"
            ></span>
            <div>
              <dt class="text-sm font-medium text-gray-900">
                Heures d’ouverture
              </dt>
              <dd class="mt-1 text-sm leading-relaxed text-gray-700">
                {officeHours}
              </dd>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span
              aria-hidden="true"
              class="mt-1 h-8 w-1 flex-shrink-0 rounded-sm bg-primary-600"
            ></span>
            <div>
              <dt class="text-sm font-medium text-gray-900">WhatsApp</dt>
              <dd class="mt-1">
                <a
                  href={whatsappLink}
                  class="text-sm font-medium text-primary-700 underline-offset-4 hover:underline"
                >
                  {contactPhone}
                </a>
              </dd>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span
              aria-hidden="true"
              class="mt-1 h-8 w-1 flex-shrink-0 rounded-sm bg-primary-600"
            ></span>
            <div>
              <dt class="text-sm font-medium text-gray-900">Lieu</dt>
              <dd class="mt-1 text-sm leading-relaxed text-gray-700">
                Cameroun, Afrique centrale
              </dd>
            </div>
          </div>
        </dl>
      </section>

      <section class="lg:col-span-2" aria-labelledby="contact-form-heading">
        <div class="mb-5">
          <h2
            id="contact-form-heading"
            class="text-xl font-semibold text-gray-900"
          >
            Envoyez-nous un message
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-gray-600">
            Les champs marqués d’un astérisque (*) sont obligatoires.
          </p>
        </div>

        <form class="space-y-5" id="contact-form">
          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
            <div>
              <label
                for="name"
                class="mb-1.5 block text-sm font-medium text-gray-800"
                >Nom <span aria-hidden="true">*</span></label
              >
              <input
                type="text"
                id="name"
                name="name"
                autocomplete="name"
                required
                aria-required="true"
                class="w-full rounded-lg border border-gray-400 bg-white px-3 py-2.5 text-base text-gray-900 shadow-sm focus:border-primary-600 focus:outline-none focus:ring-2 focus:ring-primary-500"
              />
            </div>
            <div>
              <label
                for="email"
                class="mb-1.5 block text-sm font-medium text-gray-800"
                >Adresse e-mail <span aria-hidden="true">*</span></label
              >
              <input
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                required
                aria-required="true"
                class="w-full rounded-lg border border-gray-400 bg-white px-3 py-2.5 text-base text-gray-900 shadow-sm focus:border-primary-600 focus:outline-none focus:ring-2 focus:ring-primary-500"
              />
            </div>
          </div>
          <div>
            <label
              for="subject"
              class="mb-1.5 block text-sm font-medium text-gray-800"
              >Objet <span aria-hidden="true">*</span></label
            >
            <input
              type="text"
              id="subject"
              name="subject"
              autocomplete="off"
              required
              aria-required="true"
              class="w-full rounded-lg border border-gray-400 bg-white px-3 py-2.5 text-base text-gray-900 shadow-sm focus:border-primary-600 focus:outline-none focus:ring-2 focus:ring-primary-500"
            />
          </div>
          <div>
            <label
              for="message"
              class="mb-1.5 block text-sm font-medium text-gray-800"
              >Message <span aria-hidden="true">*</span></label
            >
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              aria-required="true"
              minlength="10"
              aria-describedby="message-help"
              class="w-full rounded-lg border border-gray-400 bg-white px-3 py-2.5 text-base leading-relaxed text-gray-900 shadow-sm focus:border-primary-600 focus:outline-none focus:ring-2 focus:ring-primary-500"
            ></textarea>
            <p
              id="message-help"
              class="mt-1.5 text-sm leading-relaxed text-gray-600"
            >
              Votre message doit contenir au moins 10 caractères.
            </p>
          </div>
          <button
            type="submit"
            class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-primary-700 px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-primary-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-600 focus-visible:ring-offset-2 sm:w-auto"
          >
            Envoyer le message
          </button>
        </form>
        <p class="mt-4 text-sm leading-relaxed text-gray-700">
          Votre message sera utilisé pour répondre à votre demande. Consultez
          notre
          <a
            href="/fr/privacy"
            class="font-medium text-primary-700 underline underline-offset-4 hover:text-primary-800"
          >
            politique de confidentialité
          </a>
          pour en savoir plus.
        </p>
      </section>
    </div>
  </Section>
</PageLayout>

<script>
  const urlParams = new URLSearchParams(window.location.search);
  const subjectParam = urlParams.get("subject");
  if (subjectParam) {
    const subjectInput = document.getElementById(
      "subject",
    ) as HTMLInputElement | null;
    if (subjectInput) subjectInput.value = subjectParam;
  }

  const form = document.getElementById("contact-form");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const contactForm = form as HTMLFormElement;
    const button = form.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement;
    form.querySelector("[data-form-msg]")?.remove();
    button.disabled = true;
    button.textContent = "Envoi en cours…";

    const message = document.createElement("p");
    message.setAttribute("data-form-msg", "true");
    message.setAttribute("aria-live", "polite");
    message.setAttribute("role", "status");

    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(Object.fromEntries(new FormData(contactForm))),
      });

      if (!response.ok) throw new Error("CONTACT_SEND_FAILED");

      message.className = "mt-4 text-sm font-medium text-green-800";
      message.textContent = "Message envoyé. Merci de nous avoir écrit.";
      contactForm.reset();
      button.textContent = "Message envoyé";
    } catch {
      message.className = "mt-4 text-sm text-red-700";
      message.setAttribute("role", "alert");
      message.textContent =
        "Échec de l’envoi. Veuillez réessayer ou nous écrire directement par e-mail.";
      button.disabled = false;
      button.textContent = "Envoyer le message";
    }

    form.appendChild(message);
  });
</script>
