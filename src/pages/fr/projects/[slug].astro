---
import ProjectAnnouncement from "../../../components/projects/ProjectAnnouncement.astro";
import PageLayout from "../../../layouts/PageLayout.astro";
import { reviewed2026Release } from "../../../lib/reviewed-project-summaries-2026";
import Section from "../../../components/layout/Section.astro";
import { getProjects, type SanityProject } from "../../../lib/sanity";
import { selectProjectsIndexImage } from "../../../lib/projects-index-presentation";
import { resolveProjectCardImage } from "../../../lib/project-images";
import {
  getProjectLifecycleState,
} from "../../../lib/project-lifecycle";
import {
  mergeProjectLists,
  normalizeFallbackProjects,
} from "../../../lib/project-fallbacks";
import {
  getPausedProjectMessage,
  getProjectStatusText,
} from "../../../lib/project-detail-presentation";

export async function getStaticPaths() {
  let projectData;
  try {
    const sanityProjects = await getProjects("fr");
    if (sanityProjects?.length) {
      projectData = mergeProjectLists(
        sanityProjects.map((p: SanityProject) => {
          const lifecycle = getProjectLifecycleState(p, { locale: "fr" });
          const image = resolveProjectCardImage(p, 900);
          return {
            slug: p.slug.current,
            title: p.title,
            location: p.location,
            status: lifecycle.status,
            autoArchived: lifecycle.isAutoCompleted,
            archiveHref: lifecycle.archiveHref,
            archiveReady: lifecycle.archiveReady,
            hasEnded: lifecycle.hasEnded,
            isFundable: lifecycle.isFundable,
            announcementOnly: p.announcementOnly,
            hasAnnouncementImage: Boolean(p.mainImage?.asset?._ref),
            startDate: p.startDate,
            description: p.description,
            imageUrl: image.imageUrl,
            imageAlt: image.imageAlt,
          };
        }),
        normalizeFallbackProjects({ locale: "fr" }),
      );
    } else {
      projectData = normalizeFallbackProjects({ locale: "fr" });
    }
  } catch {
    projectData = normalizeFallbackProjects({ locale: "fr" });
  }

  return projectData.filter(({ slug }) => !reviewed2026Release(slug)).map((project) => {
    const autoArchived =
      project.autoArchived ??
      (project.originalStatus === "active" &&
        project.status === "completed" &&
        project.autoArchiveAfterEndDate !== false);
    return {
      params: { slug: project.slug },
      props: { project: { ...project, autoArchived } },
    };
  });
}

const { project } = Astro.props;
const detailImage = selectProjectsIndexImage(project, "fr");
const isCompleted = project.status === "completed";
const isAutoArchived = Boolean(project.autoArchived);
const isFundable = project.isFundable;
const fundraisingNote = isFundable
  ? "Paiement sécurisé · Reçu envoyé par e-mail"
  : isAutoArchived
    ? "Projet archivé après sa date de fin ; les dons dédiés sont clôturés."
    : project.status !== "paused"
      ? "Collecte clôturée pour ce projet."
      : null;
const statusBadgeClass =
  project.status === "upcoming"
    ? "bg-primary-400/20 text-primary-100 border border-primary-400/30"
    : project.status === "active"
      ? "bg-green-400/20 text-green-200 border border-green-400/30"
      : project.status === "completed"
        ? "bg-gray-400/20 text-gray-200 border border-gray-400/30"
        : "bg-yellow-400/20 text-yellow-200 border border-yellow-400/30";
const statusBadgeLabel = isAutoArchived
  ? "○ Archivé"
  : project.status === "upcoming"
    ? `◎ ${getProjectStatusText(project.status, false, "fr")}`
    : project.status === "active"
      ? `● ${getProjectStatusText(project.status, false, "fr")}`
      : project.status === "completed"
        ? `✓ ${getProjectStatusText(project.status, false, "fr")}`
        : `⏸ ${getProjectStatusText(project.status, false, "fr")}`;

const paragraphs = project.description
  .split(/[.;]\s*(?=[A-Z(])/)
  .filter(Boolean)
  .reduce((acc: string[][], sentence: string, i: number) => {
    const paraIndex = Math.floor(i / 3);
    if (!acc[paraIndex]) acc[paraIndex] = [];
    acc[paraIndex].push(sentence.trim());
    return acc;
  }, [] as string[][])
  .map(
    (sentences: string[]) =>
      sentences.join(". ") +
      (sentences[sentences.length - 1].endsWith(".") ? "" : "."),
  );
---
<!-- Hallmark · genre: editorial · macrostructure: Photographic · design-system: design.md · designed-as-app -->

{project.announcementOnly ? (
  <ProjectAnnouncement project={project} locale="fr" />
) : (
<PageLayout
  title={project.title}
  description={project.description.slice(0, 160)}
>
  <!-- Hero -->
  <section
    class="relative py-16 md:py-24 bg-primary-900 text-white"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav aria-label="Fil d’Ariane" class="mb-6">
        <ol class="flex items-center gap-1.5 text-sm text-white/70">
          <li>
            <a href="/fr" class="hover:text-white transition-colors">Accueil</a>
          </li>
          <li class="text-white/40">/</li>
          <li>
            <a href="/fr/projects" class="hover:text-white transition-colors"
              >Projets</a
            >
          </li>
          <li class="text-white/40">/</li>
          <li class="text-white/90 truncate max-w-[200px]">{project.title}</li>
        </ol>
      </nav>
      <div class="flex flex-wrap items-center gap-2 mb-4">
        <span
          class:list={[
            "px-3 py-1 text-xs font-semibold rounded-md",
            statusBadgeClass,
          ]}
        >
          {statusBadgeLabel}
        </span>
        <span class="text-sm text-white/70">{project.location}</span>
      </div>
      <h1
        class="text-3xl md:text-4xl lg:text-5xl font-heading font-bold leading-tight"
      >
        {project.title}
      </h1>
      <p class="mt-4 text-lg text-white/80 max-w-2xl">
        Au service des communautés vulnérables à {project.location}, Cameroun
      </p>
      {detailImage && (
        <div class="mt-8 overflow-hidden rounded-md border border-white/15 bg-white/10 max-w-3xl">
          <img
            src={detailImage.src}
            alt={detailImage.alt}
            class="w-full h-[260px] md:h-[340px] object-cover"
            loading="eager"
          />
        </div>
      )}
    </div>
  </section>

  <Section background="white" padding="lg">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Main Content -->
      <div class="lg:col-span-2">
        <div class="space-y-6">
          <h2 class="text-2xl font-heading font-bold text-gray-900">
            À Propos de ce Projet
          </h2>
          <div class="prose prose-gray max-w-none space-y-4">
            {
              paragraphs.map((para) => (
                <p class="text-gray-600 leading-relaxed">{para}</p>
              ))
            }
          </div>
        </div>

      </div>

      <!-- Sidebar -->
      <div class="space-y-6">
        <!-- Fundraising Card -->
        <div
          class="p-6 bg-gray-50 rounded-md border border-gray-200 sticky top-24"
        >
          <h3 class="text-lg font-semibold text-gray-900">
            {isAutoArchived
              ? "Projet archivé après sa date de fin"
              : project.status === "paused"
                ? "Collecte en pause"
              : isCompleted
                ? "Projet terminé"
                : "Soutenir ce projet"}
          </h3>
          {project.status === "paused" && (
            <p class="mt-3 text-sm text-gray-600">{getPausedProjectMessage("fr")}</p>
          )}

          <a
            href={isFundable
              ? `/fr/donate?project=${project.slug}`
              : project.archiveHref || "/fr/projects/archive"}
            class="mt-6 block w-full text-center px-4 py-3.5 text-base font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors"
            aria-label={
              isFundable
                ? `Soutenir ${project.title}`
                : `Voir les archives du projet ${project.title}`
            }
          >
            {
              isFundable
                ? "Soutenir ce Projet"
                : "Consulter les archives"
            }
          </a>

          {fundraisingNote && (
            <div class="mt-4">
              <p class="text-xs text-gray-500">{fundraisingNote}</p>
            </div>
          )}
        </div>

        <!-- Quick Facts -->
        <div class="p-6 bg-white rounded-md border border-gray-200">
          <h3
            class="text-sm font-semibold text-gray-900 uppercase tracking-wider"
          >
            Faits Rapides
          </h3>
          <dl class="mt-4 space-y-3">
            <div class="flex justify-between">
              <dt class="text-xs text-gray-500">Statut</dt>
              <dd class="text-xs font-medium text-gray-900">
                {getProjectStatusText(project.status, isAutoArchived, "fr")}
              </dd>
            </div>
            <div class="flex justify-between">
              <dt class="text-xs text-gray-500">Localisation</dt>
              <dd class="text-xs font-medium text-gray-900">
                {project.location}
              </dd>
            </div>
          </dl>
        </div>

        <!-- Share -->
        <div class="p-6 bg-white rounded-md border border-gray-200">
          <h3
            class="text-sm font-semibold text-gray-900 uppercase tracking-wider"
          >
            Partager ce Projet
          </h3>
          <div class="mt-3 flex gap-2">
            <a
              href={`https://twitter.com/intent/tweet?text=Soutenez ${encodeURIComponent(project.title)} au Cameroun&url=https://apotidev.org/fr/projects/${project.slug}`}
              target="_blank"
              rel="noopener"
              aria-label={`Partager ${project.title} sur X`}
              class="flex-1 text-center px-3 py-2 text-xs font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors"
              >X</a
            >
            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=https://apotidev.org/fr/projects/${project.slug}`}
              target="_blank"
              rel="noopener"
              aria-label={`Partager ${project.title} sur Facebook`}
              class="flex-1 text-center px-3 py-2 text-xs font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors"
              >Facebook</a
            >
            <a
              href={`https://wa.me/?text=Soutenez ${encodeURIComponent(project.title)} https://apotidev.org/fr/projects/${project.slug}`}
              target="_blank"
              rel="noopener"
              aria-label={`Partager ${project.title} sur WhatsApp`}
              class="flex-1 text-center px-3 py-2 text-xs font-medium text-gray-700 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors"
              >WhatsApp</a
            >
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Other Projects -->
  <Section background="gray" padding="md">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-xl font-heading font-bold text-gray-900">
        Découvrir Plus de Projets
      </h2>
      <p class="mt-2 text-sm text-gray-600">
        Chaque projet aborde une dimension différente de la vulnérabilité au
        Cameroun.
      </p>
      <div
        class="mt-4 flex flex-col sm:flex-row items-start gap-3"
      >
        <a
          href="/fr/projects"
          class="px-5 py-2.5 text-sm font-medium text-primary-700 border border-primary-200 rounded-lg hover:bg-primary-50 transition-colors"
          >Voir Tous les Projets</a
        >
        <a
          href="/fr/transparency"
          class="px-5 py-2.5 text-sm font-medium text-gray-600 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors"
          >Voir Nos Données d'Impact</a
        >
      </div>
    </div>
  </Section>
</PageLayout>
)}
