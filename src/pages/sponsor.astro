---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/layout/PageHero.astro";
import Section from "../components/layout/Section.astro";
import FaqSection from "../components/seo/FaqSection.astro";
import { REGISTRATION_NUMBER } from "../data/organization";
import { resolveHeroImage } from "../lib/hero-images";
import { SPONSOR_FAQS_EN, buildFaqPage } from "../lib/structured-data";

const heroImage = await resolveHeroImage([
  "widow-support",
  "education-orphans",
  "women-empowerment",
]);
const sponsorFaqs = SPONSOR_FAQS_EN;
const faqPageSchema = buildFaqPage(
  sponsorFaqs,
  new URL("/sponsor", Astro.site).toString(),
);

const sponsorTiers = [
  {
    name: "Community Sponsor",
    amount: "$500-$1,000",
    budgetValue: "$500-$1,000",
    funds:
      "School supplies, food support, seasonal giving items, or emergency household essentials.",
    outcome:
      "Helps one focused household, school, or relief need move from urgent gap to documented support.",
    receives:
      "ADA receipt, short update, use-of-funds note, and optional public or private recognition.",
  },
  {
    name: "Project Sponsor",
    amount: "$2,500-$5,000",
    budgetValue: "$2,500-$5,000",
    funds:
      "A defined education, widow support, orphan care, young women, or IDP relief project.",
    outcome:
      "Funds a bounded project with people served, budget, evidence, and a final close-out summary.",
    receives:
      "Quarterly and annual updates with milestones and briefings; project photos when consented, an impact summary, and a final report.",
  },
  {
    name: "Program Sponsor",
    amount: "$10,000+",
    budgetValue: "$10,000+",
    funds:
      "A full program season, multi-family support cycle, or recurring community response.",
    outcome:
      "Supports a measurable program with quarterly and annual updates that include milestones and briefings, plus a final outcome report.",
    receives:
      "Sponsor agreement, quarterly and annual updates that include milestones and briefings, a separate final report, and logo recognition if approved.",
  },
  {
    name: "Strategic Partner",
    amount: "Custom",
    budgetValue: "Custom / discuss first",
    funds:
      "A multi-year commitment, capacity support, or a custom initiative shaped with ADA leadership.",
    outcome:
      "Creates shared goals, reporting cadence, and a practical partnership plan before funds move.",
    receives:
      "Quarterly and annual updates, including milestones and briefings; recognition or anonymity by preference.",
  },
];

const fundingPaths = [
  {
    title: "Sponsor a project",
    text: "Fund a defined campaign with a target, timeline, budget, and close-out update.",
  },
  {
    title: "Run a group campaign",
    text: "Churches, companies, schools, and diaspora groups can explore shared campaign support with ADA.",
  },
  {
    title: "Give recurring support",
    text: "Monthly or quarterly sponsorship helps ADA plan food, school, health, and follow-up work.",
  },
  {
    title: "Offer in-kind help",
    text: "Skills, supplies, logistics, training, or equipment can be coordinated by prior agreement.",
  },
];

const sponsorReceives = [
  "Receipt or sponsorship confirmation for your records",
  "Clear use-of-funds summary",
  "Quarterly and annual updates, including milestones and briefings",
  "Recognition by name or logo, only if approved",
  "Public recognition, internal acknowledgment, or full anonymity by preference",
  "Photos or stories when appropriate and consented",
];

const outcomeProofs = [
  {
    project: "Widow vocational training",
    cost: "$3,200 documented cohort budget",
    served: "15 widows trained; 12 graduated",
    outcome:
      "Graduates began earning income, with average income increasing from $10/month to $50/month.",
    evidence:
      "Completion records, field photos, graduate follow-up, and project report.",
    next: "Sponsor the next cohort with materials, trainers, and post-training follow-up.",
  },
  {
    project: "Clean water infrastructure",
    cost: "$4,417 documented project cost",
    served: "300+ community members",
    outcome:
      "A completed water point improved daily access to safe water for households and students.",
    evidence:
      "Project budget, completion records, community photos, and annual report.",
    next: "Maintain the well and expand water access planning for nearby households.",
  },
  {
    project: "Back-to-school support",
    costLabel: "Historical activity",
    cost: "Two school campaigns in 2024",
    served: "40 orphaned children",
    outcome:
      "Children received fees, supplies, and school materials before the academic term.",
    evidence:
      "Attendance lists, procurement records, consented photos, and project summaries.",
    next: "Fund the next term earlier so families and schools can plan with confidence.",
  },
  {
    project: "Emergency food relief",
    cost: "$2,417 documented relief budget",
    served: "50 displaced families; 150+ people",
    outcome:
      "Families received planned food packages across a three-month emergency support cycle.",
    evidence:
      "Distribution records, receipts, field notes, and project close-out report.",
    next: "Pre-position sponsor-backed emergency response funds before the next crisis window.",
  },
];

const trustProofs = [
  `Registered NGO: ${REGISTRATION_NUMBER}`,
  "80% direct program delivery target",
  "Receipts issued for records",
  "Project reports available",
  "Stripe-secured card giving",
  "Due-diligence packet available",
  "Bilingual reporting: English/French",
];

const diligenceItems = [
  "Cameroon registration certificate",
  "Leadership and governance overview",
  "Financial allocation model",
  "Annual reports and project records",
  "Safeguarding and financial management policies",
  "Reporting expectations and contact path",
];
---

<!-- Hallmark · genre: editorial · macrostructure: Split Studio · design-system: design.md · designed-as-app -->
<PageLayout
  title="Sponsor a Program"
  description="Sponsor practical support for widows, orphans, young women, displaced families, and students in Cameroon. Clear funding options, receipts, reporting, and due diligence."
  jsonLdExtra={[faqPageSchema]}
>
  <PageHero
    title="Sponsor practical support for families in Cameroon"
    subtitle="Partner with ADA to fund direct community programs with clear options, written records, and transparent use of funds."
    compact
    imageUrl={heroImage?.imageUrl}
    imageAlt={heroImage?.imageAlt}
  />

  <section class="overflow-hidden bg-white">
    <div
      class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-10 items-center"
    >
      <div class="min-w-0">
        <p
          class="text-xs font-semibold uppercase tracking-wider text-primary-700"
        >
          Sponsor ADA work in Cameroon
        </p>
        <h2
          class="mt-4 max-w-3xl text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-gray-950 leading-tight"
        >
          Sponsorship for community programs
        </h2>
        <p class="mt-5 text-lg text-gray-600 leading-relaxed max-w-2xl">
          Sponsorship is a way to discuss support for a defined project or
          program and the records or updates that accompany it. For a general
          gift, visit the <a
            href="/donate"
            class="font-semibold text-primary-700 underline underline-offset-2"
            >donation page</a
          >.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row flex-wrap gap-3">
          <a
            href="/sponsor/inquiry"
            class="inline-flex items-center justify-center px-5 py-3 text-sm font-semibold text-white bg-primary-700 rounded-md hover:bg-primary-800 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700"
          >
            Discuss a sponsorship
          </a>
          <a
            href="/docs/diligence/ada-corporate-sponsor-one-pager.pdf"
            target="_blank"
            rel="noopener"
            class="inline-flex items-center px-4 py-2 text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
          >
            Download one-pager
          </a>
          <a
            href="#tiers"
            class="inline-flex items-center px-4 py-2 text-sm font-semibold text-gray-700 underline underline-offset-4 hover:text-gray-900"
          >
            See sponsor options
          </a>
        </div>
        <p class="mt-5 text-xs text-gray-500">
          Registered in Cameroon ({REGISTRATION_NUMBER}). ADA's public
          allocation model targets 80% of expenditure for direct program
          delivery.
        </p>
      </div>

      <div class="rounded-md border border-gray-200 bg-gray-50 p-6 md:p-8">
        <h2 class="text-xl font-heading font-bold text-gray-900">
          Sponsor-ready at a glance
        </h2>
        <dl class="mt-6 space-y-4">
          <div
            class="grid grid-cols-1 gap-1 border-b border-gray-200 pb-3 sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] sm:gap-4"
          >
            <dt class="text-sm text-gray-500">Legal status</dt>
            <dd
              class="min-w-0 break-words text-sm font-semibold text-gray-900 sm:text-right"
            >
              Cameroon-registered NGO
            </dd>
          </div>
          <div
            class="grid grid-cols-1 gap-1 border-b border-gray-200 pb-3 sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] sm:gap-4"
          >
            <dt class="text-sm text-gray-500">Reporting</dt>
            <dd
              class="min-w-0 break-words text-sm font-semibold text-gray-900 sm:text-right"
            >
              Updates, records, reports
            </dd>
          </div>
          <div
            class="grid grid-cols-1 gap-1 border-b border-gray-200 pb-3 sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] sm:gap-4"
          >
            <dt class="text-sm text-gray-500">Giving paths</dt>
            <dd
              class="min-w-0 break-words text-sm font-semibold text-gray-900 sm:text-right"
            >
              Card donations in USD; one-time or monthly
            </dd>
          </div>
          <div
            class="grid grid-cols-1 gap-1 sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] sm:gap-4"
          >
            <dt class="text-sm text-gray-500">Due diligence</dt>
            <dd
              class="min-w-0 break-words text-sm font-semibold text-gray-900 sm:text-right"
            >
              Packet available
            </dd>
          </div>
        </dl>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href="/docs/diligence/ada-corporate-sponsor-one-pager.pdf"
            target="_blank"
            rel="noopener"
            class="text-sm font-semibold text-primary-700 hover:underline"
          >
            Corporate one-pager
          </a>
          <a
            href="/docs/diligence/ada-registration-certificate.pdf"
            target="_blank"
            rel="noopener"
            class="text-sm font-semibold text-primary-700 hover:underline"
          >
            Registration certificate
          </a>
          <a
            href="/transparency"
            class="text-sm font-semibold text-primary-700 hover:underline"
          >
            Transparency
          </a>
          <a
            href="/resources"
            class="text-sm font-semibold text-primary-700 hover:underline"
          >
            Resource library
          </a>
          <a
            href="/impact-scorecard"
            class="text-sm font-semibold text-primary-700 hover:underline"
          >
            Impact scorecard
          </a>
        </div>
      </div>
    </div>
  </section>

  <Section background="gray" padding="md">
    <div class="max-w-4xl">
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900">
        Four simple ways organizations can help
      </h2>
      <p class="mt-3 text-sm text-gray-600">
        Choose the path that fits your church, company, school, diaspora group,
        foundation, or family.
      </p>
    </div>
    <dl
      class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-x-12 border-t border-gray-200"
    >
      {
        fundingPaths.map((path) => (
          <div class="border-b border-gray-200 py-6">
            <dt class="text-base font-semibold text-gray-900">{path.title}</dt>
            <dd class="mt-2 text-sm text-gray-600 leading-relaxed">
              {path.text}
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section background="white" padding="lg">
    <div class="max-w-4xl">
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900">
        Impact shown as outcomes
      </h2>
      <p class="mt-3 text-sm text-gray-600 leading-relaxed">
        Sponsors should see what changed, not only what ADA did. These examples
        show activity, people served, outcomes, evidence, and the next
        milestone.
      </p>
    </div>
    <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-5">
      {
        outcomeProofs.map((proof) => (
          <article class="rounded-md border border-gray-200 bg-white p-5">
            <h3 class="text-lg font-semibold text-gray-900">{proof.project}</h3>
            <dl class="mt-4 space-y-3 text-sm">
              <div>
                <dt class="font-semibold text-gray-900">
                  {proof.costLabel || "Documented cost (USD)"}
                </dt>
                <dd class="mt-1 text-gray-600 leading-relaxed">{proof.cost}</dd>
              </div>
              <div>
                <dt class="font-semibold text-gray-900">Number served</dt>
                <dd class="mt-1 text-gray-600 leading-relaxed">
                  {proof.served}
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-gray-900">Outcome</dt>
                <dd class="mt-1 text-gray-600 leading-relaxed">
                  {proof.outcome}
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-gray-900">Evidence</dt>
                <dd class="mt-1 text-gray-600 leading-relaxed">
                  {proof.evidence}
                </dd>
              </div>
              <div>
                <dt class="font-semibold text-gray-900">Next milestone</dt>
                <dd class="mt-1 text-gray-600 leading-relaxed">{proof.next}</dd>
              </div>
            </dl>
          </article>
        ))
      }
    </div>
  </Section>

  <Section id="tiers" background="white" padding="lg">
    <div class="max-w-4xl">
      <div>
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900">
          Sponsor options
        </h2>
        <p class="mt-3 text-sm text-gray-600">
          Suggested sponsorship bands are shown in USD. Online donations by card
          are available once or monthly; use the inquiry form to discuss support
          for a defined project or program.
        </p>
      </div>
      <p class="mt-4 text-xs text-gray-500">All amounts are in USD.</p>
      <div
        class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-0 border-t border-gray-200"
      >
        {
          sponsorTiers.map((tier) => (
            <article class="flex h-full flex-col border-b border-gray-200 py-6">
              <h3 class="text-lg font-semibold text-gray-900">{tier.name}</h3>
              <p class="mt-2 text-2xl font-bold text-primary-700">
                {tier.amount}
              </p>
              <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-gray-500">
                Helps fund
              </p>
              <p class="mt-1 text-sm text-gray-600 leading-relaxed">
                {tier.funds}
              </p>
              <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-gray-500">
                Outcome focus
              </p>
              <p class="mt-1 text-sm text-gray-600 leading-relaxed">
                {tier.outcome}
              </p>
              <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-gray-500">
                Sponsor receives
              </p>
              <p class="mt-1 flex-1 text-sm text-gray-600 leading-relaxed">
                {tier.receives}
              </p>
              <a
                href={`/sponsor/inquiry?budgetRange=${encodeURIComponent(tier.budgetValue)}`}
                aria-label={`Ask about ${tier.name} (${tier.amount})`}
                class="mt-6 inline-flex text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
              >
                Ask about this option
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </Section>

  <Section background="gray" padding="lg">
    <div
      class="max-w-5xl grid grid-cols-1 lg:grid-cols-[0.95fr_1.05fr] gap-8 items-start"
    >
      <div>
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900">
          Clear follow-through, not vague promises
        </h2>
        <p class="mt-3 text-gray-600 leading-relaxed">
          Every sponsor receives confirmation of support and a useful record for
          their files. Reporting stays practical: enough detail to show
          stewardship without overwhelming sponsors or the communities we serve.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href="/projects/archive"
            class="inline-flex text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
          >
            See completed work
          </a>
          <a
            href="/resources#due-diligence"
            class="inline-flex text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
          >
            Review documents
          </a>
        </div>
      </div>
      <ul class="divide-y divide-gray-200 border-y border-gray-200">
        {
          sponsorReceives.map((item) => (
            <li class="py-3 text-sm text-gray-700 leading-relaxed">{item}</li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section background="white" padding="lg">
    <div
      class="max-w-5xl grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-8 items-start"
    >
      <div>
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900">
          What sponsors can review before giving
        </h2>
        <p class="mt-3 text-gray-600 leading-relaxed">
          For sponsors who need internal approval, ADA can provide a concise
          one-page sponsor brief, due-diligence packet, and public records
          already available on the site.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href="/docs/diligence/ada-corporate-sponsor-one-pager.pdf"
            target="_blank"
            rel="noopener"
            class="inline-flex text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
          >
            Download one-pager
          </a>
          <a
            href="/docs/diligence/ada-sponsor-readiness-packet.pdf"
            target="_blank"
            rel="noopener"
            class="inline-flex text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
          >
            Open sponsor packet
          </a>
          <a
            href="/resources#due-diligence"
            class="inline-flex text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
          >
            Review diligence documents
          </a>
        </div>
      </div>
      <ul class="divide-y divide-gray-200 border-y border-gray-200">
        {
          diligenceItems.map((item) => (
            <li class="py-3 text-sm text-gray-700">{item}</li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section background="gray" padding="md">
    <div
      class="max-w-5xl grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-8 items-start"
    >
      <div>
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900">
          Giving and sponsorship
        </h2>
        <p class="mt-3 text-gray-600 leading-relaxed">
          A general donation supports ADA's work. A sponsorship inquiry lets you
          discuss a defined project or program before deciding whether to give.
        </p>
      </div>
      <div class="space-y-4">
        <div class="rounded-md border border-gray-200 bg-white p-5">
          <h3 class="text-base font-semibold text-gray-900">
            Online donations
          </h3>
          <p class="mt-3 text-sm text-gray-700 leading-relaxed">
            Donate by card in USD, once or monthly. ADA's donation page is open
            to donors without an account.
          </p>
          <a
            href="/donate"
            class="mt-4 inline-flex text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
          >
            Make a donation
          </a>
        </div>
        <div class="rounded-md border border-amber-200 bg-amber-50 p-5">
          <h3 class="text-base font-semibold text-amber-950">
            Clear tax and sponsorship status
          </h3>
          <p class="mt-2 text-sm text-amber-900 leading-relaxed">
            ADA is registered in Cameroon. At this time, contributions are not
            represented as tax-deductible in Canada, the United States, the
            United Kingdom, or the European Union unless a qualified registered
            partner is confirmed in writing. ADA can issue a receipt, invoice,
            or sponsorship confirmation for your records, but does not provide
            tax advice.
          </p>
          <p class="mt-3 text-sm text-amber-900 leading-relaxed">
            If ADA confirms a qualified fiscal sponsor or registered charity
            partner in the future, ADA will publish the partner name, country,
            donation instructions, eligible tax treatment, and receipt
            limitations before promoting that pathway.
          </p>
          <a
            href="/sponsor/inquiry"
            class="mt-4 inline-flex text-sm font-semibold text-amber-950 underline underline-offset-4 hover:text-amber-900"
          >
            Discuss giving requirements
          </a>
        </div>
      </div>
    </div>
  </Section>

  <Section background="white" padding="lg">
    <FaqSection
      title="Sponsorship FAQ"
      subtitle="Tax status, fund use, reporting, and how to start."
      faqs={sponsorFaqs}
      contactHref="/sponsor/inquiry"
      contactLabel="Have a question? Send ADA a sponsorship inquiry."
    />
  </Section>

  <Section background="dark" padding="lg" class="!bg-gray-900 !bg-none">
    <div class="max-w-4xl">
      <h2 class="text-2xl md:text-3xl font-heading font-bold">
        Ready to sponsor a focused program?
      </h2>
      <p class="mt-3 text-sm text-white/80 leading-relaxed">
        Use the inquiry form to describe your interests and any records you
        need. ADA can follow up with relevant information about donation or
        sponsorship options.
      </p>
      <div class="mt-7 flex flex-col sm:flex-row gap-3">
        <a
          href="/sponsor/inquiry"
          class="inline-flex items-center px-4 py-2 text-sm font-semibold text-white border border-white/40 rounded-md hover:bg-white/10 transition-colors"
        >
          Start sponsorship inquiry
        </a>
        <a
          href="/donate"
          class="inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors"
        >
          Give now
        </a>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-2 text-left sm:grid-cols-2">
        {
          trustProofs.map((proof) => (
            <div class="rounded-lg border border-white/10 bg-white/5 px-4 py-3 text-sm text-white/85">
              {proof}
            </div>
          ))
        }
      </div>
    </div>
  </Section>
</PageLayout>
