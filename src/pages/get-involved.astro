---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/layout/PageHero.astro";
import Section from "../components/layout/Section.astro";
import {
  getVolunteerRoles,
  getSiteSettings,
  type SanityVolunteerRole,
} from "../lib/sanity";
import {
  resolveGalleryStrip,
  resolveHeroImage,
} from "../lib/hero-images";

let socialFacebook = "https://facebook.com/apotidev";
let socialInstagram = "https://instagram.com/apotidev";
let socialTwitter = "https://twitter.com/apotidev";

try {
  const settings = await getSiteSettings();
  if (settings) {
    socialFacebook = settings.socialFacebook || socialFacebook;
    socialInstagram = settings.socialInstagram || socialInstagram;
    socialTwitter = settings.socialTwitter || socialTwitter;
  }
} catch {}

// TODO: Move to Sanity schema when partnershipTier type is created
const partnershipTiers = [
  {
    tier: "Community Sponsor",
    range: "$500-$1,000",
    desc: "Support supplies, food, or seasonal giving with a receipt and concise update.",
  },
  {
    tier: "Project Sponsor",
    range: "$2,500-$5,000",
    desc: "Fund a defined project with a budget, people served, outcome summary, and final report.",
  },
  {
    tier: "Program Sponsor",
    range: "$10,000+",
    desc: "Support a full program cycle with quarterly updates, final reporting, and agreed recognition.",
  },
  {
    tier: "Strategic Partner",
    range: "Custom",
    desc: "Discuss a larger campaign, recurring support, or custom reporting agreement.",
  },
];

const partnerAudiences = [
  {
    title: "Churches",
    desc: "Mission committees, youth groups, and congregations can sponsor education, widow support, or seasonal giving projects with clear updates for members.",
  },
  {
    title: "Companies",
    desc: "CSR teams can fund practical programs, employee giving campaigns, or in-kind support with concise reporting and public recognition.",
  },
  {
    title: "Diaspora Groups",
    desc: "Cameroonian and African diaspora associations can pool gifts into visible community projects back home.",
  },
  {
    title: "Schools & Universities",
    desc: "Student clubs, service-learning programs, and campus faith groups can support campaigns, research, and awareness events.",
  },
  {
    title: "Foundations",
    desc: "Grantmakers receive proposals, budgets, monitoring data, and governance documents for review.",
  },
];

const fallbackRoles = [
  {
    title: "Community Outreach Coordinator",
    time: "10-15 hrs/week",
    location: "On-site",
    desc: "Lead community engagement and program delivery.",
  },
  {
    title: "Education Mentor",
    time: "5-10 hrs/week",
    location: "On-site",
    desc: "Tutor and mentor orphaned children in our education program.",
  },
  {
    title: "Skills Training Facilitator",
    time: "8-12 hrs/week",
    location: "On-site",
    desc: "Teach vocational skills to young women.",
  },
  {
    title: "Healthcare Support Volunteer",
    time: "5-8 hrs/week",
    location: "On-site",
    desc: "Assist with hospital visits and health awareness campaigns.",
  },
  {
    title: "Digital Media & Communications",
    time: "5-10 hrs/week",
    location: "Remote",
    desc: "Manage social media, create content, and tell our story.",
  },
  {
    title: "Fundraising & Events",
    time: "Flexible",
    location: "Remote",
    desc: "Help plan campaigns and coordinate fundraising events.",
  },
];

let volunteerRoles = fallbackRoles;
try {
  const roles = await getVolunteerRoles();
  if (roles?.length) {
    volunteerRoles = roles.map((r: SanityVolunteerRole) => ({
      title: r.title,
      time: r.timeCommitment,
      location: r.location,
      desc: r.description,
    }));
  }
} catch {}

const metaTitle = "Get Involved";
const metaDescription =
  "Join ADA as a volunteer, monthly supporter, or corporate partner. Multiple ways to make a difference.";

const heroImage = await resolveHeroImage([
  "women-empowerment",
  "widow-support",
  "education-orphans",
]);
const galleryStrip = await resolveGalleryStrip(4);
const ways = [
  {
    title: "Volunteer",
    desc: "Give your time and skills",
    href: "#volunteer",
    image: galleryStrip[0],
  },
  {
    title: "Monthly Giving",
    desc: "Join our giving community",
    href: "/monthly",
    image: galleryStrip[1],
  },
  {
    title: "Advocate",
    desc: "Share our mission with others",
    href: "#advocate",
    image: galleryStrip[2],
  },
  {
    title: "Partner",
    desc: "Institutional and community partnerships",
    href: "#partnerships",
    image: galleryStrip[3],
  },
];
---
<!-- Hallmark · genre: editorial · macrostructure: Photographic · design-system: design.md · designed-as-app -->

<PageLayout title={metaTitle} description={metaDescription}>
  <PageHero
    title="Get Involved"
    subtitle="There are many ways to support our mission. Find the one that's right for you."
    imageUrl={heroImage?.imageUrl}
    imageAlt={heroImage?.imageAlt}
  />

  <!-- Ways to Help -->
  <Section background="white" padding="lg">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-heading font-bold text-gray-900 tracking-tight">
        Ways to Help
      </h2>
    </div>
    <ul class="mt-10 divide-y divide-gray-200 border-y border-gray-200 max-w-3xl">
      {
        ways.map((way) => (
          <li>
            <a
              href={way.href}
              class="group flex flex-col sm:flex-row sm:items-center gap-4 py-5"
            >
              {way.image ? (
                <div class="w-full sm:w-28 h-20 shrink-0 overflow-hidden rounded-md bg-gray-100">
                  <img
                    src={way.image.imageUrl}
                    alt={way.image.imageAlt}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
              ) : null}
              <div class="min-w-0">
                <h3 class="font-heading text-lg font-semibold text-gray-900 group-hover:text-primary-700">
                  {way.title}
                </h3>
                <p class="mt-1 text-sm text-gray-600">{way.desc}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Volunteer Opportunities -->
  <Section id="volunteer" background="gray" padding="lg">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-heading font-bold text-gray-900 tracking-tight">
        Volunteer Opportunities
      </h2>
      <p class="mt-4 text-gray-600">
        We have roles for every skill set and availability.
      </p>
    </div>
    <ul class="mt-10 divide-y divide-gray-200 border-y border-gray-200 max-w-3xl">
      {
        volunteerRoles.map((role) => (
          <li class="py-5">
            <h3 class="font-heading text-base font-semibold text-gray-900">{role.title}</h3>
            <p class="mt-1 text-xs text-gray-500">
              {role.time} · {role.location}
            </p>
            <p class="mt-2 text-sm text-gray-600">{role.desc}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Volunteer Form -->
  <Section background="white" padding="lg">
    <div class="max-w-2xl">
      <h2 class="text-2xl font-heading font-bold text-gray-900">
        Apply to Volunteer
      </h2>
      <form class="mt-8 space-y-4" id="volunteer-form">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label
              for="vol-name"
              class="block text-sm font-medium text-gray-700 mb-1">Name *</label
            >
            <input
              type="text"
              id="vol-name"
              name="name"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
            />
          </div>
          <div>
            <label
              for="vol-email"
              class="block text-sm font-medium text-gray-700 mb-1"
              >Email *</label
            >
            <input
              type="email"
              id="vol-email"
              name="email"
              required
              class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
            />
          </div>
        </div>
        <div>
          <label
            for="vol-role"
            class="block text-sm font-medium text-gray-700 mb-1"
            >Preferred Role</label
          >
          <select
            id="vol-role"
            name="role"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
          >
            <option value="">Select a role...</option>
            {
              volunteerRoles.map((r) => (
                <option value={r.title}>{r.title}</option>
              ))
            }
          </select>
        </div>
        <div>
          <label
            for="vol-availability"
            class="block text-sm font-medium text-gray-700 mb-1"
            >Availability</label
          >
          <select
            id="vol-availability"
            name="availability"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
          >
            <option value="flexible">Flexible</option>
            <option value="full-time">Full-time</option>
            <option value="part-time">Part-time</option>
            <option value="weekends">Weekends only</option>
          </select>
        </div>
        <div>
          <label
            for="vol-message"
            class="block text-sm font-medium text-gray-700 mb-1"
            >Why do you want to volunteer?</label
          >
          <textarea
            id="vol-message"
            name="message"
            rows="3"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
          ></textarea>
        </div>
        <button
          type="submit"
          class="w-full sm:w-auto px-6 py-3 text-base font-semibold text-primary-800 border border-primary-300 rounded-md hover:bg-primary-50 transition-colors"
        >
          Submit Application
        </button>
      </form>
    </div>
  </Section>

  <script>
    document
      .getElementById("volunteer-form")!
      .addEventListener("submit", async (e) => {
        e.preventDefault();
        const form = e.target as HTMLFormElement;
        const btn = form.querySelector(
          'button[type="submit"]',
        ) as HTMLButtonElement;
        btn.disabled = true;
        btn.textContent = "Sending...";

        const formData = new FormData(form);
        const role = (formData.get("role") as string) || "General Volunteer";
        const availability =
          (formData.get("availability") as string) || "Flexible";
        const motivation = (formData.get("message") as string) || "";

        const payload = {
          name: formData.get("name") as string,
          email: formData.get("email") as string,
          subject: `Volunteer Application — ${role}`,
          message: `Role: ${role}\nAvailability: ${availability}\n\nMotivation:\n${motivation}`,
        };

        const msg = document.createElement("p");
        msg.setAttribute("role", "alert");
        msg.setAttribute("aria-live", "polite");

        try {
          const res = await fetch("/api/contact", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });

          if (res.ok) {
            msg.className = "mt-4 text-sm text-green-700 font-medium";
            msg.textContent =
              "Application submitted! We will review it and be in touch within 3–5 business days.";
            form.reset();
            btn.textContent = "Submitted!";
          } else {
            throw new Error("Server error");
          }
        } catch {
          msg.className = "mt-4 text-sm text-red-600";
          msg.textContent =
            "Something went wrong. Please email us directly at info@apotidev.org.";
          btn.disabled = false;
          btn.textContent = "Submit Application";
        }

        form.appendChild(msg);
      });
  </script>

  <!-- Partnerships -->
  <Section id="partnerships" background="gray" padding="lg">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-heading font-bold text-gray-900 tracking-tight">
        Partnerships
      </h2>
      <p class="mt-4 text-gray-600">
        Partner with us to create lasting impact in Cameroon through sponsorship,
        grants, campaigns, or in-kind support.
      </p>
    </div>
    <ul class="mt-8 divide-y divide-gray-200 border-y border-gray-200 max-w-3xl">
      {
        partnerAudiences.map((partner) => (
          <li class="py-4">
            <h3 class="font-heading text-sm font-semibold text-gray-900">
              {partner.title}
            </h3>
            <p class="mt-1 text-sm text-gray-600 leading-relaxed">
              {partner.desc}
            </p>
          </li>
        ))
      }
    </ul>
    <ul class="mt-10 divide-y divide-gray-200 border-y border-gray-200 max-w-3xl">
      {
        partnershipTiers.map((p) => (
          <li class="py-5 flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-2">
            <div>
              <h3 class="font-heading text-lg font-semibold text-gray-900">
                {p.tier}
              </h3>
              <p class="mt-1 font-heading text-base font-bold text-primary-700">
                {p.range}
              </p>
              <p class="mt-2 text-sm text-gray-600">{p.desc}</p>
            </div>
            <a
              href={`/contact?subject=Sponsorship+Inquiry+%E2%80%94+${encodeURIComponent(p.tier)}`}
              class="font-heading text-sm font-semibold text-primary-700 shrink-0"
            >
              Start an inquiry →
            </a>
          </li>
        ))
      }
    </ul>
    <div class="mt-8 max-w-3xl p-5 bg-[#faf8f4] rounded-md border border-gray-200">
      <h3 class="text-base font-semibold text-gray-900">
        Need documents before sponsoring?
      </h3>
      <p class="mt-2 text-sm text-gray-600">
        We can share registration documents, annual reports, project records,
        budgets, and references for churches, companies, foundations, and
        diaspora groups reviewing ADA.
      </p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href="/transparency"
          class="font-heading text-sm font-semibold text-primary-700 underline underline-offset-4"
          >Review transparency</a
        >
        <a
          href="/contact?subject=Partnership+Due+Diligence+Package"
          class="font-heading text-sm font-semibold text-primary-700 underline underline-offset-4"
          >Request due diligence package</a
        >
        <a
          href="/sponsor"
          class="font-heading text-sm font-semibold text-primary-700 underline underline-offset-4"
          >See sponsor options</a
        >
      </div>
    </div>
  </Section>

  <!-- Advocate -->
  <Section id="advocate" background="dark" padding="md" class="!bg-[#121a14] !bg-none">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-heading font-bold tracking-tight">Spread the Word</h2>
      <p class="mt-2 text-white/80">
        Share our mission on social media and help us reach more people.
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-4">
        <a
          href={socialFacebook}
          target="_blank"
          rel="noopener"
          class="font-heading text-sm font-semibold text-white/90 underline decoration-white/40 underline-offset-4 hover:text-white"
          >Facebook</a
        >
        <a
          href={socialInstagram}
          target="_blank"
          rel="noopener"
          class="font-heading text-sm font-semibold text-white/90 underline decoration-white/40 underline-offset-4 hover:text-white"
          >Instagram</a
        >
        <a
          href={socialTwitter}
          target="_blank"
          rel="noopener"
          class="font-heading text-sm font-semibold text-white/90 underline decoration-white/40 underline-offset-4 hover:text-white"
          >Twitter/X</a
        >
      </div>
    </div>
  </Section>
</PageLayout>
