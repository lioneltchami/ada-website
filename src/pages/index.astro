---
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/layout/Section.astro";
import CurrentWork from "../components/home/CurrentWork.astro";
import PhotoMosaic from "../components/home/PhotoMosaic.astro";
import WorkVideo from "../components/home/WorkVideo.astro";
import StoryReviewNotice from "../components/home/StoryReviewNotice.astro";
import {
  getImpactMetrics,
  getHomePage,
  getTestimonials,
  getProjects,
  type SanityImpactMetric,
  type SanityProject,
  sanityImageUrl,
} from "../lib/sanity";
import { REGISTRATION_NUMBER } from "../data/organization";
import { homepageStatsFallback } from "../data/impact";
import { loadSpotlightProjects } from "../lib/spotlight-projects";
import { loadGalleryMosaic } from "../lib/gallery";

let heroImageUrl = "";
try {
  const projects = await getProjects();
  if (projects?.length) {
    const preferred =
      projects.find(
        (p: SanityProject) =>
          p.slug?.current === "widow-support" && p.mainImage?.asset?._ref,
      ) ||
      projects.find(
        (p: SanityProject) =>
          p.slug?.current === "education-orphans" && p.mainImage?.asset?._ref,
      ) ||
      projects.find((p: SanityProject) => p.mainImage?.asset?._ref);
    if (preferred?.mainImage?.asset?._ref)
      heroImageUrl = sanityImageUrl(preferred.mainImage.asset._ref, 1200);
  }
} catch {}

let stats = homepageStatsFallback("en");

try {
  const metrics = await getImpactMetrics();
  if (metrics?.length) {
    stats = metrics.map((m: SanityImpactMetric) => ({
      value: `${m.value}${m.suffix || ""}`,
      label: m.label,
    }));
  }
} catch {}

// Fallback content
let heroBadge = "Faith-Based Charity \u00b7 Cameroon";
let heroHeadline =
  "No Widow Should Have to Choose Between Food and School Fees";
let heroSubtitle =
  "Since 2021, ADA has worked with widows, orphans, and young women in Cameroon through community-based support.";
let missionHeading = "Our Mission";
let missionBody =
  "To provide holistic support to vulnerable communities in Cameroon through faith-based programs that address immediate needs while building long-term self-sufficiency.";
let missionCards = [
  {
    icon: "",
    title: "Widow Support",
    description:
      "Food and financial support for widows and families rebuilding household stability.",
  },
  {
    icon: "",
    title: "Education",
    description:
      "School supplies, tuition support, and mentorship for orphaned children.",
  },
  {
    icon: "",
    title: "Empowerment",
    description:
      "Vocational training and microfinance for young women seeking independence.",
  },
];
let ctaHeading = "Fund school kits for Buea and Bamenda";
let ctaBody =
  "Your gift buys bags, books, and fees so orphaned and displaced children can start the school year with dignity.";

try {
  const page = await getHomePage();
  if (page) {
    heroBadge = page.heroBadge || heroBadge;
    heroHeadline = page.heroHeadline || heroHeadline;
    heroSubtitle = page.heroSubtitle || heroSubtitle;
    missionHeading = page.missionHeading || missionHeading;
    missionBody = page.missionBody || missionBody;
    if (page.missionCards?.length) missionCards = page.missionCards;
    ctaHeading = page.ctaHeading || ctaHeading;
    ctaBody = page.ctaBody || ctaBody;
  }
} catch {}

interface Testimonial {
  name: string;
  quote: string;
  location: string;
  program: string;
  photoUrl?: string;
  photoAlt?: string;
}

const fallbackTestimonials: Testimonial[] = [
  {
    name: "Marie F.",
    quote:
      "ADA paid my school fees when my grandmother could not afford them. They gave me books, a uniform, and a mentor who checks on me every week. I want to become a nurse to help others.",
    location: "Douala",
    program: "Education for Orphans",
  },
  {
    name: "Esther K.",
    quote:
      "The skills training program taught me hairdressing. ADA even helped me get my first set of tools. Now I have regular clients and I am saving to open my own salon.",
    location: "Yaoundé",
    program: "Young Women Empowerment",
  },
];

let testimonials: Testimonial[] = fallbackTestimonials;
try {
  const data = await getTestimonials();
  if (data?.length) {
    testimonials = data.map((t: any) => ({
      name: t.name,
      quote: t.quote,
      location: t.location || "",
      program: t.program || "",
      photoUrl: t.photo?.asset?._ref
        ? sanityImageUrl(t.photo.asset._ref, 200)
        : undefined,
      photoAlt: t.photo?.alt || t.name,
    }));
  }
} catch {}

const spotlightProjects = await loadSpotlightProjects("en", 4);
const mosaicPhotos = await loadGalleryMosaic(8);

const programPillars = [
  {
    title: "Widow Relief",
    text: "Food support, cash assistance, and follow-up for widows rebuilding household stability.",
    href: "/projects/widow-support",
  },
  {
    title: "Orphan Education",
    text: "School fees, supplies, uniforms, and mentoring so vulnerable children can stay enrolled.",
    href: "/projects/education-orphans",
  },
  {
    title: "Young Women Skills",
    text: "Vocational training and startup support for young women moving toward income and dignity.",
    href: "/projects/women-empowerment",
  },
  {
    title: "Emergency Family Support",
    text: "Rapid food, hygiene, and household relief for families facing crisis or displacement.",
    href: "/projects/emergency-relief",
  },
  {
    title: "Health and Maternal Care",
    text: "Practical support for hospital visits, prenatal care, and urgent community health needs.",
    href: "/projects/archive/hospital-prenatal-care-jul-2025",
  },
  {
    title: "Community Development",
    text: "Environmental stewardship and locally led improvements for shared wellbeing.",
    href: "/projects/archive",
  },
];

const confidenceProofs = [
  { label: "Registered in Cameroon", value: REGISTRATION_NUMBER },
  {
    label: "Diaspora accountability",
    value: "Led from Canada, serving Cameroon",
  },
  {
    label: "Open documentation",
    value: "Reports, policies, and project records available",
  },
  {
    label: "Clear donor status",
    value: "Receipts for records, no tax-deductible claims outside Cameroon",
  },
];

const journeyMilestones = [
  {
    year: "2021",
    title: "Founded in Buea",
    text: "ADA began in Buea with food support for widows facing immediate household needs.",
  },
  {
    year: "2022",
    title: "Community support",
    text: "Food and family support remained part of ADA's work.",
  },
  {
    year: "2023",
    title: "Education support deepened",
    text: "School supplies, fees, and mentorship became a core path for children.",
  },
  {
    year: "2024",
    title: "Bamenda office opened",
    text: "ADA added a Bamenda office and organized reports, TORs, and financial documents for partners.",
  },
  {
    year: "2025",
    title: "Community programs broadened",
    text: "Clean-up, health, youth mentorship, and emergency support reached more communities.",
  },
  {
    year: "2026",
    title: "Partnership readiness",
    text: "ADA is preparing stronger systems for institutional partners and recurring donors.",
  },
];

const actionPaths = [
  {
    title: "Give",
    text: "Make a one-time or monthly gift to support urgent relief and long-term empowerment.",
    href: "/donate",
    cta: "Donate now",
  },
  {
    title: "Volunteer",
    text: "Offer time, skills, coordination, translation, fundraising, or community support.",
    href: "/get-involved",
    cta: "Get involved",
  },
  {
    title: "Partner",
    text: "Sponsor a focused program with clear funding options, reporting, and due diligence.",
    href: "/sponsor",
    cta: "Sponsor a program",
  },
  {
    title: "Read reports",
    text: "Explore annual reports, policies, and project documentation before funding work.",
    href: "/resources",
    cta: "View resources",
  },
];
---

<PageLayout
  title="Apoti Development Association | Hope, Dignity, Empowerment"
  description="Supporting vulnerable communities through faith-based programmes that bring hope, uphold dignity and create opportunities for widows, orphans and young women."
>
  <!-- Hallmark · genre: editorial · macrostructure: Photographic · design-system: design.md · designed-as-app -->
  <!-- Hero — left-biased photographic -->
  <section class="relative overflow-hidden min-h-[70vh] flex items-end text-white">
    {
      heroImageUrl ? (
        <img
          src={heroImageUrl}
          alt="Beneficiaries of ADA programs in Cameroon"
          class="absolute inset-0 w-full h-full object-cover"
          loading="eager"
        />
      ) : (
        <div class="absolute inset-0 bg-primary-900" />
      )
    }
    <div
      class="absolute inset-0 bg-gradient-to-r from-primary-950/95 via-primary-900/70 to-primary-900/25"
    >
    </div>
    <div class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
      <div class="max-w-2xl">
        <p
          class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-200 mb-4"
        >
          {heroBadge}
        </p>
        <h1
          class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-heading font-bold leading-[1.1] tracking-tight"
        >
          {heroHeadline}
        </h1>
        <p class="mt-5 text-base md:text-lg text-white/85 leading-relaxed max-w-xl">
          {heroSubtitle}
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="/donate"
            class="font-heading inline-flex items-center px-5 py-2.5 text-sm font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors"
            data-umami-event="hero-donate-cta"
          >
            Donate now
          </a>
          <a
            href="/projects"
            class="font-heading inline-flex items-center px-5 py-2.5 text-sm font-semibold text-white border border-white/40 rounded-md hover:bg-white/10 transition-colors"
          >
            Our projects
          </a>
          <a
            href="/transparency"
            class="font-heading text-sm font-semibold text-white/90 underline decoration-white/40 underline-offset-4 hover:text-white"
          >
            Transparency
          </a>
        </div>
        <p class="mt-6 text-sm text-white/75">
          {
            stats
              .slice(0, 2)
              .map((stat) => `${stat.value} ${stat.label.toLowerCase()}`)
              .join(" · ")
          }
          {" · "}80% to programs
        </p>
      </div>
    </div>
  </section>

  <CurrentWork locale="en" projects={spotlightProjects} />
  <PhotoMosaic locale="en" photos={mosaicPhotos} />
  <WorkVideo locale="en" />

  <!-- Impact stats — flat band -->
  <Section background="white" padding="md">
    <div
      class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-4 border-y border-gray-200 py-8"
    >
      {
        stats.map((stat) => (
          <div>
            <p class="font-heading text-3xl md:text-4xl font-bold text-primary-700 tracking-tight">
              {stat.value}
            </p>
            <p class="mt-1 text-sm text-gray-600">{stat.label}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-sm text-gray-500">
      5% administrative allocation target · Cameroon NGO
      registration N&deg; 415/G.37/D14/VolI/SAAJP ·{" "}
      <a href="/transparency" class="text-primary-700 underline underline-offset-2"
        >Full transparency report</a
      >
    </p>
  </Section>

  <!-- Partner confidence — split, hairline proofs -->
  <Section background="gray" padding="md">
    <div class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-10 items-start">
      <div>
        <p
          class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700"
        >
          Partner with confidence
        </p>
        <h2
          class="mt-3 text-2xl md:text-3xl font-heading font-bold text-gray-900 tracking-tight"
        >
          Small enough to know families by name. Organized enough to show the
          records.
        </h2>
        <p class="mt-4 text-gray-600 leading-relaxed">
          ADA combines local community relationships in Cameroon with diaspora
          accountability, documented project files, and clear donor
          communication.
        </p>
      </div>
      <dl class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-gray-200 border border-gray-200">
        {
          confidenceProofs.map((item) => (
            <div class="bg-[#f7f5f0] p-5">
              <dt class="font-heading text-xs font-semibold uppercase tracking-wider text-gray-500">
                {item.label}
              </dt>
              <dd class="mt-2 text-sm font-semibold text-gray-900 leading-relaxed">
                {item.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <!-- Program pillars — typographic list, not numbered tiles -->
  <Section background="white" padding="lg">
    <div class="max-w-3xl">
      <p
        class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700"
      >
        How we serve
      </p>
      <h2
        class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight"
      >
        Practical paths for vulnerable families
      </h2>
      <p class="mt-4 text-gray-600 leading-relaxed">
        Each program starts with immediate needs, then points toward dignity,
        stability, and self-sufficiency.
      </p>
    </div>
    <ul class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-0 border-t border-gray-200">
      {
        programPillars.map((pillar) => (
          <li class="border-b border-gray-200">
            <a
              href={pillar.href}
              class="group flex items-baseline justify-between gap-4 py-5"
            >
              <div>
                <h3 class="font-heading text-lg font-semibold text-gray-900 group-hover:text-primary-700 transition-colors">
                  {pillar.title}
                </h3>
                <p class="mt-1 text-sm text-gray-600 leading-relaxed">
                  {pillar.text}
                </p>
              </div>
              <span
                class="font-heading text-sm font-semibold text-primary-700 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity"
                aria-hidden="true"
              >
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Leadership -->
  <Section background="gray" padding="lg">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <div>
        <p
          class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700"
        >
          Leadership and governance
        </p>
        <blockquote
          class="mt-4 text-xl md:text-2xl font-heading font-bold text-gray-900 leading-snug tracking-tight"
        >
          “Faith must become practical care, careful records, and accountable
          service.”
        </blockquote>
        <p class="mt-5 text-gray-600 leading-relaxed">
          ADA is led by volunteer executive leadership, a 12-member board, and
          local program coordination in Cameroon. The work is built around
          documented needs, separated financial roles, and community
          relationships.
        </p>
      </div>
      <div>
        <h2
          class="text-2xl md:text-3xl font-heading font-bold text-gray-900 tracking-tight"
        >
          Local relationships, visible accountability
        </h2>
        <p class="mt-4 text-gray-600 leading-relaxed">
          Programs are coordinated with widows, caregivers, school leaders,
          churches, volunteers, and community partners so support reaches
          documented needs.
        </p>
        <dl class="mt-6 grid grid-cols-3 gap-4 border-t border-gray-200 pt-6">
          <div>
            <dt
              class="font-heading text-xs font-semibold uppercase tracking-wider text-gray-500"
            >
              Board
            </dt>
            <dd class="mt-1 font-heading text-lg font-bold text-primary-700">
              12 members
            </dd>
          </div>
          <div>
            <dt
              class="font-heading text-xs font-semibold uppercase tracking-wider text-gray-500"
            >
              Delivery
            </dt>
            <dd class="mt-1 font-heading text-lg font-bold text-primary-700">
              Cameroon
            </dd>
          </div>
          <div>
            <dt
              class="font-heading text-xs font-semibold uppercase tracking-wider text-gray-500"
            >
              Oversight
            </dt>
            <dd class="mt-1 font-heading text-lg font-bold text-primary-700">
              Dual roles
            </dd>
          </div>
        </dl>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/about"
            class="font-heading text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
            >Read our story</a
          >
          <a
            href="/transparency"
            class="font-heading text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
            >View governance</a
          >
        </div>
      </div>
    </div>
  </Section>

  <!-- Journey — left-aligned editorial -->
  <Section background="white" padding="lg">
    <div class="max-w-3xl">
      <p
        class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700"
      >
        ADA journey
      </p>
      <h2
        class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight"
      >
        From first food packages to partner-ready transparency
      </h2>
      <p class="mt-4 text-gray-600 leading-relaxed">
        ADA has grown by responding to real community needs and documenting the
        work as it expands.
      </p>
    </div>
    <ol class="mt-10 max-w-3xl space-y-0 list-none border-l border-gray-200 ml-1">
      {
        journeyMilestones.map((item) => (
          <li class="relative pl-8 pb-8 last:pb-0">
            <span
              class="absolute left-0 top-1.5 -translate-x-1/2 w-2 h-2 rounded-sm bg-primary-600 border border-[#f7f5f0]"
              aria-hidden="true"
            />
            <p class="font-heading text-sm font-bold text-primary-700">
              {item.year}
            </p>
            <h3 class="mt-1 font-heading text-base font-semibold text-gray-900">
              {item.title}
            </h3>
            <p class="mt-1 text-sm text-gray-600 leading-relaxed">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Mission — text, no emoji cards -->
  <Section background="gray" padding="lg">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.1fr] gap-10 items-start">
      <div>
        <h2
          class="text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight"
        >
          {missionHeading}
        </h2>
        <p class="mt-4 text-lg text-gray-600 leading-relaxed">{missionBody}</p>
      </div>
      <ul class="space-y-0 border-t border-gray-200">
        {
          missionCards.map((card) => (
            <li class="border-b border-gray-200 py-5">
              <h3 class="font-heading text-lg font-semibold text-gray-900">
                {card.title}
              </h3>
              <p class="mt-1 text-sm text-gray-600 leading-relaxed">
                {card.description}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <StoryReviewNotice locale="en" variant="featured" />

  <!-- Testimonials — featured quote + supporting -->
  <Section background="white" padding="lg">
    <p
      class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700"
    >
      Voices from the field
    </p>
    <h2
      class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight"
    >
      Stories of impact
    </h2>
    {
      testimonials[0] && (
        <figure class="mt-10 max-w-3xl">
          <blockquote class="text-xl md:text-2xl text-gray-800 leading-relaxed">
            “{testimonials[0].quote}”
          </blockquote>
          <figcaption class="mt-6 flex items-center gap-3">
            {testimonials[0].photoUrl ? (
              <img
                src={testimonials[0].photoUrl}
                alt={testimonials[0].photoAlt || testimonials[0].name}
                class="w-12 h-12 rounded-md object-cover border border-gray-200"
                loading="lazy"
              />
            ) : (
              <div class="w-12 h-12 rounded-md bg-primary-100 text-primary-700 flex items-center justify-center text-sm font-heading font-bold border border-primary-200">
                {testimonials[0].name.charAt(0)}
              </div>
            )}
            <div>
              <p class="font-heading text-sm font-semibold text-gray-900">
                {testimonials[0].name}
              </p>
              <p class="text-xs text-gray-500">
                {testimonials[0].program}
                {testimonials[0].location
                  ? ` · ${testimonials[0].location}`
                  : ""}
              </p>
            </div>
          </figcaption>
        </figure>
      )
    }
    {
      testimonials.length > 1 && (
        <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-8 border-t border-gray-200 pt-10">
          {testimonials.slice(1, 3).map((t) => (
            <figure>
              <blockquote class="text-base text-gray-700 leading-relaxed">
                “{t.quote}”
              </blockquote>
              <figcaption class="mt-4 flex items-center gap-3">
                {t.photoUrl ? (
                  <img
                    src={t.photoUrl}
                    alt={t.photoAlt || t.name}
                    class="w-10 h-10 rounded-md object-cover border border-gray-200"
                    loading="lazy"
                  />
                ) : (
                  <div class="w-10 h-10 rounded-md bg-primary-100 text-primary-700 flex items-center justify-center text-xs font-heading font-bold border border-primary-200">
                    {t.name.charAt(0)}
                  </div>
                )}
                <div>
                  <p class="font-heading text-sm font-semibold text-gray-900">
                    {t.name}
                  </p>
                  <p class="text-xs text-gray-500">
                    {t.program}
                    {t.location ? ` · ${t.location}` : ""}
                  </p>
                </div>
              </figcaption>
            </figure>
          ))}
        </div>
      )
    }
  </Section>

  <!-- Action paths — text list -->
  <Section background="gray" padding="lg">
    <div class="max-w-3xl">
      <p
        class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700"
      >
        Join the work
      </p>
      <h2
        class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight"
      >
        Choose the path that fits your role
      </h2>
    </div>
    <ul class="mt-8 max-w-3xl divide-y divide-gray-200 border-y border-gray-200">
      {
        actionPaths.map((path) => (
          <li>
            <a
              href={path.href}
              class="group flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 sm:gap-6 py-5"
            >
              <div>
                <h3 class="font-heading text-lg font-semibold text-gray-900 group-hover:text-primary-700 transition-colors">
                  {path.title}
                </h3>
                <p class="mt-1 text-sm text-gray-600 leading-relaxed">
                  {path.text}
                </p>
              </div>
              <span class="font-heading text-sm font-semibold text-primary-700 shrink-0">
                {path.cta} →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  <!-- Closing CTA — specific copy from Sanity -->
  <Section background="dark" padding="lg" class="!bg-[#121a14] !bg-none">
    <div class="max-w-2xl">
      <h2
        class="text-3xl md:text-4xl font-heading font-bold tracking-tight text-left"
      >
        {ctaHeading}
      </h2>
      <p class="mt-4 text-lg text-white/80 text-left">{ctaBody}</p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/donate"
          class="font-heading inline-flex items-center px-5 py-2.5 text-sm font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors"
          data-umami-event="cta-donate"
        >
          Donate now
        </a>
        <a
          href="/get-involved"
