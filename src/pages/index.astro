---
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/layout/Section.astro";
import CurrentWork from "../components/home/CurrentWork.astro";
import NewsletterSignup from "../components/islands/NewsletterSignup";
import {
  getImpactMetrics,
  getHomePage,
  getTestimonials,
  getProjects,
  type SanityImpactMetric,
  type SanityHomePage,
  type SanityProject,
  sanityImageUrl,
} from "../lib/sanity";
import { REGISTRATION_NUMBER } from "../data/organization";
import { homepageStatsFallback } from "../data/impact";
import { loadSpotlightProjects } from "../lib/spotlight-projects";

let heroImageUrl = "";
try {
  const projects = await getProjects();
  if (projects?.length) {
    const withImage = projects.find(
      (p: SanityProject) => p.mainImage?.asset?._ref,
    );
    if (withImage)
      heroImageUrl = sanityImageUrl(withImage.mainImage!.asset._ref, 1200);
  }
} catch {}

let stats = homepageStatsFallback("en");

try {
  const metrics = await getImpactMetrics();
  if (metrics?.length) {
    stats = metrics.map((m: SanityImpactMetric) => ({
      value: `${m.value}${m.suffix || ""}`,
      label: m.label,
    }));
  }
} catch {}

// Fallback content
let heroBadge = "Faith-Based Charity \u00b7 Cameroon";
let heroHeadline =
  "No Widow Should Have to Choose Between Food and School Fees";
let heroSubtitle =
  "Since 2021, we've helped 200+ widows, orphans, and young women in Cameroon move from crisis to self-sufficiency. 80\u00a2 of every dollar goes directly to programs.";
let missionHeading = "Our Mission";
let missionBody =
  "To provide holistic support to vulnerable communities in Cameroon through faith-based programs that address immediate needs while building long-term self-sufficiency.";
let missionCards = [
  {
    icon: "🤝",
    title: "Widow Support",
    description:
      "Financial aid, skills training, and community for widows rebuilding their lives.",
  },
  {
    icon: "📚",
    title: "Education",
    description:
      "School supplies, tuition support, and mentorship for orphaned children.",
  },
  {
    icon: "💪",
    title: "Empowerment",
    description:
      "Vocational training and microfinance for young women seeking independence.",
  },
];
let ctaHeading = "Make a Difference Today";
let ctaBody =
  "Every contribution helps us reach more vulnerable communities in Cameroon. Join us in building a brighter future.";

try {
  const page = await getHomePage();
  if (page) {
    heroBadge = page.heroBadge || heroBadge;
    heroHeadline = page.heroHeadline || heroHeadline;
    heroSubtitle = page.heroSubtitle || heroSubtitle;
    missionHeading = page.missionHeading || missionHeading;
    missionBody = page.missionBody || missionBody;
    if (page.missionCards?.length) missionCards = page.missionCards;
    ctaHeading = page.ctaHeading || ctaHeading;
    ctaBody = page.ctaBody || ctaBody;
  }
} catch {}

interface Testimonial {
  name: string;
  quote: string;
  location: string;
  program: string;
}

const fallbackTestimonials: Testimonial[] = [
  {
    name: "Amina N.",
    quote:
      "After my husband passed, I did not know how I would feed my children. ADA provided food packages and enrolled me in tailoring training. Today I run a small shop and can support my family on my own.",
    location: "Bamenda",
    program: "Widow Support Program",
  },
  {
    name: "Marie F.",
    quote:
      "ADA paid my school fees when my grandmother could not afford them. They gave me books, a uniform, and a mentor who checks on me every week. I want to become a nurse to help others.",
    location: "Douala",
    program: "Education for Orphans",
  },
  {
    name: "Esther K.",
    quote:
      "The skills training program taught me hairdressing. ADA even helped me get my first set of tools. Now I have regular clients and I am saving to open my own salon.",
    location: "Yaoundé",
    program: "Young Women Empowerment",
  },
];

let testimonials: Testimonial[] = fallbackTestimonials;
try {
  const data = await getTestimonials();
  if (data?.length) {
    testimonials = data.map((t: any) => ({
      name: t.name,
      quote: t.quote,
      location: t.location || "",
      program: t.program || "",
    }));
  }
} catch {}

const spotlightProjects = await loadSpotlightProjects("en", 4);

const programPillars = [
  {
    title: "Widow Relief",
    text: "Food support, cash assistance, and follow-up for widows rebuilding household stability.",
    href: "/projects/widow-support",
  },
  {
    title: "Orphan Education",
    text: "School fees, supplies, uniforms, and mentoring so vulnerable children can stay enrolled.",
    href: "/projects/education-orphans",
  },
  {
    title: "Young Women Skills",
    text: "Vocational training and startup support for young women moving toward income and dignity.",
    href: "/projects/women-empowerment",
  },
  {
    title: "Emergency Family Support",
    text: "Rapid food, hygiene, and household relief for families facing crisis or displacement.",
    href: "/projects/emergency-relief",
  },
  {
    title: "Health and Maternal Care",
    text: "Practical support for hospital visits, prenatal care, and urgent community health needs.",
    href: "/projects/archive/hospital-prenatal-care-jul-2025",
  },
  {
    title: "Community Development",
    text: "Clean water, environmental stewardship, and locally led improvements for shared wellbeing.",
    href: "/projects/archive",
  },
];

const confidenceProofs = [
  { label: "Registered in Cameroon", value: REGISTRATION_NUMBER },
  {
    label: "Diaspora accountability",
    value: "Led from Canada, serving Cameroon",
  },
  {
    label: "Open documentation",
    value: "Reports, policies, and project records available",
  },
  {
    label: "Clear donor status",
    value: "Receipts for records, no tax-deductible claims outside Cameroon",
  },
];

const journeyMilestones = [
  {
    year: "2021",
    title: "Founded in Bamenda",
    text: "ADA began with food support for widows facing immediate household needs.",
  },
  {
    year: "2022",
    title: "Widow support expanded",
    text: "Relief work grew into training, follow-up, and direct family support.",
  },
  {
    year: "2023",
    title: "Education support deepened",
    text: "School supplies, fees, and mentorship became a core path for children.",
  },
  {
    year: "2024",
    title: "Transparency library launched",
    text: "Reports, TORs, and financial documents were organized for funder review.",
  },
  {
    year: "2025",
    title: "Community programs broadened",
    text: "Clean-up, health, youth mentorship, and emergency support reached more communities.",
  },
  {
    year: "2026",
    title: "Partnership readiness",
    text: "ADA is preparing stronger systems for institutional partners and recurring donors.",
  },
];

const actionPaths = [
  {
    title: "Give",
    text: "Make a one-time or monthly gift to support urgent relief and long-term empowerment.",
    href: "/donate",
    cta: "Donate now",
  },
  {
    title: "Volunteer",
    text: "Offer time, skills, coordination, translation, fundraising, or community support.",
    href: "/get-involved",
    cta: "Get involved",
  },
  {
    title: "Partner",
    text: "Sponsor a focused program with clear funding options, reporting, and due diligence.",
    href: "/sponsor",
    cta: "Sponsor a program",
  },
  {
    title: "Read reports",
    text: "Explore annual reports, policies, and project documentation before funding work.",
    href: "/resources",
    cta: "View resources",
  },
];
---

<PageLayout
  title="Empowering Communities in Cameroon"
  description="Empowering vulnerable communities in Cameroon through faith-based programs supporting widows, orphans, and young women since 2021."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden py-24 md:py-32 text-white">
    {
      heroImageUrl ? (
        <img
          src={heroImageUrl}
          alt="Beneficiaries of ADA programs in Cameroon"
          class="absolute inset-0 w-full h-full object-cover"
          loading="eager"
        />
      ) : null
    }
    <div
      class="absolute inset-0 bg-gradient-to-br from-primary-900/90 via-primary-800/85 to-primary-900/90"
    >
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span
        class="inline-block px-4 py-1.5 mb-6 text-sm font-medium bg-white/10 backdrop-blur-sm rounded-full border border-white/20"
      >
        {heroBadge}
      </span>
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold leading-tight"
      >
        {heroHeadline}
      </h1>
      <p
        class="mt-6 text-lg md:text-xl text-white/80 max-w-2xl mx-auto leading-relaxed"
      >
        {heroSubtitle}
      </p>
      <div
        class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4"
      >
        <a
          href="/donate"
          class="inline-flex items-center px-6 py-3 text-base font-semibold text-primary-900 bg-white rounded-lg hover:bg-gray-100 transition-colors shadow-lg"
          data-umami-event="hero-donate-cta"
        >
          Donate Now
        </a>
        <a
          href="/projects"
          class="inline-flex items-center px-6 py-3 text-base font-semibold text-white border-2 border-white/30 rounded-lg hover:bg-white/10 transition-colors"
        >
          Our Projects
        </a>
        <a
          href="/transparency"
          class="inline-flex items-center px-6 py-3 text-base font-semibold text-white/90 underline decoration-white/40 underline-offset-4 hover:text-white"
        >
          View Transparency
        </a>
      </div>
      <p
        class="mt-6 text-sm text-white/80 flex flex-wrap items-center justify-center gap-3"
      >
        {
          stats.slice(0, 2).map((stat) => (
            <span class="px-2.5 py-1 bg-white/10 rounded-full border border-white/20">
              {stat.value} {stat.label.toLowerCase()}
            </span>
          ))
        }
        <span
          class="px-2.5 py-1 bg-white/10 rounded-full border border-white/20"
          >80% to programs</span
        >
      </p>
    </div>
  </section>

  <!-- Live campaigns — first content below hero so visitors see current work without deep scroll -->
  <CurrentWork locale="en" projects={spotlightProjects} />

  <!-- Impact Stats -->
  <Section background="white" padding="md">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {
        stats.map((stat, i) => (
          <div class="stat-animate" style={`animation-delay: ${i * 150}ms`}>
            <p class="text-3xl md:text-4xl font-bold text-primary-700">
              {stat.value}
            </p>
            <p class="mt-1 text-sm text-gray-600">{stat.label}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-center text-sm text-gray-500">
      85% of beneficiaries are women and girls · 5% admin overhead · Cameroon
      NGO registration N&deg; 415/G.37/D14/VolI/SAAJP · <a
        href="/transparency"
        class="text-primary-600 hover:underline"
        >View full transparency report</a>
    </p>
  </Section>

  <!-- Partner Confidence -->
  <Section background="gray" padding="md">
    <div
      class="grid grid-cols-1 lg:grid-cols-[0.85fr_1.15fr] gap-8 items-center"
    >
      <div>
        <p
          class="text-xs font-semibold uppercase tracking-wider text-primary-700"
        >
          Partner with confidence
        </p>
        <h2
          class="mt-3 text-2xl md:text-3xl font-heading font-bold text-gray-900"
        >
          Small enough to know families by name. Organized enough to show the
          records.
        </h2>
        <p class="mt-3 text-sm md:text-base text-gray-600 leading-relaxed">
          ADA combines local community relationships in Cameroon with diaspora
          accountability, documented project files, and clear donor
          communication.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          confidenceProofs.map((item) => (
            <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
              <p class="text-xs font-semibold uppercase tracking-wider text-gray-500">
                {item.label}
              </p>
              <p class="mt-2 text-sm font-semibold text-gray-900 leading-relaxed">
                {item.value}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- Program Pillars -->
  <Section background="white" padding="lg">
    <div class="max-w-3xl">
      <p
        class="text-xs font-semibold uppercase tracking-wider text-primary-700"
      >
        Program pillars
      </p>
      <h2
        class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900"
      >
        Six practical ways ADA serves vulnerable families
      </h2>
      <p class="mt-4 text-gray-600 leading-relaxed">
        Each program starts with immediate needs, then points toward dignity,
        stability, and self-sufficiency.
      </p>
    </div>
    <div class="mt-10 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {
        programPillars.map((pillar, index) => (
          <a
            href={pillar.href}
            class="group rounded-xl border border-gray-200 bg-white p-6 shadow-sm hover:-translate-y-1 hover:border-primary-200 hover:shadow-lg transition-all duration-200"
          >
            <div class="flex items-center justify-between gap-4">
              <span class="text-xs font-bold text-primary-700">
                0{index + 1}
              </span>
              <span class="text-xs font-semibold text-gray-400 group-hover:text-primary-600">
                View work →
              </span>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-gray-900 group-hover:text-primary-700 transition-colors">
              {pillar.title}
            </h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">
              {pillar.text}
            </p>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- Leadership / Governance -->
  <Section background="gray" padding="lg">
    <div
      class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-10 items-center"
    >
      <div
        class="rounded-2xl bg-white border border-gray-200 p-6 md:p-8 shadow-card"
      >
        <p
          class="text-xs font-semibold uppercase tracking-wider text-primary-700"
        >
          Leadership and governance
        </p>
        <blockquote
          class="mt-4 text-xl md:text-2xl font-heading font-bold text-gray-900 leading-snug"
        >
          “Faith must become practical care, careful records, and accountable
          service.”
        </blockquote>
        <p class="mt-4 text-sm text-gray-600 leading-relaxed">
          ADA is led by volunteer executive leadership, a 12-member board, and
          local program coordination in Cameroon. The work is built around
          documented needs, separated financial roles, and community
          relationships.
        </p>
        <div class="mt-6 border-t border-gray-100 pt-5">
          <p class="text-sm font-semibold text-gray-900">
            Volunteer-led governance
          </p>
          <p class="text-xs text-gray-500">
            Board oversight, financial separation, and local delivery
          </p>
        </div>
      </div>
      <div>
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900">
          Local relationships, visible accountability
        </h2>
        <p class="mt-4 text-gray-600 leading-relaxed">
          ADA’s leadership story matters because trust is personal before it
          becomes institutional. Programs are coordinated with widows,
          caregivers, school leaders, churches, volunteers, and community
          partners so support reaches documented needs.
        </p>
        <dl class="mt-6 grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="rounded-xl bg-white border border-gray-200 p-4">
            <dt
              class="text-xs font-semibold uppercase tracking-wider text-gray-500"
            >
              Board
            </dt>
            <dd class="mt-1 text-lg font-bold text-primary-700">12 members</dd>
          </div>
          <div class="rounded-xl bg-white border border-gray-200 p-4">
            <dt
              class="text-xs font-semibold uppercase tracking-wider text-gray-500"
            >
              Delivery
            </dt>
            <dd class="mt-1 text-lg font-bold text-primary-700">Cameroon</dd>
          </div>
          <div class="rounded-xl bg-white border border-gray-200 p-4">
            <dt
              class="text-xs font-semibold uppercase tracking-wider text-gray-500"
            >
              Oversight
            </dt>
            <dd class="mt-1 text-lg font-bold text-primary-700">Dual roles</dd>
          </div>
        </dl>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/about"
            class="inline-flex px-4 py-2 text-sm font-semibold text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors"
            >Read our story</a
          >
          <a
            href="/transparency"
            class="inline-flex px-4 py-2 text-sm font-semibold text-primary-700 bg-primary-50 rounded-lg hover:bg-primary-100 transition-colors"
            >View governance</a
          >
        </div>
      </div>
    </div>
  </Section>

  <!-- Journey Timeline -->
  <Section background="white" padding="lg">
    <div class="max-w-3xl mx-auto text-center">
      <p
        class="text-xs font-semibold uppercase tracking-wider text-primary-700"
      >
        ADA journey
      </p>
      <h2
        class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900"
      >
        From first food packages to partner-ready transparency
      </h2>
      <p class="mt-4 text-gray-600 leading-relaxed">
        The timeline below keeps the story simple: ADA has grown by responding
        to real community needs and documenting the work as it expands.
      </p>
    </div>
    <ol
      class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 list-none"
    >
      {
        journeyMilestones.map((item) => (
          <li class="rounded-xl border border-gray-200 bg-gray-50 p-5">
            <p class="text-sm font-bold text-primary-700">{item.year}</p>
            <h3 class="mt-2 text-base font-semibold text-gray-900">
              {item.title}
            </h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">
              {item.text}
            </p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Mission Section -->
  <Section background="gray" padding="lg">
    <div class="relative">
      <div class="text-center relative z-10">
        <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900">
          {missionHeading}
        </h2>
        <p class="mt-4 text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
          {missionBody}
        </p>
        <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8">
          {
            missionCards.map((card) => (
              <div class="p-6 bg-white rounded-card shadow-card border-t-2 border-transparent hover:border-primary-500 hover:-translate-y-1 hover:shadow-lg transition-all duration-300">
                <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-primary-100 flex items-center justify-center">
                  <span class="text-2xl" aria-hidden="true">
                    {card.icon}
                  </span>
                </div>
                <h3 class="text-lg font-semibold text-gray-900">
                  {card.title}
                </h3>
                <p class="mt-2 text-sm text-gray-600">{card.description}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </Section>

  <!-- Featured Story -->
  {
    testimonials.length > 0 && (
      <Section background="white" padding="md">
        <div class="max-w-3xl mx-auto">
          <a
            href="/stories/mama-rose-grandchildren"
            class="group block p-6 bg-gradient-to-r from-primary-50 to-accent-50 rounded-2xl border border-primary-100 hover:shadow-lg transition-all duration-300"
          >
            <div class="flex items-center gap-2 mb-2">
              <span class="px-2 py-0.5 text-[10px] font-semibold uppercase bg-purple-100 text-purple-700 rounded-full">
                Featured Story
              </span>
            </div>
            <h3 class="text-xl font-heading font-bold text-gray-900 group-hover:text-primary-700 transition-colors">
              Mama Patience: From Selling Her Last Cooking Pots to Running a
              Business
            </h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">
              When her husband died, Patience lost everything. She was selling
              her cooking pots one by one to feed her four children. Today,
              thanks to a $400 investment over 12 months, she runs a food
              business at the Bamenda market.
            </p>
            <span class="mt-3 inline-block text-sm font-medium text-primary-600">
              Read her full story →
            </span>
          </a>
        </div>
      </Section>
    )
  }

  <!-- Video Section -->
  <Section background="gray" padding="lg">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold text-gray-900">
        See Our Work in Action
      </h2>
      <p class="mt-4 text-gray-600">
        Watch how ADA programs are transforming lives in Cameroon.
      </p>
      <div class="mt-8 rounded-2xl overflow-hidden shadow-lg">
        <video
          controls
          preload="metadata"
          class="w-full aspect-video bg-gray-900"
          aria-label="ADA Back to School program video showing children receiving school supplies"
        >
          <source
            src="https://cdn.sanity.io/files/rj2m21gk/production/2595057db9e9f64f1e8e8833e720a4ce6b2feadd.mp4"
            type="video/mp4"
          />
          Your browser does not support the video tag.
        </video>
      </div>
      <p class="mt-3 text-sm text-gray-500">
        Widow Support Program — Delivering food and financial aid to widows in
        Buea, 2022
      </p>
    </div>
  </Section>

  <!-- Testimonials Section -->
  <Section background="white" padding="lg">
    <h2
      class="text-3xl md:text-4xl font-heading font-bold text-gray-900 text-center"
    >
      Stories of Impact
    </h2>
    <p class="mt-4 text-gray-600 text-center max-w-2xl mx-auto">
      Real stories from the people we serve.
    </p>
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-8">
      {
        testimonials.map((t) => (
          <div class="p-6 bg-gray-50 rounded-card shadow-card">
            <p class="text-gray-700 italic leading-relaxed">"{t.quote}"</p>
            <div class="mt-4 pt-4 border-t border-gray-200">
              <p class="text-sm font-semibold text-gray-900">{t.name}</p>
              <p class="text-xs text-gray-500">
                {t.program}
                {t.location ? ` \u2022 ${t.location}` : ""}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Action Paths -->
  <Section background="gray" padding="lg">
    <div class="max-w-3xl mx-auto text-center">
      <p
        class="text-xs font-semibold uppercase tracking-wider text-primary-700"
      >
        Join the work
      </p>
      <h2
        class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900"
      >
        Choose the path that fits your role
      </h2>
      <p class="mt-4 text-gray-600 leading-relaxed">
        Donors, volunteers, churches, companies, and grant partners can all help
        ADA serve with more consistency.
      </p>
    </div>
    <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {
        actionPaths.map((path) => (
          <a
            href={path.href}
            class="group flex h-full flex-col rounded-xl border border-gray-200 bg-white p-5 shadow-sm hover:border-primary-200 hover:shadow-lg transition-all duration-200"
          >
            <h3 class="text-lg font-semibold text-gray-900 group-hover:text-primary-700 transition-colors">
              {path.title}
            </h3>
            <p class="mt-2 flex-1 text-sm text-gray-600 leading-relaxed">
              {path.text}
            </p>
            <span class="mt-5 text-sm font-semibold text-primary-700">
              {path.cta} →
            </span>
          </a>
        ))
      }
    </div>
  </Section>

  <!-- CTA Section -->
  <Section background="dark" padding="lg" class="!bg-gray-900 !bg-none">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-heading font-bold">{ctaHeading}</h2>
      <p class="mt-4 text-lg text-white/80">
        {ctaBody}
      </p>
      <div
        class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4"
      >
        <a
          href="/donate"
          class="inline-flex items-center px-6 py-3 text-base font-semibold text-primary-800 bg-white rounded-lg hover:bg-gray-100 transition-colors"
          data-umami-event="cta-donate"
        >
          Donate Now
        </a>
        <a
          href="/get-involved"
          class="inline-flex items-center px-6 py-3 text-base font-semibold text-white border-2 border-white/30 rounded-lg hover:bg-white/10 transition-colors"
        >
          Volunteer With Us
        </a>
      </div>
    </div>
  </Section>

  <!-- Newsletter Section -->
  <Section background="gray" padding="lg">
    <div class="text-center">
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900">
        Stay Connected
      </h2>
      <p class="mt-2 text-gray-600 max-w-lg mx-auto">
        Get updates on our impact, stories, and upcoming projects delivered to
        your inbox.
      </p>
      <div class="mt-6">
        <NewsletterSignup client:visible />
      </div>
    </div>
  </Section>
</PageLayout>
