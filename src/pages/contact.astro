---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/layout/PageHero.astro";
import Section from "../components/layout/Section.astro";
import { getSiteSettings } from "../lib/sanity";
import { resolveHeroImage } from "../lib/hero-images";

let contactEmail = "info@apotidev.org";
let contactPhone = "+237 676 282 346";
let whatsappLink = "https://wa.me/237676282346";
const officeHours = "Monday–Friday, 8:00 a.m.–5:00 p.m. Cameroon time (UTC+1)";

try {
  const settings = await getSiteSettings();
  if (settings) {
    contactEmail = settings.contactEmail || contactEmail;
    contactPhone = settings.contactPhone || contactPhone;
    const whatsappNumber = (settings.contactPhone || "").replace(/[^0-9]/g, "");
    if (whatsappNumber) whatsappLink = `https://wa.me/${whatsappNumber}`;
  }
} catch {}

const heroTitle = "Contact Us";
const heroSubtitle =
  "Have questions or want to get involved? We'd love to hear from you.";
const heroBadge = "Get in Touch";
const heroImage = await resolveHeroImage([
  "widow-support",
  "women-empowerment",
]);
---

<!-- Hallmark · genre: editorial · macrostructure: Long Document · design-system: design.md · designed-as-app -->
<PageLayout
  title="Contact Us"
  description="Contact Apoti Development Association. Reach us by email, phone, or WhatsApp. Located in Cameroon, Central Africa."
>
  <PageHero
    title={heroTitle}
    subtitle={heroSubtitle}
    compact
    imageUrl={heroImage?.imageUrl}
    imageAlt={heroImage?.imageAlt}
  />

  <Section background="white" padding="lg">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Contact Info -->
      <div class="space-y-6">
        <h2 class="text-xl font-semibold text-gray-900">Reach us directly</h2>
        <div class="space-y-4">
          <div class="flex items-start gap-3">
            <div class="w-1 h-10 rounded-sm bg-primary-600 flex-shrink-0"></div>
            <div>
              <p class="text-sm font-medium text-gray-900">Email</p>
              <a
                href={`mailto:${contactEmail}`}
                class="text-sm text-primary-600 hover:underline"
                >{contactEmail}</a
              >
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-1 h-10 rounded-sm bg-primary-600 flex-shrink-0"></div>
            <div>
              <p class="text-sm font-medium text-gray-900">WhatsApp</p>
              <a
                href={whatsappLink}
                class="text-sm text-primary-600 hover:underline"
                >{contactPhone}</a
              >
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-1 h-10 rounded-sm bg-primary-600 flex-shrink-0"></div>
            <div>
              <p class="text-sm font-medium text-gray-900">Location</p>
              <p class="text-sm text-gray-600">Cameroon, Central Africa</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-1 h-10 rounded-sm bg-primary-600 flex-shrink-0"></div>
            <div>
              <p class="text-sm font-medium text-gray-900">Office hours</p>
              <p class="text-sm text-gray-600">{officeHours}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="lg:col-span-2">
        <form class="space-y-4" id="contact-form">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label
                for="name"
                class="block text-sm font-medium text-gray-700 mb-1"
                >Name <span aria-hidden="true">*</span></label
              >
              <input
                type="text"
                id="name"
                name="name"
                autocomplete="name"
                required
                minlength="2"
                maxlength="100"
                aria-describedby="required-fields-hint"
                class="w-full px-3 py-2.5 border border-gray-500 rounded-lg text-gray-900 focus:ring-2 focus:ring-primary-600 focus:border-primary-600"
              />
            </div>
            <div>
              <label
                for="email"
                class="block text-sm font-medium text-gray-700 mb-1"
                >Email <span aria-hidden="true">*</span></label
              >
              <input
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                required
                aria-describedby="required-fields-hint"
                class="w-full px-3 py-2.5 border border-gray-500 rounded-lg text-gray-900 focus:ring-2 focus:ring-primary-600 focus:border-primary-600"
              />
            </div>
          </div>
          <div>
            <label
              for="subject"
              class="block text-sm font-medium text-gray-700 mb-1"
              >Subject <span aria-hidden="true">*</span></label
            >
            <input
              type="text"
              id="subject"
              name="subject"
              required
              minlength="2"
              maxlength="150"
              aria-describedby="required-fields-hint"
              class="w-full px-3 py-2.5 border border-gray-500 rounded-lg text-gray-900 focus:ring-2 focus:ring-primary-600 focus:border-primary-600"
            />
          </div>
          <div>
            <label
              for="message"
              class="block text-sm font-medium text-gray-700 mb-1"
              >Message <span aria-hidden="true">*</span></label
            >
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              minlength="10"
              maxlength="5000"
              aria-describedby="message-hint"
              class="w-full px-3 py-2.5 border border-gray-500 rounded-lg text-gray-900 focus:ring-2 focus:ring-primary-600 focus:border-primary-600"
            ></textarea>
            <p id="message-hint" class="mt-1.5 text-sm text-gray-700">
              Please enter at least 10 characters.
            </p>
          </div>
          <button
            type="submit"
            class="w-full sm:w-auto px-6 py-3 text-base font-semibold text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors"
          >
            Send Message
          </button>
        </form>
        <p id="required-fields-hint" class="mt-3 text-sm text-gray-700">
          * Required fields. We use your details to respond to this message. See
          our <a
            href="/privacy"
            class="font-medium text-primary-700 underline underline-offset-2 hover:text-primary-800"
            >Privacy Policy</a
          >.
        </p>
      </div>
    </div>
  </Section>
</PageLayout>

<script>
  // Pre-fill subject from URL params (e.g. ?subject=Partnership+Inquiry)
  const urlParams = new URLSearchParams(window.location.search);
  const subjectParam = urlParams.get("subject");
  if (subjectParam) {
    const subjectInput = document.getElementById("subject") as HTMLInputElement;
    if (subjectInput) subjectInput.value = subjectParam;
  }

  const form = document.getElementById("contact-form");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = form.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement;
    // Remove any previous message
    const prev = form.querySelector("[data-form-msg]");
    if (prev) prev.remove();
    btn.disabled = true;
    btn.textContent = "Sending...";
    const data = Object.fromEntries(new FormData(form as HTMLFormElement));
    const msg = document.createElement("p");
    msg.setAttribute("role", "alert");
    msg.setAttribute("aria-live", "polite");
    msg.setAttribute("data-form-msg", "true");
    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      if (res.ok) {
        msg.className = "mt-4 text-sm text-green-700 font-medium";
        msg.textContent = "Message sent. Thank you for contacting ADA.";
        (form as HTMLFormElement).reset();
        btn.textContent = "Message Sent";
      } else {
        msg.className = "mt-4 text-sm text-red-600";
        msg.textContent =
          "Failed to send. Please try again or email info@apotidev.org directly.";
        btn.disabled = false;
        btn.textContent = "Send Message";
      }
    } catch {
      msg.className = "mt-4 text-sm text-red-600";
      msg.textContent =
        "Network error. Please check your connection and try again.";
      btn.disabled = false;
      btn.textContent = "Send Message";
    }
    form.appendChild(msg);
  });
</script>
