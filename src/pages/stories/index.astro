---
import SocialFollow from "../../components/stories/SocialFollow.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import PageHero from "../../components/layout/PageHero.astro";
import Section from "../../components/layout/Section.astro";
import StoryReleaseIndex from "../../components/stories/StoryReleaseIndex.astro";
import { STORY_RELEASE_HERO_IMAGE } from "../../lib/story-release-index";

const title = "Stories & Updates";
const description = "Stories, outreach updates, and program perspectives from Apoti Development Association in Cameroon.";
---

<PageLayout title={title} description={description} ogImage="/brand/ada-primary-lockup.png" ogImageAlt="Apoti Development Association">
	<PageHero title={title} subtitle="People we’ve helped and news from our outreaches." imageUrl={STORY_RELEASE_HERO_IMAGE} imageDecorative imageLayout="side" preserveFraming />
	<Section background="white" padding="lg">
		<StoryReleaseIndex locale="en" />
		<SocialFollow locale="en" />
	</Section>
</PageLayout>
