---
import HeroBackdrop from "../components/layout/HeroBackdrop.astro";
import { getEditorialHeroPhoto } from "../data/editorial-hero-photos";
import PageLayout from "../layouts/PageLayout.astro";
import Section from "../components/layout/Section.astro";
import DonationOutreachPhoto from "../components/layout/DonationOutreachPhoto.astro";
import DonationForm from "../components/islands/DonationForm";
import {
  getProjects,
  getSiteSettings,
  type SanityProject,
} from "../lib/sanity";
import {
  getProjectLifecycleState,
} from "../lib/project-lifecycle";
import {
  mergeProjectLists,
  normalizeFallbackProjects,
} from "../lib/project-fallbacks";
import { DONATION_FAQS_EN, buildFaqPage } from "../lib/structured-data";
import FaqSection from "../components/seo/FaqSection.astro";

const headerPhoto = getEditorialHeroPhoto("donate", "en");

let contactEmail = "info@apotidev.org";
try {
  const settings = await getSiteSettings();
  if (settings?.contactEmail) contactEmail = settings.contactEmail;
} catch {}

const pageTitle = "Make a Difference";
const pageSubtitle =
  "Help our local teams provide practical support to women and adolescent girls in Cameroon.";
const pageBadge = "Support Our Mission";

const trustIndicators = [
  { text: "Secure online giving", sub: "Payments handled by Stripe" },
  {
    text: "80% program-delivery target",
    sub: "A public allocation target, not an audited expense ratio",
  },
];

const givingExamples = [
  "Food and household essentials for widows",
  "Menstrual health supplies for adolescent girls",
  "Practical essentials for mothers and newborns",
];

const otherWaysToGive = [
  {
    title: "In-Kind Donations",
    description: `Contact <a href="mailto:${contactEmail}" class="text-primary-600 hover:underline">${contactEmail}</a> to arrange goods or supplies.`,
  },
  {
    title: "Corporate Matching",
    description:
      "Many employers match charitable donations. Ask your HR team if your company has a matching program.",
  },
  {
    title: "Sponsorships",
    description:
      '<a href="/sponsor" class="text-primary-600 hover:underline">Sponsor a focused program</a> and agree with ADA in advance on what the gift supports and what follow-up is possible.',
  },
  {
    title: "Legacy Giving",
    description:
      '<a href="/contact?subject=Legacy+Giving" class="text-primary-600 hover:underline">Contact us</a> to learn about including ADA in your estate plans.',
  },
];

const donationFaqs = DONATION_FAQS_EN;

let projectOptions: { slug: string; title: string }[] =
  normalizeFallbackProjects()
    .filter((p) => p.isFundable)
    .map((p) => ({ slug: p.slug, title: p.title }));
try {
  const projects = await getProjects();
  if (projects?.length) {
    projectOptions = mergeProjectLists(
      projects
        .filter((p: SanityProject) =>
          getProjectLifecycleState(p).isFundable,
        )
        .map((p: SanityProject) => ({
          slug: p.slug.current,
          title: p.title,
        })),
      projectOptions.filter((fallback) => !projects.some((project) => project.slug.current === fallback.slug)),
    );
  }
} catch {}

// Donation tier cost examples are omitted until each amount-to-outcome claim
// has a documented source that can be shown to donors.

const faqPageSchema = buildFaqPage(
  donationFaqs,
  new URL("/donate", Astro.site).toString(),
);
---

<PageLayout
  title="Donate"
  description="Support Apoti Development Association’s work with women and adolescent girls in Cameroon. Give once or monthly through secure online checkout."
  jsonLdExtra={[faqPageSchema]}
>
  <!-- Hallmark · genre: editorial · macrostructure: Split Studio · design-system: design.md · designed-as-app -->

  <!-- Split Studio: proof + form -->
  <Section background="white" padding="lg">
    <div
      class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-6 lg:gap-x-14 lg:gap-y-5 items-start"
    >
      <div class="relative isolate min-w-0 overflow-hidden rounded-md bg-primary-900 p-5 text-white md:p-6 lg:col-start-1 lg:row-start-1" data-donate-hero>
        <HeroBackdrop imageUrl={headerPhoto?.src} imageAlt={headerPhoto?.alt} imageDecorative={false} textDense />
        <div class="relative">
          <p
            class="text-xs font-semibold uppercase tracking-wider text-primary-100"
          >
            {pageBadge}
          </p>
          <h1
            class="mt-3 text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-white leading-tight tracking-tight"
          >
            {pageTitle}
          </h1>
          <p class="mt-5 text-lg text-white/90 leading-relaxed max-w-xl">
            {pageSubtitle}
          </p>
          {headerPhoto && (
            <a href={headerPhoto.credit.href} class="mt-4 inline-block text-sm text-white/90 underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4">
              {headerPhoto.credit.text}
            </a>
          )}
        </div>
      </div>

      <div
        id="donation-form"
        class="min-w-0 scroll-mt-24 rounded-md border border-gray-200 bg-gray-50 p-5 md:p-6 lg:col-start-2 lg:row-start-1 lg:row-span-2"
      >
        <DonationForm client:load projects={projectOptions} />
      </div>

      <div class="min-w-0 lg:col-start-1 lg:row-start-2">
        <ul
          class="grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-gray-200 pt-5"
        >
          {
            trustIndicators.map((item) => (
              <li class="min-w-0">
                <p class="text-sm font-semibold text-gray-900">{item.text}</p>
                <p class="mt-1 text-sm text-gray-600 leading-relaxed">
                  {item.sub}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  <!-- Records and Reporting -->
  <Section background="white" padding="md">
    <div
      class="max-w-5xl mx-auto flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="max-w-2xl">
        <p
          class="text-xs font-semibold uppercase tracking-wider text-primary-700"
        >
          After you give
        </p>
        <h2
          class="mt-2 text-xl md:text-2xl font-heading font-bold text-gray-900"
        >
          Your receipt and our public reports
        </h2>
        <p class="mt-2 text-sm text-gray-600 leading-relaxed">
          Once your card donation is confirmed, we email a payment receipt for
          your records. It is not an official charitable tax receipt. You can
          also read our published financial summaries and project reports where available.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 shrink-0">
        <a
          href="/transparency"
          class="inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-primary-600 rounded-md hover:bg-primary-700 transition-colors"
          >Financial summaries</a
        >
        <a
          href="/projects/archive"
          class="inline-flex items-center px-4 py-2 text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800"
          >Project reports</a
        >
      </div>
    </div>
  </Section>

  <!-- Giving priorities and gift designations -->
  <Section background="gray" padding="md">
    <div
      class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-[1fr_0.8fr] gap-5 items-stretch"
    >
      <div class="bg-white rounded-md border border-gray-200 p-5 md:p-6">
        <span
          class="text-xs font-semibold uppercase tracking-wider text-primary-700"
          >What your support helps make possible</span
        >
        <h2
          class="mt-3 text-2xl md:text-3xl font-heading font-bold text-gray-900"
        >
          Practical support in Cameroon
        </h2>
        <p class="mt-3 text-sm md:text-base text-gray-600 leading-relaxed">
          These examples come from our completed outreaches. A gift to our General
          Fund helps us respond to current needs. If you want to support a specific
          available outreach, select it in the donation form.
        </p>
        <ul class="mt-4 space-y-2">
          {
            givingExamples.map((need) => (
              <li class="flex gap-3 text-sm text-gray-700">
                <span
                  class="mt-1 h-2 w-2 rounded-full bg-primary-500 flex-shrink-0"
                  aria-hidden="true"
                />
                <span>{need}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-5 flex flex-wrap gap-3">
          <a
            href="#donation-form"
            class="inline-flex items-center px-4 py-2 text-sm font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors"
            >Go to the donation form</a
          >
          <a
            href="/projects/archive/"
            class="inline-flex items-center px-4 py-2 text-sm font-semibold text-primary-700 bg-primary-50 rounded-lg hover:bg-primary-100 transition-colors"
            >Read our outreach records</a
          >
        </div>
      </div>
      <div
        class="overflow-hidden rounded-md bg-primary-700 text-white"
      >
        <DonationOutreachPhoto locale="en" />
        <div class="p-5 md:p-6">
          <p
            class="text-sm font-semibold uppercase tracking-wider text-white/70"
          >
            How gifts are applied
          </p>
          <p class="mt-3 text-base text-white/90 leading-relaxed">
            To discuss a gift restricted to a specific purpose or agree what
            should happen if needs change, contact us before giving.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Monthly Giving -->
  <Section background="white" padding="md">
    <div
      class="max-w-5xl mx-auto flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="max-w-2xl">
        <p
          class="text-xs font-semibold uppercase tracking-wider text-primary-700"
        >
          Monthly Giving
        </p>
        <h2
          class="mt-3 text-2xl md:text-3xl font-heading font-bold text-gray-900"
        >
          Give monthly
        </h2>
        <p class="mt-2 text-sm text-gray-600 leading-relaxed">
          Learn how recurring gifts work, how to update or cancel them, and what
          they can support.
        </p>
      </div>
      <a
        href="/monthly"
        class="inline-flex items-center text-sm font-semibold text-primary-700 underline underline-offset-4 hover:text-primary-800 shrink-0"
        >See monthly giving details</a
      >
    </div>
  </Section>

  <!-- Other Ways to Give -->
  <Section background="gray" padding="md">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-heading font-bold text-gray-900">
        Other Ways to Give
      </h2>
      <ul class="mt-4 divide-y divide-gray-200 border-y border-gray-200">
        {
          otherWaysToGive.map((item) => (
            <li class="py-3">
              <h3 class="text-sm font-semibold text-gray-900">{item.title}</h3>
              <p
                class="mt-1 text-sm text-gray-600 leading-relaxed"
                set:html={item.description}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <!-- Donation FAQ -->
  <Section background="white" padding="lg">
    <FaqSection
      title="Frequently Asked Questions"
      subtitle="Everything you need to know before giving."
      faqs={donationFaqs}
      contactHref="/contact?subject=Donation+Question"
      contactLabel="More questions? Contact us — we typically respond within 24 hours."
    />
  </Section>
</PageLayout>
