---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/layout/PageHero.astro";
import Section from "../components/layout/Section.astro";
import {
  getTeamMembers,
  getImpactMetrics,
  sanityImageUrl,
} from "../lib/sanity";
import { REGISTRATION_NUMBER } from "../data/organization";

let teamMembers: {
  name: string;
  role: string;
  bio: string;
  photoUrl: string;
}[] = [];
try {
  const m = await getTeamMembers();
  if (m?.length)
    teamMembers = m.map((m: any) => ({
      name: m.name,
      role: m.role,
      bio: m.bio || "",
      photoUrl: m.photo?.asset?._ref
        ? sanityImageUrl(m.photo.asset._ref, 400)
        : "",
    }));
} catch {}

let teamStats = [
  { value: "10", label: "Active Volunteers" },
  { value: "5", label: "Years of Service" },
  { value: "5", label: "Communities" },
];

try {
  const metrics = await getImpactMetrics();
  if (metrics?.length) {
    const communities = metrics.find((m) => m.label.includes("Communities"));
    const years = metrics.find((m) => m.label.includes("Years"));
    teamStats = [
      { value: "10", label: "Active Volunteers" },
      {
        value: years ? `${years.value}${years.suffix || ""}` : "5",
        label: "Years of Service",
      },
      {
        value: communities
          ? `${communities.value}${communities.suffix || ""}`
          : "5",
        label: "Communities",
      },
    ];
  }
} catch {}

const heroTitle = "Our Team";
const heroSubtitle =
  "Dedicated individuals working together to serve vulnerable communities.";
const heroBadge = "The People Behind ADA";

const governanceProfiles = [
  {
    name: "Lionel Tchami Nfada",
    role: "Founder & President",
    bio: "Provides mission leadership, sponsor relationships, and strategic direction while keeping ADA focused on practical support for vulnerable families.",
  },
  {
    name: "Naomi Ndababonga",
    role: "Country Director",
    bio: "Coordinates Cameroon-based delivery, beneficiary follow-up, and local partner communication so sponsored work can be documented responsibly.",
  },
  {
    name: "Corrine Mbekenyui",
    role: "Regional Coordinator NW",
    bio: "Supports regional planning, community coordination, and field-level reporting for programs serving widows, students, and displaced families.",
  },
  {
    name: "Board of Directors",
    role: "12-member oversight board",
    bio: "Provides governance oversight for organizational direction, budgets, policies, and significant restricted gifts before funds are committed.",
  },
];

const governanceSafeguards = [
  {
    title: "Conflict-of-interest discipline",
    text: "Board, team, and volunteer participants are expected to disclose personal, family, business, or financial interests that could affect procurement, beneficiary selection, or program decisions.",
  },
  {
    title: "Restricted-gift approval",
    text: "Restricted gifts are reviewed before payment. Program leadership confirms purpose, feasibility, reporting expectations, and recognition terms; board-level oversight is used for larger or unusual restrictions.",
  },
  {
    title: "Financial controls",
    text: "Project spending is expected to follow budgets, receipts, invoices, distribution lists, field notes, or close-out reports where appropriate.",
  },
];
---

<PageLayout
  title="Our Team"
  description="Meet the dedicated team and volunteers behind Apoti Development Association serving communities across Cameroon."
>
  <PageHero
    title={heroTitle}
    subtitle={heroSubtitle}
    badge={heroBadge}
    compact
  />

  <Section background="white" padding="lg">
    <div class="max-w-5xl mx-auto">
      <div
        class="grid grid-cols-1 lg:grid-cols-[0.9fr_1.1fr] gap-8 items-start"
      >
        <div>
          <p class="text-sm font-semibold text-primary-700">
            Governance and oversight
          </p>
          <h2
            class="mt-2 text-2xl md:text-3xl font-heading font-bold text-gray-900"
          >
            People donors can identify, roles sponsors can verify
          </h2>
          <p class="mt-3 text-gray-600 leading-relaxed">
            ADA is registered in Cameroon ({REGISTRATION_NUMBER}) and uses
            volunteer executive leadership, country coordination, regional field
            support, and board oversight to protect donor confidence.
          </p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a
              href="/docs/diligence/ada-governance-overview.pdf"
              target="_blank"
              rel="noopener"
              class="inline-flex justify-center px-4 py-2 text-sm font-semibold text-primary-700 bg-primary-50 rounded-lg hover:bg-primary-100 transition-colors"
            >
              Governance overview
            </a>
            <a
              href="/docs/diligence/ada-anti-fraud-gift-integrity-summary.pdf"
              target="_blank"
              rel="noopener"
              class="inline-flex justify-center px-4 py-2 text-sm font-semibold text-gray-700 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors"
            >
              Gift integrity summary
            </a>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            governanceProfiles.map((profile) => (
              <article class="rounded-xl border border-gray-200 bg-gray-50 p-5">
                <h3 class="text-base font-semibold text-gray-900">
                  {profile.name}
                </h3>
                <p class="mt-1 text-sm font-semibold text-primary-700">
                  {profile.role}
                </p>
                <p class="mt-3 text-sm text-gray-600 leading-relaxed">
                  {profile.bio}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </Section>

  <Section background="gray" padding="md">
    <div class="max-w-5xl mx-auto">
      <div class="max-w-3xl">
        <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900">
          Governance safeguards sponsors ask about
        </h2>
        <p class="mt-2 text-sm text-gray-600 leading-relaxed">
          Sponsor trust depends on more than kind intentions. ADA publishes the
          controls sponsors commonly need for internal review: who decides, what
          gets disclosed, and how restricted funds are approved.
        </p>
      </div>
      <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
        {
          governanceSafeguards.map((item) => (
            <article class="rounded-xl border border-gray-200 bg-white p-5">
              <h3 class="text-base font-semibold text-gray-900">
                {item.title}
              </h3>
              <p class="mt-2 text-sm text-gray-600 leading-relaxed">
                {item.text}
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </Section>

  <Section background="white" padding="lg">
    <div class="mb-8 max-w-3xl">
      <h2 class="text-2xl md:text-3xl font-heading font-bold text-gray-900">
        Active team and volunteers
      </h2>
      <p class="mt-2 text-sm text-gray-600">
        Profiles below come from ADA's CMS and may be expanded as team members
        add approved photos and bios.
      </p>
    </div>
    {
      teamMembers.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {teamMembers.map((member) => (
            <div class="text-center">
              {member.photoUrl ? (
                <img
                  src={member.photoUrl}
                  alt={member.name}
                  class="w-32 h-32 mx-auto rounded-full object-cover shadow-md"
                  loading="lazy"
                />
              ) : (
                <div class="w-32 h-32 mx-auto rounded-full bg-primary-100 flex items-center justify-center">
                  <span class="text-3xl font-bold text-primary-600">
                    {member.name
                      .split(" ")
                      .map((n) => n[0])
                      .join("")}
                  </span>
                </div>
              )}
              <h3 class="mt-4 text-lg font-semibold text-gray-900">
                {member.name}
              </h3>
              <p class="text-sm text-primary-600">{member.role}</p>
              <p class="mt-2 text-sm text-gray-600">{member.bio}</p>
            </div>
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <span class="text-5xl">👥</span>
          <h2 class="mt-4 text-xl font-semibold text-gray-900">
            Team Profiles Coming Soon
          </h2>
          <p class="mt-2 text-gray-600 max-w-md mx-auto">
            Our team profiles will be available once added to the CMS. In the
            meantime, feel free to reach out to learn more about us.
          </p>
          <a
            href="/contact"
            class="mt-6 inline-flex items-center px-4 py-2 text-sm font-medium text-primary-700 border border-primary-200 rounded-lg hover:bg-primary-50 transition-colors"
          >
            Contact Us
          </a>
        </div>
      )
    }
  </Section>

  <!-- Stats -->
  <Section background="gray" padding="md">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
      {
        teamStats.map((stat) => (
          <div>
            <p class="text-3xl font-bold text-primary-700">{stat.value}</p>
            <p class="mt-1 text-sm text-gray-600">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- CTA -->
  <Section background="dark" padding="md">
    <div class="text-center">
      <h2 class="text-2xl font-heading font-bold">Join Our Team</h2>
      <p class="mt-2 text-white/80">
        We're always looking for passionate volunteers.
      </p>
      <a
        href="/get-involved"
        class="mt-4 inline-flex items-center px-6 py-3 text-base font-semibold text-primary-800 bg-white rounded-lg hover:bg-gray-100 transition-colors"
      >
        Get Involved
      </a>
    </div>
  </Section>
</PageLayout>
