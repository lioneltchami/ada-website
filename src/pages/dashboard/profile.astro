---
export const prerender = false;

import PageLayout from "../../layouts/PageLayout.astro";
import Section from "../../components/layout/Section.astro";

const user = Astro.locals.user;
---

<PageLayout title="Profile" description="Manage your ADA profile." noIndex>
  <Section background="gray" padding="lg">
    <div class="max-w-2xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-2xl font-heading font-bold text-gray-900">Your Profile</h1>
        <a href="/dashboard" class="text-sm text-primary-600 hover:underline">← Dashboard</a>
      </div>

      <div class="bg-white rounded-card shadow-card p-6">
        <form id="profile-form" class="space-y-4">
          <div>
            <label for="profile-name" class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
            <input type="text" id="profile-name" value={user?.user_metadata?.full_name || ""} class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
          </div>
          <div>
            <label for="profile-email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
            <input type="email" id="profile-email" value={user?.email || ""} disabled class="w-full px-3 py-2 border border-gray-200 rounded-lg bg-gray-50 text-gray-500" />
            <p class="mt-1 text-xs text-gray-400">Email cannot be changed.</p>
          </div>
          <div>
            <label for="profile-phone" class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
            <input type="tel" id="profile-phone" value={user?.user_metadata?.phone || ""} class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500" />
          </div>
          <button type="submit" class="px-5 py-2.5 text-sm font-semibold text-white bg-primary-600 rounded-lg hover:bg-primary-700">
            Save Changes
          </button>
        </form>
      </div>

      <!-- Sign Out -->
      <div class="mt-6 p-4 bg-white rounded-card shadow-card">
        <form method="POST" action="/api/auth/logout">
          <button type="submit" class="text-sm text-red-600 hover:underline">Sign Out</button>
        </form>
      </div>
    </div>
  </Section>
</PageLayout>

<script>
  const form = document.getElementById("profile-form");
  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const nameInput = document.getElementById("profile-name") as HTMLInputElement | null;
    const phoneInput = document.getElementById("profile-phone") as HTMLInputElement | null;
    form.querySelector("[data-profile-message]")?.remove();
    if (!btn || !nameInput || !phoneInput) return;

    btn.disabled = true;
    const msg = document.createElement("p");
    msg.setAttribute("data-profile-message", "true");
    msg.className = "text-sm mt-2";
    form.appendChild(msg);

    try {
      const res = await fetch("/api/auth/profile", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ fullName: nameInput.value, phone: phoneInput.value }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || "Profile update failed");
      msg.textContent = "Profile updated successfully.";
      msg.classList.add("text-green-600");
    } catch (err) {
      msg.textContent = err instanceof Error ? err.message : "Profile update failed";
      msg.classList.add("text-red-600");
    } finally {
      btn.disabled = false;
    }
  });
</script>
