---
import { getEditorialHeroPhoto } from "../data/editorial-hero-photos";
import { REGISTRATION_NUMBER } from "../data/organization";
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/layout/PageHero.astro";
import Section from "../components/layout/Section.astro";
import CalledToServe from "../components/about/CalledToServe.astro";

const locale = "en";
const archivePath = "/projects/archive";
const missionStatement = "Rooted in our Christian faith, we offer practical support to women and adolescent girls in Cameroon, with particular attention to widows and mothers. We welcome people of all faiths and none. Taking part in prayer is never a condition of receiving support.";
const storyParagraphs = [
  "Lionel Tchami Nfada founded Apoti Development Association in 2021. That November, our team brought food to widows in Buea and made time to listen and pray with those who wished to join.",
  "Since then, we have worked with local teams to meet practical needs. Today, our focus is women and adolescent girls. Our archive preserves the full record of earlier community outreaches.",
];
const coreValues = [
  { title: "Faith and compassion", desc: "Our Christian faith inspires us to serve with care and humility." },
  { title: "Dignity and respect", desc: "We listen to women and girls, respect their choices, and protect their privacy." },
  { title: "Local partnership", desc: "We work alongside people and organizations who know their communities." },
  { title: "Transparency", desc: "We document what we did, how funds were used, and what we can verify." },
];
const programs = [
  { title: "Widows’ Support", desc: "Food and practical help, informed by what widows tell our team they need.", slug: "widow-support-food-cash-mar-2022" },
  { title: "Girls’ Dignity", desc: "Menstrual health education and practical supplies for adolescent girls.", slug: "girls-dignity-menstrual-health-bamenda-jun-2026" },
  { title: "Support for Mothers", desc: "A completed outreach in Muea provided everyday essentials for mothers and newborns.", slug: "prenatal-care-support-program" },
];
const timeline = [
  { year: "2021", event: "Lionel Tchami Nfada founded ADA; our team made its first widows’ home visits in Buea." },
  { year: "2023", event: "Back-to-school supplies in Buea." },
  { year: "2025", event: "Our outreach work began in Bamenda." },
  { year: "2026", event: "Held the Girls’ Dignity and Menstrual Health Outreach in Bamenda." },
];
---

<!-- Hallmark · genre: editorial · macrostructure: Long Document · design-system: design.md · designed-as-app -->
<PageLayout title="About Us" description="Meet Apoti Development Association, a Christian nonprofit serving women and adolescent girls in Cameroon, including widows and mothers.">
  <PageHero
    title="About Us"
    subtitle="Practical support for women and adolescent girls in Cameroon."
    photo={getEditorialHeroPhoto("about", locale)}
  />

  <!-- Mission -->
  <Section background="white" padding="lg">
    <div class="max-w-3xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Our mission
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Shine the light of Jesus Christ through practical care
      </h2>
      <p class="mt-6 text-lg text-gray-600 leading-relaxed">{missionStatement}</p>
    </div>
    <p class="mt-6 text-sm text-gray-600 max-w-3xl">
      Registered nonprofit association in Cameroon · {REGISTRATION_NUMBER}
    </p>
  </Section>

  <CalledToServe locale={locale}>
    {storyParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    <a href="/team/" class="inline-flex mt-2 font-semibold text-primary-700 underline underline-offset-4">Meet our team</a>
  </CalledToServe>

  <!-- Core Values -->
  <Section background="gray" padding="lg">
    <div class="max-w-3xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        What guides us
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Our Core Values
      </h2>
    </div>
    <ul class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-0 border-t border-gray-200 max-w-4xl">
      {coreValues.map((value) => (
        <li class="border-b border-gray-200 py-5">
          <h3 class="font-heading text-lg font-semibold text-gray-900">{value.title}</h3>
          <p class="mt-1 text-sm text-gray-600 leading-relaxed">{value.desc}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- Programs (linked to project pages) -->
  <Section background="white" padding="lg">
    <div class="max-w-3xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        How we serve
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Our Programs
      </h2>
      <p class="mt-4 text-lg text-gray-600 leading-relaxed">
        Read the records behind the work. Each example describes an outreach we have carried out.
      </p>
    </div>
    <ul class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-0 border-t border-gray-200 max-w-4xl">
      {programs.map((program) => (
        <li class="border-b border-gray-200">
          <a href={`${archivePath}/${program.slug}/`} class="group flex items-baseline justify-between gap-4 py-5">
            <div>
              <h3 class="font-heading text-lg font-semibold text-gray-900 group-hover:text-primary-700 transition-colors">
                {program.title}
              </h3>
              <p class="mt-1 text-sm text-gray-600 leading-relaxed">{program.desc}</p>
              <span class="mt-2 inline-block text-sm font-semibold text-primary-700 underline underline-offset-4">Read the outreach record</span>
            </div>
            <span class="font-heading text-sm font-semibold text-primary-700 shrink-0" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section background="gray" padding="lg">
    <div id="where-we-work" class="max-w-5xl scroll-mt-28">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">Our locations</p>
      <h2 class="mt-3 font-heading text-3xl font-bold tracking-tight text-gray-900 md:text-4xl">Where we work</h2>
      <div class="mt-8 grid gap-5 lg:grid-cols-3">
        <article class="border border-gray-200 bg-white p-6">
          <p class="text-xs font-semibold uppercase tracking-wide text-primary-700">Established</p>
          <h3 class="mt-2 font-heading text-lg font-bold text-gray-900">Cameroon</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-700">We are registered in Cameroon and work with local teams in Buea and Bamenda. Our outreach work in Bamenda began in 2025.</p>
        </article>
        <article class="border border-gray-200 bg-white p-6">
          <p class="text-xs font-semibold uppercase tracking-wide text-primary-700">Sister initiative</p>
          <h3 class="mt-2 font-heading text-lg font-bold text-gray-900">Nigeria</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-700">Our sister initiative in Nigeria is Beacon of Blessings Charity Initiative.</p>
          <a href="https://www.blessedbeaconcharity.org/" class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-primary-800 underline underline-offset-4">Visit Beacon of Blessings</a>
        </article>
        <article class="border border-gray-200 bg-white p-6">
          <p class="text-xs font-semibold uppercase tracking-wide text-primary-700">In preparation</p>
          <h3 class="mt-2 font-heading text-lg font-bold text-gray-900">Canada</h3>
          <p class="mt-2 text-sm leading-relaxed text-gray-700">We are preparing to form a nonprofit in Canada and exploring local service opportunities. We have not launched Canadian programs and do not issue Canadian charitable tax receipts.</p>
        </article>
      </div>
    </div>
  </Section>

  <!-- Timeline -->
  <Section background="gray" padding="lg">
    <div class="max-w-3xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Our journey
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Milestones in our work
      </h2>
    </div>
    <ol class="mt-10 max-w-3xl space-y-0 list-none border-l border-gray-200 ml-1">
      {timeline.map((milestone) => (
        <li class="relative pl-8 pb-8 last:pb-0">
          <span
            class="absolute left-0 top-1.5 -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-primary-600 border-2 border-[#f7f5f0]"
            aria-hidden="true"
          />
          <p class="font-heading text-sm font-bold text-primary-700">{milestone.year}</p>
          <p class="mt-1 text-sm text-gray-600 leading-relaxed">{milestone.event}</p>
        </li>
      ))}
    </ol>
    <a href={`${archivePath}/`} class="mt-6 inline-flex text-sm font-semibold text-primary-700 underline underline-offset-4">View all outreach records</a>
  </Section>

  <!-- Impact Video -->
  <Section background="white" padding="lg">
    <div class="max-w-4xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Field footage
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Earlier outreaches
      </h2>
      <p class="mt-4 text-lg text-gray-600 leading-relaxed">
        These videos are part of our history and include broader community outreach. Our archive has the full program records.
      </p>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-md overflow-hidden border border-gray-200">
          <video controls preload="metadata" class="w-full aspect-video bg-gray-900" aria-label="ADA Back to School program video">
            <source src="https://cdn.sanity.io/files/rj2m21gk/production/6d43bdec66014a0bddb4702538982688a8ec4412.mp4" type="video/mp4" />
            Your browser does not support the video tag.
          </video>
          <p class="p-3 text-sm text-gray-600 bg-gray-50 border-t border-gray-200">Back to School Program 2022</p>
        </div>
        <div class="rounded-md overflow-hidden border border-gray-200">
          <video controls preload="metadata" class="w-full aspect-video bg-gray-900" aria-label="ADA community outreach video">
            <source src="https://cdn.sanity.io/files/rj2m21gk/production/02cbff013caef81d8c01e96e68f95cb364ce3a01.mp4" type="video/mp4" />
            Your browser does not support the video tag.
          </video>
          <p class="p-3 text-sm text-gray-600 bg-gray-50 border-t border-gray-200">Community Outreach</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Closing CTA -->
  <Section background="dark" padding="lg" class="!bg-[#121a14] !bg-none">
    <div class="max-w-2xl">
      <h2 class="text-3xl md:text-4xl font-heading font-bold tracking-tight text-left">
        Join Our Mission
      </h2>
      <p class="mt-4 text-lg text-white/80 text-left">
        Through giving, volunteering, or prayer, you can support our work with women and adolescent girls in Cameroon.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/donate"
          class="font-heading inline-flex items-center px-5 py-2.5 text-sm font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors"
        >
          Donate Now
        </a>
        <a
          href="/get-involved"
          class="font-heading text-sm font-semibold text-white/90 underline decoration-white/40 underline-offset-4 hover:text-white"
        >
          Get Involved
        </a>
        <a
          href="/team"
          class="font-heading text-sm font-semibold text-white/90 underline decoration-white/40 underline-offset-4 hover:text-white"
        >
          Meet Our Team
        </a>
      </div>
    </div>
  </Section>
</PageLayout>
