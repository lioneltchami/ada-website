---
import PageLayout from "../layouts/PageLayout.astro";
import PageHero from "../components/layout/PageHero.astro";
import Section from "../components/layout/Section.astro";
import { getAboutPage, getGalleryImages, getProjects, type SanityAboutPage, type SanityProject, sanityImageUrl } from '../lib/sanity';
import { getLocale, t, localePath } from '../i18n';

const locale = getLocale(Astro.url.pathname);
const i18n = t(locale);

// Fallbacks
let missionStatement = 'Shine the light of Jesus Christ by empowering widows, orphans, and young women in Cameroon through food distribution, education, vocational training, and healthcare — restoring dignity and building self-sufficiency.';
const defaultMissionStatement = missionStatement;
let storyParagraphs = [
  'Founded in 2021, Apoti Development Association was born from a deep conviction that faith must be expressed through action. In the heart of Cameroon, where widows, orphans, and young women face daily challenges of poverty and marginalization, we saw an opportunity to make a tangible difference.',
  'Pastor Emmanuel Tchami, witnessing the struggles of widows in his community who had lost everything — their husbands, their income, their dignity — felt called to act. He gathered a small group of committed believers and together they delivered their first food packages to three widows in Bamenda.',
  'What began as a simple act of compassion has grown into a community-driven organization serving communities across Cameroon. Its programs are designed not just to provide relief, but to build lasting self-sufficiency.',
];
const defaultStoryParagraphs = storyParagraphs;
let coreValues = [
  { icon: '', title: 'Faith & Love', desc: 'Grounded in Christian faith, we serve with unconditional love and compassion.' },
  { icon: '', title: 'Dignity & Respect', desc: 'Every person we serve is treated with the dignity they deserve as God\'s creation.' },
  { icon: '', title: 'Empowerment & Growth', desc: 'We equip people with skills and resources to build their own futures.' },
  { icon: '', title: 'Transparency & Integrity', desc: 'We are accountable to our donors, partners, and the communities we serve.' },
  { icon: '', title: 'Community Partnership', desc: 'We work alongside local leaders and organizations for lasting impact.' },
  { icon: '', title: 'Sustainable Impact', desc: 'Our programs are designed to create long-term change, not temporary relief.' },
];
let programs = [
  { icon: '', title: 'Food Distribution', desc: 'Regular food packages for widows and families in need.', slug: 'widow-support' },
  { icon: '', title: 'Hospital Visits', desc: 'Medical support and hospital visits for community members.', slug: 'emergency-relief' },
  { icon: '', title: 'Back-to-School Support', desc: 'School supplies, uniforms, and tuition for orphaned children.', slug: 'education-orphans' },
  { icon: '', title: 'Community Clean-Up', desc: 'Environmental stewardship through clean-up drives, tree planting, and waste management education.', slug: 'archive/city-cleanup-may-2023' },
];
let timeline = [
  { year: '2021', event: 'Founded in Buea — first food packages delivered to widows facing crisis' },
  { year: '2023', event: 'Education program begins — 20 orphaned children sponsored for school' },
  { year: '2024', event: 'Bamenda office opened — expanded regional reach and partner documentation' },
  { year: '2025', event: 'Community clean-up activities' },
  { year: '2026', event: 'Pursuing Canadian institutional partnerships and planning a skills center' },
];

try {
  const page = await getAboutPage(locale);
  if (page) {
    missionStatement = page.missionStatement || missionStatement;
    if (page.storyParagraphs?.length && typeof page.storyParagraphs[0] === 'string') storyParagraphs = page.storyParagraphs;
    if (page.coreValues?.length) {
      coreValues = page.coreValues.map((v) => ({
        icon: v.icon || "",
        title: v.title,
        desc: v.description,
      }));
    }
    if (page.programs?.length) {
      programs = page.programs.map((p) => ({
        icon: p.icon || "",
        title: p.title,
        desc: p.description,
        slug: p.slug || "widow-support",
      }));
    }
    if (page.timeline?.length) timeline = page.timeline;
  }
} catch {}

const wellReference = /clean water|water well|borehole|water access|puits|forage|eau potable/i;
if (wellReference.test(missionStatement)) missionStatement = defaultMissionStatement;
storyParagraphs = storyParagraphs.filter((paragraph) => !wellReference.test(paragraph));
if (storyParagraphs.length === 0) storyParagraphs = defaultStoryParagraphs;
programs = programs.filter((program) => !wellReference.test(`${program.title} ${program.desc}`) && program.slug !== "women-empowerment" && program.slug !== "young-women-skills-training-program");
timeline = timeline.filter((item) => !wellReference.test(item.event));

// Fetch a community photo for the story section + page hero
let communityPhotoUrl = '';
let communityPhotoAlt = 'ADA community work in Cameroon';
try {
  const photos = await getGalleryImages(undefined, "en");
  const photo = photos.find((item) => item.photo?.asset?._ref);
  if (photo?.photo?.asset?._ref) {
    communityPhotoUrl = sanityImageUrl(photo.photo.asset._ref, 1400);
    communityPhotoAlt = photo.photo.alt || photo.title || communityPhotoAlt;
  }
} catch {}
---

<!-- Hallmark · genre: editorial · macrostructure: Long Document · design-system: design.md · designed-as-app -->
<PageLayout title="About Us" description="Learn about Apoti Development Association's mission to empower vulnerable communities in Cameroon through faith-based programs.">
  <PageHero
    title="About Us"
    subtitle="Faith-based charity empowering vulnerable communities in Cameroon since 2021."
    imageUrl={communityPhotoUrl}
    imageAlt={communityPhotoAlt}
  />

  <!-- Mission -->
  <Section background="white" padding="lg">
    <div class="max-w-3xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Our mission
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Shine the light of Jesus Christ through practical care
      </h2>
      <p class="mt-6 text-lg text-gray-600 leading-relaxed">{missionStatement}</p>
    </div>
    <div class="mt-10 grid grid-cols-2 gap-8 border-y border-gray-200 py-8 max-w-3xl">
      <div>
        <p class="font-heading text-3xl font-bold text-primary-700 tracking-tight">5</p>
        <p class="mt-1 text-sm text-gray-600">Communities</p>
      </div>
      <div>
        <p class="font-heading text-3xl font-bold text-primary-700 tracking-tight">80%</p>
        <p class="mt-1 text-sm text-gray-600">To Programs</p>
      </div>
    </div>
    <p class="mt-6 text-sm text-gray-500 max-w-3xl">
      Registered NGO in Cameroon · Led from Canada · N&deg; 415/G.37/D14/VolI/SAAJP
    </p>
  </Section>

  <!-- Our Story + Photo -->
  <Section background="gray" padding="lg">
    <div class="max-w-4xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Our story
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Called to Serve
      </h2>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-5 gap-8 items-start">
        <div class="md:col-span-3 space-y-4 text-gray-600 leading-relaxed">
          {storyParagraphs.map(p => <p>{p}</p>)}
          <div class="mt-6 rounded-md border border-gray-200 bg-white p-5">
            <p class="text-xs font-semibold uppercase tracking-wide text-primary-700">Founder credibility</p>
            <h3 class="mt-2 text-lg font-semibold text-gray-900">Pastor Emmanuel Tchami leads ADA through local church and community partnerships.</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">His team works directly with widows, orphan caregivers, school leaders, and volunteers in Cameroon so support reaches named programs and documented community needs.</p>
            <dl class="mt-4 grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
              <div>
                <dt class="font-semibold text-gray-900">Founded</dt>
                <dd class="text-gray-500">2021 in Buea</dd>
              </div>
              <div>
                <dt class="font-semibold text-gray-900">Accountability</dt>
                <dd class="text-gray-500">Registered NGO</dd>
              </div>
              <div>
                <dt class="font-semibold text-gray-900">Model</dt>
                <dd class="text-gray-500">Local partners first</dd>
              </div>
            </dl>
          </div>
        </div>
        {communityPhotoUrl && (
          <div class="md:col-span-2">
            <img src={communityPhotoUrl} alt="ADA community program in action" class="w-full rounded-md border border-gray-200" loading="lazy" />
          </div>
        )}
      </div>
    </div>
  </Section>

  <!-- Impact Video -->
  <Section background="white" padding="lg">
    <div class="max-w-4xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Field footage
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        See Our Impact
      </h2>
      <p class="mt-4 text-lg text-gray-600 leading-relaxed">
        Watch how your support transforms lives in our communities.
      </p>
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-md overflow-hidden border border-gray-200">
          <video controls preload="metadata" class="w-full aspect-video bg-gray-900" aria-label="ADA Back to School program video">
            <source src="https://cdn.sanity.io/files/rj2m21gk/production/6d43bdec66014a0bddb4702538982688a8ec4412.mp4" type="video/mp4" />
            Your browser does not support the video tag.
          </video>
          <p class="p-3 text-sm text-gray-600 bg-gray-50 border-t border-gray-200">Back to School Program 2022</p>
        </div>
        <div class="rounded-md overflow-hidden border border-gray-200">
          <video controls preload="metadata" class="w-full aspect-video bg-gray-900" aria-label="ADA community outreach video">
            <source src="https://cdn.sanity.io/files/rj2m21gk/production/02cbff013caef81d8c01e96e68f95cb364ce3a01.mp4" type="video/mp4" />
            Your browser does not support the video tag.
          </video>
          <p class="p-3 text-sm text-gray-600 bg-gray-50 border-t border-gray-200">Community Outreach</p>
        </div>
      </div>
    </div>
  </Section>

  <!-- Core Values -->
  <Section background="gray" padding="lg">
    <div class="max-w-3xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        What guides us
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Our Core Values
      </h2>
    </div>
    <ul class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-0 border-t border-gray-200 max-w-4xl">
      {coreValues.map((value) => (
        <li class="border-b border-gray-200 py-5">
          <h3 class="font-heading text-lg font-semibold text-gray-900">{value.title}</h3>
          <p class="mt-1 text-sm text-gray-600 leading-relaxed">{value.desc}</p>
        </li>
      ))}
    </ul>
  </Section>

  <!-- Programs (linked to project pages) -->
  <Section background="white" padding="lg">
    <div class="max-w-3xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        How we serve
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        Our Programs
      </h2>
      <p class="mt-4 text-lg text-gray-600 leading-relaxed">
        Focused programs addressing the most pressing needs in our communities.
      </p>
    </div>
    <ul class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-0 border-t border-gray-200 max-w-4xl">
      {programs.map((program) => (
        <li class="border-b border-gray-200">
          <a href={`/projects/${program.slug}`} class="group flex items-baseline justify-between gap-4 py-5">
            <div>
              <h3 class="font-heading text-lg font-semibold text-gray-900 group-hover:text-primary-700 transition-colors">
                {program.title}
              </h3>
              <p class="mt-1 text-sm text-gray-600 leading-relaxed">{program.desc}</p>
            </div>
            <span class="font-heading text-sm font-semibold text-primary-700 shrink-0" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <!-- Timeline -->
  <Section background="gray" padding="lg">
    <div class="max-w-3xl">
      <p class="font-heading text-xs font-semibold uppercase tracking-wider text-primary-700">
        Our journey
      </p>
      <h2 class="mt-3 text-3xl md:text-4xl font-heading font-bold text-gray-900 tracking-tight">
        From first food packages to growing impact
      </h2>
    </div>
    <ol class="mt-10 max-w-3xl space-y-0 list-none border-l border-gray-200 ml-1">
      {timeline.map((milestone) => (
        <li class="relative pl-8 pb-8 last:pb-0">
          <span
            class="absolute left-0 top-1.5 -translate-x-1/2 w-2.5 h-2.5 rounded-full bg-primary-600 border-2 border-[#f7f5f0]"
            aria-hidden="true"
          />
          <p class="font-heading text-sm font-bold text-primary-700">{milestone.year}</p>
          <p class="mt-1 text-sm text-gray-600 leading-relaxed">{milestone.event}</p>
        </li>
      ))}
    </ol>
  </Section>

  <!-- Closing CTA -->
  <Section background="dark" padding="lg" class="!bg-[#121a14] !bg-none">
    <div class="max-w-2xl">
      <h2 class="text-3xl md:text-4xl font-heading font-bold tracking-tight text-left">
        Join Our Mission
      </h2>
      <p class="mt-4 text-lg text-white/80 text-left">
        Whether through giving, volunteering, or prayer, you can make a difference in the lives of widows, orphans, and young women in Cameroon.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <a
          href="/donate"
          class="font-heading inline-flex items-center px-5 py-2.5 text-sm font-semibold text-white bg-secondary-500 rounded-md hover:bg-secondary-600 transition-colors"
        >
          Donate Now
        </a>
        <a
          href="/get-involved"
          class="font-heading text-sm font-semibold text-white/90 underline decoration-white/40 underline-offset-4 hover:text-white"
        >
          Get Involved
        </a>
        <a
          href="/team"
          class="font-heading text-sm font-semibold text-white/90 underline decoration-white/40 underline-offset-4 hover:text-white"
        >
          Meet Our Team
        </a>
      </div>
    </div>
  </Section>
</PageLayout>
